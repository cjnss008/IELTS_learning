# Preserve the original learning package bytes across Windows and NAS.
* -text

# Audio is binary; the large EPUB is stored with Git LFS.
*.mp3 -diff
*.epub filter=lfs diff=lfs merge=lfs -text
# User-authorized textbook originals and any later imported textbook audio.
*.pdf filter=lfs diff=lfs merge=lfs -text
materials/textbook-audio/** filter=lfs diff=lfs merge=lfs -text
audio/curriculum/*.mp3 filter=lfs diff=lfs merge=lfs -text
audio/independent-bank/*.mp3 filter=lfs diff=lfs merge=lfs -text
audio/vocabulary/*.mp3 filter=lfs diff=lfs merge=lfs -text
audio/oral-models/*.mp3 filter=lfs diff=lfs merge=lfs -text
*.cmd text eol=crlf
runtime-packages/*.zip filter=lfs diff=lfs merge=lfs -text

audio/human-listening/** filter=lfs diff=lfs merge=lfs -text

audio/public/** filter=lfs diff=lfs merge=lfs -text

audio/independent-bank/us/** filter=lfs diff=lfs merge=lfs -text

# Portable local English recognizer and model; no learner audio.
runtime-packages/local-asr/*.zip filter=lfs diff=lfs merge=lfs -text
runtime-packages/local-asr/*.bin filter=lfs diff=lfs merge=lfs -text
