    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 36,
        "text": "Hello. I am Maya. Are you new?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "21930a8f4e2a655ceba880fbaa55d5f5db1951ebc527580bf5df6dc99fa5541a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 42,
        "sourceEnd": 83,
        "text": "Yes, I am Leo. I am in the evening class.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b33ff322457025b03e5307fd3f599891342688c134a68f958a9f07cc1a7e94e7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 90,
        "sourceEnd": 110,
        "text": "Are you in Room Two?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82478880e859fa1f0049fe50203dc18416974822434026cdae212f73dd6f5c4e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 116,
        "sourceEnd": 148,
        "text": "No, I am not. I am in Room Four.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a62f376c5d306fdf133a0fc279eadf5b72c4785f62186cea602afc25e8f0f06f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 155,
        "sourceEnd": 173,
        "text": "We are classmates.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "90052bdf258ab26140942474d4193a56a6c3f7b5970852780cd291feb0cfa362",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 180,
        "sourceEnd": 217,
        "text": "I am Ben, the teacher. Are you ready?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "77d237b38f38a9098b79f7460b174bf5e1c0dae9cffa1586241898df6cbfa299",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 224,
        "sourceEnd": 245,
        "text": "Yes. My book is blue.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2d8f3bcfe727f3367c33b6973ced3b0c430cc9497a338c90893806e37576d43e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 251,
        "sourceEnd": 273,
        "text": "No. My pen is at home.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "708d32c17c05912a07b29b44fc46c8957a93fe52d4739fe0cac58516fec78cef",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 279,
        "sourceEnd": 321,
        "text": "A green pen is on the desk. It is for you.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "85252b064fa00b7d100a93ad7fb270b53626eaaba33568677d1bd54c7b5c764a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 327,
        "sourceEnd": 366,
        "text": "Are the books on the chair for Class A?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a3824927fea3febfca2902f776092fc3b0216a52529ff003de59b362db963675",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 372,
        "sourceEnd": 449,
        "text": "No, they are not. They are for Class C. The books for Class A are in the box.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "31bbad8bf8be54ec1263d36ecc4b7357a29243ec7014e4146781545600cf5d11",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 457,
        "sourceEnd": 477,
        "text": "Is the class at six?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f236f1e12b54e6df59abd55e71cfbdb2f34a8f7c253bcfa80d6e745ddce021f6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 483,
        "sourceEnd": 509,
        "text": "No. The class is at seven.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c8fb8f8ccd200475fa3b267e51ad52a645e08de98bcb19b412b936c66269d309",
        "pauseBeforeSeconds": 0.45
      }
    ]
