    "segments": [
      {
        "role": "narrator",
        "speaker": "Narrator",
        "sourceStart": 10,
        "sourceEnd": 43,
        "text": "It is 7 p.m. Anna opens the door.",
        "boundary": "section",
        "voice": "en-US-AvaNeural",
        "textHash": "3f078ab3346b0a0eeeb7d91c4ccb4b574c7af16c454593e98eaabd6c2c901736",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 50,
        "sourceEnd": 90,
        "text": "Hello. I am Anna. Are you a new student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2f20190106291fdf124bd799ccd902e9d0c304c164bbb0ed79f8ebf3352ad385",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 96,
        "sourceEnd": 128,
        "text": "Yes. I am Ben. Nice to meet you.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bf999688aca803f124c6684a9f667cd8c8bb95381d0d4c582896821824b7272b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 135,
        "sourceEnd": 176,
        "text": "Nice to meet you, too. You are in Room 3.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "343c2f17b94178f10de27a88893950e06a23a95a3de53f5280db2f4c2c5185e3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 182,
        "sourceEnd": 213,
        "text": "Thank you. Are you the teacher?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ebff0a555d09a03b490b624ce96c23a38213397e5028517bdb64f8476ca20d93",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 220,
        "sourceEnd": 264,
        "text": "No, I am not. I am a student. I am new, too.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "38d51b6874790f756f7ff5fa286ba3a1a870be72897408e5d335754186874c53",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 270,
        "sourceEnd": 304,
        "text": "Oh! You are a student. I am happy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "00e163d97bed04c0b5590887b6022ceb9ae2d9402310e5aab3267fa2d10b4d81",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 311,
        "sourceEnd": 359,
        "text": "We are classmates. This is Tom. He is a student.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "14d91144de6c98b83628e9c04391d2cfd9946dcd6b8440f73e4a1afb3bb7369f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 365,
        "sourceEnd": 389,
        "text": "Hello, Tom. Are you new?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fed4122de8668abd1db39521368eebe0d55f3b69c02e74153688b1eb6a09dedf",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 395,
        "sourceEnd": 440,
        "text": "No, I am not. I am not new here. You are new.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "14737d3c88221de64c7041f343a3d81c7b102b3a619fc216ff3db94be9f479d7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 446,
        "sourceEnd": 482,
        "text": "Yes. I am new. We are all in Room 3.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d90dc950fecd4d2bc6d7f943722a679958b08ff26b931407c46e17ad74a970f4",
        "pauseBeforeSeconds": 0.45
      }
    ]
