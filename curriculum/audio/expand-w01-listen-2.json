    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 47,
        "text": "Good morning. I am Mia. Are you a visitor?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0cfefba9f8020c601f73ed25f9123c68cd69f228588be23b7198d5d7dcf0d583",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 53,
        "sourceEnd": 90,
        "text": "Yes. I am Ben. I am here for Room 12.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2dbde59ef0320d695a94d5bcfdb3e5342a558daff12323a8ee46cf861425de39",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 96,
        "sourceEnd": 128,
        "text": "Room 12? No. You are in Room 14.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3e9569ed2376c7b3236bc2b07d660ba4b1ce1f5138fa3c5508d9cb4395671fb9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 134,
        "sourceEnd": 157,
        "text": "Oh. Room 14. Thank you.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a614788a84bfbc97800c4d1033af2034add8e15d67de6062c113a88ee626f146",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 163,
        "sourceEnd": 185,
        "text": "Are you with a friend?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a632661a9d5b53463984f9344ca61cd41fbbfb004e9efa1460690c28ca95830c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 191,
        "sourceEnd": 227,
        "text": "Yes. We are here. We are two people.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "61c47dc804a74ebe82866e3eccf16328b3047c3eda76fe6996f529628e0ef7be",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 233,
        "sourceEnd": 278,
        "text": "Good. You are in Room 14. It is on floor two.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82e0e46b95f77b36e4a851c892483c2ac0c9f808367271319123d31275950f8d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 284,
        "sourceEnd": 306,
        "text": "Is it near the stairs?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c87a2774630348c91d174d76d4c4637c20e9e81968117ab10a38432116e5547d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 312,
        "sourceEnd": 345,
        "text": "Yes, it is. The stairs are there.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6556db0aba6785d1573621dd9ca0ffb12632681e486a19504aafd97f7cfec836",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 351,
        "sourceEnd": 387,
        "text": "Great. We are happy. Thank you, Mia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3a7b3e2dc96ab6f5e37e237436b756fb736052387abc084105e37f55aaad64a4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 393,
        "sourceEnd": 426,
        "text": "You are welcome. Have a good day.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cc72793966efc8be6ab86af2ea575a9ec3dba7278c983e06e8bbbf71f62a7f1f",
        "pauseBeforeSeconds": 0.45
      }
    ]
