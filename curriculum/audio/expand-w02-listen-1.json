    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 52,
        "text": "Hi, Ben. This is our flat. That is the kitchen.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8f8d1d91a8cb6ff29528e6a0b2e4837c024dd54c85b88ea9c8e301557a460a34",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 58,
        "sourceEnd": 100,
        "text": "Hi, Mia. It is small but nice. Who is she?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d2f93b415f3663f701df3d902cc0a2610f24e4e77791ff8534fe6070d1034c68",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 106,
        "sourceEnd": 158,
        "text": "She is Lucy. She is a teacher. She is not a student.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "785f2785fafe8f9b488712666d4af9eb83bf3c81c1a24daebde3a3ed4a40df25",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 164,
        "sourceEnd": 178,
        "text": "And who is he?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ca122528adeee044e045a76fa860181bbdae9aebd1aad46cdbd4d8ff0c7b57f1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 184,
        "sourceEnd": 228,
        "text": "He is Tom. He is a cook. He is not a doctor.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d5687b555fa7099fefb99e1365c835c182435985a4ba2e4d72f3e08abe55fe5b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 234,
        "sourceEnd": 252,
        "text": "Is that your room?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ef314e585d8949ced7bae4313bb330d218a075e9e3b60634d02ccfae1b4ac965",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 258,
        "sourceEnd": 309,
        "text": "No, that is Tom's room. This is my room. It is big.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "62d29384071b6026ca34386b44eef681c69dc11c18f4a3e6b3a8fc719c1efc4e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 315,
        "sourceEnd": 331,
        "text": "Is Lucy a nurse?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c00a015ec0b2ddba678e55387d5e23115f04eab910897eac3e561f7d24eefe1a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 337,
        "sourceEnd": 378,
        "text": "No, she is not a nurse. She is a teacher.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "20cd3ee63e883492eb44059f92217aa70be3438f626f305a22482f3539ec94d0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 384,
        "sourceEnd": 405,
        "text": "OK. Is Tom a teacher?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "722f5470a6c7ee0d44b61aea982b18064e759ac86ebc592c47a508c2a4da3dad",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 411,
        "sourceEnd": 449,
        "text": "No, he is a cook. He is not a teacher.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3ed1fc684b8ba97210fdbf0272bcea32ca5c8dd0510e8b491e4023a99b1009a3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 455,
        "sourceEnd": 467,
        "text": "Thanks, Mia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4d8f63669f98389156460b122366433f7de4f8c051ec9e8cb2609ebec0930c00",
