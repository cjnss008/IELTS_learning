    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 50,
        "text": "Hi, Ben. This is our team table. It is small.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "316c9c5e0bf64b3ef425dc73e87082a2807426a4b348a5fe212cbc205517dd4f",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 56,
        "sourceEnd": 114,
        "text": "Yes. It is a small table. And this is a cup. It is my cup.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9c05b548e3a5c8b4fa343535741de8cad8695770d1e6c28872cada2eb604ec33",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 120,
        "sourceEnd": 154,
        "text": "That is a red cup. Is it your cup?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "055a5967e38a621d7505d8b20a5fa79f339d35ec1e1cb5b37f4f06f195544787",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 160,
        "sourceEnd": 215,
        "text": "No, it is not my cup. It is Anna's cup. My cup is blue.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6d7edb56679d2fff390344a250b91eca7cca168f22971697e3b447e69affd0d2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 221,
        "sourceEnd": 266,
        "text": "Oh, sorry. And that is a bag. Is it your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "786e34f73851910f66cfc17ac36ccd50e44d6de6c0d2e70677f4dc1f8a46105c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 272,
        "sourceEnd": 324,
        "text": "No. It is not my bag. It is Anna's bag. She is here.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ac401e7e6f65ec45db4c84408a806e40e63330f1dbf25a7d2c3364ec5e89f80f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 330,
        "sourceEnd": 353,
        "text": "Anna, is this your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ad4985e74bd1b35afd312114025a4dd7a809f0b0f732ac654b9059e9855661c8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 360,
        "sourceEnd": 421,
        "text": "Yes, it is. Thank you. And this is my pen. It is a black pen.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ead9388d7622f30c2a4ca33bc82aca060fbf195b78ba49019233b136ea71fa98",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 427,
        "sourceEnd": 467,
        "text": "That is a phone. Is it your phone, Anna?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9e89afd90952fc290d00089e03f19fb997e522719493eaf646ce767475a503b0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 474,
        "sourceEnd": 536,
        "text": "No, it is not my phone. It is Mia's phone. She is at the door.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "01db4d97edff6a09bd2947ae11cbfbab6a37e7bd009296f85b7c4e0df989e34a",
        "pauseBeforeSeconds": 0.45
      }
    ]
