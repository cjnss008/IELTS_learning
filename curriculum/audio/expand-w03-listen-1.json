    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 48,
        "text": "Hi, Ben. My sister and her family are here.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "53b456b504a564d72e79f1604162c1198e858e3c95644fb5edd5fbcd985fc1f4",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 54,
        "sourceEnd": 87,
        "text": "Nice! Are they in your house now?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "23d7e48418d9feac1a0448b9b68a85febb0b6575c6dd39a4070541b7d486ea7e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 93,
        "sourceEnd": 163,
        "text": "Yes, they are. We have two guests. My sister has a son and a daughter.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "db8e2d66dd036456fe0dae9695452ba192859e7bf210cb49d4a5b36a287af258",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 169,
        "sourceEnd": 188,
        "text": "Do they have a car?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1718bfcf99a8421401356e2612c32157db8b994908d5a1e5508495da87ed4e70",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 194,
        "sourceEnd": 273,
        "text": "No, they don't. They have two bikes. My sister's son is Tom. He has a red bike.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cc494f22be4cb8aacd314a82a9f8d5f8b2a9518f90ec042f4acfbb730d03ac0f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 279,
        "sourceEnd": 296,
        "text": "And her daughter?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8a2f118d3cda936e2a2492ee6f60ea0ee3c373d7185dd16f6772e35b17500310",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 302,
        "sourceEnd": 414,
        "text": "Her name is Lily. She has a small bag. We need food for dinner. We have eggs and rice, but we don't have apples.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "60c2a37c571ee36b251778ca0c03696ffe52a998d4170311082119c33f8450aa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 420,
        "sourceEnd": 473,
        "text": "I have a list. We need six apples and three tomatoes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ee00251452d95cc8124d80ec2b00bea674d96a0a6b0ee896d707e90815bf24e7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 479,
        "sourceEnd": 533,
        "text": "Good. Your list is on the table. His bag is here, too.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "987f82c6bec1b1cded0102c600141a1d3ec7a16cf0de3b7b9a6bf26620c5d8ad",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 539,
        "sourceEnd": 564,
        "text": "OK. Let's go to the shop.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3924446adfda3b60f2769ebe3b187206890251a603334686c8f56be18282dc78",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
