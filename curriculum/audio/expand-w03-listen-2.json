    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 59,
        "text": "Hello, Ben. This is our club room. We are new members.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a2bc3f7d826a2d67dd4eb29b871c9e4616e45ffdd4fd38af97708d7e56e05565",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 65,
        "sourceEnd": 127,
        "text": "Hi, Mia. Welcome! I am Ben. I have two keys. They are for you.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2699f079b509b1a46897171565dcac649c36446c02e191d219fea2535ed82e69",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 133,
        "sourceEnd": 163,
        "text": "Thank you. Are they your keys?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "94c3c8881e7b84d3a3deaa90183d6661c1305450e7aaa25ad6570dece9ad5e21",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 169,
        "sourceEnd": 250,
        "text": "No, they are not my keys. They are her keys. Her name is Lily. She has a big bag.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "60567106f4cf8d4dffd64ee07fe8792714087725aee9304040fe7c20db34de35",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 256,
        "sourceEnd": 295,
        "text": "And who are they? Are they members too?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6c539ad3edbaf85b65f119bac4690ea9ae76fad9e5842a20fa35f08d3845fc05",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 301,
        "sourceEnd": 389,
        "text": "Yes, they are. They are Tom and Anna. They have three maps. Their maps are on the table.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c81460459d2bfb5713bfa6ce411590b14addfe92db766fc386edd228d6f072c3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 395,
        "sourceEnd": 428,
        "text": "My map is small. Your map is big.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "14d911c6b4528fca0a26828178178212dc326e7ca28f52b0add01b68ad096c2d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 434,
        "sourceEnd": 482,
        "text": "Yes. We are a happy club. We have eight members.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3b42d7e88af309d8d80e129cd3f3baa9e0387c67828bee2955e411ab3280a448",
        "pauseBeforeSeconds": 0.45
      }
    ]
