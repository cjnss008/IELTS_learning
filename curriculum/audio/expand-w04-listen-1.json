    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 51,
        "text": "Leo, look at this poster. Is this your poster?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "464c01e3a818222710c443901c5ac285f3cea6dd2de4180d3a0702675a59f159",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 57,
        "sourceEnd": 122,
        "text": "No, it is not my poster. My poster is blue. This poster is green.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9faa5329d06fefb6d93a36a0884051886a75e1bd0e9c166023dce46410c81806",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 128,
        "sourceEnd": 161,
        "text": "Are you sure? Your name is on it.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "df4a50c05722ba50d6acbd7a0eee2c37083feaca8cefd063977a7acc98a42aba",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 167,
        "sourceEnd": 235,
        "text": "Wait. Yes, my name is there. But my poster is not green. It is blue.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c4d197a6bfebc22fa706aefb82b9924cc1faae7376530e4915c64db419ae0032",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 241,
        "sourceEnd": 281,
        "text": "Who is the teacher for the green poster?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d9a4142e19608c5143c0cdda874994672ed77b1907c6dc17c4188fb08a15543d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 287,
        "sourceEnd": 366,
        "text": "I am not the teacher. I am a student. The green poster is for Mr. Chen's class.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fbff79fa254ddd5b6cdc5d5447304e0524caf0b1b36d0b4baad909bffb3ffac7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 372,
        "sourceEnd": 389,
        "text": "Is Mr. Chen here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e6a813643d79f16aa5684bd048c8b948a10e8ed1b5ed0586de4f248dae392c96",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 395,
        "sourceEnd": 465,
        "text": "No, he is not here today. But we are in the same group. We can fix it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "13630c67445a568192e9fd0d5fc98714c776c93ce48fc6edd1bf261718ee6825",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 471,
        "sourceEnd": 502,
        "text": "Good. Are we in the same group?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f5520b2e0687edf0dd14dbb401f3427e857a1ceb422b48b781fda406fd54302d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 508,
        "sourceEnd": 567,
        "text": "Yes, we are. Let's put the green poster in Mr. Chen's room.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fc01f721edb0957bb27aaf23a711bd28476b99a371582a3dda84cae14f301eec",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
