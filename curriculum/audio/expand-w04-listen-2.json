    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 56,
        "text": "Hello. I am new here. Are you the building manager?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1fd2e99ef8189f7c181dedd7cf330504b735c0605b13fcfda5ac66960cc0918a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "mr lee",
        "speaker": "Mr. Lee",
        "sourceStart": 66,
        "sourceEnd": 106,
        "text": "Yes, I am. I am Lee. Are you from China?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a7a961135a32e7993fe5fcb100e53ce6de4a1c0f1bb7a562d6d7964a877e9891",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 112,
        "sourceEnd": 160,
        "text": "Yes, I am. But I am not a student. I am a nurse.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "dd0b15326bbc27b0bd1debf5626968961d0edcc3756dff1fb72a931240e70cd5",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mr lee",
        "speaker": "Mr. Lee",
        "sourceStart": 170,
        "sourceEnd": 210,
        "text": "Oh, good. Is there a hospital near here?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5f91fa03837929e05f96f831d267f54c1ab7c94957fa8f73b7a20f544d3ea398",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 216,
        "sourceEnd": 270,
        "text": "Yes, there is. It is not far. Who is the doctor there?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8f8e6411740ea7c99b4fe2e7045ecbdeca17496220d8d293d96cb04a07fde7f3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mr lee",
        "speaker": "Mr. Lee",
        "sourceStart": 280,
        "sourceEnd": 322,
        "text": "Dr. Chen. She is very nice. Are you tired?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c9cc68e0e2116b9b6b15de7c52e6ae29bcae7ecf025210e26965e41c36c28f3e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 328,
        "sourceEnd": 376,
        "text": "No, I am not. Is the bus stop near the hospital?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "790d4d65f18d6ff9f74e354280494f875d957e7ebe81dffc4cca2ffc237673ff",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mr lee",
        "speaker": "Mr. Lee",
        "sourceStart": 386,
        "sourceEnd": 449,
        "text": "Yes, it is. It is next to the bank. The bank is not open today.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ca5abecc3137726809be6502b23faaba32ac60a89adf89cd7524ef80a1d231ec",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 455,
        "sourceEnd": 483,
        "text": "Thank you. Are you busy now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "af48a1783e71c842bcea12fefe65b8b57c9721bf171cb98f064df7311e123063",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mr lee",
        "speaker": "Mr. Lee",
        "sourceStart": 493,
        "sourceEnd": 520,
        "text": "No, I am not. Goodbye, Mia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a4d89412d20535504dd6a74fe54401351dd45648d0448d09b9acaaa53aaeff14",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
