    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 36,
        "text": "Hi, Leo. Do you work every day?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5edb160fd4441cb40c686ab6e73b9028dae27d1fe016021898c9f345d86cfd1d",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 42,
        "sourceEnd": 107,
        "text": "No, I don't. I work Monday to Friday. But this week is different.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2868fc2fac6bbc81f65f7d9954304f88218a01dc57fdbf689e0c763deb4a8cd0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 113,
        "sourceEnd": 117,
        "text": "Why?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5d8a995a6fa7cf7c577cc9d49ca9e00d4aee4d0bcd5e2ad5caff27e2a8097276",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 123,
        "sourceEnd": 180,
        "text": "My sister visits on Thursday. So I stay home on Thursday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9e16746e3ad6b0e0e5f613a1d380aa1dd346b1870055173263de76b969c039b7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 186,
        "sourceEnd": 219,
        "text": "Do you go to the gym on Thursday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c898f0518a1244492698d957711170f3a829d4e9c9504765f57445f60d318602",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 225,
        "sourceEnd": 276,
        "text": "No, I don't. I go to the gym on Tuesday and Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1d45971c5505548c5eb24a00fc81a974312d2e2d49330bea5c0874339efcd45c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 282,
        "sourceEnd": 310,
        "text": "What time do you start work?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fdb7e7c814cc635937b9c724dec21eb2bbb27c748f7bb4a6d59e259bd296ac59",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 316,
        "sourceEnd": 350,
        "text": "I start at nine. I finish at five.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7f050ccd718d35cfcd933b7bba980cc48ff0857d677951c864bbcea40fa5b7bd",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 356,
        "sourceEnd": 382,
        "text": "Do you have lunch at home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ab9f5b8bcba8170df9024d28b8024a17fab924dd6aa0acb11b3e6be227accca5",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 388,
        "sourceEnd": 438,
        "text": "No, I don't. I eat lunch at a café near my office.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "708eadf20460fbece9a5f732f4da14919eea88a7528bba5c675ffb84ecd94d60",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 444,
        "sourceEnd": 480,
        "text": "Do you study English in the evening?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "191b8605414b9ceb88636d53eef11f3438dca75a168bf2495fea85acb3c2e19c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 486,
        "sourceEnd": 562,
        "text": "Yes, I do. I study English on Monday and Wednesday. I don't study on Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6c5054360cd31c191059dd251cb9c74c1614c47fab778133d24a44b81d492b98",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 568,
        "sourceEnd": 592,
        "text": "OK. See you on Thursday!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "60fdb16a7699a5e587ecb2ac76547556ea0c4c144da3b0b8544cec6df01d1074",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 598,
        "sourceEnd": 606,
        "text": "See you!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b85e335c228acb9216783405b917ea818b8eef57dd9629d259506cb49ea4e519",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
