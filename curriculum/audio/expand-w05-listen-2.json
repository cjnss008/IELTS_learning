    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 79,
        "text": "Hi, Leo. This is my volunteer shift. I help at the food bank on Saturdays.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "71bf83472f26e554dd78f68e370ab8fb7670b83b82ddfd05be3013acbeb53258",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 85,
        "sourceEnd": 114,
        "text": "Nice. What time do you start?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "67f567bab5977e8690813a1739d73a326580a8b2dd3b490bb2ad61fcc8ccf258",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 120,
        "sourceEnd": 161,
        "text": "We start at nine. We open at nine thirty.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fe4d7b2aea31479792df537c4f186defd5628b83af2ada91b242ab349cebabfa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 167,
        "sourceEnd": 185,
        "text": "Do you work alone?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b66205f29c384664a20accc7f351f0d2c57697e062308567fa6f9aab8cf00e4e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 191,
        "sourceEnd": 253,
        "text": "No, I don't. We work in a team. I sort cans. You can help too.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "99de691d66fa72795d7503af3280c2f3cf683087a207dc1b52b4d1de9f5bc6e3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 259,
        "sourceEnd": 327,
        "text": "Great. I have free time on Saturday mornings. Do you finish at noon?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "610a7bd1d90d352905b8850b903045e1a4c0266a7deec24099753187213adf5f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 333,
        "sourceEnd": 391,
        "text": "No, we don't. We finish at one. We take a break at eleven.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e7206639fb0d5afa4ac8d340c063d436224e16445a988d3dfa1d5c549309523d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 397,
        "sourceEnd": 424,
        "text": "How often do you volunteer?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c4656460baf24a60e7d52116640a9777e6af9086289bc7abb41ca281bbedb2d0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 430,
        "sourceEnd": 489,
        "text": "I volunteer every week. My sister volunteers twice a month.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9977797ee2a38b8a8dc0da36f56e9f2da8f63ac35f3bf15761606eac12099ca9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 495,
        "sourceEnd": 529,
        "text": "Perfect. I can come this Saturday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4ea87736685ae859332779344dcb7df27dbb0cfe109d8c21fbb61caba322cecb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 535,
        "sourceEnd": 575,
        "text": "Good. Please arrive at eight forty-five.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2020433912986c7f608056dc88b23eac714dfc943e231227993b68a0210c1789",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
