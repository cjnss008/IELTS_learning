    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 45,
        "text": "Hi, I'm Mia. I want lunch for my family.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "195744477fa10205909fdb1d3aadb8096cdaa463dbae86a44af73feff8b0a1a3",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 51,
        "sourceEnd": 75,
        "text": "Hello. What do you need?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8914a57df59378c590c3ceee45811cead614d0b4ece46fc416a942824341b0c2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 81,
        "sourceEnd": 126,
        "text": "My son likes noodles, but he cannot eat eggs.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8fe8ff92fdbc2967e696c9174233a110d5c9c87f46d1876a3adf0d9c0a5a5b82",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 132,
        "sourceEnd": 172,
        "text": "OK. Noodles, no eggs. And your daughter?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "59bfba905454d0a74d883aa33e529f34c35fc4a81c1e0f91c75a0c3e650bbf06",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 178,
        "sourceEnd": 211,
        "text": "She likes rice. She can eat eggs.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "dadef9aa30cbfc9ea1cde0960c3f4189f17de81d82fab53e86fdd3f5c1443454",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 217,
        "sourceEnd": 258,
        "text": "Rice with eggs. Does she like vegetables?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9b1afec014acac792f7fabbcb7b9d6bc17ab83e6eeba96cba550819a882c60a6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 264,
        "sourceEnd": 280,
        "text": "No, she doesn't.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e283692ed2709feb220735b0c387a8da96eb8cbeccc5feee88f387c68cc5ac44",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 286,
        "sourceEnd": 294,
        "text": "And you?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0c1c23dc335e76d0716be6f8fbd4a526dc6f58a39960621dd893929e7dcc1bd8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 300,
        "sourceEnd": 331,
        "text": "I like soup. I can eat chicken.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1c208944f5bc8fcabcee7f5957e0db63cf9d6385d2d30d95201e32ab90aea986",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 337,
        "sourceEnd": 379,
        "text": "Chicken soup. Does your husband like soup?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9536a3d1f9ae8228e3bc669563d4496ba7973deb4ec20e591828f44bc152be4c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 385,
        "sourceEnd": 427,
        "text": "No, he doesn't. He likes bread and cheese.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9283fd3a52054f0a58dd7fb3dd23dda7347b338dd7067e57387da26132303d20",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 433,
        "sourceEnd": 484,
        "text": "Bread and cheese. One more thing: does he eat fish?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9313aa102b5f5997f8accc87399d04e2da07738580f812d0270dc3ff0c815e73",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 490,
        "sourceEnd": 527,
        "text": "Yes, he does. But he cannot eat nuts.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "eeb92e655b2a4458bec1450f1367a3093505648dc6f8029755c2384d4ddc06a9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 533,
        "sourceEnd": 571,
        "text": "OK. No nuts. Your lunch is ready soon.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7af33d71c0b4c73f83df2c4c0d6c6c782ebe0fedea3b68f417469d2ab687e6bc",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
