    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 47,
        "text": "Hi, Ben. Do you like the community centre?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "64d00824a15df2b6bacc1f7262176763274afcd17e6e4c635d31073d04cff7c7",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 53,
        "sourceEnd": 74,
        "text": "Yes, I do. It is fun.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6f5501357dc2d2021a236fd4ec62e65c025f059e4c8f8bf6028d22cc6d0a702e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 80,
        "sourceEnd": 107,
        "text": "What does your sister like?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e1b07937d81b763a4935119141850a52d130b00d92c159f3b50feb778dcca646",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 113,
        "sourceEnd": 162,
        "text": "She likes art. She can draw, but she cannot sing.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "dee15d50690fc9ee17df40e4c09fc2ad38f68a63cb86693cd502fba9c2902ee0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 168,
        "sourceEnd": 197,
        "text": "Does she go to the art class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3e57eec2fd4660417e24e3a41a3ec58a6900c50a28104fbc815c2ba6894a7c3f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 203,
        "sourceEnd": 249,
        "text": "No, she does not. She goes to the music class.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3e8e553794c06a2791f0050e9207efb72841fe398dc949bff2769a8e046b3c73",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 255,
        "sourceEnd": 279,
        "text": "Can you play the guitar?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2876aaef94879cc7af2cabe7084e4246e2553b44729ad33a708aab9b4d518c7f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 285,
        "sourceEnd": 314,
        "text": "No, I cannot. But I can cook.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "548f540014b4347559d9227878c4f51e9ab76d6945a30c1b588686331535ede0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 320,
        "sourceEnd": 358,
        "text": "Great! Does your brother like cooking?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cb2e694a2f3983739b37ce1afae87e274d1020afd92b2d4fa9c8b346f2c05318",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 364,
        "sourceEnd": 398,
        "text": "Yes, he does. He cooks on Fridays.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "89dc279bdaac922db985bd0d905903d5528fcab9dd50b7a493be0e79c33562cf",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 404,
        "sourceEnd": 428,
        "text": "Do they like the centre?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2fa6bc36518ed2d8faade210ae5f00fcf8eba4f909eb6f1ae34298c413de5d47",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 434,
        "sourceEnd": 466,
        "text": "They like it, and I like it too.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3e9caa8589a32a870866014cdc2cce06ede7a4998a2acb793ab23fc38e7c839f",
        "pauseBeforeSeconds": 0.45
      }
    ]
