    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 43,
        "text": "Excuse me, Tom. Where is the art room?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1726633a9e1237f95312b4ee5e76e6400fcbe556b27dd1183560aad14d01e73e",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 49,
        "sourceEnd": 114,
        "text": "It is next to the library. Go straight and turn left at the café.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0c67b32ad67270b5276d8483355883652011a3255f37ec5e971831243fa8dda5",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 120,
        "sourceEnd": 149,
        "text": "Is there a map near the gate?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d8814b0c22b5fbb8cbb40a76d3f8c0dbc438797ede7c39abd660fa4d422457ca",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 155,
        "sourceEnd": 207,
        "text": "Yes, there is. Look, two students are drawing on it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "47c8da7e335477e0332ef5af0646fb2121f591b40728db59224e43b777cad216",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 213,
        "sourceEnd": 250,
        "text": "Are there any chairs in the art room?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ddf3ae34489576244bc0348c2a57377920d4fe3a633df6456544f8c7cfee405e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 256,
        "sourceEnd": 299,
        "text": "No, there aren't. But there are six tables.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8bfd918aac24f77fe3b633a37d47567ce44dbad629a646022ac8a9e77beea0eb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 305,
        "sourceEnd": 335,
        "text": "What is the teacher doing now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "91fbdda979166a20fcdf2aef98ea5e6a030a2aa37ff7ed2698213f9f0e6a5d90",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 341,
        "sourceEnd": 397,
        "text": "She is opening the window. Please don't run in the hall.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3a83edcf147e4a7382d0ec1fe247a65b07c1f319a0854d371e21697db5b38309",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 403,
        "sourceEnd": 435,
        "text": "Thank you. Oh, is that your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e30998f486e9e43fe909c1433c1951e74571bdc162446daf3efb71a55213249e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 441,
        "sourceEnd": 480,
        "text": "No, it isn't. My bag is under the desk.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0b1978873bfc8180a43ab60b6ad9822da54af4e3ba74c4a516b5b56d726f32d5",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 486,
        "sourceEnd": 492,
        "text": "Sorry!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9317a84bd54abe3247f4af961595199a9d0520cd3bcdb00d2dc66ae44552a169",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 498,
        "sourceEnd": 540,
        "text": "That's OK. The art room is very quiet now.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f2a938681e10dc0668240f18b8b64d8e2fe9970f2da5144dbf1efdc43303c41b",
        "pauseBeforeSeconds": 0.45
      }
    ]
