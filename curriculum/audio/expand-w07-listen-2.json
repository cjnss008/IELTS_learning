    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 28,
        "text": "Hi, Ben! Where are you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9123e55a271e05013c5ac215d03b82bec7b6bdf15b5db0668f755cbaad1b5f35",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 34,
        "sourceEnd": 86,
        "text": "I'm near the big market. There are many people here.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3ec58d56dce026794fb4b9251a4d36201ff757e4d1af81572b639df567e9dd35",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 92,
        "sourceEnd": 124,
        "text": "Is there a coffee shop near you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "47f9481d1d2ae929c96059cf44d2d01dde92c8d3c788e8f2ab4005adb54326e2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 130,
        "sourceEnd": 167,
        "text": "Yes, there is. It's next to the bank.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "37bb46ea8ee4454e365801d2743d6fec8fec72f99d7e02631503237ac76b4564",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 173,
        "sourceEnd": 230,
        "text": "Good. I'm at the bus stop. I'm walking to the market now.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7f92db909dbb1617d9223301738403283863f53541725e5c8a2b55b7f95b9069",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 236,
        "sourceEnd": 287,
        "text": "OK. The market is between the bank and the library.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2c8247ef9a44d4be7424bc51abe107221d0bed7c62c73f38daba037f5c8775ab",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 293,
        "sourceEnd": 336,
        "text": "I see a tall building. Is that the library?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "678c1499b1e5949ce4a374f72bdc1a6bf62596d47f899b9fbbe236afe79cae5e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 342,
        "sourceEnd": 400,
        "text": "No, that's the hospital. The library is behind the market.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b47348691ba321eec473d773454231a99a800527769e11ab1ddce637be7e2ec0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 406,
        "sourceEnd": 459,
        "text": "Thanks. I'm coming. Wait for me near the coffee shop.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ea6a4f4e25c5dcb086c56bc55ceef876471e0d8b2d10b48d9421862050d3c99e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 465,
        "sourceEnd": 500,
        "text": "Sure. I'm standing under the clock.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "70bccbb0d1bcde0dc42b118946a2ed999f08ed392d46c4d939bb1b6085dc6dec",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 506,
        "sourceEnd": 537,
        "text": "Great. See you in five minutes.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e2577387cc7902a26592e959852fc96b21a5897c82e58f0597a3d8b0a4572ccd",
        "pauseBeforeSeconds": 0.45
      }
    ]
