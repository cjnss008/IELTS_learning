    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 49,
        "text": "Hi, Leo. Was your grandma at home yesterday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3d13dd31b3889625c23b1f294ccc1e86bccf621cf4bcb2b76664885c33811d92",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 55,
        "sourceEnd": 117,
        "text": "Yes, she was. I was at her house. We were there for two hours.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "897dda5cb729158fd4fe25f7aa71ce0b280d183fe4650886a715f6703a37838d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 123,
        "sourceEnd": 154,
        "text": "Nice. Was your sister with you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "eb2424b3fe341f681f42dec9ef5d5d5a4070cc60b560dabdf103b867ab7083f0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 160,
        "sourceEnd": 214,
        "text": "No, she wasn't. She was at work. My grandma was happy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4e9c1366f3ce1a77ab933e82bcbdba57e3204730d3ab818614b43f57e44d96d9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 220,
        "sourceEnd": 236,
        "text": "What did you do?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "32189bb58790878bac0aa48d836d846f174da8e210c9160b5d9f85a0219edd33",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 242,
        "sourceEnd": 301,
        "text": "We talked and we ate cake. Then I walked home. It was cold.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b432dd228186808402dbb24d226d475f3998ef564cef122fecdd9be94ac369ec",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 307,
        "sourceEnd": 340,
        "text": "Are you going to visit her again?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "777a95a4669512d5fd0be4f1f5daf9477a243d652bc564484daf85349bd3176f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 346,
        "sourceEnd": 409,
        "text": "Yes, I am. I'm going to go on Sunday because it's her birthday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a444861afb097d594254f2cf6688a0d5e16447b6cdf2b61c1fe97341d6652468",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 415,
        "sourceEnd": 450,
        "text": "Great. Are you going to buy a gift?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "968c21071d679614afcf09aab7fe92507aa98182c69e1201516502072681aa70",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 456,
        "sourceEnd": 511,
        "text": "No, I'm not. I'm going to make a card. She likes cards.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2f9f12bfad49427156965c32541f36a7b4831cd0ab32f87a74c26ed63be76e8e",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
