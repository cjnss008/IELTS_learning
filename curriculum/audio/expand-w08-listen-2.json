    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 47,
        "text": "Hi, Leo. How was your first English class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0c1667d7021f948cff8a9e793e91dfd4023e4a8a994f530ca940b4aeaff2843a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 53,
        "sourceEnd": 105,
        "text": "It was good. But I was late. I was ten minutes late.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9e248aa8a86c88523d20fc482d6267a0294e3e175dfb37c37b6e4112ad3a1150",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 111,
        "sourceEnd": 136,
        "text": "Oh no. Why were you late?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "40c7ab5e2cf093f44b547223bece26e93ebb716ac360aeaaa5abd23217245cca",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 142,
        "sourceEnd": 195,
        "text": "Because my bus was slow. The driver was very careful.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "83670ec2a10251894c20cfc60a50e87defb1b22dd74b4e5f6f2e58993c232a06",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 201,
        "sourceEnd": 227,
        "text": "Were you nervous in class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "301d9fde5436a9ad155d3d8a034360698e54bb105d96e4f5ae09712465601098",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 233,
        "sourceEnd": 295,
        "text": "Yes, I was. But the teacher was kind. She said, \"Don't worry.\"",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "89fe8e3c40cb4aaa7fdc46f4337ad87fd071a1c38fe96ca6e4f671d6f80e571b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 301,
        "sourceEnd": 326,
        "text": "What did you do in class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4a1413476a193380616a36dc7b5de4191055eaee2698b5d1e8b5f49a3a614440",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 332,
        "sourceEnd": 411,
        "text": "We listened to a short story. Then we talked in pairs. I was tired after class.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b79c62e260cdadc1112863dc476c55265b1c47101b76180d44b18dfc29100831",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 417,
        "sourceEnd": 448,
        "text": "Are you going to study tonight?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f1a98532a438c22e6f1cbbd3175b7c5d2577d26bfd0a91880bc47dfde9622fa7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 454,
        "sourceEnd": 525,
        "text": "Yes, I am. I'm going to review new words because the test is on Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "22b64f6317af808869cba73b6a9b402dca9f8f008606e8db0c0a86aa10ba6804",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 531,
        "sourceEnd": 593,
        "text": "Good plan. I'm going to help you. We were both late last week!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "458a8762e5e27b08d0fc8029a518240d5e6b3025f68ce98a2dcd1090a99b2e24",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 599,
        "sourceEnd": 632,
        "text": "Thanks, Mia. You were a big help.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a29d9b7d2173fcd21b7e8e8e141a5a3889a77f8be980306e48abcccf6387dc0d",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
