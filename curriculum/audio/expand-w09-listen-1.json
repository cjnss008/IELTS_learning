    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 41,
        "text": "Hi, Leo. Do you study every evening?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "691b99874c75e30d32a29028bd6c82c5a325acf3a099b753397d0d636b8a94b8",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 47,
        "sourceEnd": 163,
        "text": "No, I don't. My main study days are Mondays, Wednesdays, and Fridays. On Tuesdays and Thursdays, I work at the café.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bb3d753ecea5b94d7a597112094a796f521984f0f81f8c703ed8edfb7384e207",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 169,
        "sourceEnd": 236,
        "text": "I see. I study every day, but not in the morning. I study at night.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bb3f7a6bfdc38ece3a3437fe99f71785ef92124cbfe4a0a997eeb22103e15b93",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 242,
        "sourceEnd": 331,
        "text": "Really? I study in the morning. I get up at six and read for an hour. That is my routine.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "888bcedda00afa848e35bdd5616b694bdc1e20bd1f654755d9bb1e273e0347a1",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 337,
        "sourceEnd": 382,
        "text": "I usually study from nine to eleven at night.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "300027b435576fcea38cb79d4c782cbedcf64b175a746a463a90777a893e7ff0",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 388,
        "sourceEnd": 409,
        "text": "Do you study at home?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "85123411efcc5f7940c50fa6764791766013a4800d2a2a85745158f084751aaf",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 415,
        "sourceEnd": 480,
        "text": "No, I study at the library. It's quiet there. Where do you study?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5463bc1520b58f27c8f7715bb76575c46977172e39689433795564816b54dc6c",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 486,
        "sourceEnd": 572,
        "text": "At home. But my sister is studying at the library today. She has a big test on Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4367483870b6c9f99c11d2ee825bfa2305fc8cf16f2894d601290dd4508222e2",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 578,
        "sourceEnd": 643,
        "text": "My brother is also studying for a test. He is at the library now.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2844e3519040d9fbd4610283bb6e3c2898b9d886eaad4b19e78d6c0cd84cde74",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 649,
        "sourceEnd": 675,
        "text": "Do you always study alone?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c431925bdeac69a2f0bc5a1caae42bf6f684681008a9c3fb38adb33455a1cb66",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 681,
        "sourceEnd": 758,
        "text": "No. On Saturdays, I study with my friend Anna. We review vocabulary together.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2513d2ed2e381aa34a0c76ef73ad4e7f19d3d5496a09e19a82a64b1d077f007a",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 764,
        "sourceEnd": 797,
        "text": "I sometimes study with my sister.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c5d922589024875080cd75ebfeb4ba088350323938bdecda2bce2639f74e25b7",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 803,
        "sourceEnd": 822,
        "text": "Do you take breaks?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5e4b4aed3cfa49ac898dc03f672ec10a27ca9e4c701c6541373b5df1380e0f3a",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 828,
        "sourceEnd": 887,
        "text": "Yes. I take a short break every hour. Breaks help me focus.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d7b943aeb7edd259cae66a458e25f3e958abfc2cb21e129cc64ce9ede2ac06d2",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 893,
        "sourceEnd": 950,
        "text": "I don't take breaks. I study for two hours and then stop.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5d5b8abb0679be37b6a0c4084eabc4be1c32d1e5630e6713415bb136d733477a",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 956,
        "sourceEnd": 978,
        "text": "Breaks help you focus.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "372fde2e53435c989a6dd2693324757272d7e3940b4337f34822d8a151fb7e8e",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 984,
        "sourceEnd": 1028,
        "text": "Maybe you're right. Do you use a study plan?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "facf9ffe9233659a2e5e0ebb38406a079f39092fd91ca2a996ddcd24d8811dbf",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1034,
        "sourceEnd": 1098,
        "text": "Yes. I write a plan every Sunday. It helps me remember my goals.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e9310f668e387828c1d9c9580f49e61acc1573f8c703d0e1dc464722a964de01",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1104,
        "sourceEnd": 1185,
        "text": "I don't use a plan. But I have a goal: I want to pass my English test next month.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e99dc648b12fba584002c25259251b74defdc4b9ce0807f1bf3b5ea649d0f6d2",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1191,
        "sourceEnd": 1237,
        "text": "Good luck! Do you practice speaking every day?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a65dc5861f0c871854755262a6b2f6b78f567a002beb0b6337ebe46d4fc2f834",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1243,
        "sourceEnd": 1325,
        "text": "No. I practice speaking on Saturdays with Anna. But I listen to English every day.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "310725fe8939234a0f5f0630ebab9c256e8e705e4d911658bb2f7dcc7abb406c",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1331,
        "sourceEnd": 1397,
        "text": "I listen to English podcasts in the morning. I also read the news.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f689c9935274ba44f0a3ac8f5cf0eff83c891ae77d0cbf5979a78d342a1c7138",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1403,
        "sourceEnd": 1424,
        "text": "Do you study grammar?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8d2dbf4346aa74809e9ecf0bba411f4d867dca8cc34a6921561aab45cf78b015",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1430,
        "sourceEnd": 1513,
        "text": "Yes. I study grammar for thirty minutes every day. It's boring, but it's important.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a71a6dd8251d84cd2f328cb113c2b8b2fba971072a5fe15d99611a25c2f8d9bf",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1519,
        "sourceEnd": 1580,
        "text": "I agree. I need to go. My brother is waiting for me. See you!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e357021d29b286ec1800d34238d692e5c047ee81802e3c669c2b05e583b2b171",
        "pauseBeforeSeconds": 0.7
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1586,
        "sourceEnd": 1599,
        "text": "See you, Mia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b16ef4e8fe50c157a67ab6c2a1b050cf63fb838c4519f39f8bef0b90ad68e802",
        "pauseBeforeSeconds": 0.7
      }
    ]
  },
