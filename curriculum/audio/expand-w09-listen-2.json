    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 80,
        "text": "Good evening. I want to join an English class. Do you have evening courses?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5036255439d1c164a0edbceef0696cad40a34d74d73fa2800918e30c0ff1987e",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 89,
        "sourceEnd": 163,
        "text": "Yes, we do. We have a class on Tuesdays and Thursdays. It starts at seven.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b3f465e0da5c601c35a4aa1a5b20a4e9bfb5947d95e122b2b520c40f207db6f7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 169,
        "sourceEnd": 204,
        "text": "How many students are in the class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "50dc6a8c32ce0826f3ea06b2a4b2f4b8ce45d76468403420b6d0a5674644ee9e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 213,
        "sourceEnd": 264,
        "text": "There are twelve students. The teacher is Ms. Chen.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "56de39e5b94abbfd538ea7a13679dfddf6e5927e6d3d315b76e1a6f0e8e073fe",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 270,
        "sourceEnd": 298,
        "text": "What do you do in the class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "37af967a44a66358e859adff197dab7e50c6136d3ce319cd7da4a49d4cf2ad83",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 307,
        "sourceEnd": 392,
        "text": "We listen to short talks. We also speak in pairs. Ms. Chen gives homework every week.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "cf69733d74f00e3118a3babbf83772e0fa68dc94bb27576dd3216c32a7872606",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 398,
        "sourceEnd": 453,
        "text": "I work late on Tuesdays. Does the class finish at nine?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "87050eac4e26c680202c4e10683216c9c2bcc1c77f4542fb6925418792623e17",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 462,
        "sourceEnd": 543,
        "text": "No, it doesn't. It finishes at eight thirty. But you can watch the lesson online.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "03b0436ef209d3bae368f41796a2b7c7c1163fb60b10a94b52a1707904b7b1b2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 549,
        "sourceEnd": 572,
        "text": "Good. Do I need a book?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d573fe3fe7ea841acd9d06add7e6b67680756f5bcab8d63cd713df3da6634c50",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 581,
        "sourceEnd": 624,
        "text": "Yes, you do. The book costs twenty dollars.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b46ec7808fdcf11884218ad5b184bca2ef03b04b160a0cf00b5cb6544f0f41bb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 630,
        "sourceEnd": 658,
        "text": "How often do you have tests?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4583b2f9e4fc488ed496bc51f86a54da30cff6f01e4adec222a3fef670a2f244",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 667,
        "sourceEnd": 733,
        "text": "We have a test every month. Ms. Chen is marking the last test now.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5243756d498290c09bd26c573b7597b54418dc321b02cc4f57abbb27f30c4edd",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 739,
        "sourceEnd": 793,
        "text": "I am not working next Thursday. Can I visit the class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "997d62662e0780d0ee2b249d96d3d8f093d505d4850c3552791a5e1e8cb7762f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 802,
        "sourceEnd": 865,
        "text": "Sure. Please come at six fifty. The class is starting at seven.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "01d987323c686c404c5abcb699cb02af1302ba17b89edf88e0514a91df3c83c8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 871,
        "sourceEnd": 943,
        "text": "Great. I usually study at home in the evening. But I want to speak more.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "67321468dd4cc702ab24c665c9a9236ea0fbbc78c4b564aa5cade0d950987dad",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 952,
        "sourceEnd": 1015,
        "text": "That is a good goal. Many students practise speaking every day.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "311d867b1449915865e151fa80e7c38e2b74c8b2cb8b39a06d53edd05f7b8fd1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1021,
        "sourceEnd": 1079,
        "text": "Thank you. I am writing the class time in my notebook now.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "16d6bb2b594879de56eec597559dd58f1c6db0880749507542587255c4ec4d7e",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
