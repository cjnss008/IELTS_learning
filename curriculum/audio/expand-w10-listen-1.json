    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 43,
        "text": "Hi, I'm Mia. I'm here to see the room.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2c116abc37ed277c03ed5bf5c5545a88855aac6e1bcd79d74dfbb3e4c36838b6",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 50,
        "sourceEnd": 101,
        "text": "Hi Mia, I'm Ben. Come in. This is the shared house.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "93f7ca0f0fa0f5d798457a65747fb53b9230933862841043732b1819cb9f11b1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 108,
        "sourceEnd": 144,
        "text": "Thanks. How many bedrooms are there?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "70900c1ef2be2c020167c5a65269a0029d03c59dd4e3b578cf9fff5c3050a6da",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 151,
        "sourceEnd": 216,
        "text": "There are four bedrooms. Two are upstairs and two are downstairs.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "af507b9f095d8f7ce6ec77120356a9fb66a68b2c1c264ea9e092bc72ea394d34",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 223,
        "sourceEnd": 252,
        "text": "Is there a bathroom upstairs?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e3923129e96920cf19734defecebe4d88bda5245e77b76ba3bb1934fffa5c6f9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 259,
        "sourceEnd": 330,
        "text": "No, there isn't. There is one bathroom downstairs, next to the kitchen.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "2caf4acc059d853ac6dc698b2857f568ee5aa449741b668e33de43b01a27e7ed",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 337,
        "sourceEnd": 357,
        "text": "OK. And the kitchen?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "8ffd4393b25cd125629662f42814e5869d1df591322cd6d9204819986a572413",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 364,
        "sourceEnd": 466,
        "text": "The kitchen is big. There is a table and four chairs. There is some space for your food in the fridge.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "b09c261ecfc4bcaca3b4d4158a00ff05db91dd589a6726d8fa269a8c41fa3a6d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 473,
        "sourceEnd": 509,
        "text": "Good. Are there any shops near here?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ac82c67b6aed8dfb5f7117fc3769588e078bf6fac5a4cf63277b8fdfd06c9de8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 516,
        "sourceEnd": 613,
        "text": "Yes, there are. There is a small shop on the corner, and there is a supermarket behind the house.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "07f09ed9510536d2dd92e4646f7fcb01ba5fd6859be15916cb1096d0c05b26e6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 620,
        "sourceEnd": 640,
        "text": "Is there a bus stop?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "1a0798e2c99a5da0a4852172bcd0abcf8b2861e01d95c624d2b04fb396d0d455",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 647,
        "sourceEnd": 700,
        "text": "Yes, there is. The bus stop is in front of the house.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "efc7b9aa8d21c6911abfb0c8e51301246a37c039ed468202cb1c66eb98240d7d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 707,
        "sourceEnd": 734,
        "text": "Great. What about the room?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "6a13ed357fd47412a2bf9ee374cba5eb608baa6ab91f1592f8a540c1279356f3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 741,
        "sourceEnd": 867,
        "text": "The room is upstairs, on the left. There is a bed, a desk, and a chair. There isn't a wardrobe, but there is a small cupboard.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "5959675baa99d2d7a8b5b2ff04f156f1622970a9c4650763c3bbaabd3572d037",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 874,
        "sourceEnd": 902,
        "text": "Is there any noise at night?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "8e43a9d5ba138b91b3ec878a9f0d32f966437f1df65b36d4293481feabe86ac5",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 909,
        "sourceEnd": 952,
        "text": "No, there isn't any noise. It's very quiet.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "835228c653615e4aafa400703bc6cbb7027ab1c25004cd73c4e80535dfbe2965",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 959,
        "sourceEnd": 972,
        "text": "And the rent?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "cea09ac3171e99af533505f0d0dbde031e4b798b498cf807fb003bedbb893046",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 979,
        "sourceEnd": 1056,
        "text": "The rent is 400 dollars a month. There are some bills, but they are not much.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "2a0c8935f89815504b563abac9cf5e87e2238f849d36558b0129dfee2573eb19",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1063,
        "sourceEnd": 1090,
        "text": "OK. Can I see the room now?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "4d501bd87a471138a103c9bb8398354a4eed86f9cb7aa154702750412339f97b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1097,
        "sourceEnd": 1131,
        "text": "Yes, of course. Let's go upstairs.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "48ca1fd27c84afa075b7efa2c08e5d6a3bfc1278b38d5d0b9a14f9a3ac48e696",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
