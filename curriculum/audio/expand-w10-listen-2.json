    "segments": [
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 8,
        "sourceEnd": 118,
        "text": "Good morning, Mrs. Wang. This is Li Wei from apartment 302. I have a problem. Water is coming from my ceiling.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "f16cef3242cbb8bc7a1af1db49873a566f69879bb7107b7b24b44d150800a893",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 130,
        "sourceEnd": 154,
        "text": "Oh no. Is the floor wet?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "9c1a7a6c5db1e83cd1ac7413e4766c96fb887e1b39ec911a7972be9848879526",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 163,
        "sourceEnd": 271,
        "text": "Yes, it is very wet. There is a big brown mark on the ceiling. There are some small drops on the table, too.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e3c2fbe394ffe5aaa67b17548ea6403c40a6e57fcdcb69236ca0d32e7f93b795",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 283,
        "sourceEnd": 324,
        "text": "I am sorry. Is the water near the window?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "b65148aed902a112063e2a2aaf86871071ab9b234aefb1a585d038063a9a737d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 333,
        "sourceEnd": 432,
        "text": "No, it is not near the window. It is above the kitchen table. There is a bucket under the leak now.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "23ba0e166a807dcbbad65b27498245d394b126a3b804c06faf364cf0f802e0ee",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 444,
        "sourceEnd": 473,
        "text": "Good. Do you have any towels?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "a2ad48a7546ed3f8f3467e3069fb31fdf70107bc7d04869c6375a581e9f074d6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 482,
        "sourceEnd": 572,
        "text": "Yes, I have two towels. But there is not any hot water in the bathroom. The water is cold.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "5f211086b29e312b3329e6efbf91c07c16984587ad23e91be4815cd4fb632ca2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 584,
        "sourceEnd": 677,
        "text": "I see. I can call Mr. Chen, the plumber. He is at his shop now. He can come at three o’clock.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ebf0970ca3e1bf5e142eb93d90d3e4af0456941f2a3969711fa9c92823b2097f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 686,
        "sourceEnd": 724,
        "text": "Three o’clock is fine. Is there a fee?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "480a6a61b594d6a1bd73278b8868d9418404687cc1306af9523dd49e95107d91",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 736,
        "sourceEnd": 844,
        "text": "No, there is no fee for you. The building pays for the repair. But please do not use the kitchen sink today.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "8fe4cde97e1154defab1a5a3f41fc6d8c252e5e5f23211f750022a75b9150c1b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 853,
        "sourceEnd": 941,
        "text": "OK. I will not use it. There are some boxes on the floor near the sink. I can move them.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "694b321f6c3577288339d0d952b85e088bbcab58b5cfd6ca09f7262fa9c7e124",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 953,
        "sourceEnd": 1012,
        "text": "Thank you. Is your neighbor at home? Maybe he can help you.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "de393d846f18a05859ba03d0668863ea35da9ae8a354fe2f38285636fecc2f21",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 1021,
        "sourceEnd": 1090,
        "text": "No, he is not at home. He is at work. But I can move the boxes alone.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b8bb1432aecd8188f940ee5b61ba5a5132e8bef62d05cc8d43a7ac24c2f8015f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 1102,
        "sourceEnd": 1188,
        "text": "Good. I will send you a message at two thirty. The plumber’s number is in the message.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c8a0ba535607947391a80a4e58b096cf657c76730f292fe057716be4ee68873e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 1197,
        "sourceEnd": 1236,
        "text": "Thank you, Mrs. Wang. See you at three.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c60d8ca3d2b1dfa3fcf0eee2a44f6bffdaa8ce12309f3d436286dcd6af74b338",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mrs wang",
        "speaker": "Mrs. Wang",
        "sourceStart": 1248,
        "sourceEnd": 1284,
        "text": "See you. I hope the leak stops soon.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "51c5f2739457e61ba4c9258d3bbbfb6595dae1832b121c573487a9f6b6912558",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
