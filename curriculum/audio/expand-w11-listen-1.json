    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 48,
        "text": "Hi, Ben. Are you free for dinner on Friday?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "983afb4016ccc4d1f4e913a89d45fd4c39f4bf548f0d5b4fdecc4e1a62f896d4",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 54,
        "sourceEnd": 118,
        "text": "I’m not sure. I have a late meeting. I should check my calendar.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "617371cd66c92806d382f8ff2d0bf138976a75ead3c1a1359a8bdb9052897519",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 124,
        "sourceEnd": 207,
        "text": "OK. I want to cook at home. I have a lot of vegetables, but I don’t have many eggs.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "14ca405cd66c0a05b26f360895a5709e6d372ed431ef5b331132db42ecd5b65a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 213,
        "sourceEnd": 239,
        "text": "How many eggs do you need?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "190c9cab4a31cf53449f96418661655b53d097460e4d69bc7ca729ec35496496",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 245,
        "sourceEnd": 317,
        "text": "Just a few. Maybe three or four. And I have a little rice, but not much.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "ba5706153431f5e2fccce23206820eced8c90c3a4aae89404b4c4dd8ebc36fac",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 323,
        "sourceEnd": 375,
        "text": "I can bring some eggs. Should I bring anything else?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "88d04afddccf7f2afdf88383bd86f37414a82de4785e7e3d51dd5fed34cc5d71",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 381,
        "sourceEnd": 444,
        "text": "Yes, please. We need a few tomatoes. And maybe a little cheese.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "4ba7e27624e5704cc4dcb212470455522e41f5fca2dfea2f3d34c0353ec6272d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 450,
        "sourceEnd": 509,
        "text": "No problem. I have many tomatoes at home. I can bring five.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "72d79b303acd4fad7d21249e87a7c6bf07ad1311a92dffe05d07369295873778",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 515,
        "sourceEnd": 567,
        "text": "Great. But don’t bring too many. We only need a few.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "368d513a561f7811cd75675e0231befcf50d1041a04645601500b631701ed605",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 573,
        "sourceEnd": 601,
        "text": "OK. What time should I come?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "f268a2b285745c42757389d8279abfa9972a824703f8932c6af592ff45880e06",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 607,
        "sourceEnd": 688,
        "text": "Come at seven. But I have a yoga class at six. I should finish at six forty-five.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f8f09bf74e28e3fb12af2894345d4cce9fd025d23d39cfb33ca7856bac703a01",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 694,
        "sourceEnd": 753,
        "text": "So I should arrive at seven. Should I wait if you are late?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "21009a96b11cac6e5029d0a5d973fed3afc1534acec520f5d3ba2286055d3428",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 759,
        "sourceEnd": 817,
        "text": "No, don’t wait outside. You can come in. The door is open.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "6146da8be22e85a3dc6956a018484702d339ef4a444ef17d513970bcfa00ad82",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 823,
        "sourceEnd": 853,
        "text": "Fine. And what should we cook?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "56e7cb28f5c386423a10aa5548a64163fffa22b4dcea92eee63ecddf85a59680",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 859,
        "sourceEnd": 944,
        "text": "We can make a simple rice dish with eggs and tomatoes. We shouldn’t use too much oil.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "be9e6dc9d803e699a31b69d22ce410806705641446241d50eb62af1323c9b574",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 950,
        "sourceEnd": 1014,
        "text": "Good idea. I should not eat too much rice, but a little is fine.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "7e92d9ed81831738749c8bf363bbf79f5ff5e2884dd0fd0294fd28fc084671fc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1020,
        "sourceEnd": 1096,
        "text": "Me too. We should eat more vegetables. I have many carrots and a few onions.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9e6455219fb0d3ea0ebc36f6d573207ea38adce9513f5c3f499e1dc3d9872aef",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1102,
        "sourceEnd": 1138,
        "text": "Perfect. See you on Friday at seven.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "2a5704819ad66b9daf8aa430b147846a08a4bec7ac1f49d3275a45b61cac867c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1144,
        "sourceEnd": 1175,
        "text": "See you. Don’t forget the eggs!",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "ce6a20d12d4421eeaf97517231033ee4fb64d1e2bf986cc3b746e4bd14440ebc",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
