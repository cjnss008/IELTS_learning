    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 93,
        "text": "Hi, Ben. It's 12:30. Time for lunch! Do you want to eat in the office kitchen or go out?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "941660d2a8b613c08a2079214615a11f0e960d836e17bda706c82ba2a70f6d6e",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 99,
        "sourceEnd": 169,
        "text": "Let's go out. I have too many sandwiches in my bag. I need a hot meal.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "427dd673800826b8550c6bc5c3e2a22fd59820ea5cdf1cad61708e4b4861035b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 175,
        "sourceEnd": 244,
        "text": "OK. There is a new noodle shop next to the bank. It's cheap and fast.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "80b559423231f97e832dba47d9c4f36aba584167e5e3df39a4ae20750eb932bd",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 250,
        "sourceEnd": 323,
        "text": "Good idea. But I have only a little time today. I have a meeting at 1:30.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a2be2a2f2628b868e46bab3489ce9eeb5269f6d27b886611f453087c08209de0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 329,
        "sourceEnd": 409,
        "text": "Me too. So we should not go to a big restaurant. We should choose a small place.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "2d2561ee62859ac8339f2d7f2b69b88e79d3c2401c1d188062951875690fa21e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 415,
        "sourceEnd": 489,
        "text": "Right. How much money do you have? I have only a few dollars in my wallet.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "b7baf6a58ab08434fb3dfd73539d994a5cd3e6808fb039df1631f316feec1670",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 495,
        "sourceEnd": 562,
        "text": "I have enough. The noodle shop is only five dollars for a big bowl.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b7ddb67e3ce84c7bd00400c91b3441b3794c2e322451d92c5fe9ba43f51bde61",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 568,
        "sourceEnd": 641,
        "text": "Perfect. I should not eat too much bread. I want noodles with vegetables.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a9d010c9200cb9851b9353de2d15c8a8770669c207176b8177ab7780282c4030",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 647,
        "sourceEnd": 712,
        "text": "Good. You should eat some vegetables every day. They are healthy.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "0d64ce4c528b99dc224f23a8926cd8558ffb7fccf14ca0a75ff2f8ba6b16aae6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 718,
        "sourceEnd": 763,
        "text": "Yes. And I should drink more water, not cola.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "2d64c48ccfa16e89fc6f7587aab39bf428de7adca799d7496b55eab0b33464d6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 769,
        "sourceEnd": 825,
        "text": "True. I have a little cola in my bottle, but I want tea.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b60dabfe35f48049d065df8b6143910cfe912daa5086debf00561d730bc922db",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 831,
        "sourceEnd": 882,
        "text": "Let's go. We have a few minutes before the meeting.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "fe84f42d04ee6d070e8abd39a3a4eeb6d3dc7d2f25a3a42a663637f1c32e7e65",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 888,
        "sourceEnd": 945,
        "text": "Wait. How many people are in the shop now? It looks busy.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "8d6aa5e7b714c96627da6329faae9532e9b3b337dafcdcf951b7ab36b739609d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 951,
        "sourceEnd": 996,
        "text": "I see only a few people. We can find a table.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "1ed9688420a6f88e6e7993a2798123401e066fa59750e15909bbfe4c87daf8f3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1002,
        "sourceEnd": 1059,
        "text": "Great. I should not be late for the meeting. Let's hurry.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "18fe9d4d74466af06fe4f09ff1de8b1a16f70437e55b4f47e6dba71f2af84518",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
