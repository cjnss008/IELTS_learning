    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 58,
        "text": "Hi, Leo. Do you want to go to the beach this weekend?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "55f122bd8e94f533700394f3da71d33e8708b062b77955902c997a793d165f1d",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 64,
        "sourceEnd": 113,
        "text": "I do, but my car is broken. We can't drive there.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fbb2cefcd6aa0c8f197a27b024be08b90e6e0c5eb0b07a194ca024680b836fe6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 119,
        "sourceEnd": 172,
        "text": "OK. We can take the train. The train leaves at eight.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "35c42e4508775c7513f1ce316b5351c3a5fca5a98b878377c4940034d26cdcff",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 178,
        "sourceEnd": 234,
        "text": "Eight is early. I work late on Friday. Can we go at ten?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8b7919a69d8b46740f41e3d308ef16cee3e767b0fba3020f7e55a40bde893d10",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 240,
        "sourceEnd": 357,
        "text": "Yes, the ten o'clock train is fine. We arrived at the beach at eleven last time. The train ride takes about one hour.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cd769819c00a8c9eda0db276871274c2edc281ea42f92fa8bfd7b982a0c24f3a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 363,
        "sourceEnd": 436,
        "text": "Good. But I have only fifty dollars. The train ticket is fifteen dollars.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3ae94aa13fb3b1a6746f0d8a5159706209d3d626bcd0149b0942c3792bdc4b4e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 442,
        "sourceEnd": 564,
        "text": "That's OK. I have thirty dollars. We can buy sandwiches and water. Together we have enough money for the tickets and food.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bda3dcdde2a910fd106da62b9311aa90c4a1f21d0ae43ffc692a667acf0b223a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 570,
        "sourceEnd": 634,
        "text": "Perfect. After that, we can walk on the beach. Then we can swim.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "425993987dfaf187345391acd45a2e169c98f01c4a5cde728eff0f8bf62ae373",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 640,
        "sourceEnd": 681,
        "text": "Wait, I can't swim. I forgot my swimsuit.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ac89637afb09a6d35cec14a03dbe60d1e65ed25a75139981f9b87c160580a5fa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 687,
        "sourceEnd": 799,
        "text": "No problem. We can play volleyball instead. It is fun and easy. Finally, we can take the six o'clock train home.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "888a5cd2fe5764ba94651858761f122c05aff3fefa9a6376a8aee971300c84cc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 805,
        "sourceEnd": 864,
        "text": "Great. I called my sister yesterday. She wants to come too.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7cbed601110354914244ff72c7b5d0a952344ee42f212c8a556261f26e1960f9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 870,
        "sourceEnd": 922,
        "text": "Nice. She can meet us at the station at nine thirty.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6670cf798ccfaeb4412678f5ec4255ff7c6f0dce29c800d63c68b4a4b695ab99",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 928,
        "sourceEnd": 952,
        "text": "OK. See you on Saturday!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "906d6e79edc8c0b052ca807847b7a4cd6ab3f713f8e494a6304c4b029a39f097",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
