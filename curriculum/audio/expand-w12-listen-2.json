    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 78,
        "text": "Hi, I'm Mia. I have a booking for tonight. My reservation number is 4472.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a328621281759b0b58e6cba76bf6b1614523865ce54e7ea7ed76a58fcb0b033b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 93,
        "sourceEnd": 198,
        "text": "Let me check. Ah, I see a problem. Your booking is for the City Hotel, not here. This is the River Hotel.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d36b4d526f46f02b8258ec382df0aa7de1ecfa1950655d96080b9966fee9c009",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 204,
        "sourceEnd": 278,
        "text": "What? I booked the River Hotel. I'm sure. I checked the website last week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "aad550157c4a3aaa4cc224d5bf31d6e40c98cb6ee684eaf6b5780c368b99e7f7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 293,
        "sourceEnd": 378,
        "text": "The website says City Hotel. Maybe you clicked the wrong link when you booked online.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a467abcce83bf1e42fdc6f08973d553017448cf7bef985afe95a4e1f614b2724",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 384,
        "sourceEnd": 442,
        "text": "Oh no. I paid 120 dollars for two nights. Can I stay here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b237b7889e7c9550205d24bbae91d192891f79739824393c91182da28d024843",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 457,
        "sourceEnd": 573,
        "text": "We have one room free tonight. It's 80 dollars a night. But tomorrow we are full, so you cannot stay a second night.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9d1888cb4af00965896785b3e6a16ddb1ab799bbac71e4e1ae142a3f33834842",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 579,
        "sourceEnd": 649,
        "text": "OK. I'll take it for tonight. Then tomorrow I'll go to the City Hotel.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bdc0ef0fab183c98b54d196588d6e7a81fdcd87028bb3b1ecf47ce636551f74f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 664,
        "sourceEnd": 749,
        "text": "Good plan. After that, you can call the City Hotel to confirm your booking with them.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6bae9292194c07d15120b700f29ea276194a79d8bb138d03ce5a5bfdcd8b4851",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 755,
        "sourceEnd": 862,
        "text": "Yes. Finally, I'll check my email for the booking confirmation. That will show which hotel I really booked.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "480da875787c00415de4c780ff512fdb1cd7141bcdd17f9e1b956df0f34728cd",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 877,
        "sourceEnd": 929,
        "text": "Here is your key. Room 305. The lift is on the left.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e2c1e4ce69cae0b045af60a5a1b4d632ae1a9d910cfe1baaa3b18705c377b3f9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 935,
        "sourceEnd": 992,
        "text": "Thank you. I'm tired. I travelled for six hours by train.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d0cd5cb18a4067533474102737a586fd56879414e2358513804ef067abacb714",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "receptionist",
        "speaker": "Receptionist",
        "sourceStart": 1007,
        "sourceEnd": 1064,
        "text": "You're welcome. Breakfast is from 7 to 10 in the morning.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "995ee39213789606a3a4f21211d88ec272a9af54d46e574d70875e3c41addabc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1070,
        "sourceEnd": 1099,
        "text": "Great. I'll see you tomorrow.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7b693fec3da0c2c12c1818bf5572aa5947563ce7a107b2499cd8e67e62cdd930",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
