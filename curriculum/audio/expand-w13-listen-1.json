    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 82,
        "text": "Good morning, Lin Tao. Welcome to your first week. I'm Mia, your team leader.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "7248180095bf2c394a1c3369be0de1c84b791ab3af50d5422521d70b22dee6e9",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 92,
        "sourceEnd": 143,
        "text": "Good morning, Mia. Thank you. I'm a little nervous.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c582c159f0bc3c918260d589ffc918fc649b9685dd2a5dcdb70e551e82031458",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 149,
        "sourceEnd": 238,
        "text": "That's normal. Let's talk about the rules. First, you have to arrive at 9 a.m. every day.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "7201eaf54dc25fed4d5615359f8086d493763ddeef8d2c166a4df74dbb58a31e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 248,
        "sourceEnd": 280,
        "text": "OK. Do I have to wear a uniform?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "1e753a1134f17346a30727851fc7c1dc547ba49c7c0e88fb1d117cd5b30321d1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 286,
        "sourceEnd": 365,
        "text": "No, you don't. But you must wear your name badge. You can wear jeans on Friday.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ba1b047c3e27227c8a9fdcab805cbde0af0acba50010fbb73b9a5a8fb5bdc30b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 375,
        "sourceEnd": 399,
        "text": "Great. What about lunch?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "20d65792a026d688567da621b10994166a2ad22901ae6ba79e9bd6a393d9b935",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 405,
        "sourceEnd": 483,
        "text": "You can take one hour for lunch. But you must tell me if you leave the office.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "f54551a9b609b8a1ae78d59e5c45bbd1989c84d14c1e733fe36a8a72a529a278",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 493,
        "sourceEnd": 514,
        "text": "I see. And the phone?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "d7c969fb69206773dfe6fc5450f3319164a59778a02ef37571a2ee728199f9b2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 520,
        "sourceEnd": 590,
        "text": "You can use your phone for calls, but you must not use it in meetings.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "5b9d5570811f81080862c2ec2edfd0676f52ebe2c03066224cddfe3ed55429c2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 600,
        "sourceEnd": 638,
        "text": "Understood. What did you do last week?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "95e1c25181605cbaeed4578ee99fb04c9f74397d52851b6eb8499046bc2f3d1d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 644,
        "sourceEnd": 739,
        "text": "I visited a client on Monday. I wrote three reports on Tuesday. Yesterday I had a long meeting.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "159543b25bf1f256e13368525ba02d9ce0eca1059120219a4137400beb678dc1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 749,
        "sourceEnd": 775,
        "text": "Did you have to work late?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "adea4c3cdf30e482bee599501af041355576315da025ae439e491f0047594ff2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 781,
        "sourceEnd": 842,
        "text": "Yes, I did. I worked until 8 p.m. But today I can leave at 5.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ce6fea3e72a2eb915b770a7cbe66b61f34976b04682d86a7b6dc04ae3be4e116",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 852,
        "sourceEnd": 900,
        "text": "Good. One more question. Can I ask you for help?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ae6e64650fda543ae79a58301d666cd7e03010ccb49fc0da72c9da5a08e42457",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 906,
        "sourceEnd": 978,
        "text": "Of course. You can ask me any time. But you have to send an email first.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2d67272efecad1c5ed3808ac1c1897ef62f9849e5106af51c289e145bdd38290",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "lin tao",
        "speaker": "Lin Tao",
        "sourceStart": 988,
        "sourceEnd": 1016,
        "text": "OK. I sent one this morning.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "9f1b02def707f9eb602a1ebb3a15f062cecb4c93fb85d4026d31598b13e1a252",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1022,
        "sourceEnd": 1049,
        "text": "Perfect. You're doing well.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "d37c95f320a8e020ebdd73344759854c6e497582cfdb6adb9764c64837dcece5",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
