    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 75,
        "text": "Hi, Ben. Do you have a minute? I have a problem with the new requests.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "3a97c06666c59dc38beace518628710fb9a40891eea5403e0741d34f2e7606cf",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 81,
        "sourceEnd": 102,
        "text": "Sure, Mia. What's up?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "21b0da62f8c1aa797c9bc855dc10565ac13374c470184a999566372a3531f428",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 108,
        "sourceEnd": 208,
        "text": "Three customers asked for changes today. I have to finish the report by five. I can't do everything.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b7a69b3bf97eb59eb044d46b7b7e06b7d9763a12e16eede52d2ce4d5c5d06a81",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 214,
        "sourceEnd": 290,
        "text": "I see. Last week, we had the same problem. We must decide who answers first.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "96edfaff5774de8bc1d2c2d05a81a29c542800511515deb5c01c834e0856dfd0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 296,
        "sourceEnd": 335,
        "text": "Right. So, what do we have to do first?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "5487c9e96ea7d3bdb285389f4f88dd1c136f43598bf13a4b70672b162231690f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 341,
        "sourceEnd": 400,
        "text": "We have to check the request time. Old requests come first.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "553bc5110fc273874457b59d43b4d836f81b45d119d2d8265d7ba3497cc2aaea",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 406,
        "sourceEnd": 441,
        "text": "OK. And who can call the customers?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0d99276241532a644b5e959754ec5f032e8643b499b992c55760737a0298c549",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 447,
        "sourceEnd": 538,
        "text": "You can call them. I can write the emails. But we must not forget the team meeting at four.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "4ecd58f194449dc438a807ce84a041e82fbfd3e27e3c872252ea9029ff0d0636",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 544,
        "sourceEnd": 599,
        "text": "Good point. Yesterday, I forgot the meeting. I'm sorry.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c951642938be02e3c46ba5782c1383e5f0f57c39ca519af65659116ba2d712d1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 605,
        "sourceEnd": 658,
        "text": "No problem. Today, we can put a note on the computer.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "36a26a15a2bea0fc7b5a505d4884844160535f7b3ae74504b0dc2eb8554f7780",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 664,
        "sourceEnd": 724,
        "text": "Great. So, I have to call Mr. Lee first. He waited two days.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "1c7c64704bf159570450fd0b977361d565696e2544f0679031758d1999209439",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 730,
        "sourceEnd": 779,
        "text": "Yes. And I must send the report to Anna by three.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ab2a014fae0d09cb0caa3ff489167d4dc318680228f6b29455cef9901584b1f7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 785,
        "sourceEnd": 812,
        "text": "Can I help with the report?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "689da5b939db667a009d3763095dcce4b62d1a93f6dd9f5af5d0b4c3dc1ae2a0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 818,
        "sourceEnd": 865,
        "text": "Thanks, but you don't have to. I can finish it.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "1bb86d9379b3ca35f70de29adf163e0f3b34b7cc187a9aebee9971d5aedac43e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 871,
        "sourceEnd": 911,
        "text": "OK. Let's meet at three thirty to check.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "fd916ad49a9eab0670dcb91711e1189cc8753063c274fecf54af502c8e1f507b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 917,
        "sourceEnd": 939,
        "text": "Perfect. See you then.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "0915f9fe630252118c0062ccf28db0d90335662185e27d718bb17a174663934d",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
