    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 46,
        "text": "Hi Ben. You look tired today. Are you OK?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "372e508e6da6cd668941fa2a14c307235851c19a7eb7bf8839ca99dcbe33b905",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 52,
        "sourceEnd": 137,
        "text": "Hi Mia. Yes, I'm fine. But I go to bed very late these days. I sleep only five hours.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "822c12d92aec05059c09691c4e4aeb6250d75748246fa3d12a1c76e2f4ebadf2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 143,
        "sourceEnd": 197,
        "text": "Five hours? That's not good. Why do you sleep so late?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3c9926877eed590d6f69951f2213ac1928278ab9c90e37cceb95a3de71c82a66",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 203,
        "sourceEnd": 288,
        "text": "Because I watch videos on my phone. I start at ten, and I stop at one in the morning.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a29b6cecf85d9931685d5d2109897cf0df5786af302cfda5850de8430b296317",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 294,
        "sourceEnd": 358,
        "text": "Oh no. You should stop at ten. Your phone is bad for your sleep.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f8921b7454b88fd49ab77a077f353ffe16c914bd6f617385065b21fa9f9c3827",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 364,
        "sourceEnd": 408,
        "text": "I know. But I like the videos. They are fun.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "0dcd44313d7e766dd830606eb0e8c00cd54c048356acf9976abddfc697e2e632",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 414,
        "sourceEnd": 494,
        "text": "Fun, yes, but sleep is more important. You should put your phone in the kitchen.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "a8afa46b679d672b9410edcd6744831746536abfe7c7db4f29475f6fdcfeb0c9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 500,
        "sourceEnd": 567,
        "text": "In the kitchen? Hmm. Maybe. And I don't exercise now. I'm too busy.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a93507b7064f3c150cd67ad15392e9b0436430b402e60fcbb44e94583ae29198",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 573,
        "sourceEnd": 633,
        "text": "You should walk every day. Walking is easy and good for you.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b50f14813fab25972cfbc9aa767d3a0b42cd41386cb56330e43bbd1f2c6837af",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 639,
        "sourceEnd": 664,
        "text": "How long? Twenty minutes?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "4af1c6a25a6a180bce1d4a56870aa4d4bb639ccfccebe9a65afab621816053c6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 670,
        "sourceEnd": 735,
        "text": "Thirty minutes is better. It's the best exercise for busy people.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b3c4f4a2f022a46a48c262e300ea659847dc6411f89eddc2ce4f419777ff3324",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 741,
        "sourceEnd": 791,
        "text": "OK. I can walk to work. It's only fifteen minutes.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "80035a34f38d591e7e4c6b7fdbd3a16b4a18107b2feb253352f346f1a5f0dd04",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 797,
        "sourceEnd": 854,
        "text": "Good. And you should eat breakfast. Do you eat breakfast?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "5111b98a107811daa2b074751f257b6f2a842d8f951aee03c1a392a17690f872",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 860,
        "sourceEnd": 893,
        "text": "No, I don't. I only drink coffee.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "30befedd40143173c4b69e9aefc9f541ebdb809a6ba77564f1ebbca8279530c6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 899,
        "sourceEnd": 975,
        "text": "Coffee is OK, but breakfast is better. You should eat an egg and some bread.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "4eafece30884642c6eb846a4e7c951edcb17aca27d4a967e60e1aa529a9a500e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 981,
        "sourceEnd": 1017,
        "text": "An egg and bread. OK. I can do that.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "fe04fa0d9d244f53a8687343dd5f8e608eb5fa9b9268d61573aad838c9f862b1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1023,
        "sourceEnd": 1049,
        "text": "So, what is your new plan?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3b3b3bf58ad5d5aa34e1659ae2177f056090154516d1e84bae7cb0de2d81e3be",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1055,
        "sourceEnd": 1120,
        "text": "I stop my phone at ten, and I walk to work. I eat breakfast, too.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "2c87ec803b16e9ad01ad349abe08cc166eaf7548a005810a4a2a06ee34fa2cfe",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1126,
        "sourceEnd": 1167,
        "text": "That's a good plan. You will feel better.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "5168f4bff7a4cb7e9044dbb67180d2713248c90e66b4db734c2c8dd18c55e468",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1173,
        "sourceEnd": 1199,
        "text": "I hope so. Thank you, Mia.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "2a6a03b84c0ac5c6a5730b95c9e0d38a22fd2751a78f1e86e9226ab61d18fba8",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
