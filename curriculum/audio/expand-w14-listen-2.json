    "segments": [
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 7,
        "sourceEnd": 90,
        "text": "Good morning. This is the Green Street Clinic information desk. How can I help you?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "d746521bf8c2bf2b0aad7ee6b0557bb760187ac6bc372c4d38e10bcee44e7e30",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 100,
        "sourceEnd": 170,
        "text": "Hi. I feel tired every day. I sleep only five hours. What should I do?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "7d649d7773a6b54a9a1b078847c5d227343e4acb4283387e7bac28022cd682f6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 178,
        "sourceEnd": 270,
        "text": "You should sleep seven or eight hours. Sleep is very important because your body needs rest.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "486b1da692ea7d6a0e85b35a125ade2bc96660d85cee9e4bad7c4f30ace69d86",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 280,
        "sourceEnd": 337,
        "text": "OK. And I drink two cups of coffee at night. Is that bad?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "aa870ecfeac1ee9db0da323226c4192c5084a0a32dfc15451df31b7b46f171d2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 345,
        "sourceEnd": 430,
        "text": "Yes. Coffee at night is bad for sleep. You should not drink coffee after six o'clock.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "4db649edb79ed557a2512322a8b2242b714fbda6c637abdcb1dc78706df71f6c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 440,
        "sourceEnd": 500,
        "text": "I see. I also eat a big dinner very late. Is that a problem?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "19e98d6fe8f8b1d24edc87234e3fe8e02551e28f38f2dc815d2e31fb678e14b1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 508,
        "sourceEnd": 590,
        "text": "Yes, it is. A big late dinner is not good because your stomach needs time to rest.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "239a34f27f0217d61186167da1682ca0910e35c6bbe4945644c25d1587b00716",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 600,
        "sourceEnd": 629,
        "text": "So I should eat dinner early?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ac4f1b9b3f697cca83570c1af4ea4d283872f89b6bee08be831347d7cb0a2c52",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 637,
        "sourceEnd": 749,
        "text": "Yes. Eat dinner before seven o'clock. And walk for twenty minutes after dinner. Walking is good for your health.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b2c31b5ded5756e8e5e84a9f212895744888edd1484607c51b6a2e747ab1d227",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 759,
        "sourceEnd": 819,
        "text": "My friend says running is better than walking. Is that true?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "7cfb0157d24f45baa1c3b469d7c81fdf67c4f98c95156c30fd5d1c64a1f3f058",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 827,
        "sourceEnd": 920,
        "text": "Running is faster, but walking is safer for you. Walking is the best exercise for a beginner.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "5b1efa9a61ffe4220dc5dd4e3c3d2b00d7389dd0e030e24c7473dd526593055b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 930,
        "sourceEnd": 1011,
        "text": "OK. I have one more question. I work on my computer for ten hours. My back hurts.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "3ef98e1e634cd04d2ce13f504b21a2de79590d57be91a8ed7c915c30cf848e7d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 1019,
        "sourceEnd": 1152,
        "text": "You should stand up every hour. Stand up and move for five minutes. This is very important because long sitting is bad for your back.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1042dc50ae99706488ea1bb64f817ece82164dda2e6a64d757200e0da74d0e82",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 1162,
        "sourceEnd": 1202,
        "text": "Thank you. Can I get a paper about this?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "09af2757a0229d1d2b3283cc8d21dd2593fd03d3dc4109b9ef9c72b676892efc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 1210,
        "sourceEnd": 1379,
        "text": "Yes. Here is our new patient paper. It says: sleep eight hours, no coffee at night, dinner before seven, walk every day, and stand up every hour. Please read it at home.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "56574b77490080341899ced79e9cf9fa94c1e00805dc0b175862fe798bb7e11a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "patient",
        "speaker": "Patient",
        "sourceStart": 1389,
        "sourceEnd": 1440,
        "text": "Great. I will read it tonight. Thank you very much.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "d3d0f7a03872f7c133e762aef10f8ed2b722000ee28de5461f4cb6cf35c5fdc1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nurse",
        "speaker": "Nurse",
        "sourceStart": 1448,
        "sourceEnd": 1472,
        "text": "You're welcome. Goodbye.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "cd5e0a1426f430e8d3cd468452a21209b87ae9c6e32dcd1078d48465eac44ee7",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
