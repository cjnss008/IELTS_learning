    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 54,
        "text": "Hi, Daniel. You look worried. Is something wrong?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "73f80d69843f765ef4843d524f76d30830a47ed5debc8e847410989f81d8a9fc",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 63,
        "sourceEnd": 163,
        "text": "Yes, a little. The number 14 bus changed its route this morning. It doesn't go past the library now.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b9e04f5b6db305cc967f60538bce209f011bb9e40e793bbc3169f468cf555083",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 169,
        "sourceEnd": 206,
        "text": "Oh no. How long have you waited here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1905ff92d20f1ec5919fc212f886551aece34cc3e3c204dc9aa8d53883f9829a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 215,
        "sourceEnd": 293,
        "text": "About twenty minutes. I usually take the 14 at 8:10, but today it didn't come.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "054f9715d61729d6eae6ee29a629e41a6d84a9fb60af7bc1933a782a32b58db1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 299,
        "sourceEnd": 325,
        "text": "How often does the 14 run?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8ed51e6ce52b0f34306af35af02f841f4c8e01865c84da0bcfb55ec0a94c1aa8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 334,
        "sourceEnd": 453,
        "text": "Every fifteen minutes. But the driver told me the new route is longer. It goes around the park and then to the station.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d0309de3fb9eb8f1c48557e812e1415656a74c9d085bd9c18f777d00dce25bf1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 459,
        "sourceEnd": 517,
        "text": "That's annoying. Is the new route slower than the old one?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "87e9e08b08f4df6dc5bd1572e839a82b5ccb07783cb1f9794393c54a12c269e3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 526,
        "sourceEnd": 633,
        "text": "Yes, much slower. The old route was the fastest way to my office. Now I need to change buses at the museum.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0aa3df8be3ab488190716b9c5730b7a0ee7ca25d400cf49d0305b774cc5e34a3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 639,
        "sourceEnd": 701,
        "text": "Can you take the 22 instead? It stops near your office, right?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "18a8fa7d38e627cab266f14bc7b54078cfbfa92acffbad7a225fda610f58a9be",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 710,
        "sourceEnd": 785,
        "text": "Good idea. The 22 is more frequent than the 14. It comes every ten minutes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "440a37f03ada49eff507b8f5241df2114f6083852ebbf75b76d2ce52221ffac1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 791,
        "sourceEnd": 841,
        "text": "And the 22 is usually less crowded in the morning.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e71f6a2e104f7caf51b52f79c80ff845a28184be19270f43502c8e271c21fe9a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 850,
        "sourceEnd": 915,
        "text": "True. But I need to walk five minutes from the stop. That's fine.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "195897ff23838935db9cf019552e75d42aa2db96b8e7d13b04594d505b3d7c97",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 921,
        "sourceEnd": 959,
        "text": "How long does the whole trip take now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bc66108d19b92897a3154f37224f729828f4c7aac60b4c9e4507b815e5486307",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 968,
        "sourceEnd": 1081,
        "text": "About thirty-five minutes. Before, it was only twenty. But the 22 is the most reliable bus in this area, I think.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "059ec9b245747d0099009ba780150f34f7d715a1f64344bb86c54b629cabb2c2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1087,
        "sourceEnd": 1149,
        "text": "Let's check the app. Oh, the next 22 arrives in three minutes.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7dace281fce7cb69e2f8cd2ee9fbd06741e103535bfc03b3595671389342365c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "daniel",
        "speaker": "Daniel",
        "sourceStart": 1158,
        "sourceEnd": 1206,
        "text": "Perfect. Thanks, Mia. You're the best neighbour.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4d41b30e421467176234b23ec8afc8f322d7ee294e0b53b7d8937fb7d684c792",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1212,
        "sourceEnd": 1253,
        "text": "No problem. Text me when you get to work.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "02bbc05f78070c3bf63ca7766bd7efd99d47cc0ab374e6dd1bcf4a8bf6adfd30",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
