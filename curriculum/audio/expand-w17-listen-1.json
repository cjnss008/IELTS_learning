    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 35,
        "text": "Hi Tom. You look happy today.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "faa458ba5a121c5a972ea98e1f0ede825e613ca15e26ed06efd6216ea9f3f061",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 41,
        "sourceEnd": 123,
        "text": "Yes! I started a new evening class at the community centre. It's a computer class.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "bb12aa19044e5e046c405980d5ddfeaeca91b8b26ba02a790edbb2e4ddc863e7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 130,
        "sourceEnd": 157,
        "text": "Really? When did you start?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "e5cf81b313a00ed1b7c36228157fb73ada999cdba2e7ebb7f8a43426b08d64b4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 163,
        "sourceEnd": 222,
        "text": "I started last Monday. I have already finished two lessons.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "94a57555d59f2e9141696f3b8264bdea58daf55569adbe60555ca3aaff293307",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 229,
        "sourceEnd": 278,
        "text": "Wow, that's fast. Have you done any homework yet?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "431e36aad405a4142864ae05a467efbfde7a9c647b742d09201562a03ab4bedd",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 284,
        "sourceEnd": 361,
        "text": "No, I haven't done any homework yet. The teacher gives us homework on Friday.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "342fb17c0a63f1d01d892a2b10879ff70a9cc8343f59d89a93feeef382cf14d9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 368,
        "sourceEnd": 391,
        "text": "How long is the course?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "a05f14394db5ca250da569f512342bb08de5c27af1adaeac600d23c2b5d65425",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 397,
        "sourceEnd": 460,
        "text": "It's for ten weeks. I have been in the class since last Monday.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9f6bfde2a538876129e885b0224ae96dd1b4334224527f1e50d04e8ef535bcdc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 467,
        "sourceEnd": 483,
        "text": "Is it expensive?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "8cc0f2569b9760168c83c58154d995db25e3374e3fac2fc0b47a3afdcbfb6693",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 489,
        "sourceEnd": 581,
        "text": "No, it's free for adults over eighteen. The centre has offered free classes for three years.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "991538d508cc10c43cb319a167ba59dd1ac3bb2012390420a74df5c6783f3ad1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 588,
        "sourceEnd": 651,
        "text": "That's great. I have wanted to learn computers for a long time.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1538923bfee7f04e6018e9f53a53bee464054e42aa75bbf9980bd393be69bcf1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 657,
        "sourceEnd": 743,
        "text": "You should join! The next class is on Wednesday. Have you ever used a computer before?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "3d82ba44ea69c23fc84bb2f61270c19028bf6021ab68b05106d1680596efcdf7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 750,
        "sourceEnd": 834,
        "text": "Yes, I have used one at work, but only for email. I haven't used other programs yet.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "419a1e0df6674dbe2a208a1cc99256e7c9c747cd85950fdd723c6d0358f2eb14",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 840,
        "sourceEnd": 913,
        "text": "That's fine. The teacher is very patient. She has taught here since 2019.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ffd45d4b8fb8bf3c36670057786318a319d11682b8c3a2cb32db504f14f075fb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 920,
        "sourceEnd": 945,
        "text": "Has she given you a book?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b489bd212498e334f68cd8646e5cb0ef674c4696972903271701d634a88b5298",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 951,
        "sourceEnd": 1013,
        "text": "Yes, she has already given us a small book. It's easy to read.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "5758910090f6915cc5d547c2f828edc7279afcf11b579c032e6e6a1c3a291468",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 1020,
        "sourceEnd": 1086,
        "text": "Good. I will call the centre tomorrow. I have not called them yet.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f4cf230e550d3caf3b70a33789c5010d7840779a0840db17f84f65f02f90028a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1092,
        "sourceEnd": 1162,
        "text": "Do it soon. The class is small. Only twelve people have joined so far.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "fa5036c6e0dc83a40007a2d84734bb0935c634aff54e35880927a50d42246190",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 1169,
        "sourceEnd": 1207,
        "text": "OK. Thanks, Tom. See you on Wednesday!",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9d48a0e8941922d813fce0d5c1224dc010ab786e7752f049ad7f64cf932dfbd3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1213,
        "sourceEnd": 1221,
        "text": "See you!",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "b85e335c228acb9216783405b917ea818b8eef57dd9629d259506cb49ea4e519",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
