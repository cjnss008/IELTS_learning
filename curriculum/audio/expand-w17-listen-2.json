    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 71,
        "text": "Hi, Ben. You look happy. Have you finished your study project yet?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "af8852ba4e0e1347e454f988c3464db82b9e9a9e4478f9d0038cbc3e1ce89f42",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 77,
        "sourceEnd": 153,
        "text": "Yes, I have. I finished it on Monday. I have already sent it to our teacher.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a221ad88f20cf8875ff21d1c76d7457c271e9615eac7be87d88d2e95bb25af8e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 159,
        "sourceEnd": 218,
        "text": "Great. I haven't started my part yet. I'm a little worried.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "34ffa8fa686a813c70f1e552805ef03c188eeb3a0e9892d74b1813bf99feff75",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 224,
        "sourceEnd": 299,
        "text": "Don't worry. I have used a new study method for two weeks. It really helps.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "45fa2f304141fb1bbfbf9f478f1214ea91149836dcf0855b580c9a367dafc857",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 305,
        "sourceEnd": 325,
        "text": "Really? What method?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "18ac625873929383443f8b175e0c0bb036f582128b6ba0bae9191aaf3fa16c95",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 331,
        "sourceEnd": 446,
        "text": "I have studied in short blocks since the beginning of this month. Twenty minutes of work, then a five-minute break.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "e10380c1c335d8706de2162acbc20b8987b25765eb89537be8ab2cb7d58f2634",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 452,
        "sourceEnd": 499,
        "text": "That sounds simple. Have you tried it for math?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "50a68e2e8fc27650da53b3ea09756a65b54a8a54cda718bb898cceb822cf3b31",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 505,
        "sourceEnd": 594,
        "text": "Yes, I have. I did math for three blocks yesterday. I also made flashcards for new words.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "094e8c178c109cdb59c065d4f8340ed4f05f591442ec878d5ebdb72407a7ecd4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 600,
        "sourceEnd": 684,
        "text": "I tried flashcards last year, but I stopped after one week. They didn't work for me.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1c2a5c0ab0405c3ab3782eee2c5a47e93e80c3f97c9e5053e532912117fe6f94",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 690,
        "sourceEnd": 784,
        "text": "Maybe you used too many cards. I have made only ten cards so far. I review them every evening.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9fc6357907571686e78c92710064ab7fed3655624afacd0d4e9787f1c0baa448",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 790,
        "sourceEnd": 854,
        "text": "That's a good idea. Have you told our teacher about this method?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "a190ce90f65288968cf022243480750c238002dde637fe37db684cd6acaaa528",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 860,
        "sourceEnd": 948,
        "text": "No, I haven't told her yet. But I have written a short report. I finished it last night.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "e64e1bd0272576f85badd7d608b56cbd3c14613799888d25b025c823e05ff8c0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 954,
        "sourceEnd": 1024,
        "text": "Can I read it? I have never read a student report about study methods.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "fd20eafceaa9e29b74b9df457bddd6595ad5eb007aed3732ad3173f160da014a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1030,
        "sourceEnd": 1077,
        "text": "Sure. I have just printed a copy. Here you are.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "3eaab88407afcf5caee8695df65d484446f0c9ed557e815d461c3eb5349deaea",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1083,
        "sourceEnd": 1151,
        "text": "Thanks. I have already learned something new from this conversation.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "39ef06544849a10bf48e0e62d042738e31ded18647b763821e679e12f5b5ef7f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1157,
        "sourceEnd": 1245,
        "text": "Me too. I have not used my phone during study time for five days. That has helped a lot.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "d03946d9c9c9e669791002ffd0bcc2452a7d9adac8ca480647a54626346fa012",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
