    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 48,
        "text": "Hi, Ben. You look busy. What are you doing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8da372a21cfdfbe259129a36698c1aad2f5f1c42061cc6bf75080b2ac931ead4",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 54,
        "sourceEnd": 142,
        "text": "I'm trying to choose a note-taking app for my dad. He's 65 and not good with technology.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "439dba5cc133e1fed2bb4f56906d1a35b0bbfed23866b284e6231475d94649cb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 148,
        "sourceEnd": 177,
        "text": "OK. What does he need it for?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0fb9ab61229fe156ecb248a5429ec93c2328b8903ede21af2aa93ff34ecc0de0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 183,
        "sourceEnd": 278,
        "text": "He wants to remember his medicines and doctor visits. He also needs to share lists with my mom.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e3dd3759c0f4c2cdfd086c74b9bf253a4673bc416e9e1aa2a71032046e8fd70e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 284,
        "sourceEnd": 336,
        "text": "So the app must be simple. Does he use a smartphone?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fca224bc631ec20439f8fe4e7e04dc71e1171dca7251aa3666f187f13f1d6707",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 342,
        "sourceEnd": 419,
        "text": "Yes, but he only uses it for calls and photos. He doesn't like small buttons.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "98b67472db3e303a85afa48b64adc15c462f98f9913425f8e5b2431bbcbcdad9",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 425,
        "sourceEnd": 498,
        "text": "Then a simple app with big text is better. Have you looked at 'EasyNote'?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1eb6f3e88cb6380ae2b5a99d8ab4bfe4c841449f7aa62220442437216e302565",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 504,
        "sourceEnd": 589,
        "text": "Yes, I downloaded it yesterday. But it has too many ads. My dad gets confused by ads.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "66078d02a198ffbc8b26ce7d50f050dd35ba9460aea5a9ab6fe0f625f3c5cb98",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 595,
        "sourceEnd": 687,
        "text": "What about 'SimpleList'? It's designed for older users. It has no ads and the text is large.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "750bbf0c32a30514bbc04106c99e0344842b88c9b7538da55343ecae21553939",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 693,
        "sourceEnd": 722,
        "text": "That sounds good. Is it free?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3e2c784fd32e2aa6cdea46f283016afc42a925f1f2055e033895450740e0913b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 728,
        "sourceEnd": 814,
        "text": "The basic version is free. You pay for extra features, but your dad doesn't need them.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9cb60b94c24d2ab6d708ae38ecf61801d4fd17584069403d8c5ec56149f034f3",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 820,
        "sourceEnd": 851,
        "text": "Can he share lists with my mom?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f9f48f135512862c40a66ff9c3693c87a8917edcf8519f386f8da13ad3e1d0b6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 857,
        "sourceEnd": 943,
        "text": "Yes, sharing is included in the free version. But you need to set it up for him first.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0caed311a591a33f7b9b626f26496939aa4a7f10b35172118aa3ebc78f057ccf",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 949,
        "sourceEnd": 1003,
        "text": "OK. I'll install it on his phone tonight. Thanks, Mia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "875596d77168e789f7a9afa444427ed5a3caa74617c5129b9aa0d2c712fc78da",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1009,
        "sourceEnd": 1065,
        "text": "You're welcome. Remember to write a short guide for him.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7c8c18ea1787178507c433c5ab68666e41aa8a73189dad7752bf785888fd7ad8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1071,
        "sourceEnd": 1095,
        "text": "Good idea. I'll do that.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7cbc01c5535c6af0822ef3619b0bd33d077164af4c8846e366df60ab51f831f6",
        "pauseBeforeSeconds": 0.45
      }
    ]
