    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 45,
        "text": "Hi, Leo. You look worried. What's wrong?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "4897cfd23efe93188abf5c98473085dd25bd343221e990363d50276c226225c8",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 51,
        "sourceEnd": 117,
        "text": "I got my speaking test result. I'm stuck at 5.5. I don't know why.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "4320e13e9df9f1cbb8acb138a90fd74c5930d719c73585727a371b962f067a0c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 123,
        "sourceEnd": 168,
        "text": "Let's find out. When did you start preparing?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "936f8ede20675313e40669e107583b65d57b9b4e4fa884f5ea4d779c6ecbb24b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 174,
        "sourceEnd": 213,
        "text": "Three months ago. I practice every day.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9dddfb147d0b0dc2031e4bc8215f309472c9ba5c25c171274a38d04205fcf91f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 219,
        "sourceEnd": 242,
        "text": "Do you record yourself?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "ac16a9210b28a3ce045feb1c234f62bb18b93123b949475cf3b819d133aca942",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 248,
        "sourceEnd": 280,
        "text": "No, I don't. I just speak alone.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "02d68e6a5c32e5fce0d3cecba4cbeef935ad58dd65a5ea72185d2f497d2e73ea",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 286,
        "sourceEnd": 359,
        "text": "That's the problem. You need feedback. Have you tried a language partner?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "d2259d9ec771ad14d4b65d49b1c46f4597be1dc6fa35b0630b1ece6f5168e326",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 365,
        "sourceEnd": 425,
        "text": "I had one, but she moved away. Now I have no one to talk to.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "31e0b8a522fe6a74660263271753e46097b8b519c16062136c8405a3d568575e",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 431,
        "sourceEnd": 516,
        "text": "I can help. We can meet twice a week. But first, tell me: what do you find difficult?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "054438bea3b38af23c2580ea98d361733a177cdfa2d2f5910e39a3060fe547fb",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 522,
        "sourceEnd": 613,
        "text": "Long answers. I give short answers. The examiner asks 'Why?' and I say 'Because I like it.'",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "3112c6c755cca0919cf981b34920d9c8ae7ea7d2d348b55d618164f03c8e191a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 619,
        "sourceEnd": 699,
        "text": "So you need to extend your answers. Also, your grammar—do you check your tenses?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "8962dacdfa86552042c48c8a6879a273a3f0ef3b62afe249b5542da892cc50a2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 705,
        "sourceEnd": 746,
        "text": "Not really. I often mix past and present.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ec945d3cb3bc355a49329c857355ade7dfb4306ef92e8d0d452f000f5e82ed6b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 752,
        "sourceEnd": 874,
        "text": "OK. Let's make a plan. You will record one answer daily. Then we will listen together and fix one grammar point each time.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "6820757cfc0e7dae0997e58220fe368995040ea28531852507311dd8f5815bd4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 880,
        "sourceEnd": 926,
        "text": "That sounds good. But I'm shy about recording.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "44edfbb25b22db69163fc8c4483b5fca46a5ea9592057193b21b9b16b81431e2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 932,
        "sourceEnd": 993,
        "text": "Everyone is at first. After a week, it gets easier. Trust me.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "37fdbb123f8bb8416eafed38f91afa7db5890877c33d8c7f4df68cd3d616ac92",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 999,
        "sourceEnd": 1025,
        "text": "Alright. When do we start?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "c17442cdbeeb7377ada079a3f1d040e297f5d9a04da4c246647fa1aaf620dedc",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1031,
        "sourceEnd": 1082,
        "text": "Tomorrow at 6 p.m. Bring your phone and a notebook.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3939accb7b1f0d79d2498100f03d20db2dfd5aa98b395b6636bbee0b265afffa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1088,
        "sourceEnd": 1106,
        "text": "Deal. Thanks, Mia.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9c629455fead14b3d640b022078061b798d7e9923bcaf3bb2bbd67642a35172a",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
