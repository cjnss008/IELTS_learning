  "configuration": {
    "layoutVersion": "curriculum-role-pauses-v69-us-1",
    "transcriptHash": "ce56e3a37c0278c518346c766d672aec60ee1df27eac8fc6441f645a244267e9",
    "rate": "+0%",
    "format": "mp3-24000-mono-48k",
    "authoringPackageVersion": "7.3.1",
    "roleVoices": {
      "narrator": "en-US-MichelleNeural"
    },
    "sourceLabels": [
      {
        "label": "NARRATOR",
        "role": "narrator",
        "sourceStart": 0,
        "sourceEnd": 10
