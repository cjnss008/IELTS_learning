  "configurationHash": "8f5d2338186229b86ed7b2a790aaf3af59beaa4fbe5aaa3a8b4ffe4431a9341b",
  "configuration": {
    "layoutVersion": "curriculum-role-pauses-v69-us-1",
    "transcriptHash": "cfd04cbbab0d3d6e80e4184d8473cb68dd67e038daa4c02887f61662e04fa15f",
    "rate": "+0%",
    "format": "mp3-24000-mono-48k",
    "authoringPackageVersion": "7.3.1",
