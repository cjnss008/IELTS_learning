    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 78,
        "text": "Leo, the usual bus stop is closed today. How can we get to the new stop?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f9a6f3b430f123fe11e1ffdd4770f9e2c77ca7d1137e116e01021b7e87ff4ab7",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 84,
        "sourceEnd": 137,
        "text": "Turn right at the bakery, then walk past the library.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "821e7d1c137e224bfb5d1a13026d2500a0aea6f41688ab297cf8a6b24430adf0",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 144,
        "sourceEnd": 172,
        "text": "Is it beside the green gate?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "55a9982a36524779f7c65c3cffa484ce3f4b12fb543156a5908726259f908d14",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 178,
        "sourceEnd": 234,
        "text": "No. It is across from the library, next to the pharmacy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b985ae62bf01f28937ebe93925e8fb01075e2070c807b760902fb5505f8c014b",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 241,
        "sourceEnd": 275,
        "text": "What time does the next bus leave?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "595afa6c725d8b02f6e8a196f0397d865d50f6fd1ea475b1e84a8385621021bb",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 281,
        "sourceEnd": 322,
        "text": "At three fifteen. We have twenty minutes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f36270668ca305c65be43ea4bfce65db7b45e3fc66c5414a3862edc72af02716",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 329,
        "sourceEnd": 377,
        "text": "Good. I need to return this visitor badge first.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "caabeb0f8b39ebcd3f019c9a794b3cd3ccc5ab714adcee74a2457924893a0820",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 383,
        "sourceEnd": 433,
        "text": "The office worker said to leave it on the counter.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e0495b77d540d053dcc6e9bf13e0cb7204bb194e34fc2c6643342592433a48a1",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 440,
        "sourceEnd": 490,
        "text": "I will do that. Could you carry the folded poster?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c704fb781cec9461ca16c3119055b4bfe33eadf036c4c65b540147816a511b30",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 496,
        "sourceEnd": 539,
        "text": "Yes. I will keep it in my coat if it rains.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7e71387415a764d46dcd1f8a5d262257ecfaa1832cad5be080ff70a9b8c1d5e8",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 546,
        "sourceEnd": 597,
        "text": "Thank you. Should we ask the worker about tomorrow?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "37f785c344c0e5c387fe63134e4248e0b6b8d4644e7416aee1cb6cd1b1c544ea",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 603,
        "sourceEnd": 666,
        "text": "Yes. She wants us to arrive at nine and bring two clean towels.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3a641b1686a94cc9ca34957b1766e45483ad288734b2f175d4f18aaee21929bd",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 673,
        "sourceEnd": 706,
        "text": "I will write that in my notebook.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2757a10998071d93fb8f820c38db50d780a8c5bc06ea977f25095ba1b52597ae",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 712,
        "sourceEnd": 761,
        "text": "Great. Then let us walk to the new stop together.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ccb0b545ec384d70a2bacd123ce5bbafc078f2020aadc47a9c4c38ac1a2ee928",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
