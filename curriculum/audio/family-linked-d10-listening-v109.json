    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 43,
        "text": "Is the next history walk on Thursday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c65974373b16c738a1773a9c8382266be64240635a4d94f0a3280d2cb41805d1",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 49,
        "sourceEnd": 87,
        "text": "No. It is on Wednesday at four thirty.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "050074393837e854cf2c47a601c93e6dd25205775328720a925d4814692c6c67",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 94,
        "sourceEnd": 132,
        "text": "Where should we meet before it starts?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3cbc40fc73552ef584b090559ae405eecbe1bab4ff9ec379d7f7a97bc0a140a3",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 138,
        "sourceEnd": 186,
        "text": "At the public library entrance, not the station.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "339d4ffe697df4c2822f627c6b5d6ffa7e535b3d671fc35ce9e04b6ee916763e",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 193,
        "sourceEnd": 225,
        "text": "Do we need to buy tickets there?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "34c4fedb9108fb24093637cb23beb530959c1b0f7e72135ca44c045fe98f3e46",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 231,
        "sourceEnd": 268,
        "text": "No. The guide will bring the tickets.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d50f0e96467e3dfa258b3102cbef741b0715e78347a3ce36bd375cb0e3558f95",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 275,
        "sourceEnd": 307,
        "text": "Should we take bus number eight?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5e82bd76e3309d3519e4b0e0f29a0a6eb2d7fc10f40da54d83441356745f4deb",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 313,
        "sourceEnd": 362,
        "text": "No. Take number twelve and get off at Oak Street.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "45ac03bd9d896c1990e09025a93dfcec36f1b1ad93de7ee6fd1fed0f0cc430a9",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 369,
        "sourceEnd": 401,
        "text": "What should I bring if it rains?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e7f5e3ba92437ade0d5e152e0717d7e09571244becc2501c5cf2e08a21354316",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 407,
        "sourceEnd": 437,
        "text": "Please bring a small umbrella.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "65525e5e9afde068b12f299ddb480a697756a39cc5fa43aa81f08bb8032c3e5e",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 444,
        "sourceEnd": 485,
        "text": "Where can my sister wait if she is early?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9ca32f07b141214c544ea84bd1b3ca622d3246ce08c43d1c489ae14c828eda63",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 491,
        "sourceEnd": 533,
        "text": "Inside the library, by the newspaper rack.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1ecc0c1fc5a177b51d41aed3b7d3f9db965c80f1288b3065cf49bc1816b7c7a6",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 540,
        "sourceEnd": 569,
        "text": "If I am late, may I call you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8b5ef4e78b2df4fc925c67945d05622d132f13ed0e1663d39dad073d7d072313",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 575,
        "sourceEnd": 615,
        "text": "Yes, call me. Then I can tell the guide.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "717770425e34fd64cccd5e1ce4cc855099cab8a313833d9b1902c2a09dc7cbaf",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
