    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 51,
        "text": "Good morning. Is this the lost and found office?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "133e86f82e1c75f20884ea3698b7dc0bbb4b5da60f5a4f528d64b9270a42b58f",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 55,
        "sourceEnd": 78,
        "text": "Yes. Are you a student?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0f93c1a3ea8a419a9e71e24c60795a78e0c7d14ea75f03e10d166e3627657d34",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 82,
        "sourceEnd": 131,
        "text": "Yes, I am. I am a new student. My name is Li Wei.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "2d9cb4be7eebaeffd527269b717132c1f03663c7991772eb2231f5cac0f825fa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 135,
        "sourceEnd": 163,
        "text": "What is your student number?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "d7e816e497984baaf8e926344fa6c32a1e0ec2e48c5150d9e25a400e1be71482",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 167,
        "sourceEnd": 197,
        "text": "It is 2024107. Is my bag here?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "8bfc4c33dbf6e3a2890a3def7aea8f558c9b8663b37d495b7adc416db561d827",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 201,
        "sourceEnd": 237,
        "text": "No, it is not here. Is your bag big?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4517cafda2e9c3ae0643cebe25550017958e9d1234ccf09eebe4be882e3e1537",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 241,
        "sourceEnd": 266,
        "text": "No, it is small and blue.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d1eab19c607b305ba61e4f600a5c62cfc54ad13b322ece43d2c873dbb3e31e6d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 270,
        "sourceEnd": 290,
        "text": "Who is your teacher?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "22135ea18069b10c87e17e3a955a915bf34b11aa9ea053777919a4edb3419914",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 294,
        "sourceEnd": 317,
        "text": "My teacher is Mr. Wang.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "863dbf8e3e4d21f775ce0f5ebd69f050a22c6336887a251d262b778c9fe2dd82",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 321,
        "sourceEnd": 340,
        "text": "Are you in Class 3?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "daaad484bbc65a4864dd5c9683661106a2479c54439724e02a98282cb975a2ce",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 344,
        "sourceEnd": 354,
        "text": "Yes, I am.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "cc07850c5e9229139005fd230419a5d512fb253e67cf4cfd4d58100b9d016a20",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 358,
        "sourceEnd": 383,
        "text": "Is this your black phone?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "531aed150f19dab2d9267c7db4f70130687d0ec95823da6ae2867fd545b41236",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 387,
        "sourceEnd": 409,
        "text": "No. My phone is white.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c980d48546d939ed5145ab625c5ee9be203564a578ac6891b73b7bfe4778b049",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 413,
        "sourceEnd": 439,
        "text": "Please come again at 2:00.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "cf8e227f8eb3baab4321001b3b4caa4b7952ec47d00d69e4cfd01d106e0205c9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 443,
        "sourceEnd": 453,
        "text": "Thank you.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "8569efc4ed5a6273140c2b6ec0ab8d99f4398210808fbb7c0cbbae4fbcc21350",
        "pauseBeforeSeconds": 0.65
      }
    ]
