    "segments": [
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 6,
        "sourceEnd": 52,
        "text": "Welcome to the library. Are you a new student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8030d62718aa32ca3159896d0f36bef01ff9d3a2d0525e210ce1945125265573",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 58,
        "sourceEnd": 84,
        "text": "Yes, I am. My name is Ben.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d3ec00ca8feef12bb03fa0474590b4266308accc52def743aa98c484e5adb65a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 91,
        "sourceEnd": 121,
        "text": "I am Anna. Are you from China?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d4e5ff09a269d14c3d550ecbf0d6762b57f7754589b1786f0a5ae6822cc5562b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 127,
        "sourceEnd": 161,
        "text": "No, I am not. I am from Singapore.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f3caa5b2019e407ee23f0fabb2ee27e0522415651fff92f470a019eb82c00a6e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 168,
        "sourceEnd": 188,
        "text": "Who is your teacher?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "22135ea18069b10c87e17e3a955a915bf34b11aa9ea053777919a4edb3419914",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 194,
        "sourceEnd": 240,
        "text": "My teacher is Mr. Brown. He is not here today.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fe4f97c249b5716be801b1690673637faf211ad17c2013c212f0902d9a90bcaa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 247,
        "sourceEnd": 269,
        "text": "What class are you in?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a60c10338a035ae06213a849ba2db9c57a5ae607e941e40cef9c04a6815ac06a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 275,
        "sourceEnd": 291,
        "text": "English Level 1.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "58d977d395f680a822826ec16fff30b054816d37dbc09584bb1ce5b57ac5043a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 298,
        "sourceEnd": 321,
        "text": "Are you free at 3 p.m.?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "506ca0d4fc0c68c3b3b8d1630f5e6ce694e7112f32f82a0560ec6ac0b8b197b4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 327,
        "sourceEnd": 356,
        "text": "No, I am not. I am busy then.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "38c81b9ec26c04632b022203d16a68d5bf3068d5c36a8904487f7f725edd6b25",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 363,
        "sourceEnd": 386,
        "text": "Is your class at three?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5a19fd45a43854563d1762537ca82931bc77830de8fbb8758744007069171290",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 392,
        "sourceEnd": 411,
        "text": "No. It is at 4 p.m.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d89061248cdabb8b387b7353bd4f1a9c811149731b8af7ddee9e76f31704d373",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 418,
        "sourceEnd": 446,
        "text": "Is your teacher from Canada?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "295ff85002ffd88ad1dafea33a86589208c4ea0e9efdf788b546adad0c6a9d42",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 452,
        "sourceEnd": 488,
        "text": "No, he is not. He is from Australia.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "697ac1e70b61131a8b6f0c6f59a2b34c6069c0dd5a61df138875ec7ee3687d40",
        "pauseBeforeSeconds": 0.65
      }
    ]
