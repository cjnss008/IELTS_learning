    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 37,
        "text": "Hi, Mei. Where were you yesterday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4414daf3902b8f4aa8b7941d0995feb3959cf06d69f28e4ba2aa1a55a96b5ad5",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 41,
        "sourceEnd": 62,
        "text": "I was at the library.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0d093f8dfd14e79608caf9c05c2250b784813ff98fab7f4bcded8d3670040e4d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 66,
        "sourceEnd": 78,
        "text": "Was it busy?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "23bcdacd38924a44304eae33fb4360c69cea3ad25fd44def8fd851163010f839",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 82,
        "sourceEnd": 110,
        "text": "No, it wasn't. It was quiet.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "27475389abdb505d2bb81af28db02136c1d4c8addf626888a221605435ed67e0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 114,
        "sourceEnd": 148,
        "text": "What are you going to do tomorrow?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "661e42ac10847a6157e04663ecb2ed0d8ba9df9b51cce3cc88bea8270a0e76a0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 152,
        "sourceEnd": 212,
        "text": "I'm going to visit my grandmother because it's her birthday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "47b83168323d284262614087e07a96f438bb3075cdecadea9481b42713a04333",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 216,
        "sourceEnd": 288,
        "text": "That's nice. I'm going to study English because I have a test next week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a6eb0ea39f965ba0968a644443b3a88bdcc9111e2273bacef985fadc48823468",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 292,
        "sourceEnd": 302,
        "text": "Good luck!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "853d0afd9c941f2ab62cd22ac74c341b0a2463184d18904870b796628f313cfc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 306,
        "sourceEnd": 349,
        "text": "Thanks. Were you good at English in school?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "411efb54023dbaed2111bf5230f9a1f6444fe0e520f6a934257ac8cb3f79bf07",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 353,
        "sourceEnd": 385,
        "text": "No, I wasn't. But now I like it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d7e8584c83617abbf779348556ce998ee650e26175ad56aaf8194224951c1eb6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 389,
        "sourceEnd": 433,
        "text": "Me too. I was at the English club last week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4f2992a0f2a7407914b594a19d6d643f7cbbd6affdc0650c4f73490d90f6718f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 437,
        "sourceEnd": 448,
        "text": "Was it fun?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "55f532b8c5b374bcd19e29181b3ec3234b2b8741bc80cf8be87aca9783e31438",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 452,
        "sourceEnd": 487,
        "text": "Yes, it was. We were all beginners.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fe6728ca9811dad3496848dbe1d5f14401071695a406829533ea6b8c833e449f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 491,
        "sourceEnd": 543,
        "text": "I'm going to join a club because I want to practice.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fc1595792dac4352fdaf1888d81954a3a9bab6c39b69c8875ce771abce2cb6c9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 547,
        "sourceEnd": 590,
        "text": "Great! The club is going to meet on Friday.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2f782a298b398042c0566fa9cd8ba3a7a2e584c8f105efb0dce057bd4d2f4936",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
