    "segments": [
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 6,
        "sourceEnd": 43,
        "text": "Were you at the pool yesterday, Owen?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f15d75e563d8f130c8a84101b343ded9621060cbb8efa33c74f53ff1fa128b09",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 50,
        "sourceEnd": 97,
        "text": "No, I was at the bike shop. My bike was broken.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9bde56f46d5c8e70b8d5c2aa7a974c4747ef6e7a9ee2de6163370c4c80a8d374",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 104,
        "sourceEnd": 122,
        "text": "Was the shop busy?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2b21c0e083aef242876d33d526f1e5906b09b72ddf66f68067f2d42fe8fe181f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 129,
        "sourceEnd": 176,
        "text": "No, it was quiet. The repair was thirty pounds.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4716ac56360182efdc6d3c2e6d8592a120abb3f56f9acc5d5699aa315bc47442",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 183,
        "sourceEnd": 222,
        "text": "What are you going to do this Saturday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8fbffb666fc69adc8961d2928b949405d23491dfb184a2b83409e7b5f800bd72",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 229,
        "sourceEnd": 269,
        "text": "I am going to collect my bike at eleven.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "395a545c2df5fca0acd4ffb6cffc81998e83854f2b9f7f623569d4770d57fefe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 276,
        "sourceEnd": 298,
        "text": "Who is going with you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4eae7553e924c4f10e1996961a5c9d575f558e63c504e8cbe7b6515e4b42de22",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 305,
        "sourceEnd": 381,
        "text": "My brother is. We are going to ride to the lake because the weather is good.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6e21260931359a2ccc85ceea91de73ceff2c49eae42b53ecaec7145d45d7507d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 388,
        "sourceEnd": 427,
        "text": "I was at home last Saturday. I was ill.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2a3cca4fcd2c0989dad60fc1582b1587f2347e86b0d7472e0a7a4f2c56b88129",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 434,
        "sourceEnd": 473,
        "text": "Are you going to the pool this weekend?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f395313b1f363047ff957690bbd07941a9293df6f3bdf7ee13d4fcdf0758ddda",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 480,
        "sourceEnd": 524,
        "text": "No. I am going to bake a cake for my friend.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "850fb330bbb51a119ae1a9f2223f104e13deeb9a24a8e0efae6f082232fd1a9b",
        "pauseBeforeSeconds": 0.65
      }
    ]
