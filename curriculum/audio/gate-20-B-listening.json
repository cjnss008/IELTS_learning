    "segments": [
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 6,
        "sourceEnd": 69,
        "text": "Welcome to Harbour Museum. I'm Rosa, the volunteer coordinator.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "0b7afd82c72b668487514a118bd23a92daf63f23347b354ac8794a6c76eb59f1",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 75,
        "sourceEnd": 152,
        "text": "Hi, I'm Dan. I'm helping with the model boat workshop. Does it start at nine?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a9057eb920b0a25089df816c069b6a1b4170cbf35f8aee4626148bb838b4cc9f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 159,
        "sourceEnd": 209,
        "text": "No, it starts at nine thirty. We need five tables.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "29019a86b420471204a15ee40ea338ccfc09c3760d8f17d662c360c66825ec7c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 215,
        "sourceEnd": 240,
        "text": "I thought we needed four.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "6a04a6e2fe039f1255f746d10ddfff6765dff43b168790a06a06522bfb5acfcf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 247,
        "sourceEnd": 308,
        "text": "Ten children have booked. Two children will share each table.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "67b53ead7a39782ef3cf68900da32b146918de8dd1ec70741d400fae77da8e09",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 314,
        "sourceEnd": 335,
        "text": "Where are the tables?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "15282dbeece175ecc5f4730d807d458146006fbad7cb79a02f808d4288308921",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 342,
        "sourceEnd": 437,
        "text": "In the storeroom behind the ticket desk. Don't use the tables beside the door. They are broken.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "0995c6579e5be09557c33a35c0307582baec6dac18cfc43d8fc2364d7c69e13d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 443,
        "sourceEnd": 473,
        "text": "When does the workshop finish?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "938f99218ed734c8e0d7cf3754ba8c90bda6e885cb801a9640ebf36717005485",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 480,
        "sourceEnd": 563,
        "text": "At ten forty-five. Then we'll have tea and biscuits. We have two boxes of biscuits.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "e1b3d20f6afdf8477ace03ed5e21315a5d7587e63ff4d54f646493baf2362ff6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 569,
        "sourceEnd": 598,
        "text": "What happens after the break?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "824cd685cd02c0ec2bc3870685b35bc66272ae02d750694ce8546c9269e4685f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 605,
        "sourceEnd": 778,
        "text": "A short film starts at eleven in the upstairs room. Lunch is at twelve for all volunteers. The museum is closed in the afternoon for a staff meeting, so we'll finish by one.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "8fcfe3ab0b5c81acc204e50b1dc7c0dcb596239d233fc414fb19ddf85bb677b1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 784,
        "sourceEnd": 819,
        "text": "Is Emma leading the workshop today?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "35a9515a466fd6782a3d87c013ec8c158ae06c941524cfedaf75fed86c297842",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 826,
        "sourceEnd": 886,
        "text": "No. She is visiting another museum today, so I will lead it.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "b383a4a71a33d2e5a9bff1c6982cf98850daed39f5898162b0a40122b9191afd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 892,
        "sourceEnd": 940,
        "text": "You're coordinating and teaching. What can I do?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "feac4ab6c2253e37bf98aaab08c7d973a1a25880e0528adc450da5b77afd7f64",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 947,
        "sourceEnd": 1025,
        "text": "Bring paper and pencils from the office. They are on the desk near the window.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "126c5f38435484b92b8ef51642bc67f1f2b2ba77898f07bc6eafab5c682d6ee5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 1031,
        "sourceEnd": 1068,
        "text": "How many pencils and sheets of paper?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "90b74ade700296b2aa1e79b1d894e263bdebcdbf2c3b4d6f58e234f34b809b76",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "rosa",
        "speaker": "Rosa",
        "sourceStart": 1075,
        "sourceEnd": 1190,
        "text": "Please bring fifteen pencils and forty sheets of paper. Before the children arrive, put the chairs in a semicircle.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "dc570677a12db6d5adde989f95717e6c6af71f0d0b0a0dd62ed9053b5afbef6f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dan",
        "speaker": "Dan",
        "sourceStart": 1196,
        "sourceEnd": 1246,
        "text": "I'll move the tables first, then get the supplies.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "6406978767d9a8db25a12bc8b2506bc8c3ab16e4a11adf2de5a464a4f09a04fd",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
