        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 215,
        "sourceEnd": 236,
        "text": "No, I am from the UK.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "6cf7e27708ed0bf7d4cb53268b41e362d92280cddc266a90e9a93c894c7c4734",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 240,
        "sourceEnd": 266,
        "text": "I am happy. Are you happy?",
        "boundary": "turn",
