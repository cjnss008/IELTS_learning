        "pauseBeforeSeconds": 0
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 50,
        "sourceEnd": 82,
        "text": "Yes, I am Li Ming. You are Anna?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1ae01021fb333f760286b1467d631fbe18ee721228e52f3595ef3c4c7bb81049",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 89,
        "sourceEnd": 143,
        "text": "Yes, I am Anna. I am a student. You are a student too?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fd48c44d5c421b1b518698ce348597cfafa3aa15cd55c42bff131ef1ccd254c9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 153,
        "sourceEnd": 214,
        "text": "Yes, I am a student. I am in Class Two. Are you in Class Two?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "61c9d4759c77370f5dd3ec2cd033e32a234970ad5b4249832e72d4501a861296",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 221,
        "sourceEnd": 294,
        "text": "No, I am not. I am in Class One. You are in Class Two. I am in Class One.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f97bece35b3c24a0f15ae5cacd6393e1aa7729b5691e95dec9be5ec5e18dc0db",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 304,
        "sourceEnd": 322,
        "text": "OK. Goodbye, Anna.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c83cb76963e87e69653ff1825b7fe6d6f83397752413d0623a10991c5276f202",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 329,
        "sourceEnd": 346,
        "text": "Goodbye, Li Ming.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
