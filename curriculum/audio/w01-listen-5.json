        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 6,
        "sourceEnd": 42,
        "text": "Hello. I am Anna. Are you a student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "224414fecae0e1c6bd0e73e0e344aebe63743c2d76814ed76c08e587b4c9a90b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 51,
        "sourceEnd": 97,
        "text": "Yes, I am. I am Li Wei. Are you a student too?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5bff5a939a30e25d82d3fca47f356b68672851aaec2674317625b9ef9d1464a4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 104,
        "sourceEnd": 151,
        "text": "No, I am not. I am a teacher. I am from London.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "55e9f624d9c30d223c7f9d0bac6f55342a2cf81193f1c3ce430bad22762f29b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 160,
        "sourceEnd": 199,
        "text": "I am from Shanghai. Are you from China?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1fc65a8a7ef7eadee22e6dfb41efefe7b5afc36733b633a6ff00ea8da046d5c8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 206,
        "sourceEnd": 258,
        "text": "No, I am not. I am from England. You are from China.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82aed0a787efda7c3bd8fc4b2333b3cc8268ca18179fed73e1ae48457f6a932e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 267,
        "sourceEnd": 315,
        "text": "Yes. You are a teacher. I am a student. Goodbye!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e1f343ad80c858a37f501437aa3764e433da4a379c9f3f5b70c6c9036a530549",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 322,
        "sourceEnd": 330,
        "text": "Goodbye!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
