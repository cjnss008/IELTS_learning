        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 48,
        "text": "Ben, this is my neighbor. She is a teacher.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1790fe7519c13fab98e9e6235b12e9c9ea4f0f10ffb39831c9bbb827301e789a",
