      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 54,
        "sourceEnd": 79,
        "text": "Hello. I am Ben: B, E, N.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "21e11f75954eebbd1744e03558eacc4840d1fc9924351f100b854154a942a461",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 85,
        "sourceEnd": 111,
        "text": "This is a pen. It is blue.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "17d7d06f743899b0f5b8be880191c19dbf18825c3a59c86448af5f20451d5121",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 117,
        "sourceEnd": 131,
        "text": "Is that a dog?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "64933bfc1268de6cdfb748c00ff26c9b8f1ca13b320b8e6e908e37ed3d27393c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 137,
        "sourceEnd": 169,
        "text": "No. That is a cat. It is my cat.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "30591e5d48894f647fa5d5b308ad72ce1c0db619819f108d790723a098dfe0e7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 175,
        "sourceEnd": 185,
        "text": "Is it big?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "15a0ff3de58be6dc5c5c8806f4a74746c09ffd04ea1af9550b42df1e15f641bd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 191,
        "sourceEnd": 241,
        "text": "No, it is a small cat. This is a table. It is old.",
