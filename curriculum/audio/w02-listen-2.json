      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 7,
        "sourceEnd": 31,
        "text": "Hello. Is this your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b62bfd23f63af6db1d790d6181455befd6f23c789492228661a12a7344c34ceb",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 37,
        "sourceEnd": 68,
        "text": "No, it is not. It is a red bag.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d33520ce11b752301cc149f5dc3a7091940f4b7c823426b2d533152e0fbf9e1c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 76,
        "sourceEnd": 93,
        "text": "Is that your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e757e9291c3ceda411196120dc90d1bf447b9c5639fff43d90a2cecb6e8a2560",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 99,
        "sourceEnd": 128,
        "text": "Yes, it is. It is a blue bag.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c1875f7d212ae82dd05bc10fdc045da4e0f855544edb2afc213460376996499d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 136,
        "sourceEnd": 156,
        "text": "Is she your teacher?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "304724221e42e544c5e6345592608b7b3d2bdd90c394f5e06f4b5f5139118448",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 162,
        "sourceEnd": 194,
        "text": "Yes, she is. Her name is Ms. Li.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "69a2adb221ef2836f71444c77509f52d25bfc16c60de2a13aa3c02e07503c628",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 202,
        "sourceEnd": 221,
        "text": "Is he your teacher?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a8db1acec810cc441b3024629da872d29a614fff7e842213344f3c00f646ed10",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 227,
        "sourceEnd": 257,
        "text": "No, he is not. He is a doctor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5d8111e6b925a2a1837e5db2964f7bc46cf78386503506c66fd8b848aef3a97c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 265,
        "sourceEnd": 277,
        "text": "Is it a pen?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "745c4ae685a26b6bd2b5250c9ee6235e49a618f8745d56eeb6b19dcefd3473e6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 283,
        "sourceEnd": 311,
        "text": "No, it is not. It is a book.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1215d5990616272430a8fe3a0d113002c3267d8b9112302c015e58b57295591e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 319,
        "sourceEnd": 336,
        "text": "Is this a school?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3679868cb1d465023ed85ee3b76544d5544e6dea7cf412fe954c6753a7bebdb8",
