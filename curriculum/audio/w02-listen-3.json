        "textHash": "93cb8c4d0d8f01e113bb8d96b18aa234bec4e8bfa14dd291e09085677cf8e81c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sam",
        "speaker": "Sam",
        "sourceStart": 91,
        "sourceEnd": 108,
        "text": "Is that your bag?",
