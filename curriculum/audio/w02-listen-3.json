      },
      {
        "role": "sam",
        "speaker": "Sam",
        "sourceStart": 43,
        "sourceEnd": 60,
        "text": "Is this your bag?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c5e4a06cce438583ba1229be2c51ff906123b8862effc38dcc59acb4b302e3db",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jo",
        "speaker": "Jo",
        "sourceStart": 65,
        "sourceEnd": 85,
        "text": "No. My bag is small.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "93cb8c4d0d8f01e113bb8d96b18aa234bec4e8bfa14dd291e09085677cf8e81c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sam",
        "speaker": "Sam",
        "sourceStart": 91,
        "sourceEnd": 108,
        "text": "Is that your bag?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e757e9291c3ceda411196120dc90d1bf447b9c5639fff43d90a2cecb6e8a2560",
