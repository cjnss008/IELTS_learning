    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 44,
        "text": "Hello. This is the lost and found office.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3b75d8f9ef89e8ad3ae0cfe77c503639c58459c00e0e6518d14f2ac7ac22873a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 48,
        "sourceEnd": 66,
        "text": "Hi. I lost my bag.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "6e95c5a0bfd1df3b0a79c4c1d4085db53f8976b1df8603995123d407fd63e92d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 70,
        "sourceEnd": 86,
        "text": "Is it a big bag?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "709d94de0d87807100bdd677688472b0fe0869a124e62964dc7fe51bc74968fb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 90,
        "sourceEnd": 124,
        "text": "No, it is small. It is a blue bag.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c894f5ac91cf7f3e065f09099bf10ba02ad6b474a167862a6edc35fee50c6a3a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 128,
        "sourceEnd": 145,
        "text": "Is this your bag?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c5e4a06cce438583ba1229be2c51ff906123b8862effc38dcc59acb4b302e3db",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 149,
        "sourceEnd": 187,
        "text": "No, that is a red bag. My bag is blue.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "52af053d0965be6be63df884cf81f0ee6953fcf10d4a288c297df5f6b04bd9ae",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 191,
        "sourceEnd": 208,
        "text": "Is that your bag?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e757e9291c3ceda411196120dc90d1bf447b9c5639fff43d90a2cecb6e8a2560",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 212,
        "sourceEnd": 241,
        "text": "Yes! It is my bag. Thank you.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2b751e6d480adf69d9819b7ba58db5eeaad92fd9eeb848c00db93b1800786754",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 245,
        "sourceEnd": 264,
        "text": "Is this your phone?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bb378603dc3e4ffe2eea54926a030454b9b09030849ad5e91beb559e5bc7a118",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 268,
        "sourceEnd": 314,
        "text": "No, it is not my phone. My phone is in my bag.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0358b0c8049e5ce944dc0405fadb9c372b6fad0a6e6d448d382c261c815d7df5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 318,
        "sourceEnd": 339,
        "text": "OK. Here is your bag.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9cb57e2008d7ccf4402d0a652761a0b9479b4dae0b6ad39a0dca058d67cf1231",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 343,
        "sourceEnd": 359,
        "text": "Thanks. Goodbye.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "53804c28957e564aff85a7506ac8531c8e1628eeb76b6b3a8beea854f5697334",
        "pauseBeforeSeconds": 0.65
      }
    ]
