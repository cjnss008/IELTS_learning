    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 30,
        "text": "Excuse me. Is this a phone?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f4ca5b2ff763ffc6295c7eeb3dc40c0a8da948843083d1b847bae8cf243cf286",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 34,
        "sourceEnd": 62,
        "text": "No, it isn't. It is a watch.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a1078e5f2bad15db3183395e1d329683718494aa557e1c6df6aba4c2681429ee",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 66,
        "sourceEnd": 86,
        "text": "Oh. Is that a phone?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "5a0b6ac2f26175a1c58eae36119e5325637f6fb1509ac12aedeadb31c50fc99a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 90,
        "sourceEnd": 101,
        "text": "Yes, it is.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "815644d15cc8014f28708224e43fb5f9135f1f75076e3773e7dcf35367d92ef6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 105,
        "sourceEnd": 124,
        "text": "Is this your watch?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "b48bc6ba37af72595ae4ca52f2e541ed241d4eb49a020ffca5192e72d852f701",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 128,
        "sourceEnd": 151,
        "text": "No, it is not my watch.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3348e9f5991b2d55a2b9260b6979ed5d2f5c861b4e6671013ab13d60864f23d3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 155,
        "sourceEnd": 174,
        "text": "Is she your friend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "918f9ba11e6c62d393f4b9f2501bab5b5edf5c291bf2e1cf94c097194c9f1e98",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 178,
        "sourceEnd": 208,
        "text": "Yes, she is. She is a teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0697346220518a8addaa0e5b0f9585bba5295c008297a742f266559551d007bf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 212,
        "sourceEnd": 228,
        "text": "Is he a teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "895db970cf59aac6ea5b6075a5c4ce5c2ae13f1ccf1d965b1a9fc6d694ca8a63",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 232,
        "sourceEnd": 252,
        "text": "No, he is a student.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f22b8672ce09ae98160c9d2d3ecb75ad9dd893f1ec0324e3e35ed06826901f55",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 256,
        "sourceEnd": 275,
        "text": "Is it a big school?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3a261ffa9128c7ff089aacb373e84bf7df9707ed3e40aa51e36cd1ea89480d86",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
