        "speaker": "Ms. Li",
        "sourceStart": 70,
        "sourceEnd": 109,
        "text": "Hi, Ben. This is a book. It is for you.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a439e5f681b53f9d89538122a98a430a24e25329ed7c48d10326587b0efbdeca",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 115,
        "sourceEnd": 125,
        "text": "Thank you.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "8569efc4ed5a6273140c2b6ec0ab8d99f4398210808fbb7c0cbbae4fbcc21350",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ms li",
        "speaker": "Ms. Li",
        "sourceStart": 134,
        "sourceEnd": 161,
        "text": "That is a dog. It is small.",
        "boundary": "turn",
