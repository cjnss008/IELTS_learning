        "speaker": "Ms. Li",
        "sourceStart": 258,
        "sourceEnd": 269,
        "text": "Yes, it is.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "815644d15cc8014f28708224e43fb5f9135f1f75076e3773e7dcf35367d92ef6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 276,
        "sourceEnd": 293,
        "text": "Is Ben a teacher?",
