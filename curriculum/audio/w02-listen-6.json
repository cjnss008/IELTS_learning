        "speaker": "Ben",
        "sourceStart": 47,
        "sourceEnd": 61,
        "text": "Hello, Ms. Li.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "b13be193d4269be6a69615b64848d93077b0898084a6eceb90efdefdc6ceee17",
        "pauseBeforeSeconds": 0.65
      },
      {
