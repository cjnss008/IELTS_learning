        "textHash": "7d2dc85c38207d90c18b5263e99485300d3bb425b2475d7e3ce1a82775763ea3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 168,
        "sourceEnd": 185,
        "text": "Is that your dog?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7eef2b87755a515b2f797e3d282434a6e8d13f3fbcef8a765eed7218aeedc610",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ms li",
        "speaker": "Ms. Li",
        "sourceStart": 194,
        "sourceEnd": 225,
        "text": "No, it is not. It is Tom's dog.",
