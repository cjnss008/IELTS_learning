        "voice": "en-US-AriaNeural",
        "textHash": "04905f6d1092f39dc882e17c9cfde400f7b7208583a194e23ac9f67532178556",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 231,
        "sourceEnd": 249,
        "text": "Is this your book?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "587c73b1c6e548453138a35f9ae8fd6c0cef23403a8ce5dcc8c2aeac78c5cc4b",
        "pauseBeforeSeconds": 0.65
      },
      {
