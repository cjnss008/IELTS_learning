    "segments": [
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 5,
        "sourceEnd": 66,
        "text": "Hi, Lucy. This is my family photo. We are in the living room.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "34f57b4b345ca1fb28baa372a4fc54220f794ad470969f866b00b6ae13f00696",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 73,
        "sourceEnd": 103,
        "text": "Wow, nice photo. Who are they?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ab27867750e20073c6b3ef5504f5c329a0bcee54048d73df631eeff6df96ef99",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 109,
        "sourceEnd": 175,
        "text": "They are my parents. My father is a teacher. My mother is a nurse.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "47003e6f0c83606368019dac502db8a565d26c500786b3e0620e94759c5ba1de",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 182,
        "sourceEnd": 202,
        "text": "And who is this boy?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4096043659df022d92edaadd73cfbc654a25616c8efc47491814233cc49f2849",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 208,
        "sourceEnd": 259,
        "text": "He is my brother. His name is Ben. He has two dogs.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "92a331b832a402689c73ebe0ce011f6503d6aff5821e89e178e6ef09b4239c2e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 266,
        "sourceEnd": 297,
        "text": "Two dogs? What are their names?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "115b128ceb0f9cf388c7cc162d2f5d634a487aa2f59ff3cc513daa9f7ea1959e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 303,
        "sourceEnd": 358,
        "text": "Their names are Max and Milo. They are small and brown.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "0cac8db8ae33abebf3a77e459b21d29f70c35d8bd866fbefd43d5310286c86d6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 365,
        "sourceEnd": 383,
        "text": "Do you have a pet?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "b90c21ad2be467eeaecb32433ed956326427415a9671da8d59faf12ce3fdaa33",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 389,
        "sourceEnd": 444,
        "text": "No, I don't. But my sister has a cat. Her cat is white.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "83fee54f4247c95f3976137aac87a3a7a5cf29e9e49c4e6bd83def5866773149",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 451,
        "sourceEnd": 478,
        "text": "What is your sister's name?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e18b1ee4291c8f88a9c0c497f4864873dc303989b703dd143471cd04f02aadf4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 484,
        "sourceEnd": 537,
        "text": "Her name is Anna. She has a big bag. My bag is small.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6d81f9992f35ae0e180e11c0431eb7fb045588ddd4009267456c92d5f84cf977",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lucy",
        "speaker": "Lucy",
        "sourceStart": 544,
        "sourceEnd": 571,
        "text": "I see. Your family is nice.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0253e915cf2c6488556833e81945af8845b1e3ee6fd09259e59c00c3156592c5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 577,
        "sourceEnd": 601,
        "text": "Thank you. We are happy.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4aadaeea1a9b6ecbcfd5a5c83e8ec271804f6b03af6dfe8a647823c4ae4219b7",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
