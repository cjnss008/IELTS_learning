    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 58,
        "text": "Hi, this is my family photo. We are in the living room.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f1fe224bcb8ea19d59f49fb55a13a0147925cd1a3e2b99951e74fff39834a622",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 62,
        "sourceEnd": 86,
        "text": "Wow, nice. Who are they?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "96607707a3017bf3edfb163cd11b4155b6140a77cb759a5e66e2367a23a812d2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 90,
        "sourceEnd": 172,
        "text": "This is my mother. She has two sisters. And this is my father. He has one brother.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7c1e34fdad1021153328d26474ad2b4ae5a8f291c535bfe5d370c839af7b6b6e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 176,
        "sourceEnd": 212,
        "text": "So you have two aunts and one uncle?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3299d9ba0cdf82e2a0706feb5bf04c1af4f4b80499c0bc8da71b2ef858c7e2c5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 216,
        "sourceEnd": 270,
        "text": "Yes. My uncle has three children. My aunt has one son.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7463592f6d87c786452077abae6d8080666fbaef8ec554737fbc110938b972d5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 274,
        "sourceEnd": 296,
        "text": "Are they your cousins?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "5f5b261bda6f306a7f499805fe52bcaf4c35c0a705b51f5bf03a8171dae06b9e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 300,
        "sourceEnd": 336,
        "text": "Yes, they are. We have four cousins.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a22b0c8aabb7cd0f71d55d24ab5fd1c65fbd9056f9570530b105136530c95b04",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 340,
        "sourceEnd": 362,
        "text": "And your grandparents?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a8f4903086d3c17ad9b304bada3cc7744131afe9568863237cfe4f582db08ed0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 366,
        "sourceEnd": 410,
        "text": "They are not in the photo. They are at home.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6d2dadc5058e7477aa7cab351319d55de69f7a4adbe3d7167e3b74e76f630a65",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 414,
        "sourceEnd": 440,
        "text": "I see. Your family is big.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "5692b6df5f9877e823020da489b84c0b149201f131e31d7cb4092a1ef64c586c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 444,
        "sourceEnd": 483,
        "text": "Yes, we are a big family. We are happy.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "70afdfab9b42054af8d647180da5ad3d40488450b7633bb18c2af85afd08a6b0",
        "pauseBeforeSeconds": 0.65
      }
    ]
