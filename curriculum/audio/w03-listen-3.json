    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 68,
        "text": "Look at this photo. This is my family. We are in the living room.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "ed306e2793d0a5cadce6cdfc1c495ec6cf7618f5d06959ed440e99b6508a6300",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 72,
        "sourceEnd": 96,
        "text": "Nice. Who is that woman?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "14375ef9b04a5fa5ee00ec2ff487bf7b96c970dacd9fe3e982845891da6b7469",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 100,
        "sourceEnd": 138,
        "text": "That is my aunt. She has two children.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "0b6f5485094bd43ef82b2aad41c87ba8353d84c700638be551fa6e7d2e1e9879",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 142,
        "sourceEnd": 159,
        "text": "And who are they?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a468b92da72eb01aa40e3a414565b7aa655c2105ae7fdd543134b3a9f0425640",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 163,
        "sourceEnd": 208,
        "text": "They are my cousins. They are ten and twelve.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "01405f8ba667cd72cfc50cb81adec7236c99873cf2f3d783d45200115bf6cc3c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 212,
        "sourceEnd": 242,
        "text": "Are your parents in the photo?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e983861dba72f61c68bd64dc6c12a43102812eaa7c03d4678a52bbccd3bbf10c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 246,
        "sourceEnd": 346,
        "text": "Yes. My father is here. My mother is there. They have three children: my brother, my sister, and me.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c45985167735e87e8215ce35d9e63784cfee34dfc396df16ae7bf490f08df32f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 350,
        "sourceEnd": 389,
        "text": "So there are six people in your family?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "69aafa32a83b253b2ad785cad6c46d4789739bf11661f710d4801ea9ace65777",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 393,
        "sourceEnd": 509,
        "text": "Yes, six: my parents, my brother, my sister, and me. My grandparents are not in this photo. They are in the kitchen.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7e8ce191c42ef6d389fae6b0033f1b8ea2061d3f478e13481a6467de41d4c91c",
        "pauseBeforeSeconds": 0.65
      }
    ]
