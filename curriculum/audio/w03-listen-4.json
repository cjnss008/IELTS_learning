    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 42,
        "text": "Hi, Lisa. Are these your family photos?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "efdcd8a586df8d464105255b726350928a097609da0af01e806ed7f9a8b63aa3",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 46,
        "sourceEnd": 99,
        "text": "Yes, they are. This is my family. We are five people.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8d2aa4d0b246254784dfa57e6c4eb00fed39acfa613b7e94231f2ddc2a7f475f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 103,
        "sourceEnd": 122,
        "text": "Five? Who are they?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b9bf172e4267b98bb9677e10668fb9d7c208dba78ecd8896ef948a2bdc2c28b2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 126,
        "sourceEnd": 178,
        "text": "My mother, my father, my brother, my sister, and me.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e80a270e66739d910cbf3b55212866e13c9d52b454609b38bd3857d4f9c68d17",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 182,
        "sourceEnd": 203,
        "text": "Is this your brother?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bb02f5d06a2043c0db3480576ecafa3b96e687ee451eea3083f7432b0862b917",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 207,
        "sourceEnd": 268,
        "text": "No, that's my cousin. My brother is ten. My cousin is twelve.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a7132039d4fdf010b2baef90686c5d22be529dd9e8c2a1ca8d817febd49d8180",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 272,
        "sourceEnd": 304,
        "text": "And your sister? How old is she?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a69870a427a2c59ac9a3425290c9476540a229566cd132effb26f1b2ddfc1c8b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 308,
        "sourceEnd": 339,
        "text": "She is eight. She has two cats.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b4a65b55ba8237d39e9bb42457dad6a0c01dddff89d3e3241b20847f967b5b5c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 343,
        "sourceEnd": 374,
        "text": "Two cats? What are their names?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f0815925813cafcad5ab1cb6b5b0f4459d1d1d02a20416dc5b11e1580dcfe7ff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 378,
        "sourceEnd": 408,
        "text": "Their names are Mimi and Coco.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0fdd4a7004d1b861a1632010bd34bd3800ec33205a71bb7e924b963dbbe83538",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 412,
        "sourceEnd": 430,
        "text": "Do you have a pet?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b90c21ad2be467eeaecb32433ed956326427415a9671da8d59faf12ce3fdaa33",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 434,
        "sourceEnd": 488,
        "text": "No, I don't. But my brother has a dog. His dog is big.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ef0a52fbdb78b0c743f04f01cb6da60b9c66f58bcbdd37da926d6e4d54622b4a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 492,
        "sourceEnd": 518,
        "text": "Are your parents teachers?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8912a02e8a9957704cc57fe3ba0f7607523ef2c410bee59d1779d157956af36f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 522,
        "sourceEnd": 568,
        "text": "My mother is a teacher. My father is a doctor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8f556c8b9ee6ac3904f35c3025783f09f52e6178be95da733b598801f9ce9cbf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 572,
        "sourceEnd": 585,
        "text": "Thanks, Lisa.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e0d12dac96eb595c1308ea5f35847c2b0ca1adebc819240865518d3b5711d582",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 589,
        "sourceEnd": 604,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
