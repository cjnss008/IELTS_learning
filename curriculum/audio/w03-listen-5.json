    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 44,
        "text": "Hi, Lily. Is this a photo of your family?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4006b6c853e3258ca74100dcdc6a180b788456058f811013e561ab965f622169",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 48,
        "sourceEnd": 134,
        "text": "Yes, it is. Look, these are my parents. My mother is a teacher. My father is a doctor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4996876205d677b9fd8adf9fd0f5f38db3b4fd90e1a0cb934de0522509e563d6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 138,
        "sourceEnd": 178,
        "text": "And who is this boy? Is he your brother?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "47cb0a41e7c530e6bb144f8fa9dd071405cb5fe3eab6e133ef173fbc9fe4f4db",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 182,
        "sourceEnd": 231,
        "text": "Yes, he is. His name is Tom. He is ten years old.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "757ae8058ac303ea40a4204c6b171b4acafc19cfc3a007ea7b20ed5542fc3b16",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 235,
        "sourceEnd": 279,
        "text": "You have a big family. Do you have a sister?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "808d43c64dc4c8548847be29cbde56af5d4513d0ebb458bd682f7edbac32a957",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 283,
        "sourceEnd": 348,
        "text": "No, I don't. But we have two dogs. Their names are Coco and Lulu.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "24aca383529d0ac5137739c48977600c8e70c699a776441d87b1d897c62376dc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 352,
        "sourceEnd": 375,
        "text": "Two dogs! Are they big?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d14c3dc89b41407cb2e2e0d94b98d73ebfccc0613a83737e485b91b7f5a66694",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 379,
        "sourceEnd": 444,
        "text": "No, they aren't. They are small. Coco is white and Lulu is brown.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ec0799fba19074a76ee2ba2a4a1cc9ce0a10483e4101ffc93b0e2223c292f9c8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 448,
        "sourceEnd": 500,
        "text": "I see. And your grandparents? Are they in the photo?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a44078efaa1febb6c29dfc77f04b652b138dfbdc0f9aa6b96bfd807dba9fded7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 504,
        "sourceEnd": 568,
        "text": "No, they aren't. They are in Shanghai. We visit them every year.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5cefd2323c48020f0ad97c437339622699e0cac2cd45c0962ccc430aafbadbe0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 572,
        "sourceEnd": 594,
        "text": "Nice. Thank you, Lily.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f71d8a9fdc941cd52cf58e165a2861b9a1e9a573f1d0191b941fa5277f99278e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 598,
        "sourceEnd": 613,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
      }
    ]
