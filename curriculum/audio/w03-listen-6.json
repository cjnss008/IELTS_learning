    "segments": [
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 5,
        "sourceEnd": 44,
        "text": "Hi, Lily. Are these your family photos?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6aaeb4505096a1899cf75a57b8bf1a982308deba466f13e880bcffce288c1c08",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 51,
        "sourceEnd": 106,
        "text": "Yes, they are. This is my mother and this is my father.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "383954051f4fea06b27b566e1081b5add53d352ea96212b8e33d8c11bbae9e50",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 112,
        "sourceEnd": 148,
        "text": "And who is this? Is she your sister?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1b6298d5293e6c1e165b0117507c66851d42dfe5505ea78d29faf0e0ea764a95",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 155,
        "sourceEnd": 214,
        "text": "No, she is not my sister. She is my aunt. Her name is Anna.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "5dd6b0b79a78d7ba8df3cdaf6368b273e67f48611900efc97fb87e016be60f04",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 220,
        "sourceEnd": 243,
        "text": "Does she have children?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9b1c808912fa326497839b8ba4356e0301cb3bce695cd199e2ea1bb6eb4653a0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 250,
        "sourceEnd": 276,
        "text": "Yes, she has two children.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "bd246bdee8280e1ab58022eddf94a618c234c909c347908d487498b93683b8ad",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 282,
        "sourceEnd": 325,
        "text": "And these two boys? Are they your brothers?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f99ac2b6707927e09e1ceaa30ccb54c44cfcd110c0cf6e3058ced3e51e5b5787",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 332,
        "sourceEnd": 382,
        "text": "No, they are not my brothers. They are my cousins.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ddc2b756c0599350fc9461c3c4b814fc73e9f4a29d46c5f2fd31491d120938d1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 388,
        "sourceEnd": 420,
        "text": "Do you have brothers or sisters?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "14be197d6316c33c286f67915462ba1bb5c9a986dacc7f58b39dfac12c0a97f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 427,
        "sourceEnd": 488,
        "text": "I have one brother and two sisters. We are five in my family.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "150d7d3851e5947fa9e3e8d03d8f642152fb10a18f7aa84315246967d320ccbe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 494,
        "sourceEnd": 513,
        "text": "Do they have a car?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1718bfcf99a8421401356e2612c32157db8b994908d5a1e5508495da87ed4e70",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 520,
        "sourceEnd": 570,
        "text": "No, they do not have a car. They have a new table.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "916bf869d9a078df95310940bcb71b7c11c97648ff940eba85e48da452726f13",
        "pauseBeforeSeconds": 0.65
      }
    ]
