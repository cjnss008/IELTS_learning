    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 36,
        "text": "Hello, this is Anna. Are you Tom?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "10ccab0523518c91328e4589c70f4d013582ba72d0d4e6c308470dad4902afb1",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 40,
        "sourceEnd": 86,
        "text": "No, I am not Tom. I am Ben. Tom is my brother.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "22e1e45cdf542665497feeff8651a10e4de6fa6c2cca18110f1658b679cde2b5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 90,
        "sourceEnd": 116,
        "text": "Oh, sorry. Is Tom at home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ffb36ad7185f06e3038a8b4acde81f301d6faf249cfbe2c6af5a10a25da1a39c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 120,
        "sourceEnd": 149,
        "text": "No, he is not. He is at work.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "add28a006a8389621ef31b08d0aa6111d5c5a21c8234989048ffb7a01d6a80b7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 153,
        "sourceEnd": 168,
        "text": "Who is at home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8c30dce5422ff99614906d9b83aa9fcd2442e8ec54b9ac59ae997fd7af2b4107",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 172,
        "sourceEnd": 193,
        "text": "My mother is at home.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8dce668a9baee1bb1c6ff8c673131b0cde6960ffb09a76e00249b35ffcd91251",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 197,
        "sourceEnd": 214,
        "text": "Is she a teacher?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3b41693a1d56c65fc264bd8f22890236e99e9abecfb6a179cbaa296e7cddc201",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 218,
        "sourceEnd": 259,
        "text": "No, she is not a teacher. She is a nurse.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1b067df6cf26684c3c308484022b85a362602a7afcaedb61f9f16e012248ce81",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 263,
        "sourceEnd": 283,
        "text": "What is your father?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a578b31b3eceb5ecd467db1fabd6b841d4647c94a65c9af46d1f01624ac7dce0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 287,
        "sourceEnd": 302,
        "text": "He is a doctor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "41725278f8ca56ae92caef07d3a34c628a51924b76aab86a0bba6a5de6cea1b3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 306,
        "sourceEnd": 324,
        "text": "Are you a student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3cade501ac6adf125081f85d4d8321af26dbb61b6cefa223efd3a5e5626fc2ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 328,
        "sourceEnd": 354,
        "text": "Yes, I am. I am a student.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "854deee5e8788ca11487685648a0802437784d0bcbdba7779314370cc5726903",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 358,
        "sourceEnd": 384,
        "text": "Is your brother a student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cfd0bd1a3781885f50512db49c631bb2b431f3d441358fa0e9963eca04dfc74d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 388,
        "sourceEnd": 419,
        "text": "No, he is not. He is a teacher.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4b19d85009a6f8fad47bd42c9d5978269c1def130ab60a677a3301bfc056beda",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 423,
        "sourceEnd": 438,
        "text": "Thank you, Ben.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cfe290b5842907c675b01a07dd0afb525332b78586e30f0b7b0d3fab993e664a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 442,
        "sourceEnd": 458,
        "text": "You are welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ea50b2f75179dbffe00b263839764dcac996703f18cfe2d9d19f9917f605414a",
        "pauseBeforeSeconds": 0.65
      }
    ]
