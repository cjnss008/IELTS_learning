    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 52,
        "text": "Good morning. Are you the lost and found teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c6503aa26875fec79217cb647692f4cab63a93461026e37b8e0715a3f91d3603",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 56,
        "sourceEnd": 102,
        "text": "Yes, I am. I am Ms. Li. Are you a new student?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fb947853af61325bf6fa8e16463104b306b8259f7c3c1860b9353023aab27498",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 106,
        "sourceEnd": 151,
        "text": "Yes, I am. My name is Tom. I am in Class Two.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "602724d5c20dd9a461b29a85cf6700957d483e087c9005937bf4c0e450f455ee",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 155,
        "sourceEnd": 177,
        "text": "Is this your bag, Tom?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4ba2a183e08099c45806f3410801c8993bcc37800ee1cd1ce3d8113c7cc813f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 181,
        "sourceEnd": 237,
        "text": "No, it is not my bag. My bag is blue. This bag is green.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7f2fa23ca1cf2ee4f286974bae706736b128dc0bd320a724127aa11b8bbfe7b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 241,
        "sourceEnd": 261,
        "text": "Who is in Class One?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "04d6bde5518020f75b420d78c23f31769ad4addb1ea472e5850f00ebd5f28f5d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 265,
        "sourceEnd": 298,
        "text": "Amy is in Class One. Is she here?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "84852dccc8127f0d1929022a0b2f97e3c9bfb97dd6b976c2ccff71a649fb6088",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 302,
        "sourceEnd": 345,
        "text": "No, she is not here. She is in the library.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "451877b6eefdcc785d1e90613244b1ebf35834229485a0055330741a7fd310d9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 349,
        "sourceEnd": 379,
        "text": "Is my blue bag in the library?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3ace3e314eedbc0b3921488602ca07e95c57a85e9294860931c3a37aaa48d143",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 383,
        "sourceEnd": 437,
        "text": "No, it is not. Your bag is here. It is under the desk.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "bc8d283691a21d2691838555d05bbaaa7651cf834bf4c558cbacaf243e79a3b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 441,
        "sourceEnd": 467,
        "text": "Oh yes! Thank you, Ms. Li.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "5fd71c4e6bd65cc2a823a994fa8c03db9a71fd958549a69854aa371a33ae6374",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 471,
        "sourceEnd": 506,
        "text": "You are welcome. Are you happy now?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "9ec2bd62efbcaa329983a3eda186b656f8473deeb5beb89a958ee9a9e6f22f84",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 510,
        "sourceEnd": 531,
        "text": "Yes, I am very happy.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e2b4853083b4c6d075dfb1cfc1d85817f7d464256834670d1b765d2f8b4d8f0f",
        "pauseBeforeSeconds": 0.65
      }
    ]
