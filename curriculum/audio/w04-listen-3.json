    "segments": [
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 6,
        "sourceEnd": 42,
        "text": "Hi, Li Ming. Is this your classroom?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "855b11b1fa2fe2365755599dc0f1376dce33cc8dbfde9da4f8eab30c44a13f40",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 52,
        "sourceEnd": 63,
        "text": "Yes, it is.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "815644d15cc8014f28708224e43fb5f9135f1f75076e3773e7dcf35367d92ef6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 70,
        "sourceEnd": 90,
        "text": "Who is your teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "22135ea18069b10c87e17e3a955a915bf34b11aa9ea053777919a4edb3419914",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 100,
        "sourceEnd": 123,
        "text": "Mr. Wang is my teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f30e747894692d5b3653bc1de35d1ec937a285bf843d501447b3a8f29ad01290",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 130,
        "sourceEnd": 154,
        "text": "Is he a Chinese teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "ce250b5f1571f4b88166910e7e365f90d98a9cbeae4de16c95e782b30e89479c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 164,
        "sourceEnd": 204,
        "text": "No, he is not. He is an English teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "14c69bb8380638fa550d92ebe8a2645198257c8b162fb20d2abff5a1a780ebb1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 211,
        "sourceEnd": 229,
        "text": "Who is that woman?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "741abffecb04bc21596540fd2d43c7b7359722199f7e4236ae32f808e652c637",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 239,
        "sourceEnd": 276,
        "text": "She is Ms. Li. She is a math teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0a3a3122a1420b763789a7ca4431708a820405ae45057b3d3ce40e10785fe931",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 283,
        "sourceEnd": 303,
        "text": "Is she your teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "304724221e42e544c5e6345592608b7b3d2bdd90c394f5e06f4b5f5139118448",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 313,
        "sourceEnd": 351,
        "text": "No, she is not. She is not my teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "86087c8ace218a247c821d9dad2ba8def0e6dbcceed8e7004442e59cceb8480f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 358,
        "sourceEnd": 376,
        "text": "Are you a student?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3cade501ac6adf125081f85d4d8321af26dbb61b6cefa223efd3a5e5626fc2ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 386,
        "sourceEnd": 396,
        "text": "Yes, I am.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "cc07850c5e9229139005fd230419a5d512fb253e67cf4cfd4d58100b9d016a20",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 403,
        "sourceEnd": 428,
        "text": "Is your friend a student?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "476f693835dd0488641f89e2217e610825352bd7069bb6c6b7450b38d54f842d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 438,
        "sourceEnd": 466,
        "text": "Yes, he is. His name is Tom.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "62f3d0e83ff4f8765d691886fbb0d8fc37a96a4de2ff19954ccef306ced94aa8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "anna",
        "speaker": "Anna",
        "sourceStart": 473,
        "sourceEnd": 490,
        "text": "Is Tom a teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "28864fee258ff62f4ea32bbaa3b83998f15bf739dd3ff9cb38c058413985c81b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li ming",
        "speaker": "Li Ming",
        "sourceStart": 500,
        "sourceEnd": 531,
        "text": "No, he is not. He is a student.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "89c1a3d049a31d472940a4ae4fe6eebb5ff6f40adcc36cd68b80e90d155615e3",
        "pauseBeforeSeconds": 0.65
      }
    ]
