    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 40,
        "text": "Good morning. Are you a student here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c414decda4a909fd8352b40f1d08251395f8e2b6d8c04b9d7cc89bbc3404a160",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 44,
        "sourceEnd": 94,
        "text": "No, I am not. I am a new teacher. My name is Chen.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9a7115175d24d56bf67fe2a31457350608cfaf68822a00a86001053a0b417136",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 98,
        "sourceEnd": 161,
        "text": "Oh, welcome! I am Li. I am a librarian. Is this your first day?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6f11edca0100cda63ef228716b3fa0b09d7f7f900afe5ba1f145e0eb942e7032",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 165,
        "sourceEnd": 225,
        "text": "Yes, it is. But I am not ready. Where is the teachers' room?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "da03966fadcda48dfd584affd6377894707e673df6e9def7017c40596587c33a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 229,
        "sourceEnd": 273,
        "text": "It is on the second floor. Is that your bag?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "723e0fe9ffc8989b76db32a13986dcf6df12c7af2a13ef8753a0383171166e6f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 277,
        "sourceEnd": 333,
        "text": "No, it is not my bag. My bag is blue. This bag is black.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fe0806454e464222ff492bf10707323c1789375f02593bdb40e94916da43b1a7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 337,
        "sourceEnd": 363,
        "text": "Who is the man over there?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "25dd9d410d105cf94532df1cc6f4526f72d09e75d01265213d39865e40aafe56",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 367,
        "sourceEnd": 417,
        "text": "He is Mr. Wang. He is not a teacher. He is a cook.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2188a97aa574d717ebac17b8bfef93ca6c688b8b636c5b28500673c0a83c29fc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 421,
        "sourceEnd": 436,
        "text": "Is he busy now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b1405e8caf8d0bcd1d1d04e0e2ede91722e6cf0482968033ae5e6e3b465d5624",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 440,
        "sourceEnd": 479,
        "text": "No, he is not. He is free. He is happy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "cb683f0b0750f9bd406646637824a1dd83e09fb6b1e6586dcdd1a4942282fb99",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 483,
        "sourceEnd": 503,
        "text": "Are you free at ten?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5131d6c67cb577eb5bec6906d2a08f06a0d872e49eed4dd9eb636521004c3fd1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 507,
        "sourceEnd": 546,
        "text": "Yes, I am. I am free at ten. Thank you!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0490a4bf820787404f189f35a5f448889626c3a7d26c72c3ab644a4c90cb9b30",
        "pauseBeforeSeconds": 0.65
      }
    ]
