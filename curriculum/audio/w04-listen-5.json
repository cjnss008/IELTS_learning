    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 36,
        "text": "Hello, this is Anna. Are you Ben?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "686ce531af33d6cbb919f46e315a80356d2c1447f0bbde6998534f2e7eecd289",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 40,
        "sourceEnd": 86,
        "text": "No, I am not Ben. I am Tom. Ben is my brother.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "b52400c1a7746a6425c53b34b08b8ab4fe86fc12d0c9140482e3737a60702569",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 90,
        "sourceEnd": 116,
        "text": "Oh, sorry. Is Ben at home?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "be3ca97f66ec39d4c02b860a5708fb8a6b3b7ab748b02150cfb979d852e904bc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 120,
        "sourceEnd": 149,
        "text": "No, he is not. He is at work.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "add28a006a8389621ef31b08d0aa6111d5c5a21c8234989048ffb7a01d6a80b7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 153,
        "sourceEnd": 176,
        "text": "Is your sister at home?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "46233fc4c92a201ea10190ed00ea5a58f4ba3085227a58dc6790fe5c9f806b78",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 180,
        "sourceEnd": 215,
        "text": "Yes, she is. She is in the kitchen.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "6e46835c7d400ea4e8ab4debe059fa46e1d58fe1d0a4d6f826749f47cb557565",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 219,
        "sourceEnd": 236,
        "text": "What is her name?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "666ce7f2766fea14790bf89aaccb9466f620678d14c7aaaab104b3368da3baac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 240,
        "sourceEnd": 257,
        "text": "Her name is Lily.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "45ea676b8e43715f911a305c37959d9e7378c0bdb3058e041e3f985d3134cfbc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 261,
        "sourceEnd": 279,
        "text": "Is Lily a teacher?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "39c415998150579dfd4cf75adb29bb690f86ead8eed269ecf7cec14fee23beec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 283,
        "sourceEnd": 326,
        "text": "No, she is not a teacher. She is a student.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e9f0effa214ebcaa75a54ff43060038cf5664ef397f33c85759ae000e99ab77e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 330,
        "sourceEnd": 356,
        "text": "Who is in the living room?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "28288a22325d4d802c8c4d5cf0b059a565c79d661e775be7bef7c15f25e68714",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 360,
        "sourceEnd": 392,
        "text": "My mother is in the living room.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ad7ca50197b1a66b19d1438926945334d72518ee206d83870c9575630a3b6767",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 396,
        "sourceEnd": 420,
        "text": "Is your mother a doctor?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "8ea2385c5b248cc3390acfacb21471f54d59147509997eb1b329acc06caeaf23",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 424,
        "sourceEnd": 464,
        "text": "No, she is not a doctor. She is a nurse.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a55f1587cc848567c70785f33062388f208cc45d826508f5559d3f40b73e2144",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 468,
        "sourceEnd": 487,
        "text": "Thank you. Goodbye.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a1fcd448d33c642eb5043b8518df6fe3e3bd4c5d2d1ca21904635a7b2ec209b4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 491,
        "sourceEnd": 499,
        "text": "Goodbye.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2b687db6298b629d3bcb482f16aa774a55eb5ae768407b8fba9982387b6c6f81",
        "pauseBeforeSeconds": 0.65
      }
    ]
