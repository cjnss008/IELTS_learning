    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 36,
        "text": "Hello, this is Anna. Is this Ben?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c6b273cb0a6a7f8a4a918afef49638d9e1effa699517f95eef1f3d0f709ead67",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 40,
        "sourceEnd": 61,
        "text": "Yes, it is. Hi, Anna.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b918611daa38acf6379e82f0bdf4128f7c2d518cd75725e88801e15c30361772",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 65,
        "sourceEnd": 90,
        "text": "Are you free on Saturday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4a67b4148f9cfc2a0a12c5b7e52a08f90d5c0db89c98a7a3f54f6ef943f05485",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 94,
        "sourceEnd": 118,
        "text": "No, I am not. I am busy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "385ce741b205e371efd8a88295233734050bf384dadebcd4f5eba72826147403",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 122,
        "sourceEnd": 142,
        "text": "Is your sister free?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "55bbc57bd81e615bf995e76db1dce61cc4c8a611b9adb1df24b58e307840f887",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 146,
        "sourceEnd": 177,
        "text": "No, she is not. She is at work.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8d91fa31fae22b09e8432119977d467f1ba27d8e9395fc6264eb53442eda2aa8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 181,
        "sourceEnd": 196,
        "text": "Who is at home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8c30dce5422ff99614906d9b83aa9fcd2442e8ec54b9ac59ae997fd7af2b4107",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 200,
        "sourceEnd": 221,
        "text": "My mother is at home.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8dce668a9baee1bb1c6ff8c673131b0cde6960ffb09a76e00249b35ffcd91251",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 225,
        "sourceEnd": 250,
        "text": "Is your mother a teacher?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8a6c5e8a09c2f1ab51cfc64afe7a14c0ae3ff86b663527cbc7241d04e43e31af",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 254,
        "sourceEnd": 285,
        "text": "No, she is not. She is a nurse.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6800deb2df066c0963b9b299cb2b59d2c0427968652a899a499ed3cec6dea9ee",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 289,
        "sourceEnd": 306,
        "text": "What is your job?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "118235a23c89090ce0407b7361fe8b21a232d6832f3932bb5a941a106360b466",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 310,
        "sourceEnd": 325,
        "text": "I am a student.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0c00f6707d412bc9618460454a48fc3145313d7a1cef684a9d2f1127836963c2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 329,
        "sourceEnd": 352,
        "text": "Are you a good student?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9996e356d2f1226c8ceb5d96b042fbe0f4bc20fa866d58ec51e9ca33840091c7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 356,
        "sourceEnd": 366,
        "text": "Yes, I am.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "cc07850c5e9229139005fd230419a5d512fb253e67cf4cfd4d58100b9d016a20",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 370,
        "sourceEnd": 393,
        "text": "Is your father at home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0ca5d1041093ff82757ebbe3ce7a930db05a2740fec03d2812075d35ea9eb66b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 397,
        "sourceEnd": 430,
        "text": "No, he is not. He is at the shop.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "65b53e6381a51bab3faef5c013e48785a34f4e6504c6b165f26cab901344ac11",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 434,
        "sourceEnd": 460,
        "text": "What is your father's job?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "29204682e45e4c5a21684d1369d07609996325a13e6635aba2f2ae30294d8546",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 464,
        "sourceEnd": 479,
        "text": "He is a driver.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9d2e9547c1c1272a06ba45e335d856ac4dc2b8cbedef1304df2696a04d2dc87f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 483,
        "sourceEnd": 498,
        "text": "Thank you, Ben.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cfe290b5842907c675b01a07dd0afb525332b78586e30f0b7b0d3fab993e664a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 502,
        "sourceEnd": 518,
        "text": "You are welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ea50b2f75179dbffe00b263839764dcac996703f18cfe2d9d19f9917f605414a",
        "pauseBeforeSeconds": 0.65
      }
    ]
