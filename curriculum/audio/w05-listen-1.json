    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 97,
        "text": "Hi, I'm Li. I'm a student. I get up at 6:30. I have breakfast at 7:00. I go to school at 7:30.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1d4788ed512ffe0c112812cf18574f5f7e3adf40f1979404a5e2f83067b39005",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 101,
        "sourceEnd": 123,
        "text": "Do you walk to school?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ce3b560cc6ce0e21ab7c5ea0cb5d3f7b9c571cf6c4bef4c96330c408b61132e9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 127,
        "sourceEnd": 155,
        "text": "No, I don't. I take the bus.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f092b0fdc0e090cd522b0975dde7da42dc91c4052f18c01dc241d7828a6381cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 159,
        "sourceEnd": 185,
        "text": "What time do you get home?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "eec5268ad6c4341f834deb72d0f628adfac0b0e02448269144c1fe21c265cede",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 189,
        "sourceEnd": 279,
        "text": "I get home at 5:00. I do my homework at 5:30. I have dinner at 7:00. I go to bed at 10:00.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e9e5e4a4d69a280c10cd7b91c5b132a6f94fe71006c6b261cfc7204f6fa5c76f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 283,
        "sourceEnd": 299,
        "text": "Do you watch TV?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "7fe0f48162492808255878b5e06af29381173b3f575a040e8dfa54b0c04a05eb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 303,
        "sourceEnd": 333,
        "text": "Yes, I do. I watch TV at 8:00.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bd41a182893ba2914d61fe06dfc7cb771c7b959a84f412365279388ff9f65c26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 337,
        "sourceEnd": 344,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
