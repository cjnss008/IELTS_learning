    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 68,
        "text": "Hi, I'm Li Ming. I'm a student. I get up at six thirty every day.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "df89c6770dbc3d35bd42448012cec4b6db5e3590beea206377c1ed818129a5ae",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 72,
        "sourceEnd": 109,
        "text": "Oh, I get up at seven. I'm a teacher.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f2630dbf54bb845135c2aa092c2280f74860e19c89037a651699a0774c139500",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 113,
        "sourceEnd": 143,
        "text": "Do you have breakfast at home?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3dc586787b0b06f9f394fd3380559e8f15056fd0638d990c0c4ac37acea1d126",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 147,
        "sourceEnd": 179,
        "text": "Yes, I do. I have eggs and milk.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "09a45346782943d5f71f9d8d579577c9c92d0c1d78fd3d65c59b8c52e78b8544",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 183,
        "sourceEnd": 234,
        "text": "I have breakfast at school. I have bread and water.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "200688dc157fc0550b26113fd67d4fe7a4fa8f533b5743851484fb6cf7cef3fc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 238,
        "sourceEnd": 268,
        "text": "What time do you go to school?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fb8ec5ef5c58aec48dddd7e35b10b6a071879f5b5d134d1612feb14f02301927",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 272,
        "sourceEnd": 302,
        "text": "I go to school at seven forty.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "b43b73f40ddab553f07970e6dad79ef182eab9a425145adf31fe538d948bfbd3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 306,
        "sourceEnd": 328,
        "text": "I go to work at eight.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "673421442e3e95d1c59136317521c0212c020d259440647fc336e8313874b562",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 332,
        "sourceEnd": 352,
        "text": "Do you walk to work?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4d50eadeb8fb9938c6eb30fab9130f22e842224f6c0c99ee256277358c75fa70",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 356,
        "sourceEnd": 384,
        "text": "No, I don't. I take the bus.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f092b0fdc0e090cd522b0975dde7da42dc91c4052f18c01dc241d7828a6381cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 388,
        "sourceEnd": 416,
        "text": "I walk to school. It's near.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "0cd32a07fa600c8618d410b2b6b035e7434fabd5d576275ca30907eeb7936ab9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 420,
        "sourceEnd": 437,
        "text": "Do you do sports?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f3c2614ebfc18149f0d8be7d96bf52e0cacc54ae5af42a05bfd02a01baa972ec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 441,
        "sourceEnd": 477,
        "text": "Yes, I play basketball after school.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f2abd5d5be7ebe4abf77dea1d475c61dd27df66fe6238f36647269c9f322f166",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 481,
        "sourceEnd": 523,
        "text": "I don't play sports. I read books at home.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "5f3b5d2a36a93838b4a1ca781a9b598ed0e0d0241998e4a2450d16010f18a7d2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 527,
        "sourceEnd": 561,
        "text": "I read books, too. I read at nine.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "938d314352cf4a2fd357b7bd4fded0cad6cad0ec2156dfd4cffa0d925a24a467",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 565,
        "sourceEnd": 579,
        "text": "I read at ten.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c583cf72aedf840229d0d3259120180805152ac87691fc6c3346f69b6bfdb8e7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 583,
        "sourceEnd": 594,
        "text": "Good night!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "cd921e03ed225b02defa48a1227fcd03aff241fa1bd79af85781d524566cb739",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 598,
        "sourceEnd": 609,
        "text": "Good night!",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "cd921e03ed225b02defa48a1227fcd03aff241fa1bd79af85781d524566cb739",
