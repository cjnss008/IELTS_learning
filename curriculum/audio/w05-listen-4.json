    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 49,
        "text": "Hi, Lucy. What time do you get up on weekdays?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "7c3a3c68b4986b9dbebaee0818a699c2cdaf4ed53daf28a328d21f6f5d446501",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 53,
        "sourceEnd": 107,
        "text": "I get up at six thirty. Then I run for thirty minutes.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "68090e9e1ae51d1bddaf9402fed273e5d671fc0d6ebf9f79e81b00c114346b2a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 111,
        "sourceEnd": 132,
        "text": "Do you run every day?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "7aae3aada4ae8996cbfb7841cf89372ef34b04d4eab25d49841c5298d4444ac8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 136,
        "sourceEnd": 226,
        "text": "No, I run on Mondays, Wednesdays, and Fridays. On Tuesdays and Thursdays, I study English.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9c730a5e2c02890765fb44856f502a0708eed6963b487de3ea1f171918a09b2a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 230,
        "sourceEnd": 253,
        "text": "What time do you study?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "36d655d395932f6fd2bc49ab84a42f503b423c89ad7f45a0917ed3b13382c53d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 257,
        "sourceEnd": 317,
        "text": "From seven to eight. Then I have breakfast at eight fifteen.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "fa0d61b6a9537b0e2bb1f75dd0f951792e873ada7028c51a712a81425dd0143b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 321,
        "sourceEnd": 346,
        "text": "Do you go to work by bus?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2315cd98ccfae0ada0ff8c613ddfb73e9cb6d0a05e31ed8105df91b3b22980a0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 350,
        "sourceEnd": 407,
        "text": "Yes, I take the bus at eight forty. I start work at nine.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7f604174b0be151d72ad1702a89f24bbe7db2f3b27536bdb362574833e477f27",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 411,
        "sourceEnd": 440,
        "text": "What time do you finish work?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2c4ba581a5751f3ceff30ba4569b576d1521f6a5c52990ab6304b7929621d90d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 444,
        "sourceEnd": 516,
        "text": "I finish at five thirty. Then I go to the gym on Tuesdays and Thursdays.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bb05edee256e0213fe80dc8e61a4766dc776ed0242865a870eac7795c93f2638",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 520,
        "sourceEnd": 551,
        "text": "Do you watch TV in the evening?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f837c56829e3c59bee40f6b2fc16a7d5db5b2274b882e77bb30a8db6182f5f6c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 555,
        "sourceEnd": 626,
        "text": "No, I don't. I read books from nine to ten. Then I sleep at ten thirty.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4f0d1dbea69def7944c822c5b0b6c0184fdbff5ed1f00dd27dd8e6c990cdb767",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
