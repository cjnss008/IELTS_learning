    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 53,
        "text": "Hi, I'm Li. I start work at eight. What about you?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "90b8d860b25cbbebd1fb0cf6dedce7e12fbf46bbd3daa97f272d72859a5b76e2",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 57,
        "sourceEnd": 97,
        "text": "I start at nine. I usually walk to work.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4fccecdcf410728f111efdd403fa0438d829e4a3c21407bd79bccae9362eedec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 101,
        "sourceEnd": 123,
        "text": "Do you walk every day?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c1d1b78ff49f9f2cb2a46289ce22c9e242a8377eb81ef6fb42c6a1b31749071f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 127,
        "sourceEnd": 171,
        "text": "No, not every day. I sometimes take the bus.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ff902aae0e643c2523dd48daf53ccc1e711a3242c16a9271c904ab06ae68297a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 175,
        "sourceEnd": 209,
        "text": "I always walk. It's good exercise.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f4935b36fa7c6690fa3b20c5fc1bc7e8241f010016e7d61351e9b4da486b2c0e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 213,
        "sourceEnd": 245,
        "text": "You're right. I often walk, too.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "544d2e4b0cb39d96debfd494c8b3ebb5ddf466fc711ded90ed582a885135ac92",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 249,
        "sourceEnd": 273,
        "text": "What time do you get up?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "646c9e9fc193a94b7cb3f47805d7d7718cbfb7de24dcc3e74d51f31b91793a80",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 277,
        "sourceEnd": 295,
        "text": "I get up at seven.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a290d76e1b4faeac01c431dd49a1aa7ee8593dde977a0be0fbb310030b2f3fde",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 299,
        "sourceEnd": 329,
        "text": "Seven? I get up at six thirty.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "cebad501a63b8b5b4c41fd467afd8327eb49a35eafe1ef43c6b5ab3c462cd668",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 333,
        "sourceEnd": 369,
        "text": "That's early! Do you have breakfast?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0f90118bac8c084ea22bc230711b45d76e4b10d57fd6ef7017344810d8360b26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 373,
        "sourceEnd": 402,
        "text": "Yes, I always have breakfast.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d0e50460a0edfa395d45d4ebcbfbdedc1de431f54037e6af1db464ab89a0139b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 406,
        "sourceEnd": 439,
        "text": "I usually have breakfast at home.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e8cdc762ac879dd2cfc3f3096092c228c29de499d43129c32382a55fa45bace8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 443,
        "sourceEnd": 483,
        "text": "We sometimes meet for coffee after work.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7170a6578a9c09a4b46b1eec02e736d25e4d191fa6074e16dd80e6bcfd640266",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 487,
        "sourceEnd": 519,
        "text": "Good idea. Let's meet on Friday.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "863290fa87f8ed6f6662016ab2a431b599bffd91141dd310575a9a844b4fb131",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
