    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 36,
        "text": "Hi, Mei. Do you have a busy week?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "fd937dcbc191fca927e266a746b9eddab07f10290264d99c8cb876fa5ab2c922",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 40,
        "sourceEnd": 80,
        "text": "Yes, I do. I work from Monday to Friday.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "78a074d092f5ba3937e81e10f97394a7691e14d8dd6e7b15fc23b3edf7be1bc4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 84,
        "sourceEnd": 112,
        "text": "What time do you start work?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "fdb7e7c814cc635937b9c724dec21eb2bbb27c748f7bb4a6d59e259bd296ac59",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 116,
        "sourceEnd": 140,
        "text": "I start at nine o'clock.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "de97fbf2b146209621b18bcbe332fc51598667d170a4e2e4c2408f352b8d742d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 144,
        "sourceEnd": 171,
        "text": "Do you work in the evening?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "84cc31f979e29a9ce99d7595fef58bb8705e53444c867c0a33c052fe2ef8d279",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 175,
        "sourceEnd": 212,
        "text": "No, I don't. I usually relax at home.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "9982e2d31d4db0f3507fcf1fc47ce6e90efdfe4c0f5b153da2c3ab8cd9286f05",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 216,
        "sourceEnd": 239,
        "text": "What about the weekend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7bf58e645059a356f810e95b826a356fcb26fd14a0d2a75911aad09cd8d7d5c9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 243,
        "sourceEnd": 310,
        "text": "On Saturday, I go shopping with my sister. We buy food and clothes.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e04f09fe4854cb2ca980e53768b4ea8b59d9c04c98312227c2ce21da707cc01f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 314,
        "sourceEnd": 336,
        "text": "Do you cook on Sunday?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "b6281e014970bb335328f5dcc0da15d27ec3668b3ae92132e091d2fc67bf5c91",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 340,
        "sourceEnd": 404,
        "text": "Yes, I do. I cook dinner for my family. We eat at seven o'clock.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4fe6c6953c40675b0f88cb3e0d663efdb08e6fa985efb91faab958580f776096",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 408,
        "sourceEnd": 425,
        "text": "That sounds nice.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c6342b6fae9a0b4cd6e27917a24a1de122ffa2060c145a2dea9ba67b0d974238",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 429,
        "sourceEnd": 457,
        "text": "Do you have a busy week too?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "810ee6c12d429c935374b7375e6221e49369a5f7d61b3e8c2bb5708a7b8d0922",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 461,
        "sourceEnd": 498,
        "text": "Yes, I do. I study English every day.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6ae78ff6eb4c704bb24e990204e5fc83e6161de45be7c27ddb1f03c07ca9fc4c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 502,
        "sourceEnd": 512,
        "text": "Good luck!",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "853d0afd9c941f2ab62cd22ac74c341b0a2463184d18904870b796628f313cfc",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
