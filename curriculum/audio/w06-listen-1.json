    "segments": [
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 5,
        "sourceEnd": 43,
        "text": "Hi, Lily. Does your brother like fish?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f19d5299632ac7ab624b56b47f19ddc479497397539bfd8c8b3d807b78928eda",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 50,
        "sourceEnd": 102,
        "text": "No, he doesn't. He likes chicken. But he can't cook.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5eb9b18d1e767f30ddd046218bfb0d046f922e95b1983961fd51d7c0a03b0b26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 108,
        "sourceEnd": 129,
        "text": "Can you cook chicken?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0072ecd20ebae11084624a5cff5820224e546c980e8fb66ffb14e2aadebc73df",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 136,
        "sourceEnd": 214,
        "text": "Yes, I can. I cook it with rice. My sister likes salad. She doesn't like fish.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "196626312d7483d635bde2383bc18b5161e16647f841f7780156b9dfce598716",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 220,
        "sourceEnd": 248,
        "text": "Does your father like salad?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "94ad2a454f696b4969f69fe9d5020f0201506ce236b66be5a127b9a46668bb59",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 255,
        "sourceEnd": 309,
        "text": "No, he doesn't. He likes noodles. He can cook noodles.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "394cd60d47ebb34959087accfec34f8808d3bd22a1165f9f7e2d2d53f4c3a207",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 315,
        "sourceEnd": 338,
        "text": "What about your mother?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6e1dfb7283820bb08dc8d8c056302025e2d83b3e17f507ddf7742949e17c11b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 345,
        "sourceEnd": 412,
        "text": "She likes soup. She can make good soup. But she doesn't like salad.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "860a74a22c1b6323d83b3a585c003e3be69026776c76e183ce6d8746ef300095",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 418,
        "sourceEnd": 438,
        "text": "So, who likes salad?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6abf57b6986feb52c7831b672526ec3322ce7981beb4622902d2d33890822f40",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "lily",
        "speaker": "Lily",
        "sourceStart": 445,
        "sourceEnd": 496,
        "text": "My sister and I. We like salad. And we can make it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "654e7ffef9c54acbd1beafe7739b16ca7f4344544e68220027ed67991845b863",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
