    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 76,
        "text": "Hi, Tom. This is my family photo. This is my mother. She likes noodles.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2c9c9053947174ac6943d7ed6ae153dabc6820836c06103044df9e1761208e82",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 82,
        "sourceEnd": 101,
        "text": "Does she like rice?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ecb7dec66b328f7a4ad02dc568988b8bfef589d31dd30f506b0cd0d489b488d6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 107,
        "sourceEnd": 151,
        "text": "No, she doesn't. She likes noodles and fish.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "007d8e284a1fb6050a776e6953b5e4265af43161dd95ad10dfcfa6c4109a5da7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 157,
        "sourceEnd": 170,
        "text": "Can she cook?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "80fe0a976600bc09fb76ed96d62dc2d7e2bbacfaa3eb701a96c42c57fd356231",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 176,
        "sourceEnd": 213,
        "text": "Yes, she can. She can cook very well.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9fd7273ca5a010dab67b6e135b81ec08bd7c3833bee690d083f4914cfd2392b0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 219,
        "sourceEnd": 242,
        "text": "What about your father?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e13ddae5885f5a0ace1297e96075b07a276c2ac2c392934f9df11cfc04aa5ed7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 248,
        "sourceEnd": 285,
        "text": "He likes chicken. But he cannot cook.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "43461fd897bf49c71017856a83e09eb28eb2812fcbe32c4788e66ce8f5dc1344",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 291,
        "sourceEnd": 303,
        "text": "Can he swim?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ae46dd4f26a7593f70c09d8fb9975381f7d728dd11b770035de935f60576cbdd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 309,
        "sourceEnd": 344,
        "text": "No, he cannot. But he can run fast.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d068033becfbe1d2d392152ff3479a96c3a7478a8eea19a023d643878538b5cf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 350,
        "sourceEnd": 378,
        "text": "Does your brother like eggs?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f0f3b63da090c0693cf8ab734a3dde1c27485a0ffa2e0afb0a10957fff38bb8e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 384,
        "sourceEnd": 421,
        "text": "Yes, he does. He likes eggs and milk.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c22007053201ae85d02283240547eea1abf6c6fdd4e37a7a0ffd63a8538716a3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 427,
        "sourceEnd": 458,
        "text": "Can your brother play football?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "536b4631ca05ed3f214a152bae8ef2f5a75db8321020c9bee634fe88d62dfe40",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 464,
        "sourceEnd": 506,
        "text": "No, he cannot. But he can play basketball.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "14d64e2e3832cdc82584195cf6eed12c5998c87b1cac1b5c3839c4a653234577",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 512,
        "sourceEnd": 520,
        "text": "And you?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0c1c23dc335e76d0716be6f8fbd4a526dc6f58a39960621dd893929e7dcc1bd8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 526,
        "sourceEnd": 572,
        "text": "I like apples. I can sing, but I cannot dance.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b2564bc9d1528bc17c0ccd962d71f181830ab98e711f87902bf0244ddbd9b3bb",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
