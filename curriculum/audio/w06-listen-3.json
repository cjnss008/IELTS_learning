    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 32,
        "text": "Hi, Leo. Do you like salad?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a83adb3eae75e4288f4c5c186f09532099db4b99b3f07d4aba5040e5c9b7c320",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 38,
        "sourceEnd": 114,
        "text": "No, I do not like salad. But my sister Lily likes salad. She can make salad.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ea5947907a4db070475ea3cb8c2f2b3407cfd290b5473d4c764e091daf6b4971",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 120,
        "sourceEnd": 139,
        "text": "Can you make salad?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "152bb9ff89fd71f34b20425a79c28f3d5fa9080bb9b0face79d7abe06d319abe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 145,
        "sourceEnd": 219,
        "text": "No, I cannot. I only make noodles. I can make great noodles and dumplings.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "64c4d1ad3f7510e9f48ed8dcd803f5179b8aaf8ef3b122768c20cd7d53a9bc36",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 225,
        "sourceEnd": 248,
        "text": "Does Lily like noodles?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "5c0ff458da3c1b3058b289935e601f19a115594b40af218c6d27663f439c3c66",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 254,
        "sourceEnd": 326,
        "text": "Yes, she does. She likes noodles and salad. But she cannot make noodles.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3194768368425b61f710ffd86e0185212a3a37151da87f0e092c3faf508de4ce",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 332,
        "sourceEnd": 382,
        "text": "What about your brother Tom? Does he like carrots?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "236f6a8bd322d35486dd2ee990d8d053bdd9c150d747be3b9fdf24aa01eb91fd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 388,
        "sourceEnd": 475,
        "text": "No, he does not. Tom likes apples. He can make apple juice. But he cannot make noodles.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "28d4d0672b275b2bfb2294fe399de52732a909ee789a73c557f0e7872a6eb3cf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 481,
        "sourceEnd": 504,
        "text": "Can Tom make dumplings?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "2254a3b20e871a8fb98fb291ae294c5a247873b7291ec232d13740d7b8b0a981",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 510,
        "sourceEnd": 583,
        "text": "No, he cannot. Only I can make dumplings. Lily and Tom like my dumplings.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "babbbadce2a5ec360aff54bd9b14ea74b8f01790339bceb8454339f583ddf83b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 589,
        "sourceEnd": 618,
        "text": "Great! I like dumplings, too.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d548159dd4dde020793dd812d0951c49a307ae7f268688733892d39a328348eb",
        "pauseBeforeSeconds": 0.65
      }
    ]
