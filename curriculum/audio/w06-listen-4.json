    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 44,
        "text": "Hi, Leo. Does your family eat together?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9137e76f43ebfaeb6b30fe291618ecdae3c429a0c785aa0fd2bac64532678378",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 50,
        "sourceEnd": 78,
        "text": "Yes, we do. We eat at seven.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "70d772c4f309900b195737fb76fd2e7ad1c0e7a1d89f5223930eededf858cc0e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 84,
        "sourceEnd": 101,
        "text": "What do you like?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7b3eb9e98e43fdc8952ad1c73ee16454d00d03ca1e2bb1d21ab1e9bfbb97d69c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 107,
        "sourceEnd": 134,
        "text": "I like rice and vegetables.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "22673535889edc028fe28f4152c0e20cd0d4de5991fd81a30b481e3e04d4e303",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 140,
        "sourceEnd": 167,
        "text": "Does your sister like rice?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e1ebb1dfff1b6724b88057d830a94f7c87d019b8f3b863b211caebaecd555635",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 173,
        "sourceEnd": 208,
        "text": "No, she doesn't. She likes noodles.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "28f04e30e448d00f00a7b5335aba951af6ea3d3d54c180c01907d9a3dcb5455f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 214,
        "sourceEnd": 227,
        "text": "Can you cook?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "20bcfdc599022f4ae9d163ee059e8b999b90929a2cc677d022a370e8563b5986",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 233,
        "sourceEnd": 276,
        "text": "I can cook eggs, but I cannot cook noodles.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b6ab4a7d7efd12e88a4244d04b6e34ab4fcc66e0621262161711af99e69b1487",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 282,
        "sourceEnd": 303,
        "text": "Can your sister cook?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "44fd54a91e46d4134cee692548f127988042327a5bffed0b4aa2ad179621cbd1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 309,
        "sourceEnd": 353,
        "text": "Yes, she can. She can cook noodles and rice.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4049bd865fc86493ad84aed44780fa00347d85f1e57bca842b402c7a6703c71c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 359,
        "sourceEnd": 381,
        "text": "Does your father cook?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1b543c7c9136522c9dbd8b757ad38276800a7898cd79a3ec2136b9faf1793710",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 387,
        "sourceEnd": 442,
        "text": "No, he doesn't. He likes fish, but he cannot cook fish.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3504fe2cd235a06a50dcfdf140ca649156601959452b1a4bb126a427003f5a98",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 448,
        "sourceEnd": 464,
        "text": "And your mother?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "683c783ef8b591a35a50b2807ac4b8cdf33eae78aa8858df9e48283713c27622",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 470,
        "sourceEnd": 519,
        "text": "She can cook fish. She likes fish and vegetables.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e0caa602442d2259457bda44f16a7f0ea2d1d186ad4566ba5b9846a2519a3083",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 525,
        "sourceEnd": 551,
        "text": "So your mother cooks fish?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "72763ed5363e6fc08ee13395d4306134814391a7a352555afaaf90847d8fb738",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 557,
        "sourceEnd": 636,
        "text": "Yes, she does. And my sister cooks noodles. I cook eggs. We are a happy family.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9fb3ac866f6b307ee5e5d1b45fe9ae8582b3dc69fd3d9cb6b887a64dc34af151",
        "pauseBeforeSeconds": 0.65
      }
    ]
