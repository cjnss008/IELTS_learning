    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 31,
        "text": "Hi Leo. Do you like salad?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5fa92554946052e587185c16f6f98685dd166759a3a7c0008d1a2d8e86adb040",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 37,
        "sourceEnd": 107,
        "text": "Yes, I do. I like salad. But I cannot cook. I can make a simple salad.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b46af073a506add1e04b07f672561d63c9282fce893f14ef3727c1346b49bcb2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 113,
        "sourceEnd": 134,
        "text": "Can your sister cook?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "44fd54a91e46d4134cee692548f127988042327a5bffed0b4aa2ad179621cbd1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 140,
        "sourceEnd": 190,
        "text": "Yes, she can. She can make cakes. She likes cakes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "238ca0b4d781b1e9f1f7b9d5cefd8dcf57e515119c0e0fc254e35a8e241fc4fc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 196,
        "sourceEnd": 217,
        "text": "Does she like sports?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "049b25838be2979e66a54f5eb87e38c19359170c7c2599a9ede48a151b1b0cdf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 223,
        "sourceEnd": 271,
        "text": "No, she does not. She likes music. She can sing.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d2591e5e41c2bca7ed24df1361ec31aaecaa2e2725f333ded12460ea97fb0c6e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 277,
        "sourceEnd": 295,
        "text": "Do you like music?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2fce2dbf119a8ed61996ba65eb96214e5ff44de6163762dd0210de1bdff81551",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 301,
        "sourceEnd": 353,
        "text": "Yes, I do. But I cannot sing. I can play the guitar.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "18682302c4c584c641c49ffd099446d164b6cd3500de7bbc1be218c3fe8b7f83",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 359,
        "sourceEnd": 394,
        "text": "Great! Does your sister like salad?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c7e1adaaf3b6f18fdf0070a8423d3e8703423c5baaa36260feeac71e2f33ee55",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 400,
        "sourceEnd": 444,
        "text": "No, she does not. She likes cakes and music.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0464aa64b32158f5a9b7ba7bdc565d0aa7c574106ee5168d211090eac9769a6b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 450,
        "sourceEnd": 465,
        "text": "Thank you, Leo.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "154ce9e949f79b750ebbf2323ad9f7ad973ea25ca70f1b29dd66c155c9877c45",
        "pauseBeforeSeconds": 0.65
      }
