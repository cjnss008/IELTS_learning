    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 31,
        "text": "Dad, can you cook chicken?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7447407c8ba1aac974fbea22354fc75ba6bcd755df631baeb1221a888532e006",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "dad",
        "speaker": "Dad",
        "sourceStart": 37,
        "sourceEnd": 77,
        "text": "Yes, I can. I can cook chicken and rice.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fb652eb5178678015c18ca1e5f4484fadb7e5fbaa20725986b69a9ee1376c089",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 83,
        "sourceEnd": 109,
        "text": "Great! Can Uncle Tom cook?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d5d92d1c3b0ec15a4144dbfbb69f22cb8c41564360391b37fac5d04c0cc7644e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dad",
        "speaker": "Dad",
        "sourceStart": 115,
        "sourceEnd": 151,
        "text": "No, he cannot. He can only make tea.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "69efe3674fc1a69e66c4080653395b6dd3e9e89124227af56f0d678ef9f9840a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 157,
        "sourceEnd": 180,
        "text": "Oh! Does Mom like fish?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "ee8ea33e3994c4847320e99c545049b2647076fedfb907bc5dda2399231209b0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dad",
        "speaker": "Dad",
        "sourceStart": 186,
        "sourceEnd": 247,
        "text": "Yes, she does. She likes fish, but she doesn't like tomatoes.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "dbf2b0660f54be4d4d37d86e0e63e3bb5974ae78e6271504ade21ee295b837a3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 253,
        "sourceEnd": 295,
        "text": "I like carrots, but I don't like tomatoes.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c3e609682b2fb07ddc03fe94851d4a31f909ff557151d16620c0824cb356d779",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dad",
        "speaker": "Dad",
        "sourceStart": 301,
        "sourceEnd": 340,
        "text": "Me too! Does your brother like carrots?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3318d2d818f291fc58b1d58ac39b7bc1dbca05bb1bc9e22a67b4d93e600c77fe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 346,
        "sourceEnd": 380,
        "text": "No, he doesn't. He likes potatoes.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a9dcb0b0b093780823e927cd67f3a9339b28722991c94d0ec15e5118c34a2c9b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "dad",
        "speaker": "Dad",
        "sourceStart": 386,
        "sourceEnd": 436,
        "text": "OK. We have chicken, rice, and carrots for dinner.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ca5a9f10858def2351ff8325b18fddaae885b109d378bbb15f1d0160960ae1ad",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 442,
        "sourceEnd": 450,
        "text": "Perfect!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bd57f3b934e2ccaafa024220729dc6940788443dd570878dfc255ffc0e18f97b",
        "pauseBeforeSeconds": 0.65
      }
    ]
