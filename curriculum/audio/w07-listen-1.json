    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 35,
        "text": "Excuse me, where is the library?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ae4200f20ba20f63d33f50ce027ff1c92a23fc3695be868ce13eabd7f38550d0",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 39,
        "sourceEnd": 62,
        "text": "It is next to the bank.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "823a5a52e1e3c344e1e7685508f33b4e4583524e181fd14db77c611598ee258c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 66,
        "sourceEnd": 76,
        "text": "Thank you.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8569efc4ed5a6273140c2b6ec0ab8d99f4398210808fbb7c0cbbae4fbcc21350",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 80,
        "sourceEnd": 95,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 99,
        "sourceEnd": 121,
        "text": "Is there a quiet room?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0a9d86219fba8db1bcd072cb3e7a814d5cf2f48a34cf729c6e93369eb5c9c2d9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 125,
        "sourceEnd": 166,
        "text": "Yes, there is. It is on the second floor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "68cf32bd15422cb1a15e8b47751cb3694cdb95c77ac71736a255598e84672c80",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 170,
        "sourceEnd": 190,
        "text": "Are there computers?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ee2e5ad4dde72265478037cc9c17757747a00eaf3277b283233177d477e7ca80",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 194,
        "sourceEnd": 237,
        "text": "Yes, there are. They are in the quiet room.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3598185c31cc60c388510eb8b455779f8662c40b7e553ad15db146916267c081",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 241,
        "sourceEnd": 266,
        "text": "Good. What are you doing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cf3748aaf9c62d4d3ffe3845f107677c33905f445e468a9bb2f7d5d1fe0c3086",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 270,
        "sourceEnd": 290,
        "text": "I am reading a book.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "244dbb5b70a9d0e6f2bbdc189283bfc70ac9e2d7989062e606389a644566b5a2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 294,
        "sourceEnd": 310,
        "text": "Please be quiet.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "90b07aaa23f048fa7ea456625c627a082024cd3c617cfed57b7cdd4f06268b28",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 314,
        "sourceEnd": 320,
        "text": "Sorry.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9f7d79d9b6a23846d45c57a0e6f66e3bc2721ff5656d9a00f8c1ba8e9dc1b114",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 324,
        "sourceEnd": 342,
        "text": "Where is the cafe?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "13bec832e87ab1af7e578038d25216af2d3c9b31c9e2c4b8e95fc4c712f269c0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 346,
        "sourceEnd": 371,
        "text": "It is behind the library.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b7274f93278a9a0dbcbecf0e2fbbd79b7d57580c821d95d66a520387f84933ff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 375,
        "sourceEnd": 382,
        "text": "Thanks.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f51bead488e14b656af3a13e33eb1d6fa9580832cbb9d7a20061f84c4b1c160f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 386,
        "sourceEnd": 401,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
