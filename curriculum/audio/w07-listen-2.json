    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 43,
        "text": "Excuse me, where is the history section?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7018d2cc57d1b367f7876cc880d175a5d5263b3e069248fc04642e400c1e611a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 47,
        "sourceEnd": 72,
        "text": "It's on the second floor.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "aab8db24c46c39c38a54e5a9bf447342cc3c053c8002181518601e7e53164515",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 76,
        "sourceEnd": 92,
        "text": "Is there a lift?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8351e199a10b99443bc05a34ec9683ca469a34f11047f3634bb1fad1025a7750",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 96,
        "sourceEnd": 152,
        "text": "No, there isn't. But there are stairs near the entrance.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3d6c3d8a74c762bdbb768d50a220c41ebf7e9f722df0e32a55f8c0c83ed1167e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 156,
        "sourceEnd": 188,
        "text": "OK. And where are the computers?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9c071e82d27669d0ba55d0a01e271a7c5d776a8f1beae695e79436927b7e01f2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 192,
        "sourceEnd": 246,
        "text": "They are on the first floor, next to the reading room.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5e4464049c5bb0d97116b7c08b338e3e5fa100f9593eaf110f58fc0a1fc758b3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 250,
        "sourceEnd": 275,
        "text": "Can I use a computer now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "bf20a902dab01c97b880db1603006bf71f8662922aa9a2c1763decb1a210a185",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 279,
        "sourceEnd": 313,
        "text": "Yes, you can. But please be quiet.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4a5ecacec3dffffcbec506a98b06cba45572ccad3d90715bc8bf1ac581877f40",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 317,
        "sourceEnd": 366,
        "text": "Thanks. Oh, one more thing. Is there a café here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a7dd993ba5798400928ac266156aebc94f6fb1e17682489d5d59985fcfc2b205",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 370,
        "sourceEnd": 429,
        "text": "Yes, there is. It's on the ground floor, behind the stairs.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3c8f956c41c54f9c284a9bacfa1faf42777837c6a8a9f74b853137aaded823e0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 433,
        "sourceEnd": 477,
        "text": "Great. And what time does the library close?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1820311efd0d13543c57aaab52af3ab711700a309395dc25dabce377eb0c5fe7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 481,
        "sourceEnd": 499,
        "text": "At half past five.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "28e2e077d95088d42f46ebce941163d5cd640d927767c43304a1605d71d82422",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 503,
        "sourceEnd": 518,
        "text": "Half past five?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f75c55c8061a7daf50def284f8ce3ba355550dcb6e999cc71568951b6555d829",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 522,
        "sourceEnd": 540,
        "text": "Yes, that's right.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b843a315fac423a27332436f74a3f9d7be2982de1381a2fa27ebb00ab4c83166",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 544,
        "sourceEnd": 564,
        "text": "Thank you very much.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9e41164cb68b90cf8133a32422dceef505ce83d054281d47edff7b018531e88c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 568,
        "sourceEnd": 583,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
