    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 38,
        "text": "Excuse me. I am looking for a book.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "438444ed9a53feed5c99a18f5ae5f777ec0690dcd5169181812394a5640d4897",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 44,
        "sourceEnd": 65,
        "text": "OK. What is the book?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "948f974a2aafc5d7a4acad93ead989e84a889f2b911ddb3e03b9b29350f50120",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 71,
        "sourceEnd": 98,
        "text": "It is a book about animals.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c0e714394fe9835ca67bd3b34b30280209a545efe7d79e453e483a06a350fc5f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 104,
        "sourceEnd": 170,
        "text": "The animal books are there. They are on the shelf near the window.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "96b0d1b2c254543e19bae6642712c795eb52573a046b3ccc7d1a018ba608572c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 176,
        "sourceEnd": 192,
        "text": "Near the window?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "137e082c4cb210146f535caed309dd413534164bea8296b652ac0b8954a21c24",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 198,
        "sourceEnd": 258,
        "text": "Yes. Go straight. Turn left at the desk. The shelf is there.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0edd60fbad5e89e5ab37d98858881821463cf183992c44a5d98dfc34baf99e66",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 264,
        "sourceEnd": 303,
        "text": "Thank you. And where is the quiet room?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "59ce45e1349bab5eb04ab7b164ab84a392b7121f8b32ef2d31173a1d8da98a26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 309,
        "sourceEnd": 360,
        "text": "It is behind the desk. Please be quiet in the room.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ca4ad91dabb9384c010af8f474ed9038abb01760abf2e1da732c553dcc794603",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 366,
        "sourceEnd": 391,
        "text": "OK. I am going there now.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bf73f601e420a70620c3347409a623de0f61752fea9709b0a9dd1b892c97f89b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 397,
        "sourceEnd": 428,
        "text": "Wait! Your bag is on the chair.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "39078443fea389fcbbd43db7173cf988bb8912f4e0c7beb05e7938ef0f67a27d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 434,
        "sourceEnd": 453,
        "text": "Oh, yes. Thank you!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c67a8c82d2b0b18fc1592a0effd5587fb1668b9364be4ca950a88fc07d7981a6",
        "pauseBeforeSeconds": 0.65
      }
    ]
