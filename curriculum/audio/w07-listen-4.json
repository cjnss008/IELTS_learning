    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 41,
        "text": "Excuse me, where is the ticket office?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "742bf99e78cb8eaa42b96220d7484e211154137db5aa13ecf69b1d2ab2ed899a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 45,
        "sourceEnd": 87,
        "text": "It is over there, next to the coffee shop.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1d9f0e99d6aa22bc5eb4f2c88b497a227635661ee9d68a2a4014e31629e2b14b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 91,
        "sourceEnd": 128,
        "text": "Thank you. And where are the toilets?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "77e07b9a9941d8ec1d6a50aebf82fc3c11c0b7aa5403b3da9876185591551686",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 132,
        "sourceEnd": 176,
        "text": "The toilets are behind you, near the stairs.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f10e59fad7defb9f56addfe1f61b70389292c89e51a00ff0f241ca5e57378bf8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 180,
        "sourceEnd": 212,
        "text": "Oh, I see. Is there a shop here?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fe7c587480e4157d7940f7e4d145b8ff3b859a547c10e718bb69cf48acd4c66c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 216,
        "sourceEnd": 293,
        "text": "Yes, there is a small shop. It is between the ticket office and the platform.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "394518065373f8e2bc40c936c2be1797fe684f354b18ce53604846157653ec25",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 297,
        "sourceEnd": 328,
        "text": "Great. What is the woman doing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4d98f77e84329c2b5cd876588895963cabb98f27cc410c232e92e6bc941abb6c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 332,
        "sourceEnd": 355,
        "text": "She is buying a ticket.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d578b2c58fe7440a6e56adc140e81e529eea7d6f56b4c48fd8066c8909ae6997",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 359,
        "sourceEnd": 391,
        "text": "And what are the children doing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "04baf4283e4c1ae4b104a2ec7e526efdf3f959083a711548e9e7cd5504aae554",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 395,
        "sourceEnd": 426,
        "text": "They are waiting for the train.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ad9524a3b28459a208c895182b4f51e461f7d228814f25b5e0f3daba918466ee",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 430,
        "sourceEnd": 446,
        "text": "Are they eating?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "266388262d1becd32bc215b81c3613548a0edae470eb1edfa3dd02120bdd6d31",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 450,
        "sourceEnd": 499,
        "text": "No, they are not eating. They are drinking water.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "49fc81d76230bf534d6da91a85df99fd24226cd925426b15c40d13d2dd9b02e7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 503,
        "sourceEnd": 513,
        "text": "Thank you.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8569efc4ed5a6273140c2b6ec0ab8d99f4398210808fbb7c0cbbae4fbcc21350",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 517,
        "sourceEnd": 569,
        "text": "You're welcome. Please stand behind the yellow line.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4842f1126ad871ed9f36f783490efbe47d967f8af42cd963db46275ccc1dcbd1",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
