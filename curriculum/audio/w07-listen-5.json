    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 36,
        "text": "Excuse me, where is the painting?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "897e49a48f161c762ef95dc81cdb88136c2300cd7501eab44d492d9b67e6292b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 40,
        "sourceEnd": 64,
        "text": "It's there, on the wall.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e22ea5a73f22fbea4afaa75edab26a494458639b0ef1d29b9579cdbb856e571b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 68,
        "sourceEnd": 87,
        "text": "Sorry, on the wall?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6fc404cd8eb56fcfd23a3e5644fe1973ce61c7734aee0e86aec38f956d7aeb6d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 91,
        "sourceEnd": 115,
        "text": "Yes, next to the window.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "81323c47010f2ffb9bfcc5943ae2d937331640a7673c7c6857ff6e1216754313",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 119,
        "sourceEnd": 140,
        "text": "Oh, I see. Thank you.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "b29ac91d153293f7fedcf7cd1e1c41694852178bb512da73fe9b86faf95e973d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 144,
        "sourceEnd": 159,
        "text": "You're welcome.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "124eb273f9a0a470e3d6930f97e1402f311a753dc9d656b1ef17ef12367caffa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 163,
        "sourceEnd": 189,
        "text": "And where are the toilets?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c9018e5ac40550e50386cbef8aee6410db1c5c36dea5bd689927ac59d0558f6b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 193,
        "sourceEnd": 232,
        "text": "They are over there, behind the stairs.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e0eb50ea8e37dd69c921c2010c86920937c29c0b1c088ab4b229c4a8afb556cd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 236,
        "sourceEnd": 254,
        "text": "Behind the stairs?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "91b96c6ed8c5b04a77914fd3d6067bffce860e9124c7c9ca37cea3d78cc002ac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 258,
        "sourceEnd": 289,
        "text": "Yes, go straight and turn left.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e5a1d2ecb7eee5fac768be5979e67ad8b2ef80b847d4feae31e018769d331657",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 293,
        "sourceEnd": 317,
        "text": "OK. And is there a cafe?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9a3196558107af6dbc87090768bef4c85be6fe73b5379c951ceae2f8ef33d6ec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 321,
        "sourceEnd": 359,
        "text": "Yes, there is. It's near the entrance.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "d990f4d530e80b3939a5b195ff2abbbf882a565de31581b4030110ebe28d29bf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 363,
        "sourceEnd": 392,
        "text": "Great. What is the man doing?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e18798299f68c27607d536d5ee522c462e65db0ab27a1fc717ef8a4ca55104e0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 396,
        "sourceEnd": 426,
        "text": "He is looking at the painting.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0c4e2833c2ab77dc91072303c87ece0690a31eb142ae5525c270e0926668940e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 430,
        "sourceEnd": 444,
        "text": "And the woman?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d781bae161569c72c9061e52bc0d6a32b3f416078aa832fc7fc6bf716f738c6a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 448,
        "sourceEnd": 470,
        "text": "She is taking a photo.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "74d2307549673e4075da93af9c4ddd852ef41ac84c9a9d7f2017826969ec4b7f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 474,
        "sourceEnd": 507,
        "text": "Please don't touch the paintings.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "b6300e641ca8184660fd4a2cce2e92105c0152bb1ae90afdb055f5d0d1ad1956",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 511,
        "sourceEnd": 524,
        "text": "No, we don't.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "cd55057415350ce41eaefe8e2e71b4d362d5e6bbeb18901a1c8e7ad021e45a7d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 528,
        "sourceEnd": 538,
        "text": "Thank you.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "8569efc4ed5a6273140c2b6ec0ab8d99f4398210808fbb7c0cbbae4fbcc21350",
        "pauseBeforeSeconds": 0.65
      }
    ]
