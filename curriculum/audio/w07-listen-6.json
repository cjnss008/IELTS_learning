    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 41,
        "text": "Excuse me, where is the ticket office?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "742bf99e78cb8eaa42b96220d7484e211154137db5aa13ecf69b1d2ab2ed899a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 45,
        "sourceEnd": 86,
        "text": "It's over there, next to the coffee shop.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3ddb4f4528576795d0ef2f7f18f79eb676144e55967ea53a36c3f4be4620e46b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 90,
        "sourceEnd": 127,
        "text": "Thank you. And where are the toilets?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "77e07b9a9941d8ec1d6a50aebf82fc3c11c0b7aa5403b3da9876185591551686",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 131,
        "sourceEnd": 176,
        "text": "The toilets are on the left, near the stairs.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "93b62d01acaed796a235ef4abf28fa11b720196e9f0fbf4985d919367d281b15",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 180,
        "sourceEnd": 201,
        "text": "Is there a shop here?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "157c03cc837fd7e2d940e69e891f3e55d373c2784ea32df228f149bb8af5bd32",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 205,
        "sourceEnd": 249,
        "text": "Yes, there is a small shop. It's behind you.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2cd9e490bb5509b176781e725680eb342f3c3d448e61b9cd73d46d198e0b1782",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 253,
        "sourceEnd": 302,
        "text": "Oh, I see. What time is the next train to London?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "ee92fd493b1e4df92ec61992515915337afec6648f6d1a1829a53ca68c6b4a1a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 306,
        "sourceEnd": 333,
        "text": "The next train is at 10:15.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "45cc7f44ad27eb8c4ab4096ffe0ec2cec5c4432dbccb59c8b66f7be770930bab",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 337,
        "sourceEnd": 343,
        "text": "10:15?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "cc748f9ac403fe8664bc90f3b5b8ec714de3bca6d54119119218eea97e7cfe07",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 347,
        "sourceEnd": 370,
        "text": "Yes, 10:15. Platform 3.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a63c558e54847dc33bb47d8b214a918d318d7018bafd3b2d016d6f70990583ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 374,
        "sourceEnd": 406,
        "text": "Platform 3. Thank you very much.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4f1d15a56653b39abc129fc328988d60cccbf743400bed1170fe0b4d59e1bd22",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 410,
        "sourceEnd": 443,
        "text": "You're welcome. Have a good trip!",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "2bbf6d81ac17c4dafdfe851d74d51926d64b16bf7e1600dc6e7458dd4a0a995e",
        "pauseBeforeSeconds": 0.65
      }
    ]
