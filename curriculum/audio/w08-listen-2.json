    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 33,
        "text": "Hi, Mei. How was your weekend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bf92a2b2efc1e1446820532822c5948ed025129455ee86dc9011ed6d76f0e1c2",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 37,
        "sourceEnd": 84,
        "text": "It was good, thanks. I was at home on Saturday.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fbb8355622f4c44326a272affb782a767c15e122650b848321b5493a4727e839",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 88,
        "sourceEnd": 102,
        "text": "Were you busy?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7a1fe40e70a4394c26e3284bd7df6f796cf7ffca8f89f90f565e3eb7faeb8af1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 106,
        "sourceEnd": 150,
        "text": "No, I wasn't. I was very lazy. I watched TV.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "279bc2419bf6eded986ebc4954f2b6831a4e2f178fa2ac23da0c034a1925ae18",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 154,
        "sourceEnd": 173,
        "text": "What did you watch?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "297e51c52e26284f55797d4e38bad79c5e78f9eb2bf770f622aaa6c897c93469",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 177,
        "sourceEnd": 200,
        "text": "A comedy. It was funny.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c4ef72136e5735f489085c40c62ceb2a0bf14ba25443e92821c7b311cc4e1a55",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 204,
        "sourceEnd": 248,
        "text": "Nice. What are you going to do next weekend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "0b803deb6c64bb9f79c3c245e251cd5209dc2c00ba57cc13076fdf183ede19dd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 252,
        "sourceEnd": 304,
        "text": "I'm going to visit my sister. She lives in Shanghai.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "8a29747a7510626a528d67421edd9a18fe30a54fdc0732fec047038448b661dc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 308,
        "sourceEnd": 332,
        "text": "How are you going to go?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a5c018035a9f9011e4cf264e90bed48cfbcea8dabc5f23d16962c053d0a981fd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 336,
        "sourceEnd": 364,
        "text": "I'm going to take the train.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "77d0885c97c6a63fe3fd4c59203a6656730c2414ef71841f2703a1d2d0454fe5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 368,
        "sourceEnd": 372,
        "text": "Why?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "5d8a995a6fa7cf7c577cc9d49ca9e00d4aee4d0bcd5e2ad5caff27e2a8097276",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 376,
        "sourceEnd": 404,
        "text": "Because it's fast and cheap.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "1c0f9703161a17b1c5fd2d5cff94cf3d620f585b32250f6bf13ac6b2f960f90c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 408,
        "sourceEnd": 432,
        "text": "What time is your train?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a3ad0d63f2513617e498598dd8d799aebc852e7742a15ead4aa77cdb73c8c49c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 436,
        "sourceEnd": 465,
        "text": "It's at eight in the morning.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "0ff5c037b66fed3fffec17dbf4180ec27ecd3ef0e0499a9d25675bc42dd96286",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 469,
        "sourceEnd": 496,
        "text": "Are you going to stay long?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bf0b1ab526e8fd05b34be842f9773329d17cd69fa1b5d5c4de93e3ccc2cafda4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 500,
        "sourceEnd": 560,
        "text": "No, just two days. I'm going to come back on Sunday evening.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "d02ebe143bfce890553cea8478c2243fe30792c1179a7b85fb1adf35003a2064",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 564,
        "sourceEnd": 599,
        "text": "That sounds good. Have a nice trip!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6c81e4a955a71498bc1109eb0095ea5a45d4d6e481bc04ed906f2c1b89a2dfa6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 603,
        "sourceEnd": 610,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
