    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 46,
        "text": "Hi, Mei. Were you at the library yesterday?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4478b573770002da9ed80525c6366278fd7ec14f41dac3311b20548c808b62ef",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 50,
        "sourceEnd": 98,
        "text": "Yes, I was. I was there because I needed a book.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "1fdd2551180c4f19e29ace7d7250a7254a004b65c1f4432dc6c033facd86ea51",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 102,
        "sourceEnd": 114,
        "text": "Was it busy?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "23bcdacd38924a44304eae33fb4360c69cea3ad25fd44def8fd851163010f839",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 118,
        "sourceEnd": 151,
        "text": "No, it wasn't. It was very quiet.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "bdfd53bc57eebb04698c62b8768d7ce472f2fb0db4d7c38dbe5fd3df0a7fd25f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 155,
        "sourceEnd": 199,
        "text": "Good. What are you going to do this weekend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "964ac9ce525b872c6b91b8ea941fa5419ae09c68df2bad48ce3a93809518014a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 203,
        "sourceEnd": 256,
        "text": "I'm going to visit my sister. She was sick last week.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "22c662d4389f473641a0b85f8219a65e8fb10a88103397adfcb91ac7ad5a67d4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 260,
        "sourceEnd": 293,
        "text": "Oh, I'm sorry. Is she better now?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "10380dd02df221f4dee2c3dd0d56b0a072720c446f90b48740aa5ee10df89c33",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 297,
        "sourceEnd": 345,
        "text": "Yes, she is. She was tired, but now she is fine.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "794b2aa90f2dd94c3f45f20ef8bb498dc2f2d725a4f4141363fab6ea51c6e78e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 349,
        "sourceEnd": 386,
        "text": "Great. Are you going to take the bus?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1fe16365e08d117d1c079643d4f8308b3c11fe4981c28ab4178aeab1c62a3ff1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 390,
        "sourceEnd": 441,
        "text": "No, I'm going to drive. The bus was slow last time.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "9c717c027250e0cfbf0f45fcf5dabc7ed0e2693203697a8ef050d165e1418a18",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 445,
        "sourceEnd": 478,
        "text": "OK. And Tom? Is he going to come?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3bd1e697c097bf23c04e8aef27c72790c561b459ddf88ec8bc319abe48c22f3b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 482,
        "sourceEnd": 532,
        "text": "No, he isn't. He has a football match on Saturday.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ad2a1ba787599948d6f169d4312da36ddafbb03ba2d76a25fe7f0f274bd777d1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 536,
        "sourceEnd": 569,
        "text": "I see. Well, have a good weekend!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d30855aaff4764f320db132548b2e1ecf6fb1f8701ceb1f88677a57d72bb5185",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 573,
        "sourceEnd": 589,
        "text": "Thanks! You too.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "26a6b4ae7759c41eed13cf2728d2bfe9ef1c86dcf790a2d87b52768e4a2bc970",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
