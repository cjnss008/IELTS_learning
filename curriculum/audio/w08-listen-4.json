    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 33,
        "text": "Hi, Mei. How was your weekend?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "bf92a2b2efc1e1446820532822c5948ed025129455ee86dc9011ed6d76f0e1c2",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 37,
        "sourceEnd": 92,
        "text": "It was busy. On Saturday morning, I was at the library.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "af16f555468bf04606ebd07c0ea777409aafd7605525c5b923a93281d1d7f686",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 96,
        "sourceEnd": 109,
        "text": "Was it quiet?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "44694b844c95a461f39661add123e5e584083f4fc10277a1284ffae33996df48",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 113,
        "sourceEnd": 163,
        "text": "No, it was noisy because many students were there.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "36d5821023fa4867871c69accd0a584326de78fc61a82f2a03a12be7a03bc27a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 167,
        "sourceEnd": 183,
        "text": "What did you do?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "32189bb58790878bac0aa48d836d846f174da8e210c9160b5d9f85a0219edd33",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 187,
        "sourceEnd": 260,
        "text": "I read a book and I wrote a list. Then I was hungry, so I went to a café.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c83a7947a2bfdf35eda1e1d902c8466f54d60b01aa1e01172af950462397f2c8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 264,
        "sourceEnd": 284,
        "text": "Did you meet anyone?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "dbdfde0cd19b75752a2688b8e8ce2cefad6c147dbacfa25412fda82b69e21b8a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 288,
        "sourceEnd": 355,
        "text": "Yes, I met my friend Li. We were happy because the coffee was good.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c2cb4720ba167e5ec7c4dd84b07d7b97bbe81ccffae686cd678c3b8923ef9f6b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 359,
        "sourceEnd": 399,
        "text": "Are you going to go again next Saturday?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "6a273f9e2b87c122979c6849f346e31e10283281e0ece0c440892fb0624ca5e8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 403,
        "sourceEnd": 480,
        "text": "No, I'm not. I'm going to visit my parents because it's my mother's birthday.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "42521e115fcc1ff405c6c878d2d42e86791d31ce1965b9404dc58cd88f741ca0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 484,
        "sourceEnd": 501,
        "text": "That sounds nice.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c6342b6fae9a0b4cd6e27917a24a1de122ffa2060c145a2dea9ba67b0d974238",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 505,
        "sourceEnd": 542,
        "text": "Yes, I'm going to buy a gift for her.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fe3605062e95d28bbd58170d4796170321f3cd8c139465139f77f230c2370782",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
