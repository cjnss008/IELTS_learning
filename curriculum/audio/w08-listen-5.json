    "segments": [
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 5,
        "sourceEnd": 64,
        "text": "Hi, Tom. I was at the farm last Saturday. I was very tired.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ced70a0343d34e938fa602a8ad3f974809b4f3952a6bcc891b68fc2e9bdb76cb",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 70,
        "sourceEnd": 81,
        "text": "Was it fun?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "55f532b8c5b374bcd19e29181b3ec3234b2b8741bc80cf8be87aca9783e31438",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 87,
        "sourceEnd": 139,
        "text": "Yes, it was fun. We helped animals. We fed chickens.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7bde0df8e38f503a9c6da6f05153fdb22104fb03246237619288c0712599d81b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 145,
        "sourceEnd": 160,
        "text": "Were you happy?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4d523ed1a045a8b7c3c116a8b7c32ecb4edec875fed38301913be8ad226354cd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 166,
        "sourceEnd": 223,
        "text": "Yes, I was happy. But I was tired because I worked a lot.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3edceeb6c7c6b71823b7aa4e75725aeceaba463ca262fbf519115d932a881889",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 229,
        "sourceEnd": 268,
        "text": "What are you going to do next Saturday?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "38aa1b66453a3f71caf3fbfc97a15d2d47b8167d95329422685cb10e74abf597",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 274,
        "sourceEnd": 338,
        "text": "I am going to visit my cousin. She is going to come to my house.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "29adc200ebd664a2f63439ab38acc84559d108f17736fca20b8e66fe0a8587e4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 344,
        "sourceEnd": 366,
        "text": "Are you going to cook?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b07c2ee3bac3cd5f9ffd83ce361b380f7dce811466a46c0a2befd665080b0a8c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 372,
        "sourceEnd": 436,
        "text": "Yes, I am going to cook noodles because my cousin likes noodles.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "04b0917a0507d754348f2b2d7a2f525f19ebcad8663b5be91491865de229af98",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 442,
        "sourceEnd": 459,
        "text": "That sounds nice.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c6342b6fae9a0b4cd6e27917a24a1de122ffa2060c145a2dea9ba67b0d974238",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 465,
        "sourceEnd": 537,
        "text": "Thank you. I am going to buy some eggs because we need eggs for noodles.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "93b9c3006c0be7535dcd72278f8bfbd40b9ff673ac5a77339c1a192c7c66727b",
        "pauseBeforeSeconds": 0.65
      }
    ]
