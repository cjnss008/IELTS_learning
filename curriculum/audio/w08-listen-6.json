    "segments": [
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 5,
        "sourceEnd": 35,
        "text": "Hi, Tom. How was your weekend?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1c5dea6749741c205eb25a5326c78601a04be1f55dcbd825b1b3e20a508d318f",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 41,
        "sourceEnd": 90,
        "text": "It was good. I was at home. I was tired. And you?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5eacad82cea8f0c57ec1d6a28751185a4a4fdcc07e68433837ec4aa0a4ef12ca",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 96,
        "sourceEnd": 150,
        "text": "My weekend was busy. I was at the park with my family.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cc61048cebfb329bddf159b753b45562c7cc3e8e9457c89b2999765bcb4eba3c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 156,
        "sourceEnd": 200,
        "text": "Nice. What are you going to do next weekend?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0b803deb6c64bb9f79c3c245e251cd5209dc2c00ba57cc13076fdf183ede19dd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 206,
        "sourceEnd": 265,
        "text": "I am going to visit my grandmother. She was sick last week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8aa4561d5ccbeee4252634a3aeda0e8018e95e2e653f9fc85ebea01b543b89a2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 271,
        "sourceEnd": 297,
        "text": "I am sorry. Is she OK now?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e78f842519ff58e362787d8e2a35c1471714a1cf63466998a1766d0bf799c50c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 303,
        "sourceEnd": 380,
        "text": "Yes, she is fine. I am going to cook lunch for her because she likes noodles.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ff3e7b36b06d4a35820c9b8a7f0d701507337d484385cf8b1c0cb688bfe4f195",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 386,
        "sourceEnd": 450,
        "text": "That is kind. I am going to play football because I love sports.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "25e9da0664052803e5af201f5f49ec3c97c21c913af805bedb1a22d62e76bd8f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 456,
        "sourceEnd": 508,
        "text": "Good. I am going to go home now because I am hungry.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82d4f7d15478e418fd8884ab2ea04070a9fdb4454687c11f2d7ecd313cd04c55",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 514,
        "sourceEnd": 526,
        "text": "OK. See you!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8aae09f1407423e1a8e147782eac63b8721ebdc9a4b9bb9ea8a9d3495b2411c5",
        "pauseBeforeSeconds": 0.65
      }
    ]
