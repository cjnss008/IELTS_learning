    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 53,
        "text": "Hi, Ben. Do you have a study plan for this term?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "977b36f0481a605e793a45c4c61274220fba88947ccd794f8f3aa0053c793cdf",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 59,
        "sourceEnd": 180,
        "text": "Yes, I do. I usually study in the library after class. But this week I am studying at home because the library is closed.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6c22829b42c762ba688edbe16334a2eec7f7d49c977ae318f88c675337b149d0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 186,
        "sourceEnd": 215,
        "text": "Oh, really? Why is it closed?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "226cf4ea7b0a0725c3631742efac2fe4c35413acbae999f3e162e3738deb5098",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 221,
        "sourceEnd": 311,
        "text": "They are painting the walls. So I am using my kitchen table. It is noisy, but I can focus.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "370b770752f5cc0429bcb708ae4d673ccb38154f83dfcf41d98c21e0a336655d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 317,
        "sourceEnd": 352,
        "text": "Do you always study in the evening?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c9056b2664ba9ba417ebbed3a617d0f4d4924d413cdd10b05cb6bf7290de5237",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 358,
        "sourceEnd": 519,
        "text": "No, I don't. I often study in the afternoon. In the evening, I sometimes watch English videos. But I am not watching videos this week. I am preparing for a test.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3e0f8bd40c6af3b079bebb091c5dd5c85b4e924d550a708c7bfb9177f3ecde77",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 525,
        "sourceEnd": 543,
        "text": "A test? What test?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e9fd01bb8ca4c9f3c4f4d46f84fd3bf16198e6fb475a535988422ff331e986fe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 549,
        "sourceEnd": 601,
        "text": "A math test. It is on Friday. I am a little nervous.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "62b8ec67ed827338de60a81462dbffb33d371af0d665aa9faf1faee9d7b819be",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 607,
        "sourceEnd": 642,
        "text": "How often do you review your notes?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "136f872e37cd0af0c5720f267996862e1b8a5a1a206135affd509ca5b6dce7f0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 648,
        "sourceEnd": 786,
        "text": "I review my notes every day. I usually review for thirty minutes. But this week I am reviewing for one hour because the test is difficult.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6bcd972e87b41b50b9fd619d0b8778c714ec43675038941bfbe08a4f6f7f43bb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 792,
        "sourceEnd": 818,
        "text": "Do you study with friends?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c9c0d26749182cc966ce10cec91ad089224f0abb62cc95abfb808b6cbd222aff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 824,
        "sourceEnd": 936,
        "text": "Sometimes. My friend Leo is very good at math. He helps me. But he is busy this week. He is visiting his family.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "639338811ee0bb21cdfcba415954e6ce33b78095f068242ab0a5dbf9e05b76d6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 942,
        "sourceEnd": 972,
        "text": "So you are studying alone now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d212f5ad776c88d9047ef8db864b96811354c63a05daa0b7416f5a7f10e0b9f4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 978,
        "sourceEnd": 1056,
        "text": "Yes, I am. But I don't mind. I listen to quiet music. Do you study with music?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1cef9211db0a5c364d46221e7e6655476e9431c083e1388cc5fc407309671d11",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1062,
        "sourceEnd": 1139,
        "text": "No, I don't. I need silence. I usually study in my bedroom. It is very quiet.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3bb25f90cbbff47f34a3e633f704a8a8b75323f9691de01dacef5e902c990cf0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1145,
        "sourceEnd": 1196,
        "text": "That sounds nice. Do you have a goal for this term?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9babef661088f8824c0be504090915ab04d8439b0658340342363403eabc5b4c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1202,
        "sourceEnd": 1347,
        "text": "Yes, I do. I want to improve my English. I am reading one short book every week. I also write a diary in English. I do it every night before bed.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "974af82937b4c4ff66f2b51f75d3ae5829169b0a4bc98468c728baf868a3c761",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1353,
        "sourceEnd": 1398,
        "text": "That is a good habit. How often do you write?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "46fdd0ba88eddd55f7aed9964c8b2efde8c65e15c1c9c2284b121f0406dabd16",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1404,
        "sourceEnd": 1471,
        "text": "I write every night. But I am not writing now. I am talking to you!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "571bb0cf3b3364f0c51bb8cb33254d78d1d5aa504b28553b5c7c4c7a5e9b1c3a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1477,
        "sourceEnd": 1529,
        "text": "Ha ha, true. Well, good luck with your English goal.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1fe87470341c220ad4223636d80c78afb7db7f96857d81b9d94e30c03f0b9a17",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1535,
        "sourceEnd": 1573,
        "text": "Thanks. Good luck with your math test!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5cd8d2ab7540fb2e8c4ed2c50cee9c06d7161603197d8d83eece84d05ade8520",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
