    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 32,
        "text": "Hi Leo! What are you doing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "dbc8d16ac6f6d7c1022b16f144083e4961219f14e684d4738d6e648d64749a8e",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 39,
        "sourceEnd": 101,
        "text": "I'm making a study plan. I have a big English test next month.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "36eeb955bcb6ca36d318b51c49e95e1076fd26a4c429e32633fc14502825ce8b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 108,
        "sourceEnd": 145,
        "text": "That's great. Do you study every day?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "efcb2a4a9839570f0b39f94c06ca134786c3a9bd50c64985050ea765dbc09cd5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 152,
        "sourceEnd": 206,
        "text": "No, I don't. I study on weekdays, but not on weekends.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "66b61f4881530817fcae7255b23b01d0969f6dc16c843e8e30f8ef10ba8cac9f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 213,
        "sourceEnd": 244,
        "text": "How often do you study English?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7a081ecde3173ec4dabe431f5ca627122802ca3f3cc1eb8fceca0fc5f11c242a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 251,
        "sourceEnd": 333,
        "text": "I usually study English three times a week. Sometimes I study with my friend Anna.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d2dbd77b16eb84a5b7d87fcebfa5e552e6ec3e4bcbde0c1119d671da93f52153",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 340,
        "sourceEnd": 378,
        "text": "Does Anna study with you every Friday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d9653be9c959e8838adc85dec9b40dcbcbc6ec3d631e9ec31610975122720251",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 385,
        "sourceEnd": 452,
        "text": "No, she doesn't. We study together sometimes, but not every Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "69729e922d29fc4955de1324c14d075aefd6ce267c45fe8bbdca620750bde401",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 459,
        "sourceEnd": 490,
        "text": "What about your other subjects?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "00dbc6bbc7541cdcda2185c0316a3d7f58b67378a0ef1434328217e4ca041abb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 497,
        "sourceEnd": 588,
        "text": "I always do my math homework after dinner. I sometimes review science notes in the morning.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8bb087228dc42301ef09f3be68c50e77725461b40e994589902fc15c85c1bf1f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 595,
        "sourceEnd": 630,
        "text": "Do you have a favorite study habit?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "490afa70f50f1cfd7b8138073dc0d0596db5e21a7f76d96627342bd7feb6f261",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 637,
        "sourceEnd": 706,
        "text": "Yes, I do. I make flashcards for new words. I review them on the bus.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "80578b83dff2ad1cda407b09eaa6d5b2bd69a4ffdd47c62265b7ee30251331d5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 713,
        "sourceEnd": 771,
        "text": "That's a good idea. Do you listen to music when you study?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "da405f494a7fc143cd186e9160a00afe818030b43f59f26a9958e860f1a99fbe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 778,
        "sourceEnd": 836,
        "text": "No, I don't. I need quiet. But my sister listens to music.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f5cf677608b326e2c9b66a762a7692e46efbbb4ebc65ec826a156880721fd693",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 843,
        "sourceEnd": 875,
        "text": "Does your sister study with you?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3d848e17adb9d465fce2e1aac18b8c868746d0e5d8123669402e98c578c126f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 882,
        "sourceEnd": 923,
        "text": "No, she doesn't. She studies in her room.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "479dbc583f8bd0ad9b1728436424cbb92694e448c1f15d33edea4ae1a4f45eb6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 930,
        "sourceEnd": 953,
        "text": "What are you doing now?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d30c08fe20f592210491b4727778797b001c67a307c42cc990c1bebbe0ded650",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 960,
        "sourceEnd": 1009,
        "text": "I'm writing my study plan. I'm also drinking tea.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c33d79b6e908cc69234863c8579a179a2205a4683314c55ae3506cb69364f68f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1016,
        "sourceEnd": 1041,
        "text": "Good luck with your test!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1f18ad80eca08e7d41a822ae11308a2b1a15f34bd4c22ae6f9a764cbe62f7620",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1048,
        "sourceEnd": 1055,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
        "pauseBeforeSeconds": 0.65
      }
    ]
