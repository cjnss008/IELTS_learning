    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 51,
        "text": "Hi, Mei. What are you doing here at the library?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "27796c897f2f4ac426cc7b4561b4529f9db7455048a69367f347974296e0e124",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 55,
        "sourceEnd": 136,
        "text": "Hi, Tom. I'm looking for a book about study habits. I want to improve my English.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c689219fac13979c46f1a89aa53429fea01b85514ed52b4055c5445a7b302b54",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 140,
        "sourceEnd": 185,
        "text": "That's great. Do you study English every day?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "800d15ad50b2e0b1af6b26ae02832a73bf15884217bfc50d64edf0eac2f6e95a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 189,
        "sourceEnd": 273,
        "text": "Yes, I do. I usually study for one hour in the evening. But sometimes I'm too tired.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "182ac871b591139496a19059ecda136eb4b51e0241547cf96390b73a4ab2040e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 277,
        "sourceEnd": 300,
        "text": "What time do you start?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5f6ff77ee64f77c465b5fe071cc60330dc57ad3c383053ddf04cf5bc0bd3eedf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 304,
        "sourceEnd": 380,
        "text": "I start at 8 p.m. and finish at 9 p.m. I always review new words before bed.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e090c23d4ca44315fa90d851f1f94504285837bdd89050ebf31e0d36c6a9237b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 384,
        "sourceEnd": 410,
        "text": "Do you study with friends?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c9c0d26749182cc966ce10cec91ad089224f0abb62cc95abfb808b6cbd222aff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 414,
        "sourceEnd": 504,
        "text": "No, I don't. I prefer to study alone. But I often listen to English podcasts while I cook.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "03f1b9b7ba9ad4b003dfeeb7b80fee4a62c107437960a2a55b00708277baa2b9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 508,
        "sourceEnd": 546,
        "text": "That's a good idea. Do you take notes?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c29f0812b7197c0f6fbee43fd9211a015ac76eb11fdd21ef72f4f37544a1a2f0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 550,
        "sourceEnd": 643,
        "text": "Yes, I do. I write down new words in a notebook. I'm also watching English movies these days.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4488374dcbbfb9ac32cc215fa634fe7891af410709374c43fa7d79bcc61e1788",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 647,
        "sourceEnd": 678,
        "text": "Are you learning anything else?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "26461faf725beee71bc8aa3973a5add9c8d209d1b80833ec43d88ebddab12c6d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 682,
        "sourceEnd": 755,
        "text": "I'm taking an online course. It's about grammar. I have a test next week.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2373a669dddaba5cdf09b2013162246eea838436b2c1c85d079e809648362f27",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 759,
        "sourceEnd": 795,
        "text": "Good luck! Do you have a study plan?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "81ce681c0acf8b8f0c3792eaef4a41138301a8da788147865d4564453ff1c79f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 799,
        "sourceEnd": 880,
        "text": "Yes, I do. I make a weekly plan every Sunday. I write down my goals for the week.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d656a356e7002a63e523b8ea234ced1f40759860c2b5732c7971440dec7ca8f2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 884,
        "sourceEnd": 947,
        "text": "That sounds organized. How many hours do you study on weekends?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82025c45f540240157df52de710aac1a9712a4a3486c8df66b3b3ee26c9010c4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 951,
        "sourceEnd": 1052,
        "text": "I study for two hours on Saturday and one hour on Sunday. I sometimes take a break and go for a walk.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "001cd9cf18b78f01651edf2600495855f3c3a67e4077e2de00e180e1dba0f270",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 1056,
        "sourceEnd": 1094,
        "text": "Do you think you will reach your goal?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "46d89e73d3a25ffddec16a8c18b275fc1ec38cb419d10880e342f050827272fa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 1098,
        "sourceEnd": 1178,
        "text": "I hope so. My goal is to speak English fluently. I'm working hard to achieve it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a2847f09c882f244b175d231349e983dbe269e0fa1d389a07799d82dce9a1511",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
