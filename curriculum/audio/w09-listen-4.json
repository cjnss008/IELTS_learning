    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 73,
        "text": "Hi, Ben. Do you have a minute? I want to ask you about study habits.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b730cdf65123ff9fac2f00630368969844856f4aaa556167b3d9ec0eaf96cedc",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 79,
        "sourceEnd": 115,
        "text": "Sure, Mia. What do you want to know?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "23ebb8ffe958c296607452b310d94273b8f7f91fe32b909e3e70b6a1844b56da",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 121,
        "sourceEnd": 192,
        "text": "Well, I always make a study plan on Sunday evening. Do you make a plan?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0ee083599dba9ef93374e39a500bb66ecb8272d526b8eab874052f1cd1326797",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 198,
        "sourceEnd": 274,
        "text": "No, I don't. I usually study when I feel like it. But I often forget things.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5cedaa4e42102c685bb35b173cc3adf6e8d2704946c98eae2fc4c958739e0525",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 280,
        "sourceEnd": 361,
        "text": "I see. I usually follow my plan, but sometimes I only do a little when I'm tired.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9b05eddcbdd720c26636362b2f9878861337c7d0cfc59c8a6412680b253d6087",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 367,
        "sourceEnd": 421,
        "text": "That's still good. How often do you review your notes?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8049cfa275ff057f31e42d4ac786ced992350e9e156d3006cc9c587fa0385975",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 427,
        "sourceEnd": 504,
        "text": "I review my notes every day. I usually review for twenty minutes after class.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "136b41f940946cf882fe48a1f1e6736b24e95725f7b4a020096ea479d9c58ee8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 510,
        "sourceEnd": 585,
        "text": "Wow, every day? I only review before exams. How long do you study each day?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9c99dbce2b27f4e872b2ffc4987eb727c15d3bd3e7747385055d2a3adf6f11b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 591,
        "sourceEnd": 676,
        "text": "I study for about two hours every evening. I take a short break every thirty minutes.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b082a6cbc05fb120c97a81f0bd5df5c5e1b2f6f5687c259bb863dafb070e0e56",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 682,
        "sourceEnd": 721,
        "text": "That's a lot. Do you study on weekends?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b4c3a6ee3e6f1e985ea7a14b15bcb4e7281a6f46be42cc9d2cc1ccd56310e3ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 727,
        "sourceEnd": 817,
        "text": "Yes, I do. I study for three hours on Saturday morning. On Sunday, I don't study. I relax.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e785590f05131eb4aa57e18ac7617b1c8434b9577a9a7c009a5f0fa8a55f3c03",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 823,
        "sourceEnd": 893,
        "text": "That sounds nice. I sometimes study on Sunday, but I usually watch TV.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3f97682a70b70690890ab01f9bd65270db1473e45352d38ce5172634cbe9513e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 899,
        "sourceEnd": 925,
        "text": "Do you study with friends?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c9c0d26749182cc966ce10cec91ad089224f0abb62cc95abfb808b6cbd222aff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 931,
        "sourceEnd": 998,
        "text": "No, I don't. I study alone. But I sometimes ask my sister for help.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "17b8d4219816f24fe1813ca6beb9427ad8399c8a5fa696fa8f0340199a1d099a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1004,
        "sourceEnd": 1075,
        "text": "That's good. I have a study group. We meet every Friday at the library.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3f2b80c2b4ad009ad1bc25ac591b701ef5b62edfa6c1258f88d045160ed17ce1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1081,
        "sourceEnd": 1115,
        "text": "How many people are in your group?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2e2eb6f19e53181b0d1f0221dd5dbf4f38b186d4cf72eb5a25790808b09160fd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1121,
        "sourceEnd": 1187,
        "text": "There are four of us. We help each other with difficult questions.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "14133562ee2e9af67c0b970fde9f011b847351a05fd3cb2ec1aff50664e38bb1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1193,
        "sourceEnd": 1241,
        "text": "That's a good idea. Maybe I should join a group.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9053ffa0e69cdccd840bd61583c85989b8ee60f9fbcddd18e5e351175a02071b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1247,
        "sourceEnd": 1302,
        "text": "You can join ours! We are meeting this Friday at 5 p.m.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2dd846331606bdb6b41afb49faaca7274d672d0e156b034f7a346cb0a3ce9896",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1308,
        "sourceEnd": 1338,
        "text": "Thanks! I will think about it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8ffead1994ebe2e7fbfe3712806c6712b4259d6c3ae4a7937399230e74ccd1a6",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
