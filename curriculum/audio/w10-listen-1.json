    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 44,
        "text": "Hi, I'm Lin. Welcome to my new apartment!",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "63133258f21e20cd4ad402cc02e801bb5bded9fa6932c927571d70331ef9319a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 49,
        "sourceEnd": 92,
        "text": "Thanks, Lin. It's nice. Is there a balcony?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e15adf2011e2a49191dd419f1a3e8fcc525dd6fff79d758226fca4a9b2df0685",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 97,
        "sourceEnd": 150,
        "text": "No, there isn't a balcony, but there is a big window.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "764a34a0749fff693393700e6af399dd4ebbaa38faac5c6ae5331fbd686b150b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 155,
        "sourceEnd": 192,
        "text": "Oh, I see. What's in the living room?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "27f46ed24c5f4062be6c9f6fc0815f036bdaacf2665c15a6f2c62fe62c0ffca0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 197,
        "sourceEnd": 244,
        "text": "There is a sofa, a small table, and two chairs.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "bda331799a08b45c6835a159f874420a1764087bb92badaa79c044ff89ca36b1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 249,
        "sourceEnd": 282,
        "text": "Are there any books on the table?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e80844e4c95bdb6fc55c99177a76f454240c6f1e54279effd137ecfd970332c8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 287,
        "sourceEnd": 337,
        "text": "Yes, there are some books. They are English books.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2d03b6a8fb69e515acdc2f33920d7af11a471ebce66cbb713b7fb87c26cdfccd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 342,
        "sourceEnd": 356,
        "text": "Is there a TV?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "a4444fc4f78f33d341875ff6686f187d4e06be905297d8d9efb131a8f7f9ca7b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 361,
        "sourceEnd": 400,
        "text": "No, there isn't a TV. I don't watch TV.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "f8589e4d6ae9dd05975caef9ec450b084c2de99b2e8e7a910fe36d891622a876",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 405,
        "sourceEnd": 451,
        "text": "OK. What about the kitchen? Is there a fridge?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "b362e32497d3d30a0a25091b42852eaaa375a77021a1c92bfd6300ad4065f65e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 456,
        "sourceEnd": 532,
        "text": "Yes, there is a fridge. There is some milk in it, but there aren't any eggs.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "a96a110b1fefb5eae79ce961f412d1b29e5995440dc84505671536af62d64786",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 537,
        "sourceEnd": 567,
        "text": "I see. And are there any cups?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c970493844898a52b7a8e086e418cd5299435b50d25b94569fbce608095776e5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 572,
        "sourceEnd": 610,
        "text": "Yes, there are some cups on the shelf.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c73423679a656a01bfce0511a937397d289e39f7efb57776e97a96bd8c1695a8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 615,
        "sourceEnd": 636,
        "text": "Is there a microwave?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "871deda9c846b5cf42a5d6b54a2e17f58d9fc9c851c590595cfc5012bd249f88",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 641,
        "sourceEnd": 669,
        "text": "No, there isn't a microwave.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2bcce05b0dd114d0b67fbdb5f8c2f13df5be7217061cabb80d7fb884499e6a50",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 674,
        "sourceEnd": 696,
        "text": "What's in the bedroom?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "2fe62c516f35e4efa42612eff983336249d33ecda11aa8dd3754da475ac15571",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 701,
        "sourceEnd": 756,
        "text": "There is a bed and a desk. There is a lamp on the desk.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "78cc12b86454aacfa07e63ff8af3579b03e7de40291358c325ad3090aceafc06",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 761,
        "sourceEnd": 796,
        "text": "Are there any pictures on the wall?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "de24bf5c051778d5eefd374f5a993aa0106aa1b546de35e6a5fcee5dbede181e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 801,
        "sourceEnd": 859,
        "text": "Yes, there are two pictures. They are photos of my family.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b8e95cef6d9e250ea8eb38fd59e93a68924b17a9784347d76b8e861df4a1ddd6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 864,
        "sourceEnd": 884,
        "text": "Is there a bathroom?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "8ed28d916005d8862fab6e480362ea886612190cc77f456d47bd015a10c296d7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 889,
        "sourceEnd": 966,
        "text": "Yes, there is a small bathroom. There is a shower, but there isn't a bathtub.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "385139b95455d2c87907ec12513f0dbddc81fe71510f9bf125df58432ff9115e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 971,
        "sourceEnd": 1008,
        "text": "Thanks, Lin. Your apartment is great!",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "fbf63cf5b848146351b8120ed82e790921fb2fe8e41788044fefbeae1754700c",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
