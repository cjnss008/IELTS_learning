    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 33,
        "text": "Hi, Lin. How is your new flat?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1dcc3d1114dd6f11cae642be9f92593604952309bd8e3d4fc2c916ef9d759091",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 38,
        "sourceEnd": 85,
        "text": "It's nice, thanks. But there are some problems.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e8da8a346b10de5f88ec8b806bec53420238209e646e5fe3ea7c67608a39d650",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 90,
        "sourceEnd": 108,
        "text": "Oh? What problems?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bde8a22fd8c20410861803bc01ca856a26afff41ea269824a81eed0012bd9ed0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 113,
        "sourceEnd": 181,
        "text": "Well, there is a small balcony, but there isn't any furniture on it.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f1e5359360ee567678fe8be2a3457604457159284632099560a3cc21d55eeb08",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 186,
        "sourceEnd": 196,
        "text": "No chairs?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "95e47d109ce48436bbfb07d31787a9b06a9250d87d0fade36aed4246e0e77629",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 201,
        "sourceEnd": 258,
        "text": "No, nothing. And there are some boxes in the living room.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b3b19272105d53716eefaee747e1fd30773d63cb8dd229ff1076d7ec03c9a8d1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 263,
        "sourceEnd": 269,
        "text": "Boxes?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bbab529b50750008b43f10f2f2a934808711bf4dff7276e6671c175f71cd2ec2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 274,
        "sourceEnd": 317,
        "text": "Yes, from the move. There is a lot of mess.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d9cdee2ec3b04e527ee653b1b4389df37b4158b7b3715cc3d4bcf6c725934fd6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 322,
        "sourceEnd": 354,
        "text": "Is there a table in the kitchen?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7127315e354856068c82d1d8b5347c8e781a5b84ee7d32b272d07e39d78cd4c2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 359,
        "sourceEnd": 416,
        "text": "Yes, there is a small table. But there aren't any chairs.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82f2c614c40a0abff28210a00ae5fdf08f608fb10c24049237fd384d2376f686",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 421,
        "sourceEnd": 431,
        "text": "No chairs?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "95e47d109ce48436bbfb07d31787a9b06a9250d87d0fade36aed4246e0e77629",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 436,
        "sourceEnd": 479,
        "text": "No. And there isn't any milk in the fridge.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4f6a7a8a495e0e24d063f70b324128f6dc709cc9a9fded4218aaf35ca1c66c05",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 484,
        "sourceEnd": 506,
        "text": "Do you need some milk?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6e652119d4cd7d44a658650b03e8805be6600601bffc6942f36924aa4a0375de",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 511,
        "sourceEnd": 539,
        "text": "Yes, please. And some bread.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0bbc98cad33b300bfa6e961006571073c05ad185fb2e223953ab9253826354ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 544,
        "sourceEnd": 583,
        "text": "OK. Are there any shops near your flat?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b8b4f934857aa8df6f9832e34314b9ddf0a9353d193b6d843ac3fa463b7da35c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 588,
        "sourceEnd": 639,
        "text": "Yes, there is a supermarket. It's next to the bank.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d9384d7a422247d2f694c5420dc87b329c68fc2556869d07d047ce18197208ec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 644,
        "sourceEnd": 666,
        "text": "Good. Is there a park?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f872e33a69b1f5b688ca06ecaf800edf74f724ef0c6cc038354210362762776f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 671,
        "sourceEnd": 715,
        "text": "Yes, there is a park behind the supermarket.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0fa0801157d9aab1ff696f9a109d5132e8d25a30838a7018b4b6cb3a0af58e99",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 720,
        "sourceEnd": 750,
        "text": "Nice. And is there a bus stop?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6bb67fd39f381a6970043e8499af7c19dbdd47b248b299c7e81ecfa45c2aa25a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 755,
        "sourceEnd": 781,
        "text": "Yes, in front of the park.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "940dcfa2667fe04e2fa9c1477cc20642e5443aacff09e471054656c7471e91c7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 786,
        "sourceEnd": 836,
        "text": "Great. So, no chairs, no milk, and a lot of boxes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "14e5b1e2e4832998395ef9c45733999ecad5a38c4065e9910d10feb8b3745bde",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 841,
        "sourceEnd": 871,
        "text": "That's right. Can you help me?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "64aefa577fe83adcaf22970e45e5ab710165e0a5e6a6266b6b8f5e18ac435981",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 876,
        "sourceEnd": 906,
        "text": "Sure. I can bring some chairs.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "66d896942474265b4d61e539e519f2480abcb255849d43c6409bad6038e1afe4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "f",
        "speaker": "F",
        "sourceStart": 911,
        "sourceEnd": 918,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
