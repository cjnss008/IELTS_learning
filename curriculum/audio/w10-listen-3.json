    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 34,
        "text": "Hi, Lucy! How is your new flat?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2853f01d1d598e907df9e26738d2ca7e47336d73fc2eb3b42951329e5f48555b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 38,
        "sourceEnd": 85,
        "text": "It's nice, thanks. But there are some problems.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e8da8a346b10de5f88ec8b806bec53420238209e646e5fe3ea7c67608a39d650",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 89,
        "sourceEnd": 107,
        "text": "Oh? What problems?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "bde8a22fd8c20410861803bc01ca856a26afff41ea269824a81eed0012bd9ed0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 111,
        "sourceEnd": 183,
        "text": "Well, there is a big supermarket near my flat. It's very noisy at night.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "bb8f73933cde8dce42a40237d241583fe0ea4c5f913c61f2d77b0ace450a596a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 187,
        "sourceEnd": 230,
        "text": "That's bad. Is there a park near your flat?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e207f404a8d9d66e4841902a7b3ac654e8c5b7ac28bfb88d21cb8e4cdd22d597",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 234,
        "sourceEnd": 299,
        "text": "No, there isn't. But there is a small garden behind the building.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "518e2d41388b51c930275e31d6ef19e0e4c6b9b3f06f3287cb022e514c97564a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 303,
        "sourceEnd": 329,
        "text": "Good. Are there any shops?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0418d57d1d9b81692f5b046c600244696c892f296455e9d00cd0dce783b9b54a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 333,
        "sourceEnd": 396,
        "text": "Yes, there are two shops on the corner. But there isn't a bank.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "260549da5e20232baf471a9740e7ca00eb7210c85f47309d888c9f23fd20e058",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 400,
        "sourceEnd": 422,
        "text": "Do you have a balcony?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "cb688736fa754cd1f968aa7417d29f1d45f7298e15ab99e82351d48279181af1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 426,
        "sourceEnd": 479,
        "text": "No, I don't. But there is a big window in my bedroom.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "b818475d9e79228a79f23f0cfbc5ff8e56d412058284f57c0d055e44795b34f3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 483,
        "sourceEnd": 511,
        "text": "Is there a lot of furniture?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b95f80c63664e82474f7ee6b6aab148f175a12ef59eb459e8ac6cd1fc0125ae7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 515,
        "sourceEnd": 585,
        "text": "Not much. There is a bed, a table, and two chairs. There isn't a sofa.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "fbfe32adb0429b3cefab66219a8cb74de8bb7b09ab0416401b0a8569a94a151e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 589,
        "sourceEnd": 612,
        "text": "What about the kitchen?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "44d0fe784f93fbeced2d404eb7076262f7ab4552bf3dcfb87678321356449c93",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 616,
        "sourceEnd": 687,
        "text": "It's small. There is a fridge and a cooker. There aren't any cupboards.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "8623e8a755065f7f3b5784f1cf32872b6843ce9bdcf4b4725797de01a4792318",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 691,
        "sourceEnd": 711,
        "text": "Oh, that's not good.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "fa5c233fb537ed722ebe608a917d90946b5714f6c214167bfe31b214e90c40e3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 715,
        "sourceEnd": 768,
        "text": "I know. But there is some space for a small cupboard.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "443d86863a3940f9ea09c1ec2a11347acf87d1272f6acd919e3e8d3d23b14094",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 772,
        "sourceEnd": 793,
        "text": "Do you like the flat?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c78f1bdd14c9e50930554d0454c19a5929b81c7ef498c494d3389230c6caff30",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 797,
        "sourceEnd": 834,
        "text": "Yes, I do. It's quiet in the morning.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "a8bdd3c57ee5ed317b9e37fc82c955b8e3c2ca039410c4eca7009fe16e523a20",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 838,
        "sourceEnd": 880,
        "text": "Great. Is there a bus stop near your flat?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "fba60c73781b61f9dbddbfdefc815b49342e9752e4eab8c9e0599c4ae69fec9e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 884,
        "sourceEnd": 932,
        "text": "Yes, there is. It's in front of the supermarket.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "0dea6dc56ff6ec69c9a172b10a2603b26214228ae6578620d0682fbcc8b30bf0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 936,
        "sourceEnd": 954,
        "text": "That's convenient.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "d7b15c633ad6672f37c3deedff198fcbfbf5c19074ccd950eab2e0adb49cf479",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 958,
        "sourceEnd": 1004,
        "text": "Yes, but there are many people in the morning.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "64bc92a6c1dc61358d90c6f4e1e1ecd47ed3056cc260fae1acec88842eee24bf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 1008,
        "sourceEnd": 1050,
        "text": "I see. Well, good luck with your new flat!",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "8419df96dc4811c4728dc625f0d1cd0ae92ad97e300e19f5872e37010e0dde52",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 1054,
        "sourceEnd": 1061,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
        "pauseBeforeSeconds": 0.65
      }
    ]
