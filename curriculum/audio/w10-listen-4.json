    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 34,
        "text": "Hi, Lucy. How is your new flat?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e1d9cd98ce3196ede4525c1ca9845ea6842b27b693d041f53f8151a21088ae88",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 39,
        "sourceEnd": 86,
        "text": "It's nice, thanks. But there are some problems.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e8da8a346b10de5f88ec8b806bec53420238209e646e5fe3ea7c67608a39d650",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 91,
        "sourceEnd": 109,
        "text": "Oh? What problems?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "bde8a22fd8c20410861803bc01ca856a26afff41ea269824a81eed0012bd9ed0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 114,
        "sourceEnd": 207,
        "text": "Well, there is a big park near my flat. That's good. But there isn't a supermarket near here.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0f63794bdf71336bfd10dd2f7da4ec5d95256a86568d7206b71805e074aa0e15",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 212,
        "sourceEnd": 236,
        "text": "Really? Is there a shop?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "49985e965eb7ab11f7fb92704e692e2f900e4649774bc3265229f6ad61b0aeee",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 241,
        "sourceEnd": 336,
        "text": "Yes, there is a small shop, but it only sells drinks and snacks. There isn't any bread or milk.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0cc981dc96ae80f089d99f26ea7a4ee27e4652dc5dd97e1ba3e913fcf478e825",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 341,
        "sourceEnd": 398,
        "text": "That's not good. What about the flat? Is there a balcony?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "7f9091bbd263c55dabbdd2079a788392301bab398cb792f98a8feaff80de760d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 403,
        "sourceEnd": 475,
        "text": "No, there isn't a balcony. But there are two windows in the living room.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c14fab4dac5c15e5df089f0686df3ac3cbc8b82a80801eb2a7f60cd87b018fa6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 480,
        "sourceEnd": 501,
        "text": "Are there any chairs?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "83b143b64a1b41e0d9a04b9f4d7ce5038d88e9669ac6bea9933beda6c18399c5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 506,
        "sourceEnd": 558,
        "text": "Yes, there are some chairs, but there isn't a table.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "305376f2daa121d3cc47a3734d8f5a5b748ba1fb09bbaaac9028ffaf2b5d6ef7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 563,
        "sourceEnd": 588,
        "text": "No table? How do you eat?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "af11538f4b72168619107b61816ee461840be4c50b2674a69e0d128a2c5508ac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 593,
        "sourceEnd": 620,
        "text": "I eat on the sofa. It's OK.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c97d61a702ff6278294f281e35680475e87b7269cd38cca44190ee82129e07cc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 625,
        "sourceEnd": 640,
        "text": "Is there a bed?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c86b12954811fd212d345f87c7690c666d2d3997293bb50d14126a21bf1baaa8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 645,
        "sourceEnd": 719,
        "text": "Yes, there is a bed in the bedroom. And there are some books on the shelf.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "819ed7db21f7e965bf855d466850fc7be9d3561b924a3acd8c986c20b8fda7e0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 724,
        "sourceEnd": 765,
        "text": "Good. Is there a bus stop near your flat?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "0ca217e8cd41102da73322312f66bbc2d5b48f462a6a59f1c43f30fcda6d3982",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 770,
        "sourceEnd": 832,
        "text": "Yes, there is a bus stop in front of the park. It's very near.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "826deb45754aa80ccadd347929edeeb661bf0735b171c67586b0bef61b27a1d3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 837,
        "sourceEnd": 876,
        "text": "That's good. Are there any restaurants?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "7da015402d4a376d0b303a8db5199720c2a8953cf96613abaa5abfbcadcc5542",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 881,
        "sourceEnd": 962,
        "text": "No, there aren't any restaurants near here. But there is a café next to the shop.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "777ad9a84e2819922d6896eb86f7a863555c143f2af07954e8db89dd1fa5cc19",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 967,
        "sourceEnd": 1003,
        "text": "A café? Nice. Is the café expensive?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "db5867d1b16200be4f21697356e79a8105be5a25ac4e5d3edeba95e41fabaabb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1008,
        "sourceEnd": 1052,
        "text": "No, it's cheap. A coffee is only two pounds.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "eea7775775ea262978beea06fd66e4e81914351f23e28cba31b4edac24b1c470",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1057,
        "sourceEnd": 1099,
        "text": "Great. So, are you happy in your new flat?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "593d308bf48031c500bf60f1f87d3294ef96640c0d31a89845c4dbb5f508080a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1104,
        "sourceEnd": 1166,
        "text": "Yes, I am. The park is beautiful, and the people are friendly.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "214a9ff8271a7ee6577cbe9def3308b17f4b07e1a6a53bfd3d2a5556f7c20918",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1171,
        "sourceEnd": 1209,
        "text": "Good. Maybe I can visit you next week.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "9c55566bdace572be47006ebc98d7814e8ea262612b5b3939191706c7aca09b9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1214,
        "sourceEnd": 1290,
        "text": "Sure! But remember, there isn't a table, so we can't have dinner at my flat.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "98c82ac3a363ecc3cc71644e15fe0dc932dc27a28672c4179cc37e0c41bd262a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1295,
        "sourceEnd": 1325,
        "text": "Ha! OK. We can go to the café.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "063f3b4b30288922fdf203e830c031116537b4f64fa88bc5819c00d49f681461",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
