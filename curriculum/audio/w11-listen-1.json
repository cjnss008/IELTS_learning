    "segments": [
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 7,
        "sourceEnd": 36,
        "text": "Good morning! Can I help you?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3d4bf06b512ab61d08a55b7140f17dae28c37e6ca61f3daa7d96dab69fc7ccf5",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 42,
        "sourceEnd": 128,
        "text": "Yes, please. I want to buy some fruit and vegetables. But I don't know what to choose.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "7647465463345094905f57573d3eee3ac0ea563b0b493053d653dbdbf4629ef0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 136,
        "sourceEnd": 172,
        "text": "OK. What do you usually eat at home?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "deaf3f95ac9f7a4a5cd3f5b5c1d416b282078ddcc6262abc8a4d59199470449e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 178,
        "sourceEnd": 297,
        "text": "I eat a lot of rice. And I eat many vegetables, like carrots and tomatoes. But I eat many sweets too. I love chocolate.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "70b1ce6dbfbfec49e134232ea172b6b1bad762082d5196d20d7679c574680056",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 305,
        "sourceEnd": 416,
        "text": "I see. You should eat more fruit. You should not eat many sweets every day. Sweets are not good for your teeth.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ae5869c9428904d1bcf299525eaf8055add26ff5dae84211ed3f44209e5f5012",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 422,
        "sourceEnd": 487,
        "text": "You're right. I should buy some fruit. How much are these apples?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "bce0cef07a0717a70aaaacad4a8a4df4b27185286e7cd5bf953020f504afc236",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 495,
        "sourceEnd": 600,
        "text": "They are two dollars for one kilo. And these oranges are very sweet. They are three dollars for one kilo.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "83b0584582f8f013b99d56e0edf51cef7647ca81f1577a607834e0b450e8fd55",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 606,
        "sourceEnd": 711,
        "text": "OK. I should buy a few apples and a few oranges. And I need a little sugar for my tea. Do you have sugar?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "de9c28cd04835077f7fdb82b9bd9c6af3b6db1f0c5c7def01133eb21406fa7c7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 719,
        "sourceEnd": 799,
        "text": "Yes, we do. But you should not put much sugar in your tea. A little sugar is OK.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "5ee3ab5065d33acafbd24405d2fb0fc3f9155dbb8dbb19cf0c1beac8946f04d4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 805,
        "sourceEnd": 890,
        "text": "OK, I understand. I should buy only a little sugar. And I should not buy many sweets.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "04ea41effe11389cf5db838945c185ae8bb43a31a0843dbfd4d2f482c4b64a1c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 898,
        "sourceEnd": 967,
        "text": "Good. Do you want some bananas too? They are one dollar for one kilo.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3f8e4043e72bcfe7a7b0bac0c73c5d325fb3dadeae38fbb85a9aa396e554ab0f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 973,
        "sourceEnd": 1042,
        "text": "No, thank you. I have a few bananas at home. I should eat them first.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "d91fab7e2eb13222a0f0757d00c4a589fa3c87e9af0a41fc86c39a1eb4fa575b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1050,
        "sourceEnd": 1146,
        "text": "That's a good idea. So, you want a few apples, a few oranges, and a little sugar. Is that right?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3a4b8ccb4f20dc741c1a61ba6d5c8c2561bab33f77aadfbce5f311b09c2e4e16",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 1152,
        "sourceEnd": 1228,
        "text": "Yes. Oh, and how much time do I need to cook dinner? I have only 20 minutes.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8488cbae33b1cd6380389e22075d09cb600a2ed95237cfb4f7aed1c05b89dc23",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1236,
        "sourceEnd": 1315,
        "text": "Only 20 minutes? Then you should buy these small tomatoes. They cook very fast.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "2b6deb419eedda420e4b083c2ee80eff9e762f699a74824d47dd171e2cd8969f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 1321,
        "sourceEnd": 1391,
        "text": "Great. I should buy a few small tomatoes too. Thank you for your help!",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "a04c149696865c8fd9f4dcb8d098629eb215b0eec2ac1e781c6063d26fa7b895",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1399,
        "sourceEnd": 1431,
        "text": "You're welcome. Have a nice day!",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1e5140cbe505fdd16b528f93283bfe2d9194196498ced849f039e68c409ebf0c",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
