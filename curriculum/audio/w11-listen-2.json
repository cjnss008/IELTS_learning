    "segments": [
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 5,
        "sourceEnd": 68,
        "text": "Jun, we should buy food for dinner tonight. What should we get?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "139304150a8c26026ab7a62701b2f48f42cf60b58a4bd94235e551de6b717b61",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 74,
        "sourceEnd": 143,
        "text": "Let's make noodles with vegetables. We have a lot of noodles at home.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "a08e8a4bc1c5ad97acf65fd2abe60cabaa59a1845b0f4fafde69fc0faf71bd44",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 149,
        "sourceEnd": 180,
        "text": "Good. How many eggs do we need?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "00db8a92302799ee1148a74cbfca13d1b0a3db63df76ef6a8a9a91fe996e2386",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 186,
        "sourceEnd": 268,
        "text": "We have four eggs in the fridge. We don't need many eggs today. Two eggs are fine.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9088ec986c5552ec85003c2c8d7f72ca95a1d50f43386bacc2267c6c97b582d6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 274,
        "sourceEnd": 307,
        "text": "OK. And how much rice do we need?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "cbc0e997479c9827be0e9be3b7e97aa7a1a2591563c686102f745ae61f717bd3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 313,
        "sourceEnd": 386,
        "text": "We don't need much rice. We have a little rice at home. Maybe half a bag.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "17723a88797b1fbf0a9ffa552b22c6b2dcdb0b4ff636509cb4381608f507125a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 392,
        "sourceEnd": 466,
        "text": "I see. What about vegetables? We have a few tomatoes and a little cabbage.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "ed46258abbbcf563ed01c06705124851da1c17c4cbc4c52cf42a44b10f92c27e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 472,
        "sourceEnd": 517,
        "text": "We should buy some carrots. How many carrots?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ff7c2b703d80e0bd9732a7bd4af043ebbe9b32d79bfeb17cea85677a516b4f03",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 523,
        "sourceEnd": 606,
        "text": "Let's buy three carrots. And we should not buy too much fruit. We have many apples.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "84ed47a1b78d095ff3fe95fc96b7309115c2a2d7c282120b68814cedffbfead2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 612,
        "sourceEnd": 670,
        "text": "Right. We have many apples. We should not buy more apples.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "f4380a70d233683e36b1cb127b9a90320a407e77746cc4e5c7b927590e3ffd96",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 676,
        "sourceEnd": 700,
        "text": "Should we buy some milk?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "d2980acfc2858bc4f835299673021599d7c5fe4374a88e605f1aa34ad69c250c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 706,
        "sourceEnd": 825,
        "text": "Yes, a little milk is good for breakfast. But we have much milk? No, wait. We have a little milk. Let's buy one bottle.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "793d281fc9959b46c5613d9a254b0916577c8c1a5f9d6c177b5eec6389171fa1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 831,
        "sourceEnd": 905,
        "text": "OK. One bottle of milk. And we should not buy soda. It is not good for us.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1a7d301cfb5b3a49e9c33aa2ec2442daa349401782ea9d2d602e34638d2c26c1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 911,
        "sourceEnd": 957,
        "text": "I agree. We should drink water. Water is good.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "aeeb7611dd37eb969902e9d049458c52d2526e7ae91a5c35b6bf9a1293513722",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 963,
        "sourceEnd": 1043,
        "text": "So, we need two eggs, three carrots, half a bag of rice, and one bottle of milk.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "d943608028c836ac735bedd70264acf603c7559bc73d3e3fa38d127d229864c7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jun",
        "speaker": "Jun",
        "sourceStart": 1049,
        "sourceEnd": 1096,
        "text": "Yes. And we should not buy soda or more apples.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9e7da858552ab5216a99da43807467346dc970671b10db05632b775d2b218c5d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 1102,
        "sourceEnd": 1134,
        "text": "Great. Let's go to the shop now.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "2b1f29495a20e292d1f0ff5a6726f561633ba1b4c1618255a94f604a8261d8a6",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
