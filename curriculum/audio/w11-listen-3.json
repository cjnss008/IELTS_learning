    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 91,
        "text": "Hi, I'm thinking about what to buy for the office party. We need some snacks and drinks.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9c3bcdb3acd9cc2a0c9d831d2576ff9e092acf5849e0a84503e546d7de7c0c43",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 95,
        "sourceEnd": 133,
        "text": "Good idea. How many people are coming?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "11e2f491214d026d45edf6b07d408eb49e520ec1548c182b94ca8f5597d2aae5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 137,
        "sourceEnd": 183,
        "text": "About fifteen. So we need enough for everyone.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "3576c7ae665389c85361be6135cceecb9dd83bf72ef82835f5969f12680a8715",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 187,
        "sourceEnd": 255,
        "text": "Okay. We should buy some fruit. How much fruit do you think we need?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "e5562253e339dd0ab9bd29734d9a034dbb8eee742022354a934c164cc7feb7f0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 259,
        "sourceEnd": 333,
        "text": "I think we need a few apples and a little cheese. But not too much cheese.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "01d474b3d5b608f685e927e9f0cf7b8781c4badee27d749fa493023114734052",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 337,
        "sourceEnd": 411,
        "text": "Right. And we should not buy too many sweets. Some people don't eat sugar.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f516d5dd3d2e643ae6703c1a75b2fc8a3bda63264b68cad95397f0c02ba2874e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 415,
        "sourceEnd": 467,
        "text": "Good point. How many bottles of water should we get?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "1c262f35bfc1b9139fdc4b05c5917b95464d1383d508b3365e0aef38546fd86f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 471,
        "sourceEnd": 524,
        "text": "Let's get ten bottles. And maybe a few bags of chips.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "84c8e22a32b29e64eb86a5775a9347ca22459ccb6d3e9f6c09fb02e7e0f4c596",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 528,
        "sourceEnd": 614,
        "text": "Chips are salty. We should buy some nuts too. A little salt is okay, but not too much.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "17f18c9e94ed019bed8c68df7661dec9040b6f398cb41600da0ea716856c9704",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 618,
        "sourceEnd": 652,
        "text": "I agree. Should we get some juice?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3d1a124bb923c7340fed8f24c8f08c1c2fd4f01f15adec050eba6f7546f6e4f4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 656,
        "sourceEnd": 726,
        "text": "Yes, a little juice is fine. But we should not buy many sugary drinks.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "eb19719608ba335ef9cb538fc5882c6f100e730ca82611a92dbc32a3f2ebbbac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 730,
        "sourceEnd": 828,
        "text": "Okay. So, a few apples, a little cheese, ten bottles of water, a few bags of chips, and some nuts.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "fa8ad1cb0140a9803a457f7b1abce31d5b2037514b9ce277375565ee8f0a7f77",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 832,
        "sourceEnd": 901,
        "text": "And a little juice. That sounds good. I'll go to the supermarket now.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "23e1d95edf592799300f2a2986d1aaa179c7df4071a117c23a049d23a37c90f9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 905,
        "sourceEnd": 935,
        "text": "Wait, do we have enough money?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3eb4cd99fafda9fcda3434de47a1aa5a042abaf0829f60ccb328637bcdf35bed",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 939,
        "sourceEnd": 971,
        "text": "Yes, I have enough. Don't worry.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "cff3aa770820bc187d906284ff285981c9bcf1e962447d29322dcbc5e8ce4102",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 975,
        "sourceEnd": 995,
        "text": "Okay. See you later.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "352cf8c95384e9ec8c1e6c730e73cca5ffae2fa2815059168c82dd5a475ba4a0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 999,
        "sourceEnd": 1007,
        "text": "See you.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "61adafbd65d80ba418dfdb3e534ed2a5d98735cec0a9f8ae111a3d35ed9886f7",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
