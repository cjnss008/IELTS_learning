    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 30,
        "text": "Hi Lisa, how was your week?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "4bd307dff4212bc423fec8e7db1e13810d0ec44a06af13953b4c7078f0d7527c",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 34,
        "sourceEnd": 104,
        "text": "Busy! I had to finish a big report by Friday. I worked late every day.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e11eb56464710e77b56ed63bb74e893ee5c9987a2c676be0eee9d0d683c40870",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 108,
        "sourceEnd": 157,
        "text": "That sounds hard. Do you have to work late often?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "41fa780fa5414aaecd3e650cf23ee7d9cba590b5f5787fc1551796210341795f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 161,
        "sourceEnd": 296,
        "text": "No, usually I finish at 5.30. But this week was different. My manager gave me the report on Monday, and I had to check all the numbers.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "da0b38e2af94c00943fad8627bfdafd4b5fd685aefc373287242f275cecb8d81",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 300,
        "sourceEnd": 326,
        "text": "Did you make any mistakes?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "a604de9b778b0a84c78420f6ba91045aa502f0b6b0e4895c9d8c454eac552a8a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 330,
        "sourceEnd": 389,
        "text": "Yes, I made one small mistake. I corrected it on Wednesday.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "68b4a181cae505698f14f318b481f7bbb968408420b39c361424a2b45651f356",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 393,
        "sourceEnd": 424,
        "text": "Good. Can you take a break now?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "51afe19fcb747e0d2c3f6414dd9d36a6ce32dc6b67b57a2a5adb2aae1b82d9be",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 428,
        "sourceEnd": 498,
        "text": "Not yet. I must send the report to my manager today. Then I can relax.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "290d743b2a2a43b089163f615425736f9ecb4a59c94e3d440d1ab23d74de8f4b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 502,
        "sourceEnd": 528,
        "text": "What time will you finish?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "1211205111fc4a6c1509675aed1924ae25e1fc47f79a0bf125dd01db9da402ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 532,
        "sourceEnd": 593,
        "text": "I have to stay until 6 today. But tomorrow I can leave early.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "f299c54a4098bbd3482fd177289c9d51f425d49d57df0b6648934527dd97c014",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 597,
        "sourceEnd": 637,
        "text": "Great. Do you have to work this weekend?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "9504b350805008551db147d240fa200240bfaaf2b15a46216a07af3efc4710ac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 641,
        "sourceEnd": 702,
        "text": "No, I don't. I can do what I want. Maybe I'll go to the park.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b1a47ea98353f0c4b9996d31c92aab45503cb24160bd82a4830e3f5256d47c8f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 706,
        "sourceEnd": 759,
        "text": "That sounds nice. I have to work on Saturday morning.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c87bafc7a029bf862a85dad43a4c989d198f8de90ce946ebffa15ae0f1ca15bc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 763,
        "sourceEnd": 774,
        "text": "Oh no! Why?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "169ae15b4bed856af42aeba2d98d62bc4f221732b4754f93ef77ef9156ecb55e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 778,
        "sourceEnd": 829,
        "text": "I must help a new colleague. She started on Monday.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "f337d967a0426ad84e81931a4b1d30efbd45c95db8d22ad6b124e046486a33b7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 833,
        "sourceEnd": 887,
        "text": "Well, good luck. I can meet you on Sunday if you want.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c7a340c4691b1b9b5547fbd1aea8c3e0e27cc06b05d05aee2d174b47ad49cdff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 891,
        "sourceEnd": 915,
        "text": "Yes, let's meet at 2 pm.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "cf541d3a0a9d1f804577af89d5ac85df7d9a2306ce4bcca2a1b7b2946018c833",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 919,
        "sourceEnd": 941,
        "text": "Perfect. See you then.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0915f9fe630252118c0062ccf28db0d90335662185e27d718bb17a174663934d",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
