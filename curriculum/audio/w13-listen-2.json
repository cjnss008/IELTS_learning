      }
    ],
    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 31,
        "text": "Hi, Lisa. How was your week?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "7eff0cafbd040fc0fa31d3f977c89f06a1a0fc8c81b9ca8716eda5ce85d15c8b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 35,
        "sourceEnd": 82,
        "text": "Busy! I had to work late on Monday and Tuesday.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "53dcd9f633277cb9bcb2f04f88db4034d1494c62216ffda7691d632dd6d695c3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 86,
        "sourceEnd": 97,
        "text": "Oh no. Why?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ed1accf0d5d20f3e9e34a6367d68d236a0a7d6801803fee5f5f2335bf0de5a46",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 101,
        "sourceEnd": 158,
        "text": "My boss gave me a big report. I must finish it by Friday.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "84bdf62ab09e14d33ec518bcaff9cd76e80f1ddaf148a310d3fc82995e7056f3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 162,
        "sourceEnd": 209,
        "text": "That's tough. Do you have to work this weekend?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "393402fa473c9f700c945e0e374e80d67def9f516a9d839e14d58a1a3e91e7b0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 213,
        "sourceEnd": 283,
        "text": "No, I don't. But I can't relax yet. I have to check the numbers first.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e82944aaef4ef9a62011277f3aa73b579a9962695b3cd9889b35593e83b8f142",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 287,
        "sourceEnd": 326,
        "text": "I see. Did you have meetings yesterday?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "b98d0a9486f35840b7d7d393c25ba21787e3228e592fda197e1bc835a48d11d0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 330,
        "sourceEnd": 393,
        "text": "Yes, I had a meeting at nine o'clock. It lasted thirty minutes.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "8293267134fe4c59ef7adeeff2a0e06530221e516c17a18022e49bd1f208b027",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 397,
        "sourceEnd": 426,
        "text": "Thirty minutes? That's short.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "8ec06a466b8cac4540bd8db5bbb5f3daf1e78536b90ea2dfe8a4f79513822db0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 430,
        "sourceEnd": 497,
        "text": "Yes, it was quick. But I must prepare for the next one on Thursday.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "893865cf742ed1c1340673abbe854c16f65deffb2f9bcbb878073c2502e8a9f5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 501,
        "sourceEnd": 526,
        "text": "Can you take a break now?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e3e076406c1e2bb9ac90d83594335b593d9cdf0d83e3858d044682501f84dc7c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 530,
        "sourceEnd": 591,
        "text": "Not really. I can drink coffee, but I can't leave the office.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "d6b7552d5abe5abec001466c1c767ed7bcdd38f45e1de281de8738ddffb7804f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 595,
        "sourceEnd": 663,
        "text": "You work too hard. Last year, you didn't have to work late so often.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "165bde2da0c4f6848d463f80df364be86ca26d7d5195e1a75cafd4fac3cebab5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 667,
        "sourceEnd": 740,
        "text": "I know. But this month is different. I have to train a new colleague too.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "cfd553be68973fc372895b70f4958f1a42a26630829dd2dae00033fb2d4686af",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 744,
        "sourceEnd": 762,
        "text": "Really? Who is it?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ac1df6adf19ce1434468f503cf57d2b7be16ecb235181458b2fc455e4bb7a5d7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 766,
        "sourceEnd": 835,
        "text": "His name is Tom. He started last week. He must learn our system fast.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "db164123f5e65699b8176be06e7da56dc4df718622bbaa9117c26b6946685d71",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 839,
        "sourceEnd": 875,
        "text": "Good luck. I hope you can rest soon.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "fdb679f3cfbd527c1735d49e089e680335ce49c9420bfa4330caed71399e7760",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 879,
        "sourceEnd": 924,
        "text": "Thanks. I must go now. The report is waiting!",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ddd91927127319c233f27b5a218c6f8088cc4b843fb378a91a564c78ed647e65",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
