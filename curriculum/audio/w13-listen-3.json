    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 31,
        "text": "Hi, Lisa. How was your week?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7eff0cafbd040fc0fa31d3f977c89f06a1a0fc8c81b9ca8716eda5ce85d15c8b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 35,
        "sourceEnd": 127,
        "text": "Busy! I had to finish a report by Friday. I also must check the sales numbers every morning.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "20704c5b1724785d6ec2739e16142d1aa853f668b0433952ef7c72eef1f1551b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 131,
        "sourceEnd": 209,
        "text": "Really? I don't have to check numbers. But I can work from home on Wednesdays.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "09192d031932c49f470c54680bd4cb654594194c875d5b32ef95ecced6d58b7d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 213,
        "sourceEnd": 307,
        "text": "That's nice. I have to go to the office every day. Oh, wait—I must call the client now. Sorry.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c02841b980ff2e6ffdf8f31bc58b49cf86397585e527b6b0192532351db61607",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 311,
        "sourceEnd": 356,
        "text": "No problem. Can you send me the report later?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a4693f6fd9c81faddbb5882bc12ff026e29ed54c6d06b84935d23db2add9d6b9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 360,
        "sourceEnd": 398,
        "text": "Yes, I can. I'll email it after lunch.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "28457e6b5f38f24ab9bcb669425d13c7074e8d607be1c1ed7f1b2a72d4f5f3e8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 402,
        "sourceEnd": 467,
        "text": "Thanks. Last week, I had to work on Saturday. It was very tiring.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7215612fec5babe5a25c0d5b8511d856f84e6236712be3115428af7f7b16a48f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 471,
        "sourceEnd": 546,
        "text": "I know. I worked last Saturday too. But I don't have to work this Saturday.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "87fe995def902b77ab92798ae7aef62bf1dfa81668f3468dba82de13aef10802",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 550,
        "sourceEnd": 606,
        "text": "Good. I must go now. The meeting starts in five minutes.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9d1e2a6c8e79fe64bc2e2774ce4effac80c1cb1a92716351bb440b4b4c5fa609",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 610,
        "sourceEnd": 618,
        "text": "OK. Bye!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "11a1da9850e8a5b752454d5966ad5c7fade8226468afd7129ba0cb4061fd5813",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 622,
        "sourceEnd": 670,
        "text": "Wait, Lisa. Can you also send the report to Tom?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f85a0b89d3cf6506c067f6264db6743b33c1b7c9e89fbb0416ad6260fdcb0323",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 674,
        "sourceEnd": 743,
        "text": "Tom? I can send it to him, but I must finish the sales numbers first.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "13e9d7b2f9341a5f7d4df20453f737c0a7a674f5eda9bec227da17e2a78f4ae9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 747,
        "sourceEnd": 832,
        "text": "That's fine. I can wait. Oh, and I have to call the client tomorrow. Can you help me?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "af795f136d895fabbf73114eb87e9d25d62cb0d76a3b7592fc75c302f17a6435",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 836,
        "sourceEnd": 881,
        "text": "Sure, I can help you after I send the report.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b7a89485ef9cc862a82d41adfd6d3163f579f748fb532ae9f0f7ba7e72b0f0e0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 885,
        "sourceEnd": 899,
        "text": "Great. Thanks!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5eaf92b86c90870a879768d1b0c4abca0fec902e8d0e061cc3b64d853de5770b",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
