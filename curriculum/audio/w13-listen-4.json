    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 34,
        "text": "Hi Tom. How was your weekend?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "75d748e226965b69194c8255e7456ce7f4bd547d078f4f551672ee5dde3f10cf",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 40,
        "sourceEnd": 101,
        "text": "Not great. I had to work on Saturday. The café was very busy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0441d618250877aee5185520ce93c8106813ff2e32fe38516e74b888b923fc43",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 107,
        "sourceEnd": 138,
        "text": "Oh no. What did you have to do?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1143e3dbb5ae4f7a0905b8917110ea1d0b6f8fb65fb7af342326aef91fb9e4b5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 144,
        "sourceEnd": 215,
        "text": "I had to clean the tables and make coffee. I also had to wash the cups.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7d2125cf33cad6a749560874a0a4946ccffa4d022d04d9a6342d2341eeb78ff4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 221,
        "sourceEnd": 256,
        "text": "Did you have to work on Sunday too?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6f92c4a6c3d90ecf23f248c117585becc042646df398b07183979ed9316669f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 262,
        "sourceEnd": 331,
        "text": "No, I didn't. I only worked on Saturday. On Sunday, I stayed at home.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ec7bce05d728fa49ff4a9feebeb2ea180d81e802e4bdf9fcc39994a96acabc82",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 337,
        "sourceEnd": 382,
        "text": "What do you have to do at the café every day?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f0dc670e120a9e66cd5c16bae7f571ccd3617efad43c05cde225a90dbd5e5e34",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 388,
        "sourceEnd": 480,
        "text": "I have to open the café at seven o'clock. I must wear a uniform. I can take a break at noon.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4a4c0d2ada4da05c6bc46f7b0c3f95421c7ac19aa80baecbe2a9fe3564143dcc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 486,
        "sourceEnd": 517,
        "text": "Can you choose your break time?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8b55dd2cd62417bbf43fbc0334fde8cbf4d2665097a715d37679281db8bdf931",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 523,
        "sourceEnd": 599,
        "text": "No, I can't. The manager chooses it. But I can listen to music when I clean.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c775e189500c9c37ff62966a02de00aad689a6f78f41a5ae7b220056d221ef3e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 605,
        "sourceEnd": 651,
        "text": "That's good. Do you have to work next weekend?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c8f2c32c668881577dbd4dcd07be151f07c5cff8c311d0f345c9ec42bed5b49c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 657,
        "sourceEnd": 718,
        "text": "No, I don't. Next weekend is free. I want to visit my family.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "23eb9e2e3b0ef258b381af56266cd2e7060e9ac4fe57746181a177316d3b4afb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 724,
        "sourceEnd": 770,
        "text": "Nice. What time do you start work on weekdays?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fcc0b8f373697d0e1e6279fcc0572750aa7f47e132ee3d819d32412c8e2c88bb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 776,
        "sourceEnd": 846,
        "text": "I start at seven. But yesterday I started at eight because I was late.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f2f4563f66a9c977dbbaaf845e5e0fd8b20c4284d9510634f770879406b47ff8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 852,
        "sourceEnd": 876,
        "text": "Oh, were you in trouble?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4d69436214e83ea5f5736ab0f31bec8bc63334235df7ab7f45df9df7959ee605",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 882,
        "sourceEnd": 958,
        "text": "A little. My manager said, 'You must be on time.' So now I leave home early.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "402643fe1326e861bd8f7e095bb862f541ad5aed250b5270fd5536d706630720",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 964,
        "sourceEnd": 1016,
        "text": "Good idea. And what did you do after work yesterday?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "168de6018a73d29e902517e1e2faee696ef4bcbf3ffc11b58e4f9807e68938db",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1022,
        "sourceEnd": 1069,
        "text": "I went home and cooked dinner. I didn't go out.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7d5d45507ce6380d86841ac40a64fdc650b41e52a0a302b134ede34f29e7d144",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1075,
        "sourceEnd": 1105,
        "text": "Thanks, Tom. See you tomorrow.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "911c0ff8bfd0b8375dc911732b3c9dbc3d94210c18fe1aef42c95ee13ccc2322",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
