    "segments": [
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 5,
        "sourceEnd": 40,
        "text": "Hi Mia. You look tired. Are you OK?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "5d978b95e5fd22de33acde3548cf96fd1ae38da790b4f1dd64eb92e5c300b48c",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 46,
        "sourceEnd": 123,
        "text": "Hi Leo. Yes, I'm fine. But I'm a little tired. I went to bed late last night.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8b1f7e7c3fb54927212de7500befc273c13b479a2af5fa54117870eaf5b919f9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 129,
        "sourceEnd": 155,
        "text": "Why? Did you watch a film?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "7f21e70e836543fec3c4446560a607acae0891ad1f7ea01ba37a8ff11d8ae10d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 161,
        "sourceEnd": 216,
        "text": "No, I studied for a test. I went to bed at one o'clock.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "5e312e19722796bb6a3016766bd85d036e3b5be6a1a1c1437260a620442502e1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 222,
        "sourceEnd": 302,
        "text": "One o'clock! That's very late. You should go to bed earlier. Sleep is important.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "9f5fa05ffa47bd9fbb2a35872e55b8ceb45f50a300d8ab57d6691552f9b4de26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 308,
        "sourceEnd": 355,
        "text": "I know. But I have a lot of homework. I'm busy.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "e0a2abd9a3b475d22fa406004bc6de607944ea620ee9ffec036cd78faf6579e6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 361,
        "sourceEnd": 438,
        "text": "I'm busy too. But I always sleep for eight hours. I feel good in the morning.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "c9a150b02bf0f3b145939803c2709cf41d3141c247472537c5fbe1c75bd45df7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 444,
        "sourceEnd": 501,
        "text": "Eight hours? That's a lot. I usually sleep for six hours.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "aeb936741df92da5cb8aa265876db4102f2287449efd4c42c2712e0961995beb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 507,
        "sourceEnd": 601,
        "text": "Six hours is not enough. You should sleep for seven or eight hours. Then you can think better.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "2c93192c0492a1e3a0d9f590e087ee62070763bb0e696c5a7fe15f573670be90",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 607,
        "sourceEnd": 688,
        "text": "Maybe you're right. But I also drink a lot of coffee. Coffee helps me stay awake.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "43a3e589d44505fa96e005ad4a40c95627e00630206c3c0e21edf8c9d057f411",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 694,
        "sourceEnd": 721,
        "text": "How many cups do you drink?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "d38fde56b7bba4c0838c3152b4aeb860c59da68b293259838d6200d1e11572d3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 727,
        "sourceEnd": 757,
        "text": "I drink about four cups a day.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "52be6d8771af2cab9c781d4ba911776261d285a5cadcdd748a7289ce2bc89ef0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 763,
        "sourceEnd": 853,
        "text": "Four cups! That's too much. You should drink less coffee. And you should drink more water.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1819092f663cf815c443adc46a8472122f52652340391b45c72a562883d974fa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 859,
        "sourceEnd": 874,
        "text": "How much water?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "7bb09bd962b2eea7d7be54a679ee6148e5351e7c814652b47cc216a2c0d73cb2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 880,
        "sourceEnd": 943,
        "text": "About eight glasses a day. Water is better for you than coffee.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "514b78ba65efdd06c756cfcd37692bb41632903fe21ca61d5c49671824a5f465",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 949,
        "sourceEnd": 999,
        "text": "OK. I can try. What about food? What should I eat?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "cbaec51c54014b82b6e1c4c578aa4bf54748e544868166890576a3b9cc4f8480",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1005,
        "sourceEnd": 1113,
        "text": "You should eat vegetables and fruit every day. They are good for your health. And you should eat less sugar.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "24ef98bb07b14d96b844358f3cbb1664253c8db9ebc3493517bd0bb1b8741550",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1119,
        "sourceEnd": 1179,
        "text": "I like sweet food. But I can eat an apple instead of a cake.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "c301a9e425dc5a22aa1cdba65b17ba99d601ef80a214bc64e399df5026c26129",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1185,
        "sourceEnd": 1268,
        "text": "Good idea. Also, you should exercise. I run every morning. Running is good for you.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "c6766110c6632065b80c22a8b692839f9c658d17cc04a799ade129b5e8bb4f00",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1274,
        "sourceEnd": 1328,
        "text": "I don't like running. I like swimming. Is swimming OK?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8c3da67af04bfc05bcb7c6ccfc78d4b89f68be0245b7718f688bbbede6b11444",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1334,
        "sourceEnd": 1420,
        "text": "Yes, swimming is great. It's good exercise. You should swim two or three times a week.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1acdd0e64c7356a880f351d49ded375a814091d197ee8f00817cb854616f302e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1426,
        "sourceEnd": 1500,
        "text": "OK. I can swim on Tuesday and Thursday. And I can go to bed before eleven.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "fffff800e7a381bca23798525d1c4b980dbdf6e7074274fdddff1914275a3145",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1506,
        "sourceEnd": 1552,
        "text": "That's a good plan. You will feel better soon.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "0fc6c381e188f94a10c828925a327fe0f51037258f9dbbfd841ef1b9b777f50a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1558,
        "sourceEnd": 1593,
        "text": "Thanks, Leo. You are a good friend.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "b9ed88fe196b3892d34aa2591adf6d01e22a9e144a0649eeb8f9f6e577d0c9f2",
        "pauseBeforeSeconds": 0.65
      }
    ]
