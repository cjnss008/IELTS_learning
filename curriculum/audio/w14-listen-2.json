    "segments": [
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 5,
        "sourceEnd": 42,
        "text": "Hi Tom! You look tired. Are you okay?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "e6c2c55eb0a32168842b2a31a1626bce2262e925579726ef5e8ef57ed6f8e762",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 48,
        "sourceEnd": 142,
        "text": "I'm fine, but I slept badly last night. I drank coffee after dinner. So I couldn't sleep well.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "31511ef5cf923d2e0718305053045f1d6ddefa2d864e1ccb632510d94aeed02e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 148,
        "sourceEnd": 235,
        "text": "You could try coffee earlier in the day. You should put your phone away before bed too.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "16d55888d8dd94c7e7820bc11e4cf2f1dfa5c0c5830221254a429c0b91934906",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 241,
        "sourceEnd": 352,
        "text": "You're right. I should change that habit. I usually go to bed at 12:30 a.m. because I watch videos on my phone.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "f9655052ced73d55dfdab778ffb348376cfed1ce6a62551eb145d293f4a1c13c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 358,
        "sourceEnd": 442,
        "text": "That's late. I go to bed at 10 p.m. and get up at 6 a.m. So I sleep for eight hours.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "207dc221cbe69c44e4a3cbfe78a5ccbe03980c4c74522c97c9d1e0692765b54e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 448,
        "sourceEnd": 505,
        "text": "I sleep for about five hours. That's why I'm often tired.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "6dd138cfa52ee20035ed62bc82977e6d9a09371d885cef68b48a2bd40a24e00d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 511,
        "sourceEnd": 570,
        "text": "Sleep is important. Eight hours is better than five for me.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "eef66619bed49aa5678ddb409bb1dfd6ae3945fa0a013723bb3cb69ffc4efe8f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 576,
        "sourceEnd": 640,
        "text": "I should also exercise more. I walk for forty minutes every day.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "eabf134adb5e3ff82def2de1bb386c949344df2857323e5b4fc72586023a45a6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 646,
        "sourceEnd": 747,
        "text": "I walk for ten minutes to the bus stop and thirty minutes in the park. My total is forty minutes too.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "f7a7755a9f4d145f279e30ccbfd3fc42b858795f146f4d99a0f8bb495c34b7a3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 753,
        "sourceEnd": 809,
        "text": "So we walk for the same amount of time. What about food?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "a59aa3099ad43a5b16dd440f2f0523dcfb05336ce6adc371ca541b573f8df226",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 815,
        "sourceEnd": 842,
        "text": "I eat vegetables every day.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "06dd5e9a7748b9c354fb4ec997a2215d09a180eb5cc777ba0413222bb3efdcaf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 848,
        "sourceEnd": 895,
        "text": "I don't eat many vegetables. I should eat more.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "7eaf9a6da19527e5851087c5e29023524d73d1703a9044cf0664c48ce0d33e5b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 901,
        "sourceEnd": 947,
        "text": "I drink two liters of water every day as well.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "5dee0b3e2e2f2196f90dce11882a50f3a6ea66138b9785c25e1a6630e6076604",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 953,
        "sourceEnd": 1024,
        "text": "I drink about one liter a day. I often forget to take a bottle to work.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "5eb2d92479f52d7f80cd6c2223adcb095a03d3c20e36adf5813087c6fdaef90e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 1030,
        "sourceEnd": 1107,
        "text": "I keep one in my bag. Water is the best drink for your health, in my opinion.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "9372f47c466b399ec5135bcf75710ce1ac0edd3fb18d76ac9ff08f407c543a10",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1113,
        "sourceEnd": 1212,
        "text": "Thanks. You give good advice. I'll start by putting my phone away earlier and taking water to work.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "ce317e1bc2b5a2b56058036ea2798c373846956fa416b49070b0b29b83406403",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
