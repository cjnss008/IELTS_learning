    "segments": [
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 5,
        "sourceEnd": 46,
        "text": "Hi Mei. You look tired today. Are you OK?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9c6366f07fb307b0fd068723620bc216a05a0c4d78a7d00627fedc1013c8d0ef",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 52,
        "sourceEnd": 121,
        "text": "I'm fine, but I went to bed late last night because I watched a film.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "add0820ccd8991be5625c6c95989d17840730cb91c46952067bed333d91ba690",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 127,
        "sourceEnd": 216,
        "text": "You should go to bed earlier. I always sleep for eight hours. It's the best habit for me.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "5ac1d7e404564310c889796ecab18d271953947e2c0095c984f41911c2591ae0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 222,
        "sourceEnd": 282,
        "text": "I usually sleep for six hours. I'm busy with work this week.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "6e35cc0c7d79a9a9a0db216110819f8af18a739c4e923bce66b493ce538cea2c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 288,
        "sourceEnd": 347,
        "text": "Six hours is not enough for me. What exercise do you enjoy?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "996641d1c53af6bdd59f1a8ce13820f1553402befd096ad1944af1231abe3eaa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 353,
        "sourceEnd": 436,
        "text": "I prefer swimming to running. Running is boring. Swimming is more fun than running.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "2cc826571130a1897788a5fa103cc172791c39a54f3cb43b75b4aca54467f07d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 442,
        "sourceEnd": 553,
        "text": "I run every morning. Running is the best way to start the day, for me. But swimming is also very good exercise.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "78058b7c851a0bc0e96470323ec322bd8203c3be32c7cab6cd64a5a1069fbba1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 559,
        "sourceEnd": 615,
        "text": "I swim once a week, on Sundays. I want to go more often.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ddba224fb5ac5d51db200bcdae601842e9d39d8f7331b89e61f382fc389d6f18",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 621,
        "sourceEnd": 661,
        "text": "You could try two or three times a week.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "53d4b2dc0b3e29a25645caa3001f10b7a620ac17f7a13847d5bc9ff6f50efd68",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 667,
        "sourceEnd": 733,
        "text": "I won't add another swim this week. I'm too busy. Maybe next week.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "63af6e131333674177d07f815f39f5503c7326d7236fb140e11459625ad60248",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 739,
        "sourceEnd": 797,
        "text": "What about food? You should eat more vegetables and fruit.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "8a5cdce82c95b448d580e7912df5e77e335771f7c69d6ff912112325ae4dbdf3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 803,
        "sourceEnd": 854,
        "text": "I eat fruit every day, but I don't like vegetables.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "6ac36962a09a9ca6f19e2ff738e92745fdc577b4548d869536a3fb1a573c661b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 860,
        "sourceEnd": 949,
        "text": "Try some different ones. Some are sweet, like carrots. Carrots are sweeter than potatoes.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "6741a662e5d5ea4bf1378606d35c3ad19639b8d4d549189b6c9343864ed24c70",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 955,
        "sourceEnd": 1030,
        "text": "Maybe I can try carrots in my lunch tomorrow. I can buy some at the market.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9f8842245ff109bcea700fa4a3d86658e2191241f7d8f00db65fead7d1654c01",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1036,
        "sourceEnd": 1128,
        "text": "Another idea is to take breaks when you work. Stand up and walk for five minutes every hour.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3a4204b760be000ff9a0e8fe58ada14538240733093c61f6ca528f89a8686618",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 1134,
        "sourceEnd": 1205,
        "text": "That's useful. I sit at my computer for a long time and forget to move.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "e9f8def7b616f89ff9aa37175a36ef3a431e84080d6a56ba3606d441191ba69b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1211,
        "sourceEnd": 1254,
        "text": "I put a note beside my screen to remind me.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9e3e6830205224827e285ef999893b346e9b7bd1b17d8718767e3934ed16f672",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 1260,
        "sourceEnd": 1310,
        "text": "Thanks for your advice, Tom. I'll make a note too.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "b950e1de96391e9baa263b3d450f2d0fb3e417668074955de4ac86e82c4dc4a4",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
