    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 46,
        "text": "Hi, Lin. You look tired. Did you walk here?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "753b821141fbf1843f000ad3eef6e1c7d0f44821064ffc35f2d79330bf8b2cf8",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 50,
        "sourceEnd": 135,
        "text": "No, I took the bus. It's the number 7. It's usually fast, but today it was very slow.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1fe55ba8ed89eb62746085ab99fe80dafe74fb5ff8700cd1e055507cf0dcf08c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 139,
        "sourceEnd": 167,
        "text": "Oh no. How long did it take?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a3089d28a820eefe4d125e301248fd6776629231a8bdc47fac4004164b8ec4bd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 171,
        "sourceEnd": 244,
        "text": "About 30 minutes. Usually it's only 15 minutes. The traffic was terrible.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "78965f15a3669bc24aac2b828cb5f7e1b92b7cba7f448877ee83bdab2d2ab09e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 248,
        "sourceEnd": 299,
        "text": "That's a big difference. Is the bus always crowded?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f4a91d30e069672759552d3e9f855fb8c0349f5574ebee8f1041625b43f553f8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 303,
        "sourceEnd": 401,
        "text": "In the morning it's the most crowded. I sometimes have to stand. But in the afternoon it's better.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c8d206bb4dd711b5913eb8298c1bebd6f434b5551633ec4c4407e66b4f6a32b2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 405,
        "sourceEnd": 435,
        "text": "Do you take the bus every day?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a290a79e17036b0b437c5807037cf795feac9741d240f4031577ba43850f54d8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 439,
        "sourceEnd": 531,
        "text": "No, only when I'm late. Usually I ride my bike. It's faster than the bus and I get exercise.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9620edfe8c9cc4017041318d6872c99d0852464068895bf9c277e1ab1a0338cc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 535,
        "sourceEnd": 581,
        "text": "That's good. Is your home far from the office?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "28567c9e6e5ce144aa778e29267a6180c3d1e6a96d34418b6561a9672345ae76",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 585,
        "sourceEnd": 721,
        "text": "Not really. It's only a five-minute walk from the bus stop. But there's no subway near my home, so the bus is the only public transport.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "34e9677cb5d444814ba830546f0be45c546a810e49547dd3d76f6039cfacfca0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 725,
        "sourceEnd": 771,
        "text": "I see. What would make the bus better for you?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "3cb7309334431e2e666d27ec9e0d75d8542e1f47fdf6708893f5f568da23d409",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 775,
        "sourceEnd": 900,
        "text": "More buses would be better. Sometimes I wait 20 minutes at the stop. Also, the bus is older than the new ones on other lines.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "1eeaadd4abbd50d5471dda65164600d856d71c653316be141ede244beef18e2c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 904,
        "sourceEnd": 932,
        "text": "I hope they improve it soon.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "d90dba44d93895dcda94e051a63507aad5001fa0e5954d3d2c06cdb1594dd70f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 936,
        "sourceEnd": 980,
        "text": "Me too. But for now, I'm happy with my bike.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9ef965f113286c3598eae9be35b769f0989442b94d6e6dfdb3a792f9ecfc118d",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
