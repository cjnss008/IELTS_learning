    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 45,
        "text": "Hi Lin, you look tired. Did you walk here?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "85eddc53858b749cf19792c5af6183e0cf143580e581b6c263768d6111cfbf5b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 49,
        "sourceEnd": 152,
        "text": "No, I took the bus. It was slower than the underground, but cheaper. The bus stop is closer to my flat.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "559cc518fad14cd777d8a18a20f661b5beb864a39641dd5f866ba3bd585173b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 156,
        "sourceEnd": 183,
        "text": "How long does the bus take?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "61df84444a27c6d2c2d8043a6bf59e166b9fcbb58ecc119fc738627ba910852a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 187,
        "sourceEnd": 346,
        "text": "About 40 minutes in the morning. The underground takes 25 minutes, but I have to walk 10 minutes to the station. So door to door, the bus is sometimes quicker.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "306692d0c4b9ba090f6b58634ac66a17a341bd267cee7ab3404ce8fdc7fbccf5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 350,
        "sourceEnd": 387,
        "text": "I see. How often do you take the bus?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "214bd0b42ec6cfce8ef8698edb4c05381ff720c860c50240c801d19a50e211fb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 391,
        "sourceEnd": 496,
        "text": "Three times a week. On Tuesdays and Thursdays I cycle. It's the healthiest way, but it's not the fastest.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "655aa30a36f54dc371ee8db9c98ca684559b64dd0ffbaa0d2ec97655fa88494a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 500,
        "sourceEnd": 549,
        "text": "What's the fastest way to get to the city centre?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f0d2c1d6c9660e0bbd6b567d22ced2737c0c1665c0aa8418a33be421b1154a72",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 553,
        "sourceEnd": 731,
        "text": "The underground is the fastest for the journey itself, but with the walk, it's not always the quickest door to door. The train is also fast, but it's more expensive than the bus.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7a5632c75f9bf1b595b2a71dde58c227bad1b551cd7571cdcc3d7ceccf869d00",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 735,
        "sourceEnd": 748,
        "text": "And the taxi?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "98b50535c19c25cb4e8bd0d802d5faf2853537a484f516bc09bc08d8d31cc943",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 752,
        "sourceEnd": 813,
        "text": "The taxi is the most expensive. I only take it when I'm late.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "df99ee30c3b4b9eab3e59a6c0500267af30d70314fe23f4414ceca4f61a36961",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 817,
        "sourceEnd": 853,
        "text": "What time do you usually leave home?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "862fd36eaa3916c5c2824c048915e5a1b2d4b5d2224c4626018baa24084412da",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 857,
        "sourceEnd": 928,
        "text": "At 7:30. I arrive at about 8:10. The bus is often crowded at that time.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "17b4577c10789808f19b9c4a138c4e242d050ab5a1fc7e8cedef75ac474ac89f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 932,
        "sourceEnd": 949,
        "text": "Do you ever walk?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "ce0943bcd47c2fd60ccc329ce3986d5b43d751651ce2370bd13151a11fec8671",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 953,
        "sourceEnd": 1018,
        "text": "Yes, on Sundays. It takes 50 minutes, but it's the most relaxing.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "2fe1583cdbebe22b0e264d52d6a9e6fe9ca66cf3ef25bbfe531b416e3ef43205",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1022,
        "sourceEnd": 1050,
        "text": "Thanks, Lin. That's helpful.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "f1abd475a2c2e0d7867f56f6f62d1540f13da3785e49d91abb7e5d21de88488c",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
