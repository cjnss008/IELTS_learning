    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 68,
        "text": "Hi, Lisa. Are you coming to the community garden meeting tonight?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "596688d710190b925a09c12427cfe42e127aef4441d16eec9e56f1359cf4544a",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 72,
        "sourceEnd": 158,
        "text": "I'm not sure, Tom. I have a lot of work to finish. But I want to help with the garden.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e046665eb1db343c659395348c0f92b6cf9238b67063cee8d59f2f81e9830bdb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 162,
        "sourceEnd": 252,
        "text": "Well, if you come, you can vote on the new plan. We need to decide about the water system.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "433cd50b65a2e63653dbd6852619ce07d86a2bc5af43ad611d0c384c7ac6570f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 256,
        "sourceEnd": 297,
        "text": "What's the problem with the water system?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "36d738b07e2b0fc00806e43406f958be42d3c621be8e293c1a48249e8b88a79b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 301,
        "sourceEnd": 415,
        "text": "The old pipes are broken. Therefore, we waste a lot of water. If we don't fix them, the plants will die in summer.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "90aca9095861c69e11b30404bbc915c2e1a2f60b658fc9dbcc47a1da24b30e4e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 419,
        "sourceEnd": 457,
        "text": "That's serious. How much will it cost?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "9f98a0f32ae5f6e778a98df51a735769e3bf0ab9d5de31bc53754e48e2cefefa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 461,
        "sourceEnd": 515,
        "text": "About $500. But if we all give $20, we can pay for it.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "08898f239365ef68412178a9b6c2fc2ec8fa90c7fa361625638dc96cabe4cf4c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 519,
        "sourceEnd": 590,
        "text": "That's a good idea. But I'm worried about the time. I'm busy with work.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "e0d5fa804b5e2fd5fc05bdcad0cc39b4776518c5a0e1221d4e48a31ae7b80b16",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 594,
        "sourceEnd": 712,
        "text": "You should talk to the coordinator. She can give you a small job. For example, you could water the plants once a week.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "1bb72dbf3ff4ae79c45a2d946b186cb070fa4a8e25fa4004251ec92d893423de",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 716,
        "sourceEnd": 760,
        "text": "That sounds manageable. When is the meeting?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "b0fd7caf9aff83ebead2f3089ad8a8ac923d174ec156cd4e5f085f1bb82483c3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 764,
        "sourceEnd": 832,
        "text": "At 7 p.m. in the community center. If you come, we can finish early.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "777ba9b81403a3cb2f7bd558dfb1a59303fb85574164263687418fa6ec933298",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 836,
        "sourceEnd": 896,
        "text": "Okay, I'll try to come. But I might be late because of work.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "41e5cf043db4e5accea9a06a6565db9978efdca4a0c2776635b45539e1210066",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 900,
        "sourceEnd": 965,
        "text": "No problem. We can start without you. But please come if you can.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "be685940eaa177ec6bc3b54850fb37b6de15f03e02d35d86406d5b82d0175a8b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 969,
        "sourceEnd": 999,
        "text": "I will. Thanks for explaining.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "bd96eaf328913a3ef7e18c14a9e74874e885ca09655a810234722ea403bd32fa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1003,
        "sourceEnd": 1026,
        "text": "Great. See you tonight.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "3453a0aadabcfd1721841a6f18b33be51cbfaae193b01f74e406e3833fa9267b",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
