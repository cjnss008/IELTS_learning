    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 100,
        "text": "Hi Tom, thanks for coming to the community garden meeting. We need to plan the new garden area.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "40816a147aae3333c67555018fcf00146ef149d3c46bf217d0723166c6405578",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 106,
        "sourceEnd": 149,
        "text": "No problem, Mia. So, what’s the main issue?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "02bbba834f060881bb7dc6316b1791d28fb841e5f220986e4b5b5254b75fb825",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 155,
        "sourceEnd": 230,
        "text": "Well, the soil is very poor. If we don’t improve it, the plants won’t grow.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2590bdf671398e1b36eabecb0ec51711495a973ad14a5727bf7d93929ed3ce8e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 236,
        "sourceEnd": 295,
        "text": "Right. So we should add compost. I can build a compost bin.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "67a07cffc7d58623fb870c6fde3f3ab47b3c8d817072086db87f91924733e0f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 301,
        "sourceEnd": 398,
        "text": "That’s great. Also, we need to save water. If we collect rainwater, we can use it for the plants.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "43a3e12319351779150bce4e2619df090ac2bde3f12a5601fe26fb01ddd2d53b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 404,
        "sourceEnd": 455,
        "text": "Good idea. We can put a rain barrel under the roof.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b0ec69548e37eb7cb35228b615799f8d93a9c884f5826b91173de229540abeaa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 461,
        "sourceEnd": 556,
        "text": "Yes. And we should ask the school for help. If they give us some tools, we can start next week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "47be33ffa577639700874c61885fb03d32a34314071ce968f916927fa02ed952",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 562,
        "sourceEnd": 645,
        "text": "I agree. But we also need to tell more people. If more people join, we can do more.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2969cb3f8d6ec1fff68936d8cd285c7e821584e206be833bd1c9e468f0a04661",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 651,
        "sourceEnd": 738,
        "text": "True. Let’s make a poster. Can you help me write the words? My handwriting is terrible.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f588d0f840e8fb6a1a90961edd875b2078de8a3c0531cfe6351b67f793cacab7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 744,
        "sourceEnd": 790,
        "text": "Sure, I can do that. When shall we meet again?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "77868bdf0368e3ab32a030a97e66c4081719cd36f971ef64cf5b5d8c424434e4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 796,
        "sourceEnd": 829,
        "text": "How about next Saturday at 10 am?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b89d972754f5deb38436ef06272c8fdc2bc90d1a1958d1fa7133aa1f5612f691",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 835,
        "sourceEnd": 898,
        "text": "Works for me. I’ll bring my laptop so we can design the poster.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9bf9b368cb12fef0701af5dc02d83716175d23d697d4a9e0263b5d4374615701",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 904,
        "sourceEnd": 983,
        "text": "Perfect. Oh, and don’t forget to bring gloves. We’ll need them for the compost.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "121c185958bdd20a9f990e75adaa393076cbf5de3f38364427424bd2720dd7c9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 989,
        "sourceEnd": 1010,
        "text": "Got it. See you then.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "56cc77fe8d3a8732f14d5a058c0c4a50c027b395f369c7e9e7f071719d9643b9",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
