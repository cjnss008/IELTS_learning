    "segments": [
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 3,
        "sourceEnd": 60,
        "text": "Hi, Mei. Are you coming to the pool training on Saturday?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "2b22d0625d16a599b4142128039254ae6f35aa1b6eddf4046e3a994369413dec",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 64,
        "sourceEnd": 135,
        "text": "I want to, but I have a problem. My swimsuit is too old. It has a hole.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "df09f600a6a9d117e94513839d07fe6be69d9c340f797dbac9086b482d475dbd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 139,
        "sourceEnd": 230,
        "text": "Oh no. If you need a new swimsuit, you should buy one today. The sports shop closes at six.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "5ae0f9e14c9be2ea1bf6d74cb8ed88c4df3c6391fd4db163bc7c61b4649d73b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 234,
        "sourceEnd": 310,
        "text": "I know. But I also need goggles. I can't see well in the water without them.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "75bb9dd9859e586498584954b6a21798c465158a630b3631c0f096a6291baf28",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 314,
        "sourceEnd": 383,
        "text": "The shop sells goggles too. If you buy both, you will get a discount.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "c5507c884a3dc7b2f1b8be48b11504f4eb7179cec64e1ba2cb4f38d132a329ea",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 387,
        "sourceEnd": 483,
        "text": "Really? That's good. But I'm worried about the training time. It starts at eight in the morning.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "0e24f015b1cf3bb9ff6b1470250d04ff599f919083ee749a5e85073c39716cec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 487,
        "sourceEnd": 563,
        "text": "Don't worry. If you arrive late, the coach will let you join the next group.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "dfcba9f3f2ec9c5241025c330159f7a899fc92e10a2e53a4aa7757d3c113cdae",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 567,
        "sourceEnd": 629,
        "text": "OK. And what about the pool rules? Can I bring a water bottle?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "3ebd77afb32f59e5a000bd31f0e1a4218de5b657a37e8720acac6e73ab52e5cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 633,
        "sourceEnd": 704,
        "text": "Yes, you can. But you must not bring glass bottles. They are dangerous.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ab24ced27e428a504624551e3c4f7aa94cb4f93b6098142ae2cc1971e14426df",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 708,
        "sourceEnd": 778,
        "text": "I see. I'll bring a plastic bottle. And a towel—I need a towel, right?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "4ff0f2151fad8bec2c73afd2771b3da37762e32640e6d931ead11a5ae7518297",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 782,
        "sourceEnd": 845,
        "text": "Yes, you should bring a towel. The pool doesn't provide towels.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "fa6f5e54a0427aa205fa32ff815174920029d3782e8645e8fe3c941f8b991fa6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 849,
        "sourceEnd": 917,
        "text": "Thanks. One more thing: if it rains, will the training be cancelled?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "46fd4c86026920d3a50cc41acffa5c4de569b4807f37e5f3c2597962dc65a719",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 921,
        "sourceEnd": 997,
        "text": "No, it won't. The pool is indoors. But if you feel sick, you must stay home.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "26e2ed764b4c9e847193895816ed5f2410dfc12fcaa3068c85bef1b89fb30694",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 1001,
        "sourceEnd": 1079,
        "text": "Good to know. I'll sign up online now. The website is swimmingclub.com, right?",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "ae936500fb24fe66a8edd25198e4d572e0aeb9c8f4a50c34e94a4bf9a54c903b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 1083,
        "sourceEnd": 1157,
        "text": "Yes. But you must sign up before Friday. After Friday, the list is closed.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ec8f6761d3c1fff9db6daa87d8f24c0be2137faee09a89f718c5a5a2c4348b61",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "b",
        "speaker": "B",
        "sourceStart": 1161,
        "sourceEnd": 1204,
        "text": "OK. I'll do it today. Thanks for your help!",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "0ff753915b3fe434df9db08674063e22a315b825db07881116833c7d15cfd02d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "a",
        "speaker": "A",
        "sourceStart": 1208,
        "sourceEnd": 1241,
        "text": "You're welcome. See you Saturday!",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ff8fb6c452f85818e1cd5db0ddf74b0526bb4ebb20886aa53fd06ee993d863cc",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
