    "segments": [
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 7,
        "sourceEnd": 92,
        "text": "Hi, Tom. I haven't seen you at the community center for a while. Where have you been?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "5f57733b73d4a74c13c05518f9721ecbcc09e0308d596980206bfd0221d51c85",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 98,
        "sourceEnd": 181,
        "text": "Oh, hi, Lisa. I've been really busy. I started a new evening class three weeks ago.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "cf4b90a34086cbd79a4ab9e7aeea13349a0d2029315ef7588673e2564964739d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 189,
        "sourceEnd": 214,
        "text": "Really? What class is it?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "185bae8f1e6402732c890d519363ed531c593596bc074c25a1623fc15a503333",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 220,
        "sourceEnd": 338,
        "text": "It's a cooking class. I've always wanted to learn how to cook properly. I've already learned how to make three dishes.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "52aa6991709b00eb425cec75d77a09f711bb5c9a3f1da7fac534e447a096d177",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 346,
        "sourceEnd": 393,
        "text": "That's great! Have you finished the course yet?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "12f052e2dd6762a87d8dd98b3f96ec059d29550adfde2b4d3b34b19002aaa616",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 399,
        "sourceEnd": 484,
        "text": "No, not yet. It's a twelve-week course. I've been going since the beginning of March.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "9392577d07181b9896f305d344108a6daee61a528de9ac2bbb7aa0b6ff59f950",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 492,
        "sourceEnd": 542,
        "text": "So you've been in the class for about three weeks?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1f58422de3f8274a8a5d41acf8d1fd37233573915d47aabf013c7d2454912086",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 548,
        "sourceEnd": 626,
        "text": "Yes, that's right. I've really enjoyed it so far. The teacher is very patient.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "100c1e01ee835fbe58c47afd2c64ff0d605a7f6045d69cbd8ecf239b165eb1c4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 634,
        "sourceEnd": 666,
        "text": "Have you made any friends there?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "530f964cdfbf97241eaca3ebf8a9b34bb7ee5f28b658ecae824979707d19d71d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 672,
        "sourceEnd": 804,
        "text": "Yes, I've met a few people. There's a woman named Maria. She's been cooking for years, but she says she's still learning new things.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "7b7e22a77fd21a1e42f7522fc24ecea1ac33c9db46e62135769d754c99235a51",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 812,
        "sourceEnd": 927,
        "text": "That's interesting. I've never taken a cooking class. I've always cooked at home, but I just follow simple recipes.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "6c9df65e6627b6d5f3dfd372a0b3734941bf26627bc9f8f0820d17e75c3a922c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 933,
        "sourceEnd": 1014,
        "text": "You should join! The next course starts in June. Have you decided what to do yet?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "b9b5257d8c7099f59cbfa4f8b04b5a7a134e5b54f895a8fafe9add21cb89715b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1022,
        "sourceEnd": 1089,
        "text": "Not yet. I've been thinking about it, but I'm not sure I have time.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "08db3c729c2fee946d67d753dc7a262e5a2de7c717908fb47cc7e86e622b4281",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 1095,
        "sourceEnd": 1184,
        "text": "Well, the classes are only once a week, on Tuesday evenings. I've found it very relaxing.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "4c347bcf24aa6d80e110e4307b01bb7bf509c9fca9a379b5099407a6516b2867",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1192,
        "sourceEnd": 1253,
        "text": "Maybe I'll try it. I've heard good things about that teacher.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "583a4d14ec860ca113277b76f2f70604e9004c96f3267e4fcb309bc93174a7ec",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "man",
        "speaker": "Man",
        "sourceStart": 1259,
        "sourceEnd": 1344,
        "text": "Yes, she's excellent. Oh, I have to go now. I've got a lot of homework for the class!",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "82e26ed14669c463bd055d9ebf0c707d89bf35dc091156e28e26c286613ba985",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "woman",
        "speaker": "Woman",
        "sourceStart": 1352,
        "sourceEnd": 1395,
        "text": "OK, see you later. Let me know how it goes!",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "4ae1e38a9950c7037dd9dbd67f7a9f13bc9129ad51e649e572b02f8b1814a4ba",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
