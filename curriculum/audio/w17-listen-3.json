    "segments": [
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 6,
        "sourceEnd": 65,
        "text": "Hi Li Wei! I haven't seen you for a long time. How are you?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1e14db1d41a1dba600b5a559467a459018a77b1f7378219fecb26a4663e5888f",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 74,
        "sourceEnd": 148,
        "text": "Hi Mark! I'm fine, thanks. Yeah, it's been a while. I've been really busy.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "16ddfd0003eb52b452c309fff04d987b15b8361662a2edaf7790f5977db7a08e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 155,
        "sourceEnd": 176,
        "text": "Busy with what? Work?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ec2abaf87d3b9749db93fc639007579c37cf962854a737261cd06d722d5281be",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 185,
        "sourceEnd": 273,
        "text": "No, not work. I've started a new course! I'm studying business at the community college.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "cb2c7d423f93d89d9cd595e731dd1d55e16d40a2d88e5f5f41e292f112201197",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 280,
        "sourceEnd": 318,
        "text": "Wow, that's great! When did you start?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "a89c900167c126082f8e2cbe70c45d142c999ebbac5d21e8044da444839b21ce",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 327,
        "sourceEnd": 394,
        "text": "I started three months ago. I've already finished the first module.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "97155946cd8f8604c6aeb1a2f80410c7de1dd50377a07590561084e276132bed",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 401,
        "sourceEnd": 465,
        "text": "Three months already? That's fast. Have you taken any exams yet?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "a1128c2726d7fefe1ace548d0f96b295963c9ecc867e000a33838ee0279ece70",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 474,
        "sourceEnd": 575,
        "text": "No, I haven't taken any exams yet. The first exam is next month. But I've already written two essays.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "13c60d298675ab4581b373c2007e67604cb95f88818592755133ac91c10d8e03",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 582,
        "sourceEnd": 620,
        "text": "Good for you. Is the course difficult?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "efcca331cdaacd0d464a9752589db56c3d26975f50d5b0d88aade7c4380c722a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 629,
        "sourceEnd": 709,
        "text": "It's okay. I've learned a lot since I started. But I haven't had much free time.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "2592d5635d334f65df5e8c1ae3927bd54d9812a39c98d624e9987696a3fe326b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 716,
        "sourceEnd": 759,
        "text": "I bet. Have you made any new friends there?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3f9e0b3a91ba68b25efe2d1d652129415fd805c01aa742df42c516ff23c95b8c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 768,
        "sourceEnd": 880,
        "text": "Yes, I've made a few friends. We study together sometimes. Actually, I've known one of them since the first day.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "7ec4472bd1f6c5a97892f9d5d9ad55422a98757beacf6801ff70915e17dbdaad",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 887,
        "sourceEnd": 942,
        "text": "That's nice. So, how long have you been at the college?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3a6683227807c15f74f347978b5e9a56acf3c1f1374412d3fa5c50f82ecbdbcc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 951,
        "sourceEnd": 1002,
        "text": "For three months. I go there three evenings a week.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "291a040a41143b0baef69ae32ada8ae01d0b4fced50b27e3dd3a01a9fe93d7f8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 1009,
        "sourceEnd": 1079,
        "text": "Three evenings? That's a lot. Did you use to watch TV in the evenings?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1da794f471d574bcb9cc6a7f9b2657744768a8be1ff76d13619fe945bce0235f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 1088,
        "sourceEnd": 1176,
        "text": "Yes, I used to watch TV a lot. But I haven't watched TV for two weeks now. I'm too busy.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "3b624a47b8bd1475c4dcf0318f115847f63b8328d37f6df6083c82f1f68cacf9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 1183,
        "sourceEnd": 1240,
        "text": "I see. And have you finished your homework for this week?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "f72c3d30a84708b2adb22961781238bd8f3bb15e1b24cb68a92a351e308c38c2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 1249,
        "sourceEnd": 1316,
        "text": "Not yet. I still have some to do. But I've already done most of it.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "52991cd78a12fbcef23100eff4ea4b7a223648ca4195a2ab39bff59f9f2462ab",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mark",
        "speaker": "Mark",
        "sourceStart": 1323,
        "sourceEnd": 1357,
        "text": "Well, good luck with your studies!",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "12a162557ebd2b11dcb022ddf34e0cc134ca2d1ee6989a1db09d2ff50fb8333c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "li wei",
        "speaker": "Li Wei",
        "sourceStart": 1366,
        "sourceEnd": 1410,
        "text": "Thanks, Mark. It's been nice talking to you.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "f0855bdc2c7a4b01a7a2dbb78d98752f8d0b177325be340670c0fa4fbbc55b5d",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
