    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 61,
        "text": "Hi, Lisa. I haven't seen you for a long time. How are you?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "cf4710584d5beec2dbd93531340bbe7d1c1cb7200f6b966ec6ce52f01f1d6568",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 65,
        "sourceEnd": 150,
        "text": "I'm fine, thanks. I've just finished my English course. I started it three years ago.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "11b918d0341a3e599ac1fb7dc56b48e663847657f895eb82b0a3b67dd7866a83",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 154,
        "sourceEnd": 216,
        "text": "Three years? That's a long time. Have you taken any exams yet?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "bbb90895ac9d4f7a14145bba2023853ed130035e9a268e2b0f9b6c8000c4ed7b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 220,
        "sourceEnd": 279,
        "text": "Yes, I've already passed the B1 exam. I took it last month.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ffbe6477b72ad9aba399c77b32e4be642d38fce3431a3b384d07f1fc983171da",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 283,
        "sourceEnd": 359,
        "text": "Congratulations! So you've been a student at the language school since 2020?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "29d29e7d3a9b58ca8d33e813f6d783272f8e9efffdc04a959bbdeb51351669aa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 363,
        "sourceEnd": 468,
        "text": "That's right. I've studied there for three years. But I've also started teaching children English online.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ef808cb652bd9f9bed7614c2ee924625836dfb93c11d4c6d0f82dbe697790844",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 472,
        "sourceEnd": 536,
        "text": "Really? You're a teacher too? How long have you been doing that?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "0520c9a029a0a55fcadc8f27f114633bf91f1984f8d19d90c5d54396b96193a6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 540,
        "sourceEnd": 594,
        "text": "I've taught online for six months. I began in January.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "0394870c5f84458beec2bbf77bec070666ab6648a1d3c74fd70d34775de86d17",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 598,
        "sourceEnd": 682,
        "text": "That's interesting. Have you noticed any changes in your students since you started?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "b6fca02c4d29c3590922777a2ecc5b0cdb39c5e544f3629054db4f035d3a9292",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 686,
        "sourceEnd": 783,
        "text": "Yes, they've become more confident. At first, they didn't speak much, but now they ask questions.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "038227a60ff755e3323a09d319597ab73ee34a2fdd55e202a734484814521487",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 787,
        "sourceEnd": 824,
        "text": "Have you changed your teaching style?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "2a1764f56066017acd4f6e20a7f69251ae1bf062c0877bcad0944038aff86c04",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 828,
        "sourceEnd": 893,
        "text": "I have. I've used more games recently. I didn't use games before.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "20eb6fb9b28c77cba50e5abe55a3001a4635bbae60094213a7b766bca11870bc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 897,
        "sourceEnd": 952,
        "text": "What about your own studies? Have you stopped learning?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "fb772ac33e83b3df852e7e2ffd4f7f5feb1cf8139860822a97199f3db03f3b60",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 956,
        "sourceEnd": 1041,
        "text": "No, I haven't. I've just started a new course in teaching. I haven't finished it yet.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "a8c94677037098bb54274ca46b47ac11e427241bf891ad267fa5e09cb328f883",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1045,
        "sourceEnd": 1107,
        "text": "You're busy! Have you ever thought about teaching in a school?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "c68090587e3bcd8ef294609cd1b3ab0410d969e0a4ff96dc3c87e272ca1d5f41",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1111,
        "sourceEnd": 1187,
        "text": "Not yet. I've worked online only. But I've thought about it since last year.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ec1b5d5b1e19639ddc2766e92ffbc3c99f0e0eada44c745842a43fe61dc138c5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1191,
        "sourceEnd": 1223,
        "text": "Well, good luck with everything.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "e22f271234284fbe44108768dd7c5c1509a9fd4696f651d1e9532f629d363af3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1227,
        "sourceEnd": 1234,
        "text": "Thanks!",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1aa7b1c1d5fb1fd6d299eae251a665c7898baeb43d48fb6b8a5b76da6c6ef739",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
