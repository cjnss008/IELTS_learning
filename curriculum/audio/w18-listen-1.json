    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 48,
        "text": "Hi, Ben. What are you doing at the library?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c855123d93263581151d1a345af4a9e5c2a2c049f38f809b787efed46b934430",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 54,
        "sourceEnd": 126,
        "text": "I'm waiting for the tool corner to open. I want to borrow a small drill.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "386309c850c7e44912fb5249113bb5e11831eb15a43d6c8b4f2ceddd7d8bbdc0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 132,
        "sourceEnd": 151,
        "text": "Why do you need it?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "8175b33a280d7ff408486a3be193b24f91c2de2e2391be454a72b7a0194ae950",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 157,
        "sourceEnd": 216,
        "text": "To put up a shelf in my kitchen. My books are on the floor.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "06a325baed760937c2c1113f844d216d3dcf25e307ed2f16dae1a11550669cc5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 222,
        "sourceEnd": 253,
        "text": "Do you know how to use a drill?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9a39d841377def11b5dcf59cac5061ea3bd25ccbfe7b2ba09eae4fafb439bd71",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 259,
        "sourceEnd": 323,
        "text": "Not really. I watched two videos last night to learn the basics.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "d8454b52c79f011bfe289f86a363871acc7f09ab6c98dd23ceb7a66c77f258cc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 329,
        "sourceEnd": 406,
        "text": "Be careful. My brother tried to fix a shelf last year, and he broke a window.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c2de2a89334e1f75f7ab478dd8d2bdfde23ef639ebebf6ba364772078ee5139d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 412,
        "sourceEnd": 424,
        "text": "Was he hurt?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "4bfe5f605b57d7121526a93054db55f1895515b006d144043ce31d59d9d3486b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 430,
        "sourceEnd": 474,
        "text": "No, he was fine. Only the window was broken.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "763e33771b174d48af460ad2951141a281b94f1c67f0cec5656121e814bd30c2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 480,
        "sourceEnd": 515,
        "text": "Does the library lend other things?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "88673d536fe26cc0751bdf86e273c5d76687b1d8ce333d7bb4c3391fbc923424",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 521,
        "sourceEnd": 593,
        "text": "Yes. You can borrow a camera, a small sewing machine, and even a guitar.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "ff7b2418978b7bd40ef8d6a9a8e4a84a2898350fafe216f7015d2d36802dcbcc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 599,
        "sourceEnd": 652,
        "text": "I'd love to learn to play the guitar. What about you?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "17a18325fecefc548b6d623c4cad2e6fb7209a2d7d6500ce0eb62c1ad82355cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 658,
        "sourceEnd": 784,
        "text": "I'm learning to sew at the moment. I'm making a bag. The instructions are hard to read. They're printed in very small letters.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "c912e946416ae7f9ee0c1089736ad00adee09876b1f25f0414e1d92459b3ed66",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 790,
        "sourceEnd": 811,
        "text": "Can a librarian help?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "300ec88516b1740996376d177ca3276ab383e8d0b77ca082e393d47620ac50c0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 817,
        "sourceEnd": 866,
        "text": "One showed me how to start the machine yesterday.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "a7bfe7f092e97da475c304448e90d87843f643e66a4a1ae8a7b71009c26280a3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 872,
        "sourceEnd": 914,
        "text": "It's ten o'clock. Is the tool corner open?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "48c391ab439b5a007301a165478f0f3ac323673c5295cdc12ba1d72df42dda62",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 920,
        "sourceEnd": 964,
        "text": "No. The sign says it opens at half past ten.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7818603a2efd24bc13f617bca256053b9fea8ace6d52a3744987faa9830c8557",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 970,
        "sourceEnd": 1095,
        "text": "I read ten o'clock on the website. That must be old information. While we wait, I can send you one of my videos about drills.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "b97db28043d4613322e137f778fb5913ce8ce1a3da28bb5bc7b84d00e562fa3d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1101,
        "sourceEnd": 1156,
        "text": "Thanks. But my phone is almost dead. It needs charging.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "0006b8d3538bc12d404f745c260c886797251eef33c829b9eb1e6537b85d1baf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1162,
        "sourceEnd": 1211,
        "text": "There's a socket near the window. You can use it.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "95ea11b41e35f9cf6d27acc3f5a8106734f63584937e275f233a7e0a16418271",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1217,
        "sourceEnd": 1260,
        "text": "Good. Then we can watch the video together.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9e1a29150077ae68f7b63978bcc905ca0796018286ab63d19f634285b4e051e9",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
