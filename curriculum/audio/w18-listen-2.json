    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 94,
        "text": "Hi Tom! I'm trying to set up my new smart speaker, but it's not working. Can you help me?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e347f37eb055e6a19699f12cd12c2004d80b3e03aa1b52218f4990462daa4c23",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 100,
        "sourceEnd": 146,
        "text": "Sure, Mia. Let's see. First, is it plugged in?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c652ac9aa5509de8be2b3b76762a7f48a68c7cbbb302c20e0812073cc53f9bb9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 152,
        "sourceEnd": 227,
        "text": "Yes, the speaker is plugged in. I checked the power cable. The light is on.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a8ab8658a5dd38c9434a09f7d41f170a40c0dcb8ff2e5c17f34366573a529d9d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 233,
        "sourceEnd": 306,
        "text": "Okay. Maybe you need to restart your phone. Sometimes the app gets stuck.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "69222d81356717ce4d666b52c8beb1438e71dadfa05540ad3d0176436d35a040",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 312,
        "sourceEnd": 347,
        "text": "I already did that. It didn't help.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "20a111cde7d4bbff65c5025c3a889af84209382ebd2092f48e487a8efb794c97",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 353,
        "sourceEnd": 460,
        "text": "Hmm. Let me think. Oh, did you check the Wi-Fi password? The speaker needs the correct password to connect.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "661114c4ecf22bed70d5b9b87d12df508b1272151e430c203c7f55d95000ba6d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 466,
        "sourceEnd": 572,
        "text": "I think so. But let me try again. ... Oh! I see the problem. I typed the password wrong. Now it's working!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e94d215dd795ffcf362f3112ca83990ef79beedc8d3ced4a2a7b33b9b090f603",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 578,
        "sourceEnd": 671,
        "text": "Great! Next time, once the power is on, check the Wi-Fi password before restarting the phone.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "71ae4823b944205a07314eed102a8465e1a6c88ee15d810755b292ca2f0fcbac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 677,
        "sourceEnd": 709,
        "text": "Yes, I'll remember that. Thanks!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "db1e0b9d454a7d6706622a865d89122dea9dda045cb75bfb27d0b161346edacd",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 715,
        "sourceEnd": 783,
        "text": "You're welcome. Also, you should update the app to get new features.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c515d4975da4cf2c4c33489bdf7928e169998099f75f807a65c6126df2410a32",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 789,
        "sourceEnd": 916,
        "text": "Good idea. I'll do that later. By the way, my sister has a smart speaker too. She uses it to play music and listen to the news.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8b7ba4f607f02d081ec2ae8632d8a77340688ee47ce298c6dd5720b9da836cb2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 922,
        "sourceEnd": 1000,
        "text": "That's cool. Smart speakers are very useful. They can help you do many things.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e49853fcce8c1b7d50e3f0e3a50ef1536ee5c736687e25c5199751ee217dfebe",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1006,
        "sourceEnd": 1119,
        "text": "Yes, I agree. But sometimes they make mistakes. Yesterday, my speaker played a song when I asked for the weather.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "badd4291a11c6a67a49479ded046cc5fe424d2e798069abf8b239c12da3787b6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1125,
        "sourceEnd": 1221,
        "text": "Ha! That happens. You need to speak clearly. And remember that a working connection matters too.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b9ee2848eaf94406a33a2963159cea0b2c59d0da23fb1dd0c1cb880cbc097bd6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1227,
        "sourceEnd": 1262,
        "text": "I won't. Thanks for your help, Tom.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "227c57923dbbeb5cfd9754a4b42d3afa362df9821bd8e100e6a1ac063b8575bf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1268,
        "sourceEnd": 1294,
        "text": "No problem. See you later!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "50a61bc3591c4211640de0ee8775e397327ad050f1a3ec70fdeba1acb2e21c08",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
