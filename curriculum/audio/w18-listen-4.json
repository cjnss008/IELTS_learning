    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 58,
        "text": "Ben, can you help me? My smart speaker isn't working.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e86b0faffcb410cb9499b74c757c25f350608a31f0e50b06107790b1a55f94a1",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 64,
        "sourceEnd": 89,
        "text": "Sure. What's the problem?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "57286cade39e497175c163d292d8b6a6972827ed2201d8ca3cbb72a1d6b125bb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 95,
        "sourceEnd": 181,
        "text": "I say 'Turn on the light', but nothing happens. I want to use it to control my lights.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "d0a84a0a89994987caeab95017871d4be861e28b1760a24d964f8130cb09f092",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 187,
        "sourceEnd": 218,
        "text": "Let me check. Is it plugged in?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c5cf084842a5b3f466fee03c38c929a1d0fecf1a63897cebec549fd63ab4bac2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 224,
        "sourceEnd": 259,
        "text": "Yes, it is. The light on it is red.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "9fdcebaa23ed19fec89bf9e8e64f087585ea3487b96d05a0ac71bc3d771e5a53",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 265,
        "sourceEnd": 350,
        "text": "A red light usually means it's not connected to Wi-Fi. Did you move it to a new room?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "fdd6376c290919d92d5e9f1a91d439a93fbe547b8b18b931165b2f2a0626cbb4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 356,
        "sourceEnd": 395,
        "text": "No, I didn't. It was working yesterday.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "66a854938d18afaa1eb19691ac3c360d3873d6b3d69e850627746d892d6d18b3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 401,
        "sourceEnd": 464,
        "text": "Maybe the Wi-Fi password changed. Do you remember the password?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "1aade1bdcfa3a4d9e1ba662eaad16d6acc139250516d59cfb6b8bf46f3ca0932",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 470,
        "sourceEnd": 519,
        "text": "I think so. But I don't know how to reconnect it.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f55ca1b679c2916c22ac426a413715f9efd1fdd212a123da83c439ac4be7e445",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 525,
        "sourceEnd": 619,
        "text": "You need to open the app on your phone. Then press the button on the speaker for five seconds.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "148e8a4bf66ac734aa0918d958687aa6eeafd7f91f4ce97dbc284cbf418cd849",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 625,
        "sourceEnd": 664,
        "text": "OK. ... The light is flashing blue now.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "453fdf966e9793920bfda8a6855170352b68b612f83f5153025dc12cdf104de3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 670,
        "sourceEnd": 739,
        "text": "Good. Now choose your Wi-Fi network in the app and type the password.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "83d0621c48cfdd4926e673c0cd7d8cc17bf2284514eecf544b4e1beaeee50976",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 745,
        "sourceEnd": 795,
        "text": "Done. The light is green. It's working! Thank you.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e7ab77fd7819f54336217977105486b9037b6b6d0950ff6e1e3868c5a6bba06e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 801,
        "sourceEnd": 892,
        "text": "You're welcome. By the way, you can also use it to play music. Just say 'Play my playlist'.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "40c3f0177a826d43cb8104a101282098d3b8ca479f90cb6aefdaed5a8d8a7834",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 898,
        "sourceEnd": 948,
        "text": "Really? I'll try that later. I'm happy it's fixed.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "f30277be7d83674297933abc6c96b5ab5bc9ee74c81f12e2871c0c39307f294d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 954,
        "sourceEnd": 1013,
        "text": "Me too. Remember to keep the app updated to avoid problems.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "a3157308b93b978b5d328e84135474b614d29d12034874e8e1ee138cbc139324",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1019,
        "sourceEnd": 1040,
        "text": "I will. Thanks again!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "7ec0f3bd879ce79d673ab6f5bf15ffea5cf3cfab4558a0d328431e435ecff9d3",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
