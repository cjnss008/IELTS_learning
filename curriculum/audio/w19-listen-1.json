    "segments": [
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 5,
        "sourceEnd": 50,
        "text": "Hi, Grandma! I'm here. Happy Spring Festival!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "470dc3970543450054f2d58159936bb4adc4e7da4a0ed49b9a1956380d357433",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 60,
        "sourceEnd": 152,
        "text": "Mei! Come in, come in. Your grandfather is in the kitchen. He is putting dumplings in a pot.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f56fe9a37d7a802444a866a626c8ed6895b45b30d4a225d0cde6785e5fd94e7d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 158,
        "sourceEnd": 196,
        "text": "Great! I love dumplings. Where is Mom?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5c4dd9b31ad27208ee2524de2b775d7923eb6a0a6a48a0e96826142fc354e108",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 206,
        "sourceEnd": 275,
        "text": "She is on the phone. She is talking to your uncle. He is in Shanghai.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "10c251e294518b7c08839b7599506745c795a797d072bf9715768f5b8122fbb6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 281,
        "sourceEnd": 347,
        "text": "Oh, I see. And what were you doing when I called you this morning?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ee416368d60f57fd71bb046942433d368127f109e7048781b4ce9d91108e9ae3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 357,
        "sourceEnd": 448,
        "text": "I was cleaning the windows. Your grandfather was washing the vegetables. We were both busy.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "72e5b7d7f3c25397ea3bb8e962d08f7f65c38cdfeb3955a75e25c9bc55c310df",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 454,
        "sourceEnd": 504,
        "text": "I called at ten o'clock. Was Grandpa cooking then?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "990e049e0451a76709634e9b1c5355c8a986cf22d17dbe743d912b600ef6f062",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 514,
        "sourceEnd": 598,
        "text": "No, he wasn't. He was washing vegetables. He usually doesn't cook. I do the cooking.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "626556bc2679c54cc2e8c5d42f1d81aef7d9a43d31a34443fad9fac4658540ef",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 604,
        "sourceEnd": 636,
        "text": "Ha ha! Grandpa is a good helper.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "89a5da787964032f24491590233f240c95a64287fd49dc33a3c0844e2960b33a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 646,
        "sourceEnd": 704,
        "text": "Yes, he is. Now, sit down. The dumplings are almost ready.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "702be05ae0ab76744240fd1b46904afdbc7c6800070a76962a261aa599081b48",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 710,
        "sourceEnd": 761,
        "text": "Grandma, who is the woman in the photo on the wall?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1cc77dc0de5c7a4f91424bf59b8ef13988375ed8d19e5010e05c3eac98b1424c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 771,
        "sourceEnd": 829,
        "text": "That is my sister. She lives in Beijing. She is a teacher.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b1f56b78da83d1a530c2fe0e396802c121e61dc11422bf9b3f34816a89674a56",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 835,
        "sourceEnd": 893,
        "text": "The photo which is next to the window? She looks like you.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "636d0141412a58ba526058f59f284069bd8dd3d9d9242846844afc8f2e75da6d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 903,
        "sourceEnd": 964,
        "text": "Yes, that one. She visited us last year. We had a big dinner.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bfe07d399c555e0fa7d2d158f487141adfdd1b4516ef50c2cc2c430cbc70a7fa",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 970,
        "sourceEnd": 1019,
        "text": "I remember. The dinner that we had was delicious.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c1e0754b99e72691dda500ea010ffcaec9ad985a8039ab99a84931f27a47749d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandpa",
        "speaker": "Grandpa",
        "sourceStart": 1029,
        "sourceEnd": 1072,
        "text": "Mei! The dumplings are ready! Come and eat!",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "4f211a5387ba9c5a90f0904d7463845801c3dd5fcebbdc3fcd091378444fe2f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mei",
        "speaker": "Mei",
        "sourceStart": 1078,
        "sourceEnd": 1126,
        "text": "Coming, Grandpa! Grandma, thank you for the tea.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "5ef0f7da6642718fb205c2f146bb26c264fbd06d8361bfb133b9a8548e2de810",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "grandma",
        "speaker": "Grandma",
        "sourceStart": 1136,
        "sourceEnd": 1177,
        "text": "You're welcome, dear. Let's eat together.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "71d5f3bffb504a4d1565b8a5f3a3664fd7429e570c72a8e71230a9a951a11e74",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
