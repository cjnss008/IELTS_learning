    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 73,
        "text": "Hi, Tom. Are you free to talk about the pool schedule for next week?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "a6d186e4a6772d4bb54609097389b1d92046e630a0369ab637546700fb41a5a5",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 79,
        "sourceEnd": 154,
        "text": "Yes, I am. But I only have ten minutes. I need to go to the pool at eleven.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "05d57e0029c5fd3b3704a7dace869f0f8bdacff89b10b41d77d3f325169638dc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 160,
        "sourceEnd": 263,
        "text": "That's fine. So, the first thing is the swimming lessons on Monday. We have three classes now, not two.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9ed053cb71ccfe119df23603c6fb37f3a44b53520710c3fc9f3fcc9f8710bec6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 269,
        "sourceEnd": 313,
        "text": "Three? Last week we had two. Why the change?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "c510852cc457838f0c0b6b1ca3ac2299c26ffabe1171453a618dcd1a032f76d9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 319,
        "sourceEnd": 396,
        "text": "Because more children want to learn. The new class is for beginners at 4 p.m.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "20750aed7b608e68ea2d64b939d0fd7e0182f1bede23f2b558a771402af8347d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 402,
        "sourceEnd": 425,
        "text": "OK. And who teaches it?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "5d9e160e4ff13bb98b1082efcf268e6ec035201133aa6380f4f505901b3131d5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 431,
        "sourceEnd": 506,
        "text": "Sarah does. She is a good teacher. She taught the advanced class last year.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "3f6af352489dc71bbf02e946082526173d076c58b80e8f13ccf3eecf7caa2a22",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 512,
        "sourceEnd": 567,
        "text": "Good. What about the water aerobics class on Wednesday?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "aad696a8090a302090b95992c2b48162851e5d5a9d47f7a97b6f0f9619507c7f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 573,
        "sourceEnd": 653,
        "text": "That class is at 10 a.m., not 9 a.m. The teacher, Mr. Lee, asked for the change.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f01ae4cb97130f84c987b4bdf576c1ff191d615ff26502f690212d463c97b5ac",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 659,
        "sourceEnd": 702,
        "text": "So the pool is free at 9 a.m. on Wednesday?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "4ce6c891a96439f37bea1b64f85e154308eda9912994b4b279158b3de867452b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 708,
        "sourceEnd": 759,
        "text": "Yes, it is. We can use that hour for open swimming.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "14e24647a8387bb38b04a08312df94d8b28830cbb74a021dc8f22effa2d84a11",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 765,
        "sourceEnd": 830,
        "text": "Great. Now, the pool cleaning on Thursday. Is it still at 2 p.m.?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "b2200c85618b2c69732bfff98aa089ab2a79fc4f363280271903059a15efddc6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 836,
        "sourceEnd": 904,
        "text": "No, it is at 3 p.m. this week. The cleaning company is coming later.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "76bab1b3549ef1f518d72172ab089493f975dcf8ebb0156f7e70d088d0f70880",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 910,
        "sourceEnd": 966,
        "text": "So the pool is closed from 3 p.m. to 5 p.m. on Thursday?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "cdfc4d332c7d6b868450ed6cd09758fc26d0d8a2c30953e30dd7d5c301a013ab",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 972,
        "sourceEnd": 1089,
        "text": "That's right. And on Friday, we have a swimming competition for children. It starts at 9 a.m. and finishes at 12 p.m.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "d0996c267d148f622c6a3de64637638ae9a3f5512437b54cbe3db2b7895d7410",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1095,
        "sourceEnd": 1126,
        "text": "Do we need more people to help?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "e7dfcb55cd1e01eefe2b50905bde747183ae8bf98dda9586d1f75db98886250e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1132,
        "sourceEnd": 1192,
        "text": "Yes, we need two more helpers. Can you ask your friend Jack?",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "f70a06fa8f8d3758907d9f53bee0ac7bc2906f667f22272827daf0b5fabd4ff7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1198,
        "sourceEnd": 1268,
        "text": "I can ask him, but he is busy on Friday morning. He works at the shop.",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "ae5fca47b02f3ae4bb42d19eb779330baae709f431536ae653c90c1ec6231970",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1274,
        "sourceEnd": 1322,
        "text": "OK, I will ask my sister. She is free on Friday.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "9b0e65efe4d53228885e2654dd003e324843b89383797f51d93ad20e441ef4c1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1328,
        "sourceEnd": 1392,
        "text": "Good. One more thing: the pool opens at 7 a.m. every day, right?",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "8d0f70244a7c7ecef5ddcfa21f69b208f68abe29391a13f8edff29ebff30d534",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1398,
        "sourceEnd": 1474,
        "text": "Yes, but on Sunday it opens at 8 a.m. because the staff meeting is at 7 a.m.",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "1a05a15bdfa9112b10987a4e5315e8a895196ad320e654e63242aa1c55ff0814",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1480,
        "sourceEnd": 1547,
        "text": "I see. Thanks for the information. I need to go now. See you later!",
        "boundary": "turn",
        "voice": "en-US-ChristopherNeural",
        "textHash": "5f74f20a1ff8a667144808d29daf0d0fa4ec7b32e8136ba6f1441cf1cc578915",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1553,
        "sourceEnd": 1566,
        "text": "See you, Tom!",
        "boundary": "turn",
        "voice": "en-US-MichelleNeural",
        "textHash": "2248943f8564af0b7c0f192d88316039e7febb398a38ab74fa6ccbcbbcedb788",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
