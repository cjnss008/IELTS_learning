    "segments": [
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 3,
        "sourceEnd": 501,
        "text": "Good morning, everyone. Welcome to the community pool. My name is David, and I'm the pool manager. Before you start swimming, I need to tell you a few important rules. First, the pool opens at 7 a.m. and closes at 9 p.m. on weekdays. On weekends, we open at 8 a.m. and close at 8 p.m. Second, children under 12 must always swim with an adult. Third, please take a shower before you enter the pool. Fourth, you cannot bring food or glass bottles into the pool area. Water in plastic bottles is fine.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "90ddcd64ceaa59e26d372dbcaeef8c19f62a37baf75e0b680d9ae9af47c5eb63",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 506,
        "sourceEnd": 545,
        "text": "Excuse me, David. Can I ask a question?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "d5d6e433e02044c48c9e6e8903a517d733938114762a8243f321aaae725855e5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 550,
        "sourceEnd": 570,
        "text": "Of course. Go ahead.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "cd53dc6e18408b9b68f04c04ef4ed7dd7a80ff6f7000fad86e5db5f74a38ac26",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 575,
        "sourceEnd": 626,
        "text": "Is there a swimming lesson for beginners this week?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "a3cd71c21edc6e17b50d311d9c64d1a66be7488b4002681ee3533554fcd6686c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 631,
        "sourceEnd": 792,
        "text": "Yes, there is. The beginner class is on Tuesday and Thursday at 6 p.m. It lasts for 45 minutes. The cost is 10 dollars per lesson. You can pay at the front desk.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "7ac987261240640557a29502d6b816e6b7a314cddfcee46d8ac2603498b5b489",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 797,
        "sourceEnd": 840,
        "text": "Great. And do I need to bring my own towel?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3af0e4a28e1215075840d1503cccaae25a7f4268d7885c49b526e2b309b9b50a",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 845,
        "sourceEnd": 923,
        "text": "Yes, you do. We don't provide towels. But you can rent a locker for 2 dollars.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "6c793c9e69541200b3caa64afdf71f9d2b5eb451f7e7e4062183734a204eed10",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 928,
        "sourceEnd": 973,
        "text": "Okay. One more thing: is the pool water warm?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "b673f1f9aa09f712ff266c6c0f7ac1347e3b36fd8d7cf9e4729cc11847da9125",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 978,
        "sourceEnd": 1064,
        "text": "The water temperature is usually 28 degrees Celsius. It's comfortable for most people.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "e0c69aaeff1dbaf81fd65674feddc34b326bb84266897e80d389b3d74f4a767d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "w",
        "speaker": "W",
        "sourceStart": 1069,
        "sourceEnd": 1100,
        "text": "Thank you. That's very helpful.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "f98e911f6032a6670996a44fd3695e99ab908b3d8230b224f7da2d9a388e2abc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "m",
        "speaker": "M",
        "sourceStart": 1105,
        "sourceEnd": 1137,
        "text": "You're welcome. Enjoy your swim!",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "9e23f35328e281f509a811caf4565749249910666810fe1e21836a2ab6e7bf06",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
