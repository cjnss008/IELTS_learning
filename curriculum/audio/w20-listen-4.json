    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 63,
        "text": "Hi, Tom. Are you ready for the pool training this morning?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "fd965de9f77f8bf43899509aa35e78c7e6789e21b121309b45a86987c802c33b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 69,
        "sourceEnd": 139,
        "text": "Yes, I am. But I can't find my swimming cap. Do you have an extra one?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "867d9f78d9e1f99e1bf204259e85f9084287cd75a97b18f958dc7c82c1cea3ff",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 145,
        "sourceEnd": 190,
        "text": "I have two caps. You can borrow the blue one.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "6881a17d882d0ea47f500b1626b9f4e13e9997390492dfc6e7c609d944d5405b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 196,
        "sourceEnd": 237,
        "text": "Thanks. How many people are coming today?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "137fe9b882f00af2a3c9faf01babdf1446d255cb942f7eea9658b05d53a75132",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 243,
        "sourceEnd": 305,
        "text": "About twelve people. The coach said we need to arrive by 8:30.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "8f786d1f51eae263d23b9ded1180d1930cf72dc033dd232b659adffe68453d27",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 311,
        "sourceEnd": 361,
        "text": "8:30? I thought it was 9:00. I'm glad you told me.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "b8341229c740c79ee34b78b99d6e8c26f1490941da82e834c47a584199599eb1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 367,
        "sourceEnd": 444,
        "text": "The coach wants to start early because the pool closes at 11:00 for cleaning.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "0d610b6d4f25a572cf981f965f8d7283600356939f7a4d0a5526bd2542ce6010",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 450,
        "sourceEnd": 483,
        "text": "OK. What are we practising first?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "c7b4caf13a3d37f15f6ed870b8ae7bd43bc8267b21dc5305b00483dc7f6454bf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 489,
        "sourceEnd": 572,
        "text": "We are practising breathing first, then kicking. After that, we will swim two laps.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "d052c081800a4c08d7e6786a7fc44c0b9b1e9c233e1e91dd787f16371c396c00",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 578,
        "sourceEnd": 625,
        "text": "Two laps? That's 100 metres. I'm not very fast.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "bcc94524f5ab9f2a7e1c31c18617fd41e396c3cebda19d303ab23862a8618aa1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 631,
        "sourceEnd": 721,
        "text": "Don't worry. The coach will put you in the slow group. You can take a rest after each lap.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "64c0a6794fa402db4358ecfff31efc164563b28d1f63eb5b0fd6a05d32bb6d0c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 727,
        "sourceEnd": 750,
        "text": "Good. Who is the coach?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "08d01ae4e3965b7d3c137e91c8ff683a60b8ebeede0b55bb231e847327f26e4b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 756,
        "sourceEnd": 836,
        "text": "Her name is Sarah. She is from Australia. She has taught swimming for ten years.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "6f7721c3346e409169e8855bf271da0eb6b2a2a25448a34d41cbef1c200ff6cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 842,
        "sourceEnd": 856,
        "text": "Is she strict?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "da26baf0a803a2bab058cddaab218e2657e38ada08379a65f5813ca1581adcc1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 862,
        "sourceEnd": 928,
        "text": "Not really. She is friendly, but she wants us to listen carefully.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "f6dd106f6e91c4880b8e2af1040e6b7c52ee9ec1f95cace134a5383080fa842f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 934,
        "sourceEnd": 961,
        "text": "I see. What should I bring?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "f83dc8056e166511f031acc7d1bea012e23392486a715b858ee3201018e8eec3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 967,
        "sourceEnd": 1069,
        "text": "You need a towel, a water bottle, and goggles. The pool has lockers, but you must bring your own lock.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ab5bc055e219053148f2359e89c7b7dc4ad19823f80742b6a131bdef5671a3b2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1075,
        "sourceEnd": 1126,
        "text": "I don't have a lock. Can I leave my bag in the car?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "3ae1735dc30a45515e6a49341c3beb1080d5c8b80e345c448c352bb40a522d86",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1132,
        "sourceEnd": 1227,
        "text": "You can, but it's safer to use a locker. You can buy a lock at the front desk for five dollars.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "08045b6a3b7bf1a9929821c8987c7e9fc31227b488228235758a9b59c163cd5f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1233,
        "sourceEnd": 1286,
        "text": "OK, I'll buy one. What time does the training finish?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "21151fd6d7420f018c3f4ed82f2659b78acb70080a262fef9fb84948af7ca4e3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1292,
        "sourceEnd": 1368,
        "text": "It finishes at 10:30. Then we can have a drink at the café next to the pool.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1cdec83033eb16e75b5afaefcfa1b97ed75519b710ef3f30673055a6f50f4816",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1374,
        "sourceEnd": 1408,
        "text": "That sounds nice. See you at 8:30.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "10c68df55854312468759d4b4bb16ae7c2126e5102160f74614e649288c357f0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1414,
        "sourceEnd": 1445,
        "text": "See you. Don't forget your cap!",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "ea628f52cb7df7d1d5ed78bb282395f827c66e664f0f866096d339103c65132c",
        "pauseBeforeSeconds": 0.65
      }
    ]
