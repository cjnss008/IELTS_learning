    "segments": [
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 5,
        "sourceEnd": 42,
        "text": "Hi, Ben. You look worried. What's up?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "1d8768ec3c57be16d579ff9493d1e5c2d12499c20546e8ce4203f1c26e046304",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 48,
        "sourceEnd": 129,
        "text": "Oh, hi Mia. It's my new smart speaker. I think it's listening to me all the time.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "fa56eba85face98f709e7bf326bd3f16d6ada9697030a483075ca12e9fe4442b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 135,
        "sourceEnd": 165,
        "text": "Really? Why do you think that?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "abdb10d25d4b71588bc04fe1ecfc2b1d402adc372c1d7c61bf3c2b7c11f2ec53",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 171,
        "sourceEnd": 296,
        "text": "Well, yesterday I was talking about buying a new bike, and then I saw ads for bikes on my phone. That can't be a coincidence.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "38b9f2a4996460d8e9d553e31b3efe1fc7f103369f89d82b33e9975278f8cca7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 302,
        "sourceEnd": 404,
        "text": "Hmm, that is strange. But maybe your phone and the speaker are connected? Do you use the same account?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "345a6d038e092c3b422fcd47a32ed3c9f7f7d1d818ae4674619c0729a6e1d7b5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 410,
        "sourceEnd": 520,
        "text": "Yes, I do. But I didn't say anything to my phone. I only talked to my friend in the kitchen, near the speaker.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "187866ed5f9ee53fcb5fd5c396e94aa00f36a99b954ad974494776d62582cf13",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 526,
        "sourceEnd": 612,
        "text": "I see. So you think the speaker heard your conversation and shared it with your phone?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "57be1351cd9a47677b7c75eb0e4166cb4ac9e5862b53a8fde6c29b5c14c3d285",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 618,
        "sourceEnd": 765,
        "text": "Exactly. And that makes me uncomfortable. I mean, I know it's supposed to help me, but I don't like the idea that it might be recording everything.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8cda1fba143af8821a190d00b51a7634d8aecbae12dc8a674044b52295998a5b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 771,
        "sourceEnd": 889,
        "text": "I understand. But have you checked the privacy settings? Maybe you can turn off the microphone when you don't need it.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "5f96ebe0ff0fb15f83d0c015137fba9a6c844fec9c9c16b216a65ef2eb6155f9",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 895,
        "sourceEnd": 957,
        "text": "No, I haven't. I didn't know I could do that. Can you show me?",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "bd27f00aac530accf5bd243aa5b723d8a6f149c84ed0d1d510daa70a50e19d9d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 963,
        "sourceEnd": 1098,
        "text": "Sure. First, open the app on your phone. Then go to 'Settings' and find 'Privacy'. There should be an option to disable the microphone.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "aefeedfbf02caef263d27bc342f4c0daee9a14f90c2ac5dbd07739f87a300332",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1104,
        "sourceEnd": 1181,
        "text": "OK, let me try. ... Oh, I see it. It says 'Microphone: On'. I'll turn it off.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "da79972c602bc9873e937dfb9c5b0ee402e8e8a3623e274baf3964ac4209807c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1187,
        "sourceEnd": 1276,
        "text": "Good. Also, you might want to delete your voice recordings. The app probably stores them.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "97a9c369efb1ab1fbc6387bcbd913f20f80b383349e4fc1a060e1257d92d1365",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1282,
        "sourceEnd": 1339,
        "text": "Right. I'll do that too. Thanks, Mia. You're a lifesaver.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8ff229736fc5451e5d4674320f53a8aa93f933bca3f93c5471acfdc56059a982",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1345,
        "sourceEnd": 1479,
        "text": "No problem. But remember, if you turn off the microphone, you won't be able to use voice commands. You'll have to use the app instead.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "448d0c096ebe5e558cbc79260071376e7145b549ab0c9a2ec3579060d89a4ed0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1485,
        "sourceEnd": 1539,
        "text": "That's fine. I'd rather have privacy than convenience.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8b18431cbf17ade1ab24e44d1b88170d13df74bfdb27f48db813eac79524afdb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1545,
        "sourceEnd": 1612,
        "text": "That's a valid choice. Just be aware that some features won't work.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "8b10f8d451116d1b0f97f7a80ce83215450ed177a733f5359b1a3724e0abf270",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ben",
        "speaker": "Ben",
        "sourceStart": 1618,
        "sourceEnd": 1645,
        "text": "I understand. Thanks again.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "f24f6f699733d310c34d6f0069fff52dde1eaff9c5ac52a72b8f6f66e2dd425c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "mia",
        "speaker": "Mia",
        "sourceStart": 1651,
        "sourceEnd": 1701,
        "text": "You're welcome. Let me know if you need more help.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "3e39a615ca04631c31dbb9c2467dfc7a08cd21f7a442249e316a38823c1a96df",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
