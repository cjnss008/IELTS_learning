    "segments": [
      {
        "role": "narrator",
        "speaker": "Narrator",
        "sourceStart": 0,
        "sourceEnd": 1193,
        "text": "Good morning, everyone. Welcome to the campus library orientation. My name is Sarah, and I'm the head librarian. Today, I'll explain the book return process, which is important for all new students. First, you need to return books to the main desk on the first floor. The desk is staffed from 8 a.m. to 8 p.m. on weekdays. Second, when you return a book, it is checked by a librarian. If the book is damaged, a fine will be added to your account. Third, you must return books by the due date, which is printed on the receipt. If you are late, a fine of 50 cents per day is charged. Fourth, you can renew books online, but only twice. After that, the book must be returned. Fifth, if you lose a book, you must pay the full price plus a processing fee. Now, let me explain the academic stage re-test. This test is taken by all students at the end of each semester. It covers the material from the whole term. The test is marked by two teachers, and the results are posted online within a week. You need to score at least 60% to pass. If you fail, you can retake the test once. The retake is scheduled two weeks after the original test. Now, are there any questions? Yes, the student in the back?",
        "boundary": "paragraph",
        "voice": "en-US-BrianNeural",
        "textHash": "f1c1c5b61576b33e0478b371dfcb8509ae73bf4a49ff87b41cb7055f57e5313b",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 1203,
        "sourceEnd": 1303,
        "text": "Thank you, Sarah. I have a question about the re-test. Is the re-test the same as the original test?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0a881f54a5c34f810f5cc6c8dbc64b9747e9d16cec4e47da44e7f9147fc0b380",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sarah",
        "speaker": "Sarah",
        "sourceStart": 1311,
        "sourceEnd": 1412,
        "text": "No, the re-test is different. It is designed to cover the same material but with different questions.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "2e4381fcc2c4c2d02f8a70778afb7cf5c2e3588266e68855980b076f83c9b706",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 1422,
        "sourceEnd": 1450,
        "text": "And how long is the re-test?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "951229c70c6436b47d043ffb38676fcc686287fb97e077ea9a6647cce75e8110",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sarah",
        "speaker": "Sarah",
        "sourceStart": 1458,
        "sourceEnd": 1515,
        "text": "The re-test lasts two hours, just like the original test.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "055cb7422b238bec82a2ec413019b619917f47c346b2b5f497839ef8c3989e0f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 1525,
        "sourceEnd": 1565,
        "text": "Can we use a dictionary during the test?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "705eebafad24a3ab686811d3811a0b4c2cbd01a8dbb5f8995cb90b8766449304",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sarah",
        "speaker": "Sarah",
        "sourceStart": 1573,
        "sourceEnd": 1652,
        "text": "No, dictionaries are not allowed. Only a pen and your student ID are permitted.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "387085088111fa9b1bac29daef1aae7a074a9760d4b2fcb7a8acd8f5a9e1d0fb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 1662,
        "sourceEnd": 1703,
        "text": "What if I am sick on the day of the test?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "fffe2dcf0fe6c5b8c6fbeb0370835e0269c15b9210ac7bd2b5897a1f28fc61d0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sarah",
        "speaker": "Sarah",
        "sourceStart": 1711,
        "sourceEnd": 1805,
        "text": "If you are sick, you must provide a doctor's note. Then you can take the test at a later date.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "c16d380786230aeacf29451549970d90e92bf25985547b3411696144601b42f2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 1815,
        "sourceEnd": 1846,
        "text": "Thank you. That's very helpful.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "f98e911f6032a6670996a44fd3695e99ab908b3d8230b224f7da2d9a388e2abc",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "sarah",
        "speaker": "Sarah",
        "sourceStart": 1854,
        "sourceEnd": 1972,
        "text": "You're welcome. Are there any more questions? No? Then enjoy your semester, and remember to return your books on time!",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "e0c502a6c0bf28d797a5c3f2090001c9549e8fee0d17c23183eb7fb0b89b8e6b",
        "pauseBeforeSeconds": 0.65
      }
    ]
