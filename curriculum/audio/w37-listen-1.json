    "segments": [
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 7,
        "sourceEnd": 60,
        "text": "Tell me who you want your survey results to describe.",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "56c48807f88ced9207beddbc92b5bf45318b8ac5bd501b74a16b0f22e3370d38",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 67,
        "sourceEnd": 182,
        "text": "All first-year students. I planned to recruit volunteers from the photography society because I know its organiser.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "97b02afdec75881bbb2d50a78666a50b06028197f0932553c18e1fdbd451a94b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 190,
        "sourceEnd": 268,
        "text": "Convenient recruitment may influence the result. What is your actual question?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "9d6ddd5dcdd9d2543d8e4b3350c734e0fce8512077a6074954db4c307ea98519",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 275,
        "sourceEnd": 427,
        "text": "Whether students find the evening library useful. I initially wrote about satisfaction with the whole university, but I have narrowed it to one service.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "86a54e3c86e4ee44d9c8c95b48591b91db858bf1b0bbd878b00038a8a7855bc1",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 435,
        "sourceEnd": 484,
        "text": "How could you reach students outside the society?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "203e955a202355ff87afbbd73f4d6b22b0ccb614a065dc1687f402e3cf3f7b0d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 491,
        "sourceEnd": 614,
        "text": "I could invite students from six introductory classes, including morning and evening groups rather than a single timetable.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "86f44b803a9a72539a1bb377ba4a8eb063dc6e7340954fcee49c5ae10fe28c3b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 622,
        "sourceEnd": 657,
        "text": "How many responses are you seeking?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "ef3add68c14ac5966e4fd3b287a5c9c9efb6a3ea013a45ee3174f77a002f87af",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 664,
        "sourceEnd": 796,
        "text": "Eighty. I first suggested fifty, but eighty would let me compare commuters with people living on campus, provided both groups reply.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "d56afc48371e6f833c3e0eb734e65b87df956fd674ea3fca5a03e556c18adac5",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 804,
        "sourceEnd": 895,
        "text": "Do not promise equal representation before recruitment. What if commuters reply less often?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "0a69db50b59c45502f9517f305b4dfe698c7ba5e9c920881a58a3fa1fa87a0b2",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 902,
        "sourceEnd": 1059,
        "text": "I will report the response rate separately for each group. I will also offer a paper version, so participation does not depend entirely on checking an email.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "f6d852c16cae7f8d4cf4bf28e9a25cfedf95d8c3547483b45de7e37cd3e16fad",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 1067,
        "sourceEnd": 1106,
        "text": "What personal details will you collect?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "d49824a9913980ffe8fb501f683f9d56d2c32e5cb87dab5fb51bbdd38760d5ae",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 1113,
        "sourceEnd": 1240,
        "text": "Only a broad travel category, not names or exact addresses. The consent statement will explain that participation is voluntary.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "22a7268164560b946be9223439428b46c095bdc1d1385105a3f1d097b2e1691d",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 1248,
        "sourceEnd": 1275,
        "text": "When will the pilot happen?",
        "boundary": "turn",
        "voice": "en-US-JennyNeural",
        "textHash": "bef9c9f3882a1db195c5de2e82a709c3376f57de9d325d85672e45b48ec319d7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 1282,
        "sourceEnd": 1410,
        "text": "On Thursday. The final questionnaire will wait until five pilot participants have explained what they think each question means.",
        "boundary": "turn",
        "voice": "en-US-EricNeural",
        "textHash": "d6aa38f86544c67e7079af2d1565de8cd46e93bedbc70378c8d897bc8fde7b92",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
