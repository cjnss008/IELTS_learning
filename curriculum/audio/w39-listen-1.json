    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 120,
        "text": "Our pond survey is scheduled for Saturday. Should everyone choose whichever sampling point looks most interesting?",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "e1d8a161c0347c002c05ddf48a6734c80b668b5185024cda1e19502acfc227f6",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 128,
        "sourceEnd": 236,
        "text": "No. That would make a second visit hard to compare with the first. Use the eight numbered points on the map.",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e208a1508f8f0a80c64e47e7266016ae149c71f1c3c2fbc5f0f09ed3ad1691c6",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 243,
        "sourceEnd": 388,
        "text": "The original plan had ten points, but two are behind a locked gate. I have marked those as inaccessible rather than pretending they do not exist.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "28eb91de67d88cc545aad73a6283d582d4ab6e531536adeb06bd856cff4814be",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 396,
        "sourceEnd": 447,
        "text": "Good. Record that exclusion. What will you measure?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "e1ffa64c68bd8eb6aa76a2ccc37d5b296e1687170425015b7d5a997f096d7200",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 454,
        "sourceEnd": 595,
        "text": "Water temperature and the number of visible insects during a three-minute observation. We are not claiming to count every animal in the pond.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3512602615e278de6009a8941ce160c29d368f0f2ec23ff18ae2026c34fcfde0",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 603,
        "sourceEnd": 624,
        "text": "What about equipment?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "c60a15f0e1a18f43ee42d6c778e8d81a3b59dc170cab6ee0afe8069597798e4c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 631,
        "sourceEnd": 772,
        "text": "Teams will use the same thermometer model. We will check the readings together before separating, so a faulty instrument is easier to notice.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "35d7123734255faf534659d78d016b6d7af0f237e624884a59e69180e31eb899",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 780,
        "sourceEnd": 843,
        "text": "Rain is forecast in the afternoon. Will the visit be cancelled?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "94318d98a24fc7bfcc2b3c8853361e35e33e62dc743b2eca92a51ed9f7ae2a52",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 850,
        "sourceEnd": 1013,
        "text": "Only if the bank is unsafe. Otherwise we will note the rainfall and begin at ten, as planned. Weather becomes part of the record, not something we silently remove.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "3f663b5457566ec2e2ecda29e728d29631f9719b01590ebfc9a8e45da1f2f182",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 1021,
        "sourceEnd": 1037,
        "text": "And photographs?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "aa1ca9b06def05b41dff46565ff347ca0daf0dffdadd70064d403eaa2dfd6a48",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 1044,
        "sourceEnd": 1172,
        "text": "One photograph of each marked point, facing north. No identifiable visitors. Files will be named with the point number and date.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "293633c4609138736912dd3fca74816b76e5f0d21f178b38c3572b2a7731c967",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 1180,
        "sourceEnd": 1213,
        "text": "Finally, who keeps the raw notes?",
        "boundary": "turn",
        "voice": "en-GB-RyanNeural",
        "textHash": "126e1784640eb14c8cbbdf7983dbb9a6620bc20f4191e1a2fe7adb1056df7111",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 1220,
        "sourceEnd": 1329,
        "text": "The department archive. We will submit a summary, but the original sheets will remain available for checking.",
        "boundary": "turn",
        "voice": "en-GB-SoniaNeural",
        "textHash": "712528231b1ba6ba820bceb55b67f35390c6b2c07d8e6bd7ebbdfbfe2e4d9159",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
