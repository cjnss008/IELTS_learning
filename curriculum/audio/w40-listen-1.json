    "segments": [
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 9,
        "sourceEnd": 95,
        "text": "We have room for eighteen sound clips in the town exhibition. How did you select them?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "aa36eb4c70a0e1a43d29004336521838740191a97b0c914a9f7b05f06447ec71",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 101,
        "sourceEnd": 255,
        "text": "I chose recordings with contrasting activities: a market, a workshop, a garden and several others. It is a curated selection, not a representative sample.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "eee37a7f307370e7d16a6591215b151e595384eca52da116843469a4add31924",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 265,
        "sourceEnd": 340,
        "text": "Put that on the introductory label. What information accompanies each file?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "2e52237290f4194aa9e8fc41ccadb6a1659f40e2b4c5e0a15a0292cb59000ed3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 346,
        "sourceEnd": 441,
        "text": "A recording date, a broad location and the microphone model. Exact home addresses are excluded.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d0b9777fdee3e7c53caa50ff45dbe42d15c411213ad05993e85faafde7f52c04",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 451,
        "sourceEnd": 501,
        "text": "Have the original recordings survived the editing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f310eadeeb4ee4c620a013beef87ebb12a9b8b16e88ba3dd56be6a9583b2655c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 507,
        "sourceEnd": 669,
        "text": "Yes. The exhibition uses shorter copies, but the original file remains in the archive. A removed pause might matter to someone studying the rhythm of an activity.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8f36b73212dc5a3a8b82999d29250fed5d1692896b182433c194aedd22a17609",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 679,
        "sourceEnd": 750,
        "text": "One label says the market is always noisy. Can a single clip show that?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6411c27a1570f6bf06498d19b47b18baf976e9bd9ac902535c3fce4598567726",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 756,
        "sourceEnd": 897,
        "text": "No. It could include an unusual delivery. I will change the label to describe what happened during this recording, rather than a typical day.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "782257d32317dd4a238f683ddd0b6fe55fdf6b676b55dbe509f4028324afa7da",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 907,
        "sourceEnd": 931,
        "text": "And identifiable speech?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "03d4aaa89b793c33bde4787f1be5e93d5e5380e9cbf02ec32e3b9c41a6ef26f3",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 937,
        "sourceEnd": 1094,
        "text": "We obtained consent for two short interviews. A private conversation beside a cafe table has been removed. A description of that setting will appear instead.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "eee38f97a4cf0b28ccdbe4b4f1d9b4bfa56af8179bfbe5e25507defe8b82ffd8",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "curator",
        "speaker": "Curator",
        "sourceStart": 1104,
        "sourceEnd": 1138,
        "text": "When do we check the final labels?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "655a65d94a05a0e2671cf64b11d9f11c53040a30829adfc49e987bee54b40bb4",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "eli",
        "speaker": "Eli",
        "sourceStart": 1144,
        "sourceEnd": 1317,
        "text": "On Tuesday, before the public opening on Friday. We will compare the labels with the raw recording notes, so the exhibition does not imply that we measured more than we did.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "6066e8d7e34a153db6eee57e4547e0984cc12c22de75b50ec89d83fa6bc1fb82",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
