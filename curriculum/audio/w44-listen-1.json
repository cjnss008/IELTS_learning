    ],
    "segments": [
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 7,
        "sourceEnd": 94,
        "text": "Your group presentation is clearly spoken, but its conclusion goes beyond the evidence.",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "84a83f03448de2f2a823b6e31b54994a5487a5be6aebd04140d2283ff1cde2c3",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 100,
        "sourceEnd": 223,
        "text": "We said remote meetings improve participation. Our survey showed that more people attended after the meetings moved online.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "5f463a44ca74c000dc588f7f26e23d8cc30a6beb2e0532b6d8c007b010203243",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 231,
        "sourceEnd": 318,
        "text": "Attendance is one part of participation. Did you measure who contributed to discussion?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "cb851d6c02f95064a77329e4cac4ac1ae0540a2286b421d9b36107da1945fc0f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 324,
        "sourceEnd": 479,
        "text": "We counted contributions in two recordings. A few participants spoke much more than the others. We should distinguish presence from speaking opportunities.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "388ce8b2c289c0fe94f3fee3146b93484d8a930e36fb416b0cb179b9c8e534cb",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 487,
        "sourceEnd": 522,
        "text": "What else changed at the same time?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "b0d8598674f4c39d30aa92e09e2595c0abe1735d9d4de2da6a527f9557825cbf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 528,
        "sourceEnd": 642,
        "text": "Meetings moved from eight in the morning to lunchtime. The new time could explain some of the attendance increase.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "8b7097028453b3620734a35922bae980e9d68daafdb1467110b082451d0d4251",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 650,
        "sourceEnd": 717,
        "text": "Exactly. Can your design separate the effects of timing and format?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "e177a1ceef6f94045fd96bbff1438d9ef13ca54fcec9a131d5568a961da2708c",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 723,
        "sourceEnd": 858,
        "text": "Not with the existing comparison. We can describe the combined change, but we cannot attribute the whole increase to the online format.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "b45d1ff9cf7d2c202952eea796e0246f34a720de35288e94b789dc79d6635f00",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 866,
        "sourceEnd": 917,
        "text": "What revision would make the conclusion defensible?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "b993a69c738825e1ff7d241865e2f475fad21a77a2fe4711ca16f3c6af754717",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 923,
        "sourceEnd": 1112,
        "text": "We will say that attendance rose after both changes, while discussion remained uneven in the two sessions we examined. Then we will propose a further comparison using the same meeting time.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "9784f34a280ccaeb3b18a02867affcd1c443612772cc5911443f0999393bba39",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tutor",
        "speaker": "Tutor",
        "sourceStart": 1120,
        "sourceEnd": 1163,
        "text": "Will you remove the participants' comments?",
        "boundary": "turn",
        "voice": "en-AU-NatashaNeural",
        "textHash": "e3cc4dc9e9def9a1a4abce6c0e590dd0a3d76ce8baa8f6c90ac0d46256c153cf",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "jon",
        "speaker": "Jon",
        "sourceStart": 1169,
        "sourceEnd": 1325,
        "text": "No. We will keep them as examples of experience, with permission, rather than claiming they represent everyone. The revised draft will be ready on Thursday.",
        "boundary": "turn",
        "voice": "en-AU-WilliamNeural",
        "textHash": "4f883794cf1760becb745b24f685a851afd18adfbdc4d8aaf19ba593c361f2c4",
        "pauseBeforeSeconds": 0.65
      }
    ]
  },
