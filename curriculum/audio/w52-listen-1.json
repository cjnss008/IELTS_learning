    "segments": [
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 9,
        "sourceEnd": 141,
        "text": "This review concerns your training evidence, not a promise of an examination result. Which skill still needs the clearest next step?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9e48cd605a75126ab95a04d90fdb781b42550bfe83f0bf0b120a0fa136072556",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "learner",
        "speaker": "Learner",
        "sourceStart": 151,
        "sourceEnd": 270,
        "text": "Listening. I answer familiar recordings well, but my performance falls on unfamiliar discussions with several speakers.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e3845158fb726c9fe3dcb829f8e7c704a7ad27bf2660971bb80144410a8ea414",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 280,
        "sourceEnd": 415,
        "text": "Then repeating the same recording can build fluency, but it cannot show unfamiliar-task readiness. What evidence will you collect next?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "286afce717f8630a6fc2da3a7573001b944c3dd3a87c1f54e3db705a38933394",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "learner",
        "speaker": "Learner",
        "sourceStart": 425,
        "sourceEnd": 598,
        "text": "Two new discussion tasks on different days, with no transcript or vocabulary help before the first answers. I will keep those first attempts separate from later corrections.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2db5e864a1be7e4d6f748d22b7d4d2459b5d2245e3bbcd69f434f9ae6605928f",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 608,
        "sourceEnd": 627,
        "text": "What about writing?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ed2870468ab6ca55bf96da17166e11851adf06418392bc12d915e702e09fd513",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "learner",
        "speaker": "Learner",
        "sourceStart": 637,
        "sourceEnd": 818,
        "text": "I can finish both academic tasks, but feedback still identifies weak comparisons in Task One. I will practise selecting main features, then complete a different chart after a delay.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2fba4144f3be250e1d590ae763b6db04482c7e115b76b975e153e61ca82c804b",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 828,
        "sourceEnd": 861,
        "text": "How will you manage the workload?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "355de4bc061e49834189a1b2a4bb13b086bc7f31def08a6e4ad851a611636b95",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "learner",
        "speaker": "Learner",
        "sourceStart": 871,
        "sourceEnd": 1069,
        "text": "Six hours remains a daily maximum, not a minimum to fill. Unfinished feedback and unresolved errors come first. If the next task is unsuitable, I will choose supported practice at the current level.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8ffa84559b0963e848796240f5a50bfcf9d98f5c943e7e9f46120b6db5eacb43",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 1079,
        "sourceEnd": 1131,
        "text": "Will a completed calendar mark every skill as ready?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9691023228af82e967d26b7dc4a89c987ac9388d0d2a7e9199a159e279263902",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "learner",
        "speaker": "Learner",
        "sourceStart": 1141,
        "sourceEnd": 1347,
        "text": "No. Readiness depends on recent independent work across all four skills. Missing audio or pending reviews remain evidence gaps. The next cycle should target those gaps rather than rename an old task as new.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b3c3c8e4ec70297502972ccec3e62838a5f855431806e40053c55906bddf1613",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "adviser",
        "speaker": "Adviser",
        "sourceStart": 1357,
        "sourceEnd": 1449,
        "text": "Save that plan with the source work. We should be able to see why each next step was chosen.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9b95402b73703b813411570f0f3a0e230e6062e1abb78e32a8193e22435347dd",
        "pauseBeforeSeconds": 0.65
      }
    ]
