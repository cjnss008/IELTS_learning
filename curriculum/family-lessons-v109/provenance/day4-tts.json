    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 91,
        "text": "Excuse me. We are visiting the library for the first time. Can we take any book home?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d0cc3cd9d649207ea1d559bdd3e9214eb9d26697a37d807d9ed94385eb724d96",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 97,
        "sourceEnd": 170,
        "text": "Not the books on the reference table. The sign says those must stay here.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "185b74656819a7f272e2f78260479e72d72f41005d90dc7ce01e91ef20215d95",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 177,
        "sourceEnd": 231,
        "text": "I need a dictionary for one word. Where can I find it?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7cd52adf7034b9df391e2507bdb5e7e379bf70fe44a627e4872669290c4d2af8",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 237,
        "sourceEnd": 299,
        "text": "On the reference table beside the window. You can use it here.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c85308513fe3c5f34bdb0b7d3e650580aec8ba8cd0a61ea0378e0842a3248d56",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 306,
        "sourceEnd": 401,
        "text": "Thanks. The computer screen shows a book about sea animals. It is available. Shall I select it?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c16bb17f35a77dd47d387c91b1033217686e63bdaaf3a5e7595c4767ac7cd463",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 407,
        "sourceEnd": 477,
        "text": "Check its description first. We need facts about animals, not a novel.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a6cc61860aaaaa113c03de87309f7a22c9c15772ffbb3e02642da1fede61b6b3",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 484,
        "sourceEnd": 559,
        "text": "This one has an index and six short chapters. It looks useful. Where is it?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9b116cdcc10e63938e021a2ac40ba20101a6e2bfc8469632c3ac46bbeb209946",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 565,
        "sourceEnd": 646,
        "text": "In the science section, on the second shelf. Walk along this aisle and turn left.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "e235344b1e68edece4030ef996dee4b2a5a4efe3432d6b47e577ce0d7aaa2116",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 653,
        "sourceEnd": 698,
        "text": "I have my library card. How long is the loan?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e6e51f910097a0aab12f73e8a2913d81dabfaecee55505cceef00250a4881b9d",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 704,
        "sourceEnd": 767,
        "text": "Two weeks. You can renew the book once if nobody else needs it.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d3d196ca15d1708d00e3d1139fa5e8891c2eca5304eb906ae3f2ec77cfc243df",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 774,
        "sourceEnd": 843,
        "text": "Good. What about the book with the blue cover? Another reader has it.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "72350cfbd4ef54a3a657a3f3ab02a0b2cd832bbaefc92df7790f6d3a1aff27ee",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 849,
        "sourceEnd": 925,
        "text": "You can reserve it with the librarian. She will tell you when it comes back.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "8b4692fdeaa881d5468cb4e224f42874b0f5a0186ee0afba4e78e22e61e39579",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 932,
        "sourceEnd": 988,
        "text": "Let's print our notes before we go. We have three pages.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c068d3c22f83c80ccfc7033da0862fe1efee54b879e7fc2c9e41a27a93a4cbd9",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 994,
        "sourceEnd": 1116,
        "text": "The printer costs ten cents per page, so that will be thirty cents. Then we can discuss our talk in the conversation room.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4e6e80312fd3676c8c9ebcedc4eeb4a996bde93b3ccd8abb162a3f672ed6963f",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 1123,
        "sourceEnd": 1172,
        "text": "Right. We should keep quiet near the study desks.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "cae384fdea3f91a1771dbf6a2dece55fe6dcc58d37846867d022214aaaf01182",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
