    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 61,
        "text": "It is nine forty. Are you free for twenty minutes, Leo?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4c2274bfc8ea361f35514a428c225d8daeec64bdde66f36fc597119efd2f83d7",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 67,
        "sourceEnd": 111,
        "text": "Yes. I am busy after ten, so I can help now.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b66efffd1b0e3e48d3bff11046108200f64d10b977818d985b0690c10d9f00dc",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 118,
        "sourceEnd": 194,
        "text": "We need a poster for new club members. Is this the same room as our meeting?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a391dc579eb15171984b118f1787e4b6de99bc826f9f20dea48dd5c27c271612",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 200,
        "sourceEnd": 250,
        "text": "Yes. We can make it here. The desk is by the door.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2a5d1f8d62e88f2375fd5a6f00e5f4e036df1b194ed29aac4d832121b0431760",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 257,
        "sourceEnd": 320,
        "text": "The room is dark. Can you turn on the yellow desk lamp, please?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "96dd7b329b987214e7121aaa8b821579afd389770c16e648922406c6cd852de4",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 326,
        "sourceEnd": 362,
        "text": "Sure. Where should I put these pens?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "cab93e60bd4192ffc4b35ec6ac4da3c6c617d18b93340106efbc38aaa5437ca5",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 369,
        "sourceEnd": 468,
        "text": "In the white cup on the desk. Please move the brown chair away from the door so people can come in.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b056938c1253b5d74f4aa54461a135897d2179d62176f91989a3ae2b2e4a9eaa",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 474,
        "sourceEnd": 547,
        "text": "I found a long ruler. Can I use it to draw a straight line on the poster?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "cb68f7c115ee360599f619e1ee5beab241c6be2f73532c0d3feae8afc895d27c",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 554,
        "sourceEnd": 609,
        "text": "Yes. Please write \"Welcome to our club\" above the line.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a8a11f6275e2f13d1d3222aaae1a88348dc7a3a07e7ebe6846965101d0fde868",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 615,
        "sourceEnd": 658,
        "text": "What time should we put the poster outside?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "91f9c3e5125db60fb2069bdffae8c75f0df4c806c225dd700099bc4124297ac9",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 665,
        "sourceEnd": 702,
        "text": "At nine forty-five, next to the door.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6fd826311f5009a16647178c2b0e439ed177d26d69ac5ccd91453905b693e2bf",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 708,
        "sourceEnd": 753,
        "text": "All right. Then I will go to my class at ten.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a1b59612d6087d767695bb196e9b0715d552cc8a5205eab9cfa08d4c9f501319",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 760,
        "sourceEnd": 809,
        "text": "Thank you for helping. Good luck with your class!",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "76b99588655ef775b830a930aac744acc3411e6c19515cee04a723feb8c42d43",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 815,
        "sourceEnd": 843,
        "text": "Thanks, Maya. See you later!",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bd8e801afb417365f9b75a24b1d13642252b83bf553657961e3540488d2a3600",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
