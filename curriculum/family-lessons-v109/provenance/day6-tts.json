    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 77,
        "text": "We have an hour for the welcome picture. Shall we start with the paint?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c5347954984de910da4f84c708e530b13f0b99740bcc43e1bd94ca32cc4262ae",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 83,
        "sourceEnd": 180,
        "text": "First, let's check the design. There is a sketch on the table, but I think the circle is too big.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2b2d0c88dda1b2d2a4176968537d54ff0c2e9d61aca0d519629e34fb479dcba9",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 187,
        "sourceEnd": 287,
        "text": "You're right. We can make its size smaller and put it in the middle. The triangle can go at the top.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "119756863ab1bc059022cb3ba4fe709d7528b9c9c0e90f7e9be1ee9f97e85868",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 293,
        "sourceEnd": 334,
        "text": "How many brushes are there for our group?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "862c9cdbf9c3803df4b64cde17d3815599c80c33d83826d09351a74cdc2f8556",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 341,
        "sourceEnd": 444,
        "text": "Two, and there are four of us. We can share them. You and I can paint while Nora and Sam cut the paper.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "735eb453c43634fd2e11cbc227b7e9368bef97b987328887474f67ed732262d4",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 450,
        "sourceEnd": 473,
        "text": "Is there any red paint?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7b82a8c7280d0c224f6879879a049391e860e42e14bd74caae9b9f92fb9590e3",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 480,
        "sourceEnd": 553,
        "text": "No, there isn't. There is some blue paint. Let's use that for the circle.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "fc487cab3f524f3f7a5f272cf159ce4f0ab75022c8b94de7b41a254074c1343d",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 559,
        "sourceEnd": 635,
        "text": "All right. Can I borrow this ruler? I need to check the space near the edge.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b87324eb0e277f0608a56f62be5c05fd71e0fecaa9948682fb2bab375646c0e6",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 642,
        "sourceEnd": 730,
        "text": "Yes, but please return it to the next table by eleven. They need it for another project.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "41d8a84b00d65dcf113db841e8c64fdba612919f5021eec18943c3b4960625d6",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 736,
        "sourceEnd": 806,
        "text": "I made a small mistake in the bottom corner. Do I need to start again?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a6bb363de18dbf88b55aea6cf9ebe19f207c560b95dac273bb090c0f79ff1595",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 813,
        "sourceEnd": 926,
        "text": "No. You can cover it with a spare piece of paper. Be careful when you attach it because the surface is still wet.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "41a0b7deed3b7b2455798bc243351e6cf175d1a39002ee7a66a65bf3fcbf2763",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 932,
        "sourceEnd": 978,
        "text": "Then we should wait before moving the picture.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d53cf43919060e0de7828f7658505ec4a2ae11437c1aed374183aa566876af99",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 985,
        "sourceEnd": 1119,
        "text": "Exactly. The instruction says to wait twenty minutes for the paint to become dry. While we wait, let's put every tool back in its box.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "4f77c27a25a499fb7a9676b8f0761eda4ef608d5a20f528ab173de936c24bd16",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 1125,
        "sourceEnd": 1194,
        "text": "Good idea. After that, we can explain our pattern to the other group.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a34df20a077d8ae75656da4f6912b0c60d36777f374cd23950f4beb8a283bb28",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
