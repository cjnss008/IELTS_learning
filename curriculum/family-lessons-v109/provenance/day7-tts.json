    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 42,
        "text": "Leo, what time does the music begin?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "394fca9aca3d6f20618b88032a45ac584a838c10fef5672e608804ea0c761878",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 48,
        "sourceEnd": 100,
        "text": "At twelve. Ella will sing first, and Ben will watch.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f0f4be051e374b2942eba07d15d46a806f42a78667bd1c3e0c1b3dba3175cc69",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 107,
        "sourceEnd": 135,
        "text": "Is the old sign by the gate?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e9ef81acc8ab3671f5b7453d61c2bfee009b88691822d914dbef5c9461f1a9e8",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 141,
        "sourceEnd": 194,
        "text": "It fell down. The park worker gave us tape and paper.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f3e529305157c4733757f5501f5872d0fa43de3acbe5a6c17355dc74cb83724c",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 201,
        "sourceEnd": 264,
        "text": "Let us put the new sign next to the main path, not by the lake.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3f9f3d0e1f9897c314d6380c13efd05d0d36a2897999a8a29e4ab38d983e97ed",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 270,
        "sourceEnd": 322,
        "text": "Good idea. I can carry it. Is it safe to swim today?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b875fd07b14e9e2a985f8ee84acc74a16efb8f37af8c38e30a987779f2df6a44",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 329,
        "sourceEnd": 383,
        "text": "No, the water is cold. Please stay away from the lake.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e1a8f23a75e81f8ca3ac5555f9fcd4d7fc17329c34b3525b323573af06e3dd99",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 389,
        "sourceEnd": 449,
        "text": "All right. After the music, would you like to play football?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9449015b851063090c1d4858ff04030f9c37e80000b9071be726260aa61800b1",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 456,
        "sourceEnd": 539,
        "text": "Yes, but first I need to call my sister. She will travel from another neighborhood.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "43e16349df8791463d7c3368147b8f3bcb7ad5442b213c97682c777f00546418",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 545,
        "sourceEnd": 569,
        "text": "Where will you meet her?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "67829a4017f703a0d4a51de0b3a45239bbb9c4aa5e302d0a061e35d623395076",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 576,
        "sourceEnd": 649,
        "text": "At the gate at eleven fifty. Then we can walk to the music area together.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0956d364efaec0ddb3053e6bbfb6f810cc564796734dd8b228bfed20c15e9e77",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 655,
        "sourceEnd": 708,
        "text": "I will wait there too. Let us help her find the path.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4e7430da18875044953abc093e4e14bd19db9bf25691f3ef2a6c2f3f0db8da14",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 715,
        "sourceEnd": 775,
        "text": "Thank you. If the paper is wet, we can ask for another sign.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "000f93ad4051cf68a0b8c0bd62174d39f88c06850bf6cb9a949a2a8bb9289ffb",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 781,
        "sourceEnd": 840,
        "text": "Great. I will keep it under my jacket if it starts to rain.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "4d3f3843d132b85fc49fe2c79020b3dcdf5b6e78885846ffcb6576d6613435a9",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
