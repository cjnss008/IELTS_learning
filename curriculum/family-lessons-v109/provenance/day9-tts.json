    "segments": [
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 6,
        "sourceEnd": 45,
        "text": "Leo, is the next cooking class at five?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "b26b5d3ec7418c192f0bb60c2943ee958c57d64f9ed21955ef853d5b04d6ed32",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 51,
        "sourceEnd": 102,
        "text": "No. Ms. Chen moved it to four forty-five on Friday.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "50f6e750271b3d65d6da104abc8682fb8b30b317c67a87089b96bf80bd7518c4",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 109,
        "sourceEnd": 143,
        "text": "Where should we meet before class?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9681863ccc0bb9acc05d068f50544274c2d26dbd3d0a10b746c7ff956da65da5",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 149,
        "sourceEnd": 194,
        "text": "At the library entrance, not at the bus stop.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "d35f147052ed80b809a99d721f42b5ffb2824ce678aa46762c2f3ce453410ef8",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 201,
        "sourceEnd": 230,
        "text": "What should I buy on the way?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f77c59bd1f5a653252561eb57a07e7128326e36911aa29040d6d09b9770ff186",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 236,
        "sourceEnd": 280,
        "text": "Please buy two eggs. We already have apples.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "06fca5909f7aed96f8c6e138a08419de5fdef9f04da2f1bb66e46a008f0d282c",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 287,
        "sourceEnd": 313,
        "text": "Should I buy fish as well?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e2077f87bbf7921476b19393ba8b34737786646125c57860b930eaf12271ae45",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 319,
        "sourceEnd": 369,
        "text": "No. Ms. Chen said she will bring the fish herself.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "5da86920fa4b5d4d09935b32054f814aa0202c55fc6f2d4e2496ed1099fec4e0",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 376,
        "sourceEnd": 409,
        "text": "All right. Do we need a new bowl?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "de84b2108405c376a434a5ef3c365223ffe2bdd838e8755e47ee744c3e8fd202",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 415,
        "sourceEnd": 459,
        "text": "No, but we need a clean cloth for the table.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7a38b729ed6244430da6eb4a6ce6e5d9ed4512526bdc54c5095f065554307754",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 466,
        "sourceEnd": 516,
        "text": "I can bring one from home. What if my bus is late?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "791888fed93d6815ffc96c3256d54bef00574e78cd5d95f4a9541b7b93f16573",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 522,
        "sourceEnd": 566,
        "text": "Send me a message, and I will tell Ms. Chen.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "09af2ff33ff21f40a6603722ef0a643e1cd5f0f29b5dbc40652116699288b70d",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "maya",
        "speaker": "Maya",
        "sourceStart": 573,
        "sourceEnd": 628,
        "text": "Thanks. I will leave early and meet you at the library.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ef8ad7381d72f65b979e5b3b25f3f1e045e20f390f4dbbdb2a5cd98dee8114af",
        "pauseBeforeSeconds": 0.8
      },
      {
        "role": "leo",
        "speaker": "Leo",
        "sourceStart": 634,
        "sourceEnd": 672,
        "text": "Great. I will bring the shopping list.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9d782c4aecf9516bd5e098a84580cad90e57538ea6c59a1a9978853aee7f6b79",
        "pauseBeforeSeconds": 0.8
      }
    ]
  },
