    "segments": [
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 6,
        "sourceEnd": 62,
        "text": "I'm at the ticket hall. Are you waiting on platform six?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f955ff523d589b17ab25b59874f35f04dc61b73f08e6d660f4178f39f229324c",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 69,
        "sourceEnd": 156,
        "text": "No. The announcement has changed our platform to eight. I'm standing beside the stairs.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2a39cc0470d228efa9b953c12324e01fe1bd712e04d8c2c18f9c1710baf0b34a",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 163,
        "sourceEnd": 212,
        "text": "Is our express train still leaving at ten thirty?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "287dd0b6fe3e61129d09e75f2b199e9b520fea061dc42814e73172f87195a94b",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 219,
        "sourceEnd": 291,
        "text": "It is running fifteen minutes late. The display now says ten forty-five.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "99d43c804cae9d18f86a1d9d7d43733ea1b987caa800983f2567774c4aa98fa6",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 298,
        "sourceEnd": 337,
        "text": "Did the announcement explain the delay?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9ea85ee66117520a611a23be046263f197759a5bddd7c5d7321615be2925b1c6",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 344,
        "sourceEnd": 453,
        "text": "Yes. Staff are checking a signal beside the track near North Junction. They cannot say when it will be ready.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "20fdddded89bcb5b502df021fbd7892f4982fcd1c760cfe2e435cdf0d677017e",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 460,
        "sourceEnd": 585,
        "text": "I don't want to cancel our journey, but we will miss our connection at North Junction. Shall we use a direct service instead?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "43f847b9e800a616691a6621636b9ceb14fe09c1e3c2d4ba1666cfb28740ecdc",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 592,
        "sourceEnd": 696,
        "text": "Yes. The conductor says the eleven o'clock service goes directly to the coast. We won't need a transfer.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "3f37c6a4ac5190daa5cfda086778b92f81a01b89d509a57712c7ad00c19baf04",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 703,
        "sourceEnd": 739,
        "text": "Is our ticket valid on that service?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "d179e04e0d5dc38f8a770fea315f04c26ca62efec825737419333b117b7fbd83",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 746,
        "sourceEnd": 821,
        "text": "Yes, but our seat reservation is not. We can ask for new seats at the desk.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0e3183804fe7e5c14ab5231efc1f5771c64b33ed242a9a783c4127b7be285e5f",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 828,
        "sourceEnd": 891,
        "text": "I'd like a seat near the luggage space. This suitcase is heavy.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "9b3bba6bc6a3aa14029fb9da784602f19cf4ff36c095f37276fda43991820ffd",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 898,
        "sourceEnd": 997,
        "text": "There are two seats together in carriage five. The fare is the same, so we don't need to pay extra.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "7a8bb305e4385bdd1cc1eee38fc8ec07f9f742b9f05d5c495174088dbdb096a0",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 1004,
        "sourceEnd": 1039,
        "text": "Good. What is the new arrival time?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7abf6d2202f2963407893eab2eddc3e1e2c9a24a3c0c016ee7d57fe2a897ad40",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 1046,
        "sourceEnd": 1125,
        "text": "Twelve ten. I'll message our friend now. She is meeting us outside the station.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "026b1b247cecad8564a954cbf10158597c3d42aa0cac6102e3665173e9d64b70",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 1132,
        "sourceEnd": 1161,
        "text": "What if she gets there early?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "88250c817aaa25bad83f3f79561dc7c43b0217a6f2277253cf6467d104a47569",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 1168,
        "sourceEnd": 1268,
        "text": "The terminal has an indoor waiting room. She can wait there and come outside when our train arrives.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "91f02a7e18cf1612c4dfa7dd4d7edf155db6d2f5239075a820471b473a8b7a25",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 1275,
        "sourceEnd": 1343,
        "text": "Thanks. I'm buying some water before we board. Do you want anything?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "f7df02fc38902cf37a7bab59dfd21751e0356aa21c0d5c8186071567c76c147d",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 1350,
        "sourceEnd": 1462,
        "text": "Just water. Please meet me by the stairs at ten fifty. We should allow ten minutes to get to the right carriage.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fdf3de5db90c0a8593e5ec874299a7b41821aed1f03b2954701c62fa6c6046eb",
        "pauseBeforeSeconds": 0.85
      },
      {
        "role": "jade",
        "speaker": "Jade",
        "sourceStart": 1469,
        "sourceEnd": 1532,
        "text": "All right. I'll check the platform display again before I come.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "82a907df467634bc44c9549cc483557841c181d6a84ee55cc1826e60a3a2bed1",
        "pauseBeforeSeconds": 0.85
      }
    ]
  },
