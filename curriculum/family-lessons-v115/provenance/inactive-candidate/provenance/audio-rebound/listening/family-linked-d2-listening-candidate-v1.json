    "segments": [
      {
        "role": "ava",
        "speaker": "Ava",
        "sourceStart": 5,
        "sourceEnd": 119,
        "text": "Hello. My name is Ava. We meet our English group at six. There are four students in this group. What is your name?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ee68d3f49313e04bf2f0f9e2d8b0dfc1e649f72be8f18d3ad6939d1a30261699",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 126,
        "sourceEnd": 259,
        "text": "My name is Tom. I am a new student too. Three textbooks are on that table. Two notebooks are on this table. The teacher has a marker.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c1dcdb4973cca3a3c7bac1ec9714088f6c93d314cbd6193f6d717dfeef8f1802",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ava",
        "speaker": "Ava",
        "sourceStart": 266,
        "sourceEnd": 398,
        "text": "Please sit here, Tom. This is my notebook. Is that your textbook? We can open our books and write our names. I can show you my note.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "dfb2d69598d54b1081e2c1fb20231f5cb42b64665051b3a8a3f4a9acd2bda3f7",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 405,
        "sourceEnd": 550,
        "text": "Yes, this is my textbook. I have a question. I do not understand one sound. Can you speak again, please? I want to check the sound before I read.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "301b64c539fde4b5379f8a1e72d3bbb1e7880d148b02622086c67770f159916e",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ava",
        "speaker": "Ava",
        "sourceStart": 557,
        "sourceEnd": 685,
        "text": "Yes. Listen to the sound. I can help you spell the name. The name is Ben. It has three letters. We can say the letters together.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8d87589e935912a4d5213a24212db2bfd359098d787121435d54b19294aace10",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 692,
        "sourceEnd": 797,
        "text": "Thank you, Ava. I can spell Ben now. I write the name in my notebook. I ask the teacher to check my work.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "53eaedb7b747baaa545ae7f06f313ce9d0f0d93144073bbd93ef8116166f7c41",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "ava",
        "speaker": "Ava",
        "sourceStart": 804,
        "sourceEnd": 1047,
        "text": "Yes. The teacher can help us. We have ten minutes for a short task. Please read the note and then stand near the group. We can speak to the other students. The teacher shows us the next part. We can listen together. It is fine to ask for help.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e2aeaf60d099869aafa1992a25432e5e7d2e50900eda9510e59585a657a518ba",
        "pauseBeforeSeconds": 0.65
      },
      {
        "role": "tom",
        "speaker": "Tom",
        "sourceStart": 1054,
        "sourceEnd": 1172,
        "text": "Thank you. I have five names on my note, but I read only one name first. Then we can ask the teacher another question.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0aee041d4d015973c3c356ba82eaebdd15020b85ae9be7b5cc96e34d882368b8",
        "pauseBeforeSeconds": 0.65
      }
    ]
