    "segments": [
      {
        "role": "farmer",
        "speaker": "Farmer",
        "sourceStart": 8,
        "sourceEnd": 48,
        "text": "Hello. Are you here for a vegetable box?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "23fd7ee665984ba74562ba4a36cec08a390c96efa29ccc5f3b8b4b3c2fea5880",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 55,
        "sourceEnd": 101,
        "text": "Yes. My name is Nina Chen. I have a small box.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b2333c8319554c9e0b39370bd55535da33e1dd63bb63ca4720bd0414777e1838",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "farmer",
        "speaker": "Farmer",
        "sourceStart": 110,
        "sourceEnd": 179,
        "text": "Here it is. The small box is twelve dollars. The large one is twenty.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0d288bc666e7875767fcfb5d21bcd90a78b2c8171a90c7b5210221038dace6b7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 186,
        "sourceEnd": 204,
        "text": "Can I pay by card?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "73a8c75d9fc0608c53771e6cf95bcfa7417cb0b43508712afa269eae37561cb4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "farmer",
        "speaker": "Farmer",
        "sourceStart": 213,
        "sourceEnd": 308,
        "text": "Yes. Please collect your box on Friday next week, not Saturday. We are at a market on Saturday.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7387a5d583bd543ac48fc7cb59873d91780c1f78926fe7806246f5860803b15d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 315,
        "sourceEnd": 346,
        "text": "What time can I come on Friday?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f4defcd1adbe933862938eeaf107148f70c5a94cb1a2b8fad2361361d91054db",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "farmer",
        "speaker": "Farmer",
        "sourceStart": 355,
        "sourceEnd": 502,
        "text": "After two. Please bring a bag. We need the box here for the next person. Today you have beans, carrots and potatoes. There are no onions this week.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1c72044a5b95f78d10dcf0bd6ec6c1c3be472d4fb4144201569ac1a15dd30d54",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "nina",
        "speaker": "Nina",
        "sourceStart": 509,
        "sourceEnd": 546,
        "text": "That is fine. Where can I put my car?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "2e79b36db2e4800ff2bf8c1263a0d70341d28618863331a0622328e757104fd6",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "farmer",
        "speaker": "Farmer",
        "sourceStart": 555,
        "sourceEnd": 577,
        "text": "Behind the green shed.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "8eedd27f805eb978792961420b27a3f3b70829c0fd686fdf1d5d308a66193a14",
        "pauseBeforeSeconds": 0.45
      }
    ]
