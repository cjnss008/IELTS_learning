    "segments": [
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 7,
        "sourceEnd": 45,
        "text": "Good morning. Where do you want to go?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c7a7e66b01f16d5dfd85bfa5688ac3ff7ff934f100817bf801603b5fbffe2bce",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "mara",
        "speaker": "Mara",
        "sourceStart": 52,
        "sourceEnd": 75,
        "text": "To Hill Garden, please.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "025f57bac0520eb888002d9ca4082f8a432b52716bf86392b31fcfdf743684f2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 83,
        "sourceEnd": 133,
        "text": "The next bus leaves at ten. It is the number four.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ecbf506e48edc3db7b8c5c3198540fe88d8c22cc582b5022e7bb6a87dfaf88d2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mara",
        "speaker": "Mara",
        "sourceStart": 140,
        "sourceEnd": 167,
        "text": "Is the ticket three pounds?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "0e8ea6b482473d9c1366a489aa454f7eb2b6cd1e1179b4900e75eb512add5b39",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 175,
        "sourceEnd": 232,
        "text": "That is a child's ticket. An adult ticket is five pounds.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "7c5e0e35b6a5ed119f57fcaa71a32f1dce7bd8f820998903c36c56cc60c3f302",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mara",
        "speaker": "Mara",
        "sourceStart": 239,
        "sourceEnd": 281,
        "text": "One adult ticket, please. Where do I wait?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c8820f51b0e9d30932ab9ead983b9a855516c02d9e00ce0409c7b96f3809330a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 289,
        "sourceEnd": 351,
        "text": "At the stop beside the bank. The journey takes twenty minutes.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "70b74df3278f5b1e2d7ccd9a69235863161e4f5f005ddf302b8b77ef037a5a79",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mara",
        "speaker": "Mara",
        "sourceStart": 358,
        "sourceEnd": 387,
        "text": "Can I buy food at the garden?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "dbfcbdc112d46a4d1fccc29631b910fe5014a7b0d38cc626d4a18db74b5c74d1",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 395,
        "sourceEnd": 525,
        "text": "There is a café, but it is closed today. Please take a sandwich. The garden closes at six. The last bus back is at half past five.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "79c8f2fe7cadfc74a9befd8644f98e8e43a6fd0a2e83971c6f935c7d8c1f7720",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "mara",
        "speaker": "Mara",
        "sourceStart": 532,
        "sourceEnd": 567,
        "text": "Thank you. I have my lunch with me.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "bcb69331a86921c8320b66122aa137bf92f690deb07572d4720c93c59b5bf81c",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
