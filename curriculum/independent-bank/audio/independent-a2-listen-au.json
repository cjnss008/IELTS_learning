    "segments": [
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 7,
        "sourceEnd": 35,
        "text": "Coast Walks, this is Rachel.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "0293675f28b5210bff572ba78bf8024d8562742db7afdfcb424fc2c833b96fa1",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 42,
        "sourceEnd": 137,
        "text": "I would like to book two places for the walk on Sunday. I saw that it starts at the beach café.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "10b07c1769c23aade30f58f5d99d37b674836588265c9f544d608f23ccc4c3c4",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 145,
        "sourceEnd": 291,
        "text": "We have changed the meeting point. The café is being painted, so please meet at the bus shelter opposite it. The start time is still eight thirty.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e57fab3616bf290f9aa9f988556cc4be05e0d3e6dfb32b83e4452feb4dd5b5a2",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 298,
        "sourceEnd": 321,
        "text": "Is it a difficult walk?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "f0ec68bf610506018b22081467c7da31254f899ba645cd4fbf3263e3233d7f17",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 329,
        "sourceEnd": 505,
        "text": "The whole route is six kilometres. The first part is flat, but there are steps near the lighthouse. We stop for a short rest at the top. Allow three hours, including the break.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c09c9e9990fa49d7a24c89e94200981a81fe1dd3be4091bbaf3de884f725ca77",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 512,
        "sourceEnd": 537,
        "text": "What do we need to bring?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "dfb4fc3cc20691eddca4b765299d90447465634d9e3842f08ded147e3153b9b8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 545,
        "sourceEnd": 700,
        "text": "Water and a hat. There is very little shade. Wear shoes with a good grip. We do not recommend sandals. I can lend you a rain jacket if the weather changes.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "1cba088c2c2e1b53cc5c570cca5c3e94af047f537c0e277ac6e18990b549d3a8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 707,
        "sourceEnd": 722,
        "text": "How much is it?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "abdfbb3951b780a174166d38d10acc3920b5e8f4712cc6014104161424c3b2f8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 730,
        "sourceEnd": 932,
        "text": "Eighteen dollars per adult. That includes a bus ticket back to the starting point. You can pay me on the day. Please send your mobile number by email today so I can contact you if the walk is cancelled.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "c77835a843052ef4d7f27fb714aef8a08d928807ee120d4719637373ed5648ff",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "owen",
        "speaker": "Owen",
        "sourceStart": 939,
        "sourceEnd": 976,
        "text": "Does light rain mean it is cancelled?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1e9f14c9a7f0d20f2418c5dd8d97765fa33af8cbd598945bc78e2cad5cb57af0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "guide",
        "speaker": "Guide",
        "sourceStart": 984,
        "sourceEnd": 1089,
        "text": "No, but we cancel for thunderstorms. We never take a group onto the exposed path when there is lightning.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e8e6d7efb6e3455f2ba7de69d032cd041b7fff56c4c1fed0da6251ba62cba47d",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
