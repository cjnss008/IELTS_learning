    "segments": [
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 7,
        "sourceEnd": 34,
        "text": "Good afternoon. Can I help?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ff96272c2c9c746cf4ad8b478633c310cdf6c430007abb8bab41039ca6f33d03",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 43,
        "sourceEnd": 152,
        "text": "I have a card saying there is a parcel for me. I tried the post office on King Street, but they sent me here.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "ca890ab222e409ff3561a2c3df14b783cb0cd43e6f4f36f0a2cf120ee8ffc60c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 160,
        "sourceEnd": 217,
        "text": "Yes, this is the collection office. What is your surname?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e667decbac7a1933f59a65775c6b85052878bb136bf2c117a44c5310e77aa004",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 226,
        "sourceEnd": 246,
        "text": "Parker. P A R K E R.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "a8205240d82c35d54c8b35fb69b065d0a21ad68458857b99bd70bbea56a44c2f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 254,
        "sourceEnd": 298,
        "text": "Thank you. Do you have photo identification?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "e06fdf9acc7b370974213035a27d1569919d7b4bba779a994344273248a9fa26",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 307,
        "sourceEnd": 352,
        "text": "I have my driving licence. Is that all right?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "9d9125d8d1bc3fcaa377b4816ed5d09c4ce2c84b531e42537dc641708d05cffa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 360,
        "sourceEnd": 473,
        "text": "Yes. The address matches, so that is fine. Your parcel arrived yesterday. It is quite large. Did you come by car?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "a556d9c0b198219a1a640499568c00eb0160388208c4af7ca7c4faf0ec76526a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 482,
        "sourceEnd": 529,
        "text": "No, by bicycle. Can you keep it until tomorrow?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "1e638ba9b2f98b02587e236286f2d21ee20d801c9b0cdb8e433b4cce46bc3f0c",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 537,
        "sourceEnd": 693,
        "text": "Certainly. We can keep it free for seven days. After that it goes back to the sender. We close at five today, but tomorrow is Saturday, so we close at noon.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "671851b882aa9c3aa9940d1d292b89f18d91d30f9dab5454ac15cd263ec6f2a7",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 702,
        "sourceEnd": 763,
        "text": "I will come at ten with my sister's car. Is there a car park?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "b1db643a625a07e109a610b024226ab85e191437a42799b55b8175c194f465f0",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "clerk",
        "speaker": "Clerk",
        "sourceStart": 771,
        "sourceEnd": 977,
        "text": "Use the spaces behind this building. The front spaces belong to the dentist. Bring this card again. Your sister can collect the parcel for you, but she will need your written permission as well as the card.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6679fdc3623f3b84dada5e26aed7e4d6af9f42bfe46d41632931f77831b45f3a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "elliot",
        "speaker": "Elliot",
        "sourceStart": 986,
        "sourceEnd": 1028,
        "text": "I will come myself. Thanks for explaining.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "fb4e16c707b5de2a7e57b07f9599c6c8be566b8438006e80ccc017aaf0bc530a",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
