    "segments": [
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 9,
        "sourceEnd": 76,
        "text": "Hello. I need to borrow a recorder for a college interview project.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "6799bd7412cb4b806145871dc8c75a53ccacb0d7f861bed7b9a573ca7eec2491",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 89,
        "sourceEnd": 127,
        "text": "Have you completed the equipment form?",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "35c0e18776d64eaf0d8fd7a85f9ad27695f04a41ac7ea080c38837d72bdec473",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 137,
        "sourceEnd": 209,
        "text": "I filled it in online last night. My student number ends in six two one.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "ab3ad0d86762ad9afd1ff1b77281e2f540b60673eb2dead64bb56caf824ae9e8",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 222,
        "sourceEnd": 267,
        "text": "I can see it. You asked for a camera as well.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "44083c76957eee03fbcea52e423a4e25a0061bb12ecf5207d5ce7c6027f7f98d",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 277,
        "sourceEnd": 327,
        "text": "That was a mistake. We only need sound, not video.",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "be0b9c0d609be67c98ede8ab71619d8750127636fed68ddf0db3803cdef73c29",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 340,
        "sourceEnd": 455,
        "text": "Fine. The recorder is available from Wednesday. You must return it by four on Friday. We are closed at the weekend.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "185e84c501f3a57d3e04d10f955404d80035c5dbfb55395e068f08cc1330f69a",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 465,
        "sourceEnd": 488,
        "text": "Does it need batteries?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "3175401b36e2aac46f2f30bd3fa742880e25429bebe1a86358e0bbc2444f998b",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 501,
        "sourceEnd": 685,
        "text": "It has a rechargeable battery. Charge it with this cable. A full charge lasts about eight hours, but check the battery before every interview. There is a spare memory card in the case.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "c05c93b8c8809913cc7973f01df276567eda0c9d8ac48e2fcca739f8cb92da96",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 695,
        "sourceEnd": 723,
        "text": "Can we record in the street?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "270e4f063e3dcef97978176b63f203748793209944843e322320627d46cb9617",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 736,
        "sourceEnd": 863,
        "text": "You can, but traffic may hide people's voices. Try a quiet room first. Always ask people for permission before you record them.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "72e6bf005c181a4b6c6ce55a7473e7dda3cfc8889b29faae44f45c5fc36da14f",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "student",
        "speaker": "Student",
        "sourceStart": 873,
        "sourceEnd": 899,
        "text": "How can I learn to use it?",
        "boundary": "turn",
        "voice": "en-US-AriaNeural",
        "textHash": "eaa8c29146fb85c04dd9dad44aadebe3f6ef57b051ff3127712e74797f1d88aa",
        "pauseBeforeSeconds": 0.45
      },
      {
        "role": "technician",
        "speaker": "Technician",
        "sourceStart": 912,
        "sourceEnd": 1176,
        "text": "Watch the short training video on the college website. Then make a test recording here before you leave. Headphones are provided so you can check it. If there is a problem later, email the technical team. Do not post the college equipment number on a public forum.",
        "boundary": "turn",
        "voice": "en-US-GuyNeural",
        "textHash": "995cf305412dd208a19ec8885aaeb8180d63b99f7473f05e1ae614a9fd4a7822",
        "pauseBeforeSeconds": 0.45
      }
    ]
  },
