    "segments": [
      {
        "role": "narrator",
        "speaker": "Narrator",
        "sourceStart": 0,
        "sourceEnd": 331,
        "text": "Hello, and thank you for volunteering at Westfield Library. This is a training session for our Saturday reading club. Children arrive at ten, but please be here at nine forty-five so that we can arrange the chairs. The club meets in the room upstairs. We used the children's area last month, but it was too noisy for reading aloud.",
        "boundary": "paragraph",
        "voice": "en-US-AriaNeural",
        "textHash": "fe45f8951dfb1c0eadb63003223e6006ab90455afd62b1c4760a1b74339b587f",
        "pauseBeforeSeconds": 0
      },
      {
        "role": "narrator",
        "speaker": "Narrator",
        "sourceStart": 333,
        "sourceEnd": 631,
        "text": "Each volunteer will work with three children. The children choose their own story, and your job is to help them understand it. Please do not turn the session into a spelling test. If a child does not want to read aloud, you can read a page first and then invite the child to join in. Do not insist.",
        "boundary": "paragraph",
        "voice": "en-US-AriaNeural",
        "textHash": "b95bf911115233f35deced3da74983c58a2558321e4a20059a69369a2e52128b",
        "pauseBeforeSeconds": 1.2
      },
      {
        "role": "narrator",
        "speaker": "Narrator",
        "sourceStart": 633,
        "sourceEnd": 1123,
        "text": "There is a break after forty minutes. Water is available in the room. Snacks are not allowed there because a child in the club has a serious food allergy. Parents collect the children at eleven thirty. If a parent is late, tell the librarian at the front desk. Never leave a child waiting alone. You will receive a blue volunteer badge today. Please return it to the desk when you leave; we use the same badges each week. If you cannot attend a future session, email me by Thursday evening.",
        "boundary": "paragraph",
        "voice": "en-US-AriaNeural",
        "textHash": "35da810444fb6c8cdf53d632e38e8d855bd4bbf34733de69a664d94f3aec0391",
        "pauseBeforeSeconds": 1.2
      }
    ]
