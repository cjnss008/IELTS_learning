        "start": 91.97333333333333,
        "voiceEnd": 108.23666666666666,
        "end": 124.5,
        "voiceSeconds": 16.263333333333332,
        "pauseSeconds": 16.263333333333332,
        "sourceStart": 49.973333333333336,
        "sourceEnd": 66.23666666666666,
