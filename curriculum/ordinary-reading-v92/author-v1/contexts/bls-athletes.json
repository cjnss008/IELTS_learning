    {
      "id": "bls-athletes-word-3",
      "word": "helmet",
      "canonicalTargetId": "essential:helmet",
      "surface": "helmets",
      "startUtf16": 2993,
      "endUtf16": 3000,
      "quote": "Athletes and sports competitors have one of the highest rates of injuries and illnesses of all occupations. Many of these workers wear gloves, helmets, pads, and other protective gear to guard against injury.",
