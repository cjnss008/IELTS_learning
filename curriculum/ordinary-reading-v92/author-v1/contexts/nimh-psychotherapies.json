    {
      "id": "nimh-psychotherapies-word-4",
      "word": "cope",
      "canonicalTargetId": "essential:cope",
      "surface": "coping",
      "startUtf16": 2067,
      "endUtf16": 2073,
      "quote": "Even when medication relieves symptoms, psychotherapy can help address specific issues. These might include self-defeating ways of thinking; irrational fears; problems interacting with other people; or difficulty coping with situations at home, school, or work.",
