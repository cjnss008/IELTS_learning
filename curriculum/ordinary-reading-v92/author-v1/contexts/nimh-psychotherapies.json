    {
      "id": "nimh-psychotherapies-word-5",
      "word": "distress",
      "canonicalTargetId": "essential:distress",
      "surface": "distress",
      "startUtf16": 3469,
      "endUtf16": 3477,
      "quote": "Use exposure therapy (a type of CBT) for anxiety disorders, in which a person spends brief periods in a supportive environment learning to tolerate the distress caused by certain items, ideas, or imagined scenes. This is continued until, over time, the fear associated with those things goes down.",
