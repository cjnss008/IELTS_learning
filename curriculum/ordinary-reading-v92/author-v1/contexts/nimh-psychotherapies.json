    {
      "id": "nimh-psychotherapies-word-3",
      "word": "emotion",
      "canonicalTargetId": "essential:emotion",
      "surface": "emotions",
      "startUtf16": 172,
      "endUtf16": 180,
      "quote": "Psychotherapy (also called talk therapy) refers to a variety of treatments that aim to help a person identify and change troubling emotions, thoughts, and behaviors. Most psychotherapy takes place one-on-one with a licensed mental health professional or with other patients in a group setting.",
